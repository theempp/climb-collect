<roblox version="4">
  <Item class="Lighting" referent="0">
    <Properties>
      <string name="Name">Lighting</string>
      <float name="Brightness">2.5</float>
      <float name="ClockTime">13.5</float>
    </Properties>
  </Item>
  <Item class="ReplicatedStorage" referent="1">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="2">
      <Properties>
        <string name="Name">MountainShared</string>
      </Properties>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">AlpineProfile</string>
          <string name="Source"><![CDATA[-- Pure spatial contract for cosmetic mountain presentation. No gameplay state.
local P={version=1}
local function smooth(a,b,x)
 local t=math.clamp((x-a)/(b-a),0,1);return t*t*(3-2*t)
end
P.smooth=smooth
function P.intensity(x,y,z)
 local area=(1-smooth(210,360,math.abs(x-4096)))*smooth(-210,-270,z)*(1-smooth(1410,1510,-z))
 return smooth(16,400,y)*area
end
local colors={{96,125,91},{99,128,119},{151,135,105},{116,119,134},{96,105,117},{179,194,207}}
function P.ground(x,z)
 -- Boundaries wander across the face; the same palette continues onto shoulders.
 local depth=-210-z+42*math.sin(x*.014+z*.009)+22*math.noise(x*.009,z*.011,31)
 local v=math.clamp((depth-90)/200+1,1,6);local k=math.min(5,math.floor(v))
 local t=smooth(0,1,v-k);local a,b=colors[k],colors[k+1]
 local grain=math.noise(x*.023,z*.019,7)*9
 return {a[1]+(b[1]-a[1])*t+grain,a[2]+(b[2]-a[2])*t+grain,a[3]+(b[3]-a[3])*t+grain}
end
return P
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Catalog</string>
          <string name="Source"><![CDATA[local C={version='ImpossibleMountain-1',seed=241026,incubation={Common=30,Uncommon=120,Rare=300,Epic=600,Mythic=1200}}
C.kingdoms={
 {id='blossom',name='Blossom Gardens',element='Nature',resource='Bloom Essence',color={109,164,112},accent={243,170,205},rock={102,121,104},material='Grass',landmarks={"Sovereign’s Garden",'Blooming Colosseum','Rootsong Ruins'}},
 {id='azure',name='Azure Falls',element='Water',resource='Tidal Pearls',color={83,153,159},accent={100,222,233},rock={89,120,139},material='Slate',landmarks={'Heart of the Falls','Veiled Grotto','Hanging Fern Sanctuary'}},
 {id='sunstone',name='Sunstone Desert',element='Earth',resource='Sunstone Ore',color={215,171,100},accent={255,211,103},rock={179,131,80},material='Sandstone',landmarks={'Solar Throne','Oasis of Echoes','Arch of the Dawn'}},
 {id='violet',name='Violet Crystals',element='Crystal',resource='Prism Shards',color={131,108,169},accent={200,157,255},rock={101,91,128},material='Rock',landmarks={'Fractured Mirror Observatory','Amethyst Hollow','Bridge of Reflections'}},
 {id='inferno',name='Inferno Heights',element='Fire',resource='Ember Cores',color={81,73,78},accent={255,151,69},rock={57,52,62},material='Basalt',landmarks={'Emberheart Crucible','Ashen Temple','Cinderfall Forge'}},
 {id='astral',name='Astral Crown',element='Cosmic',resource='Astral Fragments',color={194,210,225},accent={153,198,255},rock={123,141,171},material='Snow',landmarks={'Eternal Astral Sanctum','Star Garden','Constellation Gate'}},
}
local names={
 {'Mossbun','Petalyn','Fernox','Bloomlet','Thorncub','Floramoth'},
 {'Bubblit','Ripplet','Coralfen','Mistfin','Tidepup','Shellora'},
 {'Pebblin','Duneling','Sunscarab','Glimfox','Sandhorn','Solspike'},
 {'Shardlet','Prismite','Glowmoth','Amethyn','Crystail','Violette'},
 {'Emberkit','Ashling','Cindercub','Magmole','Flarewing','Obsidrax'},
 {'Starbit','Moonlet','Nebulyn','Cosmorin','Astralyn','Stellhorn'},
}
local shapes={
 {'rabbit','deer','fox','sprout','bear','moth'}, {'blob','otter','deer','fish','dog','turtle'},
 {'rock','worm','beetle','fox','rhino','hedgehog'}, {'shard','orb','moth','serpent','cat','jelly'},
 {'cat','ghost','bear','mole','bird','dragon'}, {'star','rabbit','cat','whale','deer','rhino'},
}
local features={
 {'moss ears','petal antlers','fern tail','flower crown','thorn armor','six petal wings'},
 {'bubble antennae','ripple tail','coral antlers','sail fins','sapphire ears','spiral shell'},
 {'stone fists','sand frill','solar elytra','glass tail','split horns','sun spines'},
 {'twin crystals','orbiting facets','glass wings','amethyst frill','prism tail','hanging gems'},
 {'ember whiskers','ash wisps','cinder shoulders','drill snout','flame wings','obsidian horns'},
 {'five rays','crescent ears','nebula tail','stellar fins','constellation antlers','comet horn'},
}
C.species={};C.byId={}
for k,row in ipairs(names) do
 for j,name in ipairs(row) do
  local s={id=string.lower(name),name=name,kingdom=k,element=C.kingdoms[k].element,rarity=({'Common','Common','Uncommon','Rare','Epic','Mythic'})[j],
   shape=shapes[k][j],feature=features[k][j],variant=j,health=90+j*16+k*9,attack=10+j*2+k*2,
   role=({'Damage','Support','Tank','Speed','Control','Magic'})[j],weight=({20,20,28,18,10,4})[j],
   encounter=({'HiddenNest','WildEncounter','Puzzle','Branch','DangerRoute','RareDiscovery'})[j],egg='egg_'..string.lower(name),levelCap=50,evolution={15,35},specialization=25}
  table.insert(C.species,s);C.byId[s.id]=s
 end
end
C.guardians={
 {id='floravelle',name='Floravelle',title='Sovereign of Life',shape='deer',legs=6,personality='Regal',abilities={'Petal Volley','Sovereign Bloom',"Garden’s Grace",'Royal Garden Awakening'}},
 {id='aquarune',name='Aquarune',title='Sovereign of the Tides',shape='otter',legs=6,personality='Playful',abilities={'Ripple Barrage','Tidal Break','Flow Momentum','Heart of the Ocean'}},
 {id='zenthari',name='Zenthari',title='Solar Juggernaut',shape='golem',legs=2,personality='Resolute',abilities={"Monarch’s Fists",'Sunstone Crusher',"Monarch’s Resolve",'Solar Dominion'}},
 {id='veylith',name='Veylith',title='Sovereign of Refraction',shape='shard',legs=0,personality='Watchful',abilities={'Shard Lance','Prism Fracture','Crystal Alignment','Shattered Star'}},
 {id='pyralune',name='Pyralune',title='Sovereign of Embers',shape='bird',legs=0,personality='Playful and proud',abilities={'Ember Barrage','Blazing Spiral','Eternal Spark','Phoenix Ascension'}},
 {id='caeloryn',name='Caeloryn',title='Sovereign of the Stars',shape='deer',legs=6,personality='Ancient',abilities={'Astral Lance','Gravity Choir','Constellation Accord','Celestial Dominion'}},
}
for i,g in ipairs(C.guardians) do
 g.kingdom=i;g.element=C.kingdoms[i].element;g.rarity='Legendary';g.attack=28+i*5;g.health=260+i*35;g.role='Guardian';g.variant=i;g.feature='sovereign';C.byId[g.id]=g
end
local TerrainProfile=if script then require(script.Parent.TerrainProfile) else require('./TerrainProfile')
local routeSweeps={2.9,2.65,2.9,2.6,2.7,2.4}
function C.route(k,t)
 local y=16+(k-1)*136+t*72+math.floor(t*4+0.000001)*16
 local a=math.pi/2
 for i=1,k-1 do a+=routeSweeps[i] end
 a+=t*routeSweeps[k]
 local r=TerrainProfile.radius(a,y+8)
 return {x=math.cos(a)*r,y=y,z=math.sin(a)*r,angle=a,radius=r}
end
function C.guardianColumnAngles(k)
 local angles={}
 local entrance=C.route(k,.875).angle+math.pi
 for j=1,12 do
  local a=j*math.pi/6
  if math.cos(a-entrance)<=0 or 38*math.abs(math.sin(a-entrance))>14 then table.insert(angles,a) end
 end
 return angles
end
function C.ladderSetback(k,i)
 local a,b=C.route(k,(i-1)/48),C.route(k,i/48)
 local distance=math.sqrt((b.x-a.x)^2+(b.z-a.z)^2)
 return math.min(11,distance*.6)
end
return C
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">GuardianRules</string>
          <string name="Source"><![CDATA[local Config=if script then require(script.Parent.RaidConfig) else require('./RaidConfig')
local G={}
function G.new(k,now)
 return {section=k,phase='defending',threats={},restUntil=now,targetUntil=now,attackAt=now,alertVersion=0,resolvedVersion=0}
end
function G.alert(state,userId,eggId,now)
 state.threats[userId]={eggId=eggId,at=now}
 state.alertVersion+=1
 return state
end
function G.step(state,observations,now)
 local config=Config.section(state.section);local effects={}
 for id,threat in pairs(state.threats) do
  local o=observations[id]
  if not o or not o.alive or not o.inside or now-threat.at>config.threatSeconds then state.threats[id]=nil end
 end
 if now<state.restUntil then state.phase='resting';state.target=nil;return state,effects end
 local best,bestRank,bestDistance
 for id in pairs(state.threats) do
  local o=observations[id];local rank=if o.breaking then 0 else 1
  if best==nil or rank<bestRank or (rank==bestRank and (o.distance<bestDistance or (o.distance==bestDistance and id<best))) then best=id;bestRank=rank;bestDistance=o.distance end
 end
 local current=state.target and state.threats[state.target] and observations[state.target]
 if current and now<state.targetUntil and state.alertVersion==state.resolvedVersion and not (bestRank==0 and not current.breaking) then best=state.target end
 if best~=state.target then
  state.target=best;state.targetUntil=now+config.targetDwell;state.approachUntil=now+config.approachSeconds
  effects.target=best
 end
 state.resolvedVersion=state.alertVersion
 if not best then state.phase='defending';return state,effects end
 state.phase=if now<(state.approachUntil or now) then 'approaching' else 'pursuing'
 if state.phase=='pursuing' and observations[best].distance<=config.catchRange and now>=state.attackAt then
  effects.attack=best;state.attackAt=now+config.attackCooldown
 end
 return state,effects
end
function G.normalWin(state,contributors,now)
 local effects={xp={}}
 if now<state.restUntil then return state,effects end
 state.restUntil=now+Config.section(state.section).respiteSeconds;state.phase='resting';state.target=nil;state.threats={}
 local seen={};for _,id in ipairs(contributors) do if not seen[id] then seen[id]=true;table.insert(effects.xp,id) end end
 effects.respite=true
 return state,effects
end
return G
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">HazardRules</string>
          <string name="Source"><![CDATA[local Config=if script then require(script.Parent.RaidConfig) else require('./RaidConfig')
local H={}
function H.sample(k,now)
 local c=Config.section(k);local cycle=math.floor(now/c.hazardPeriod);local t=now%c.hazardPeriod
 return if t<c.hazardTell then 'warning' elseif t<c.hazardTell+c.hazardActive then 'active' else 'quiet',cycle
end
function H.contains(x,y,z,halfX,halfZ)
 return math.abs(x)<=halfX and math.abs(z)<=halfZ and y>=-2 and y<=9
end
return H
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">MovementRules</string>
          <string name="Source"><![CDATA[-- Provisional local-review tuning. No ownership or currency mutations.
local R={walk=16,sprint=27,carryMultiplier=.9,requestInterval=.08}
function R.speed(sprint,carrying)
 return (if sprint then R.sprint else R.walk)*(if carrying then R.carryMultiplier else 1)
end
function R.intent(value,now,lastPress)
 return type(value)=='boolean' and (not value or now-lastPress>=R.requestInterval)
end
function R.active(wanted,health,seated,platformStand)
 return wanted==true and health>0 and not seated and not platformStand
end
return R
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">RaidConfig</string>
          <string name="Source"><![CDATA[-- All timings and distances are provisional local-playtest tuning, not approved targets.
local Config={version=1,provisional=true,strikeRange=12,pickupRange=12,strikeCadence=.45,reservationSeconds=55,eggRestSeconds=18,seriousFall=32,saveRetrySeconds=5,combatApproachSeconds=12}
local hazards={'root','water','sandstone','prism','fire','gravity'}
local records={}
for k=1,6 do
 records[k]={section=k,hits=2+k,hazard=hazards[k],guardianSpeed=9+k*1.1,approachSeconds=1.8,catchRange=5,attackCooldown=2.5,targetDwell=1.8,respiteSeconds=24,threatSeconds=70,hazardPeriod=10-k*.5,hazardTell=2.5-k*.15,hazardActive=1.2,hazardDamage=12+k*5,normalHealth=950+k*300,trialHealthMultiplier=1.6,joinHealth=350+k*80,companionXP=200*k,contributionFraction=.03}
end
function Config.section(k) return records[k] end
return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Rules</string>
          <string name="Source"><![CDATA[local C = if script then require(script.Parent.Catalog) else require('./Catalog')
local R={}
R.tycoon=if script then require(script.Parent.Tycoon) else require('./Tycoon')
local function nextId(p,prefix) p.serial+=1;return prefix..p.serial end
local function find(list,id) for i,v in ipairs(list) do if v.id==id then return v,i end end end
function R.newProfile(now)
 local p={schema=2,legacyEntitlements={},securedRunIds={},serial=3,unlocked=1,wins={},captures={},cargo={},eggs={},creatures={},team={},checkpoint='1:entrance',discoveries={},claims={},shortcuts={},resources={},coins=0,trophies=0,lastIncome=now,competitionAt=0}
 for i,id in ipairs({'mossbun','petalyn','fernox'}) do local v={id='c'..i,species=id,level=1,xp=0};table.insert(p.creatures,v);table.insert(p.team,v.id) end
 return p
end
R.run=if script then require(script.Parent.RunRules) else require('./RunRules')
function R.canEnter(p,k) return type(k)=='number' and k==math.floor(k) and k>=1 and k<=6 end
function R.stage(level) return if level>=35 then 3 elseif level>=15 then 2 else 1 end
function R.trialReady(k,resolvedPatterns,members)
 if resolvedPatterns<4 then return false end
 if k~=5 and k~=6 then return true end
 for _,m in pairs(members) do if m.objective then return true end end
 return false
end
function R.mastered(k,m) return m.dodges>=3 and ((k~=5 and k~=6) or m.objective==true) end
function R.addXP(c,xp)
 c.xp+=math.max(0,math.floor(xp))
 while c.level<50 and c.xp>=c.level*40 do c.xp-=c.level*40;c.level+=1 end
 if c.level>=50 then c.level=50;c.xp=0 end
end
function R.winGuardian(p,k,trial)
 if not R.canEnter(p,k) then return false end
 local g=C.guardians[k]
 if trial then
  if p.schema==2 then return false,'trial_requires_raid' end
  if not p.wins[tostring(k)] or p.captures[g.id] then return false end
  p.captures[g.id]=true
  table.insert(p.creatures,{id=nextId(p,'c'),species=g.id,level=1,xp=0})
 else
  p.wins[tostring(k)]=true;p.unlocked=math.max(p.unlocked,math.min(6,k+1))
 end
 return true
end
function R.collect(p,species,source,now)
 local s=C.byId[species]
 if not s or s.rarity=='Legendary' or not R.canEnter(p,s.kingdom) or #p.cargo>=3 or (p.claims[source] or 0)>now then return false end
 table.insert(p.cargo,{id=nextId(p,'e'),species=species});p.claims[source]=now+180
 return true
end
function R.extract(p)
 local n=#p.cargo
 for _,e in ipairs(p.cargo) do table.insert(p.eggs,e) end
 p.cargo={};return n
end
function R.incubate(p,id,now)
 local e=find(p.eggs,id)
 if not e or e.readyAt then return false end
 local active=0;for _,v in ipairs(p.eggs) do if v.readyAt then active+=1 end end
 if active>=3 then return false end
 e.readyAt=now+C.incubation[C.byId[e.species].rarity];return true
end
function R.hatch(p,id,now)
 local e,i=find(p.eggs,id)
 if not e or not e.readyAt or now<e.readyAt then return false end
 table.insert(p.creatures,{id=nextId(p,'c'),species=e.species,level=1,xp=0});table.remove(p.eggs,i);return true
end
function R.equip(p,ids)
 if type(ids)~='table' or #ids<1 or #ids>3 then return false end
 for key in pairs(ids) do if type(key)~='number' or key%1~=0 or key<1 or key>#ids then return false end end
 local seen={};for _,id in ipairs(ids) do if type(id)~='string' or seen[id] or not find(p.creatures,id) then return false end;seen[id]=true end
 p.team={};for _,id in ipairs(ids) do table.insert(p.team,id) end;return true
end
function R.specialize(p,id,choice)
 local c=find(p.creatures,id)
 if not c or c.level<25 or c.specialization or not table.find({'Power','Guard','Vitality'},choice) then return false end
 c.specialization=choice;return true
end
function R.drop(p,now)
 if #p.cargo==0 then return end
 p.recovery={eggs=p.cargo,expires=now+180};p.cargo={}
end
function R.recover(p,now)
 local r=p.recovery
 if not r then return false end
 if now>=r.expires then p.recovery=nil;return false end
 if #r.eggs+#p.cargo>3 then return false end
 for _,e in ipairs(r.eggs) do table.insert(p.cargo,e) end
 p.recovery=nil;return true
end
function R.damage(element,target,base)
 local strong={Water='Fire',Fire='Nature',Nature='Earth',Earth='Crystal',Crystal='Cosmic',Cosmic='Water'}
 return math.max(1,math.floor(base*(if strong[element]==target then 1.3 elseif strong[target]==element then .8 else 1)))
end
function R.stats(c)
 local s=C.byId[c.species];local factor=1+(c.level-1)*.065
 return {attack=s.attack*factor*(if c.specialization=='Power' then 1.2 else 1),health=s.health*factor*(if c.specialization=='Vitality' then 1.25 else 1),guard=if c.specialization=='Guard' then .15 else 0,element=s.element,role=s.role}
end
function R.settleIncome(p,now)
 if p.tycoon then R.tycoon.settle(p,now,false);return 0 end
 local elapsed=math.clamp(now-p.lastIncome,0,8*3600)
 if elapsed<10 then return 0 end
 local rate=0;for _,c in ipairs(p.creatures) do rate+=({Common=6,Uncommon=12,Rare=24,Epic=48,Mythic=90,Legendary=150})[C.byId[c.species].rarity] end
 local accrued=elapsed*rate/3600+(p.incomeCarry or 0)
 local amount=math.floor(accrued+0.00000001);p.incomeCarry=math.max(0,accrued-amount);p.coins+=amount;p.lastIncome=now;return amount
end
R.find=find
return R
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">RunRules</string>
          <string name="Source"><![CDATA[-- Pure custody. secure() mutates only a caller-owned transaction draft.
local C=if script then require(script.Parent.Catalog) else require('./Catalog')
local Run={}
local function text(v) return type(v)=='string' and #v>0 and #v<=128 end
local function eggs(list)
 if type(list)~='table' then return false end
 local count=0
 for key,e in pairs(list) do
  if type(key)~='number' or key%1~=0 or key<1 or key>#list or type(e)~='table' or not text(e.id) or not C.byId[e.species] or C.byId[e.species].rarity=='Legendary' then return false end
  count+=1
 end
 return count==#list
end
function Run.migrate(p)
 if type(p)~='table' or (p.schema~=1 and p.schema~=2) then return nil end
 if p.schema==2 then return p end
 if not eggs(p.eggs) or not eggs(p.cargo) or (p.recovery~=nil and (type(p.recovery)~='table' or not eggs(p.recovery.eggs))) then return nil end
 local identities={}
 for _,list in ipairs({p.eggs,p.cargo,if p.recovery then p.recovery.eggs else {}}) do for _,e in ipairs(list) do
  local previous=identities[e.id]
  if previous and (previous.species~=e.species or (previous.readyAt~=nil and e.readyAt~=nil and previous.readyAt~=e.readyAt)) then return nil end
  identities[e.id]=previous or e
 end end
 local seen={};for _,e in ipairs(p.eggs) do if seen[e.id] then return nil end;seen[e.id]=true end
 local entitlements={}
 for _,list in ipairs({p.cargo,if p.recovery then p.recovery.eggs else {}}) do
  for _,e in ipairs(list) do
   if type(e)~='table' or not text(e.id) or not C.byId[e.species] or C.byId[e.species].rarity=='Legendary' then return nil end
   if not seen[e.id] then seen[e.id]=true;table.insert(entitlements,table.clone(e)) end
  end
 end
 p.legacyEntitlements={};for _,e in ipairs(entitlements) do table.insert(p.eggs,e);p.legacyEntitlements[e.id]=true end
 p.cargo={};p.recovery=nil;p.run=nil;p.securedRunIds={};p.schema=2
 return p
end
function Run.strike(p,egg,now)
 if p.schema~=2 or type(egg)~='table' or not text(egg.id) or not text(egg.runId) or not C.byId[egg.species] or type(egg.section)~='number' or egg.section%1~=0 or egg.section<1 or egg.section>6 or type(now)~='number' or now~=now then return false,'invalid' end
 if egg.trial and (not p.wins[tostring(egg.section)] or p.captures[egg.species]) then return false,'trial_unavailable' end
 if p.run and (p.run.eggId~=egg.id or p.run.id~=egg.runId or p.run.phase~='breaking') then return false,'full_hands' end
 if not p.run then p.run={id=egg.runId,eggId=egg.id,species=egg.species,section=egg.section,trial=egg.trial==true,phase='breaking',hits=0,startedAt=now} end
 p.run.hits+=1
 if p.run.hits>=math.max(1,egg.hitsRequired or 1) then p.run.phase='revealed' end
 return true
end
function Run.pickup(p,runId)
 local r=p.run;if not r or r.id~=runId or r.phase~='revealed' then return false,'no_reveal' end
 r.phase='carried';return true
end
function Run.forfeit(p,reason)
 if not p.run then return false end
 p.run=nil;return true,reason
end
function Run.secure(p,runId)
 for _,id in ipairs(p.securedRunIds or {}) do if id==runId then return true,'already_secured' end end
 local r=p.run
 if not r or r.id~=runId or r.phase~='carried' then return false,'not_carried' end
 if r.trial and p.captures[r.species] then return false,'already_captured' end
 p.serial+=1
 table.insert(p.creatures,{id='c'..p.serial,species=r.species,level=1,xp=0})
 if r.trial then p.captures[r.species]=true end
 p.securedRunIds=p.securedRunIds or {};table.insert(p.securedRunIds,runId)
 if #p.securedRunIds>128 then table.remove(p.securedRunIds,1) end
 p.run=nil;return true,'secured'
end
return Run
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">TerrainProfile</string>
          <string name="Source"><![CDATA[-- One deterministic landform shared by trail placement and terrain generation.
local P={}
function P.height(x,z)
 local a=math.atan2(z,x)
 local radial=math.sqrt(x*x+z*z)
 -- A connected star-shaped watershed avoids disconnected contour islands.
 -- Unequal broad ridges run continuously from the summit to the foothills.
 local width=440+65*math.sin(a*3+.5)+34*math.sin(a*5-1)+22*math.cos(a-1)
 local crown=86+15*math.sin(a*3+.5)
 local r=math.max(0,(radial-crown)/width)
 return math.max(-32,858*(1-r^1.12))
end
function P.radius(angle,height)
 local cx,cz=math.cos(angle),math.sin(angle)
 local outer=800
 for r=784,0,-16 do
  if P.height(cx*r,cz*r)>=height then
   local inner=r
   for _=1,20 do
    local mid=(inner+outer)*.5
    if P.height(cx*mid,cz*mid)>=height then inner=mid else outer=mid end
   end
   return (inner+outer)*.5
  end
  outer=r
 end
 return 0
end
return P
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">TraversalRules</string>
          <string name="Source"><![CDATA[local T={}
function T.gravityScale(x,y,z,halfX,halfZ)
 if math.abs(x)<=halfX and math.abs(z)<=halfZ and y>=0 and y<=30 then return .38 end
 return 1
end
function T.sandSpeed(time) return math.sin(time*math.pi/6)*5 end
return T
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Tycoon</string>
          <string name="Source"><![CDATA[local C=if script then require(script.Parent.Catalog) else require('./Catalog')
local Config=if script then require(script.Parent.TycoonConfig) else require('./TycoonConfig')
local T={config=Config}
local function integer(v,lo,hi) return type(v)=='number' and v==v and v%1==0 and v>=lo and v<=hi end
local function fraction(v) return type(v)=='number' and v==v and v>=0 and v<1 end
local function find(p,id) for _,c in ipairs(p.creatures) do if c.id==id then return c end end end
local function storeValid(s) return type(s)=='table' and integer(s.eggs,0,Config.maxCount) and integer(s.value,0,Config.maxCount*100) and ((s.eggs==0 and s.value==0) or (s.eggs>0 and s.value>=s.eggs)) end
function T.valid(t)
 if type(t)~='table' or t.version~=1 or not integer(t.slots,2,8) or not integer(t.lastAt,0,9007199254740991) or not storeValid(t.bag) or not fraction(t.bankCarry) or not table.find(Config.cosmetics,t.cosmetic) then return false end
 if type(t.levels)~='table' or type(t.habitats)~='table' or #t.habitats~=8 then return false end
 for k,v in pairs(t.habitats) do if not integer(k,1,8) then return false end end
 for _,key in ipairs({'production','storage','bag','banking','automation'}) do if not integer(t.levels[key],0,#Config.paths[key].costs) then return false end end
 local seen={}
 for i,h in ipairs(t.habitats) do
  if not storeValid(h) or not integer(h.level,0,4) or not integer(h.kingdom,1,6) or not fraction(h.progress) or not fraction(h.processCarry) or not integer(h.cycle,0,9) then return false end
  if h.creature~=nil then
   if type(h.creature)~='string' or #h.creature<1 or #h.creature>80 or seen[h.creature] or i>t.slots then return false end
   seen[h.creature]=true
  end
 end
 return true
end
function T.ensure(p,now)
 if p.tycoon then return p.tycoon end
 local habitats={}
 for i=1,8 do habitats[i]={level=0,kingdom=1,eggs=0,value=0,progress=0,processCarry=0,cycle=0} end
 p.tycoon={version=1,slots=2,lastAt=math.floor(now),habitats=habitats,bag={eggs=0,value=0},levels={production=0,storage=0,bag=0,banking=0,automation=0},bankCarry=0,cosmetic='Nature'}
 return p.tycoon
end
function T.capacity(p,index) return 30+30*p.tycoon.levels.storage+10*p.tycoon.habitats[index].level end
function T.bagCapacity(p) return 20+20*p.tycoon.levels.bag end
function T.rate(p,index)
 local t=p.tycoon;local h=t.habitats[index];local c=h.creature and find(p,h.creature)
 if not c then return 0,0,0 end
 local species=C.byId[c.species];if not species then return 0,0,0 end
 local kin=0
 for i,other in ipairs(t.habitats) do
  local adjacent=(math.floor((i-1)/2)==math.floor((index-1)/2) and i~=index) or math.abs(i-index)==2
  local v=adjacent and i<=t.slots and other.creature and find(p,other.creature)
  if v and C.byId[v.species].kingdom==species.kingdom then kin+=1 end
 end
 local bonus=(if species.kingdom==h.kingdom then .05 else 0)+math.min(kin,2)*.05
 local rarity=Config.rarity[species.rarity]
 return rarity.rate*(1+t.levels.production*.15+h.level*.1)*(1+bonus),rarity.value,bonus
end
function T.collect(p,index)
 local t=p.tycoon
 if not integer(index,0,t.slots) then return 0 end
 local order={};for i=1,t.slots do if index==0 or index==i then table.insert(order,i) end end
 if t.levels.automation>=3 then table.sort(order,function(a,b)
  local x,y=t.habitats[a],t.habitats[b]
  local xv,yv=x.value/math.max(1,x.eggs),y.value/math.max(1,y.eggs)
  return if xv==yv then a<b else xv>yv
 end) end
 local moved=0
 for _,i in ipairs(order) do
  local h=t.habitats[i];local n=math.min(h.eggs,math.max(0,T.bagCapacity(p)-t.bag.eggs))
  if n>0 then
   local value=if n==h.eggs then h.value else math.floor(h.value*n/h.eggs)
   h.eggs-=n;h.value-=value;t.bag.eggs+=n;t.bag.value+=value;moved+=n
  end
 end
 return moved
end
function T.bank(p)
 local t=p.tycoon;if t.bag.eggs==0 then return 0 end
 local raw=t.bag.value*(1+t.levels.banking*.025)+t.bankCarry
 local value=math.floor(raw+1e-8)
 if p.coins+value>9007199254740991 then return 0 end
 t.bankCarry=math.max(0,raw-value);p.coins+=value;t.bag.eggs=0;t.bag.value=0
 return value
end
function T.settle(p,now,offline)
 local t=T.ensure(p,now)
 if not integer(now,0,9007199254740991) or now<=t.lastAt then return 0 end
 local elapsed=math.min(now-t.lastAt,Config.offlineSeconds);t.lastAt=now
 local made=0
 for i=1,t.slots do
  local h=t.habitats[i];local rate,value=T.rate(p,i)
  local raw=h.progress+elapsed*rate/3600;local whole=math.floor(raw+1e-8)
  h.progress=math.max(0,raw-whole)
  local count=math.min(whole,math.max(0,T.capacity(p,i)-h.eggs))
  local bonus=math.floor((h.cycle+count)/10);h.cycle=(h.cycle+count)%10
  local amount=(count+bonus)*value
  if t.levels.automation>=2 then
   local extra=amount*.05+h.processCarry;local added=math.floor(extra+1e-8)
   h.processCarry=math.max(0,extra-added);amount+=added
  end
  h.eggs+=count;h.value+=amount;made+=count
 end
 -- Offline catchup never drains storage, including when automatic banking is unlocked.
 if not offline and t.levels.automation>=4 then
  if t.levels.automation>=5 then
   T.bank(p)
   -- At most eight bounded stores; empty with finite batches, no per-egg iteration.
   for _=1,80 do if T.collect(p,0)==0 then break end;T.bank(p) end
  else T.collect(p,0) end
 end
 return made
end
function T.assign(p,index,id,now)
 local t=p.tycoon
 if not integer(index,1,t.slots) or (id~=nil and (type(id)~='string' or not find(p,id))) then return false end
 for i,h in ipairs(t.habitats) do if id and h.creature==id and i~=index then return false end end
 T.settle(p,now,false)
 t.habitats[index].creature=id;t.habitats[index].progress=0
 return true
end
function T.attune(p,index,kingdom,now)
 if not integer(index,1,p.tycoon.slots) or not integer(kingdom,1,6) or kingdom>p.unlocked then return false end
 T.settle(p,now,false);p.tycoon.habitats[index].kingdom=kingdom;return true
end
function T.swap(p,first,second,now)
 local t=p.tycoon
 if not integer(first,1,t.slots) or not integer(second,1,t.slots) or first==second then return false end
 local a,b=t.habitats[first],t.habitats[second]
 if not b.creature or not find(p,b.creature) or (a.creature and not find(p,a.creature)) then return false end
 T.settle(p,now,false)
 a.creature,b.creature=b.creature,a.creature
 -- Fractional production follows its creature; stored eggs remain in each habitat.
 a.progress,b.progress=b.progress,a.progress
 return true
end
function T.upgradeEffect(p,path)
 local t=p.tycoon
 if path=='habitats' then return 'Active habitats: '..t.slots..' → '..math.min(8,t.slots+1)
 elseif path=='habitat' then return '+10% base egg rate · +10 egg storage'
 elseif path=='production' then return '+15% base egg rate in every habitat'
 elseif path=='storage' then return 'Each habitat: +30 egg storage'
 elseif path=='bag' then return 'Bag: '..T.bagCapacity(p)..' → '..(T.bagCapacity(p)+20)..' eggs'
 elseif path=='banking' then return string.format('Bank value bonus: %.1f%% → %.1f%%',t.levels.banking*2.5,(t.levels.banking+1)*2.5)
 elseif path=='automation' then return Config.automation[t.levels.automation+1] or 'All automation installed' end
 return ''
end
function T.quote(p,path,index)
 local def=Config.paths[path];if not def then return nil end
 local t=p.tycoon;local level
 if path=='habitat' then if not integer(index,1,t.slots) then return nil end;level=t.habitats[index].level
 elseif path=='habitats' then level=t.slots-2 else level=t.levels[path] end
 local cost=def.costs[level+1];if not cost then return nil end
 local ready=true
 if path=='automation' and level>=1 then ready=t.levels.production>=math.min(level,4) and t.levels.storage>=math.min(level,4) and t.levels.banking>=math.max(0,level-2) end
 return {cost=cost,level=level,next=level+1,ready=ready,requirement=if ready then '' else 'Requires production/storage '..math.min(level,4)..' and banking '..math.max(0,level-2)}
end
function T.upgrade(p,path,index,now)
 local q=T.quote(p,path,index);if not q or not q.ready or p.coins<q.cost then return false end
 T.settle(p,now,false);p.coins-=q.cost
 if path=='habitats' then p.tycoon.slots+=1 elseif path=='habitat' then p.tycoon.habitats[index].level+=1 else p.tycoon.levels[path]+=1 end
 return true
end
function T.cosmetic(p,id)
 if not table.find(Config.cosmetics,id) then return false end
 p.tycoon.cosmetic=id;return true
end
function T.snapshot(p)
 local t=p.tycoon;local rows={};local eggs,value,rate=0,0,0
 for i,h in ipairs(t.habitats) do
  local r,v,bonus=T.rate(p,i);eggs+=h.eggs;value+=h.value;rate+=r
  rows[i]={creature=h.creature,level=h.level,kingdom=h.kingdom,eggs=h.eggs,value=h.value,capacity=T.capacity(p,i),rate=r,bonus=bonus,unlocked=i<=t.slots}
 end
 return {slots=t.slots,habitats=rows,eggs=eggs,value=value,rate=rate,bag=table.clone(t.bag),bagCapacity=T.bagCapacity(p),levels=table.clone(t.levels),cosmetic=t.cosmetic,offlineSeconds=Config.offlineSeconds}
end
return T
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">TycoonConfig</string>
          <string name="Source"><![CDATA[-- Provisional balance, deliberately centralized for playtesting. No paid advantages.
return {
 version=1, offlineSeconds=8*3600, maxCount=1000000000,
 rarity={Common={rate=60,value=1},Uncommon={rate=72,value=1},Rare={rate=90,value=2},Epic={rate=108,value=2},Mythic={rate=132,value=3},Legendary={rate=156,value=4}},
 paths={
  habitats={label='Habitat modules',costs={50,120,250,450,750,1200}},
  habitat={label='Habitat comfort',costs={25,75,200,500}},
  production={label='Production',costs={40,120,300,700}},
  storage={label='Habitat storage',costs={25,75,180,400}},
  bag={label='Egg bag',costs={20,60,150,350}},
  banking={label='Banking',costs={80,250,600,1400}},
  automation={label='Automation',costs={100,300,650,1300,2500}},
 },
 automation={'Conveyor routing','Processor · +5% value','Sorter · valuable eggs first','Automatic collectors','Automatic banking'},
 cosmetics={'Nature','Water','Earth','Crystal','Fire','Cosmic'},
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">UIPresentation</string>
          <string name="Source"><![CDATA[-- Pure view models. These helpers never award, equip, or mutate profile data.
local C = if script then require(script.Parent.Catalog) else require('./Catalog')
local R = if script then require(script.Parent.Rules) else require('./Rules')
local P = {}
local rarityOrder = {Common=1, Uncommon=2, Rare=3, Epic=4, Mythic=5, Legendary=6}
local roleSkills = {Damage='Burst', Support='Heal', Tank='Shield', Speed='Haste', Control='Control', Magic='Burn'}
local function finite(value)
 return type(value)=='number' and value==value and math.abs(value)<math.huge
end
function P.remaining(deadline, now)
 if not finite(deadline) or not finite(now) then return 0 end
 return math.max(0,math.ceil(deadline-now))
end
function P.formatTime(seconds)
 local n = if finite(seconds) then math.max(0,math.ceil(seconds)) else 0
 if n>=3600 then return string.format('%d:%02d:%02d',math.floor(n/3600),math.floor(n/60)%60,n%60) end
 return string.format('%d:%02d',math.floor(n/60),n%60)
end
function P.creature(c)
 local species = c and C.byId[c.species]
 if not species then
  return {name='Unknown creature',rarity='Unknown',element='Unknown',role='Unknown',stage=1,attack=0,health=0,xpRequired=0,abilityNames={}}
 end
 local level = if finite(c.level) then math.clamp(math.floor(c.level),1,50) else 1
 local stats = R.stats({species=c.species,level=level,specialization=c.specialization})
 return {name=species.name,rarity=species.rarity,element=species.element,role=species.role,
  stage=R.stage(level),attack=stats.attack,health=stats.health,xpRequired=if level>=50 then 0 else level*40,
  abilityNames=if species.abilities then table.clone(species.abilities) else {roleSkills[species.role] or 'Special'}}
end
function P.filterCreatures(profile,query,rarity,sort)
 local found = {}
 local search = string.lower(tostring(query or '')):match('^%s*(.-)%s*$') or ''
 local tier = string.lower(tostring(rarity or 'all'))
 local teamOrder = {}
 for slot,id in ipairs(if profile then profile.team or {} else {}) do teamOrder[id]=slot end
 for _,c in ipairs(if profile then profile.creatures or {} else {}) do
  local s = C.byId[c.species]
  if s then
   local searchable = string.lower(table.concat({s.name,s.rarity,s.element,s.role,c.id or ''},' '))
   if (tier=='' or tier=='all' or string.lower(s.rarity)==tier) and (search=='' or string.find(searchable,search,1,true)) then
    table.insert(found,c)
   end
  end
 end
 local mode=string.lower(tostring(sort or 'name'))
 table.sort(found,function(a,b)
  local sa,sb=C.byId[a.species],C.byId[b.species]
  if mode=='team' and (teamOrder[a.id] or 4)~=(teamOrder[b.id] or 4) then return (teamOrder[a.id] or 4)<(teamOrder[b.id] or 4) end
  if mode=='level' and a.level~=b.level then return a.level>b.level end
  if mode=='rarity' and rarityOrder[sa.rarity]~=rarityOrder[sb.rarity] then return rarityOrder[sa.rarity]>rarityOrder[sb.rarity] end
  if sa.name~=sb.name then return sa.name<sb.name end
  return tostring(a.id)<tostring(b.id)
 end)
 return found
end
function P.quest(profile)
 if not profile then return {title='Preparing your mountain',detail='Waiting for the server profile.',progress=0,total=1} end
 if profile.schema==2 then
  if profile.run then return {title=if profile.run.phase=='carried' then 'Escape to sanctuary' elseif profile.run.phase=='revealed' then 'Pick up your creature' else 'Break the guarded egg',detail='Follow the clear downhill lane. Only the sanctuary exit secures this attempt.',progress=0,total=1} end
  local count=0;for k=1,6 do if profile.discoveries[k..':entrance'] then count+=1 end end
  return {title='Explore any of the six sections',detail='Find a visible egg, tap each strike, then carry your creature to sanctuary.',progress=count,total=6}
 end
 local discoveries,wins=profile.discoveries or {},profile.wins or {}
 for k,kingdom in ipairs(C.kingdoms) do
  if not wins[tostring(k)] then
   if not discoveries[tostring(k)..':entrance'] then
    return {title='Explore '..kingdom.name,detail='Reach the entrance checkpoint on the mountain route.',progress=0,total=1}
   end
   return {title='Challenge '..C.guardians[k].name,detail='Find the Guardian altar in '..kingdom.name..'.',progress=k-1,total=#C.kingdoms}
  end
 end
 return {title=if discoveries.summit then 'Summit discovered' else 'Reach the Impossible Summit',
  detail=if discoveries.summit then 'Explore branches and return for Legendary Trials.' else 'Follow the Astral Crown route to the summit.',
  progress=if discoveries.summit then 1 else 0,total=1}
end
function P.capabilities()
 -- Connected describes a real service boundary, never player eligibility.
 return {
  inventory={status='connected',reason='Authoritative creature inventory and three active team slots.'},
  training={status='connected',reason='Train at the expedition refuge with server-validated coins and XP.'},
  evolution={status='connected',reason='Level stages at 15 and 35; permanent specialization at 25.'},
  eggs={status='connected',reason='Carried and secured eggs, three incubators, timed free hatching.'},
  income={status='connected',reason='Collect habitat production eggs and bank them for coins on your own plot.'},
  travel={status='connected',reason='Discovered checkpoints and refuge travel validated by the server.'},
  combat={status='connected',reason='Automatic attacks, manual specials, dodge and Guardian Trials.'},
  coop={status='connected',reason='Join a nearby Guardian encounter at its altar.'},
  defenses={status='connected',reason='Register an offline defense or challenge a UserId at the refuge.'},
  profile={status='read-only',reason='Collection, discoveries, Guardian wins, captures and trophies.'},
  quests={status='read-only',reason='Objectives reflect existing discoveries and Guardian wins; no claimable quest reward service.'},
  settings={status='connected',reason='Validated UI preferences stored with the existing profile.'},
  sanctuary={status='connected',reason='Assigned plots, three Blossom gates and return travel share the mountain profile; incubation and training use existing services.'},
  habitats={status='connected',reason='Own-plot assign, swap, collect, bank, upgrade, attune and cosmetic actions.'},
  partyInvites={status='unavailable',reason='No party finder, invitation or readiness backend.'},
  dailyRewards={status='unavailable',reason='No daily reward or quest reward backend.'},
  rankings={status='unavailable',reason='No server ranking service.'},
  badges={status='unavailable',reason='No badge award service for this mountain.'},
  titles={status='unavailable',reason='No title ownership or equip service.'},
  shop={status='unavailable',reason='No approved product catalog, receipt or entitlement backend.'},
 }
end
function P.combatVisible(battle,ready,hubOpen)
 return ready==true and type(battle)=='table' and not hubOpen
end
function P.layout(width,height,largeText)
 local w=if finite(width) then math.max(1,width) else 667
 local h=if finite(height) then math.max(1,height) else 339
 local compact=h<500
 local phone=w<900 or compact
 local margin=if compact then 12 else 20
 local hubWidth=math.max(1,math.min(1040,w-margin*2))
 local hubHeight=math.max(1,math.min(760,h-margin*2))
 local narrow=w<560
 local teamBottom=if narrow then 176 else 12
 local teamWidth=math.max(1,math.min(if largeText then 324 else 300,if narrow then w-24 else w-360))
 return {compact=compact,phone=phone,sidebarWidth=if phone then 56 else 176,
  hubWidth=hubWidth,hubHeight=hubHeight,columns=math.max(1,math.floor((hubWidth-32)/(if largeText then 200 else 164))),
  teamWidth=teamWidth,teamBottom=math.min(teamBottom,math.max(0,h-160)),
  actionBottom=math.min(teamBottom+100,math.max(0,h-48))}
end
-- Safe-root coordinates. Native bounds are supplied by the actual TouchGui.
function P.horizontalNavigation(height,touch) return height<550 or touch==true end
function P.hudLayout(w,h,obstacles,touch)
 local short=h<400
 local left,right=12,w-12
 for _,o in ipairs(obstacles or {}) do
  if o.y+o.h>h-100 then
   if o.x<w/2 then left=math.max(left,math.min(o.x+o.w+8,w*.43))
   else right=math.min(right,o.x-8) end
  end
 end
 local tw=math.min(if short then 258 else 330,right-left)
 local center=(left+right)/2
 local function rect(x,y,rw,rh) return {x=x,y=y,w=rw,h=rh} end
 local horizontal=P.horizontalNavigation(h,touch==true or #(obstacles or {})>0)
 local actionY=math.min(h-190,h-((if short then 140 else 170)+54))
 for _,o in ipairs(obstacles or {}) do if o.x>w/2 then actionY=math.min(actionY,o.y-108) end end
 return {
  short=short,
  horizontalNavigation=horizontal,
  navigation=if horizontal then rect(100,if h<550 then 54 else 60,math.min(w-110,696),if h<550 then 50 else 82) else rect(12,140,184,326),
  status=rect(12,8,if w<900 then 230 else 290,44),
  journey=rect(w-(if short then 232 else 272)-12,8,if short then 232 else 272,if short then 64 else 78),
  menu=rect(12,if short then 54 else 60,80,if short then 48 else 70),
  quickCreatures=rect(100,if short then 54 else 60,76,if short then 48 else 70),
  quickMountain=rect(184,if short then 54 else 60,76,if short then 48 else 70),
  team=rect(center-tw/2,h-(if short then 90 else 112),tw,if short then 76 else 94),
  context=rect(center-math.min(tw,250)/2,h-(if short then 144 else 168),math.min(tw,250),48),
  dodge=rect(w-106,actionY,94,48),
  ability=rect(w-208,actionY,94,48),
  sprint=rect(w-106,actionY+54,94,48),
 }
end
return P
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">UIProtocol</string>
          <string name="Source"><![CDATA[-- Shared wire validation only; all ownership, proximity and costs remain server rules.
local U={}
local actions={Strike=true,Pickup=true,PutDown=true,Tycoon=true,State=true,Equip=true,Train=true,Specialize=true,Incubate=true,Hatch=true,Travel=true,TravelAbandon=true,CollectIncome=true,RegisterDefense=true,ChallengeDefense=true,Special=true,Dodge=true,Settings=true}
local defaults={reducedMotion=false,largeText=false,highContrast=false,simplifiedVFX=false,musicVolume=.7,sfxVolume=.8,hints=true}
local function finite(value) return type(value)=='number' and value==value and math.abs(value)<math.huge end
local function text(value) return type(value)=='string' and #value>0 and #value<=80 end
local function fields(value,allowed)
 if type(value)~='table' then return false end
 for key in pairs(value) do if not allowed[key] then return false end end
 return true
end
function U.parseId(id)
 if type(id)~='string' or #id>64 then return nil end
 local token,sequence=id:match('^([%w_%-]+):(%d+)$')
 if not token or #token>48 or #sequence>15 or sequence:sub(1,1)=='0' then return nil end
 local n=tonumber(sequence)
 if not n or n<1 or n>9007199254740991 then return nil end
 return token,n
end
function U.settings(patch,current)
 local result=table.clone(defaults)
 if type(current)=='table' then
  for key,default in pairs(defaults) do
   local value=current[key]
   if type(value)==type(default) and (type(value)~='number' or (finite(value) and value>=0 and value<=1)) then result[key]=value end
  end
 end
 if patch==nil then return result end
 if type(patch)~='table' then return nil end
 for key,value in pairs(patch) do
  local default=defaults[key]
  if default==nil or type(value)~=type(default) or (type(value)=='number' and (not finite(value) or value<0 or value>1)) then return nil end
  result[key]=value
 end
 return result
end
function U.validate(id,action,payload)
 if not U.parseId(id) then return false,'Invalid request id.' end
 if type(action)~='string' or not actions[action] then return false,'Unknown action.' end
 local valid=false
 if action=='PutDown' then valid=payload==nil
 elseif action=='TravelAbandon' then valid=fields(payload,{destination=true,runId=true}) and text(payload.destination) and text(payload.runId)
 elseif action=='Strike' or action=='Pickup' then valid=text(payload)
 elseif action=='Tycoon' then
  local function slot(v,zero) return finite(v) and v%1==0 and v>=(if zero then 0 else 1) and v<=8 end
  if type(payload)=='table' then
   if payload.op=='bank' then valid=fields(payload,{op=true})
   elseif payload.op=='collect' then valid=fields(payload,{op=true,slot=true}) and slot(payload.slot,true)
   elseif payload.op=='assign' then valid=fields(payload,{op=true,slot=true,id=true}) and slot(payload.slot,false) and (payload.id==nil or text(payload.id))
   elseif payload.op=='swap' then valid=fields(payload,{op=true,slot=true,other=true}) and slot(payload.slot,false) and slot(payload.other,false) and payload.slot~=payload.other
   elseif payload.op=='attune' then valid=fields(payload,{op=true,slot=true,kingdom=true}) and slot(payload.slot,false) and finite(payload.kingdom) and payload.kingdom%1==0 and payload.kingdom>=1 and payload.kingdom<=6
   elseif payload.op=='cosmetic' then valid=fields(payload,{op=true,id=true}) and text(payload.id)
   elseif payload.op=='upgrade' then valid=fields(payload,{op=true,path=true,slot=true}) and table.find({'habitats','habitat','production','storage','bag','banking','automation'},payload.path)~=nil and (if payload.path=='habitat' then slot(payload.slot,false) else payload.slot==nil) end
  end
 elseif action=='State' or action=='Dodge' or action=='CollectIncome' or action=='RegisterDefense' then valid=payload==nil
 elseif action=='Train' or action=='Incubate' or action=='Hatch' or action=='Travel' then valid=text(payload)
 elseif action=='ChallengeDefense' then valid=finite(payload) and payload%1==0 and payload>=0 and payload<=9007199254740991
 elseif action=='Settings' then valid=payload~=nil and U.settings(payload)~=nil
 elseif action=='Specialize' then valid=fields(payload,{id=true,choice=true}) and text(payload.id) and table.find({'Power','Guard','Vitality'},payload.choice)~=nil
 elseif action=='Special' then valid=fields(payload,{slot=true,ability=true}) and finite(payload.slot) and payload.slot%1==0 and payload.slot>=1 and payload.slot<=3 and (payload.ability==nil or (finite(payload.ability) and payload.ability%1==0 and payload.ability>=1 and payload.ability<=4))
 elseif action=='Equip' and type(payload)=='table' and #payload>=1 and #payload<=3 then
  valid=true;local seen={}
  for key,value in pairs(payload) do
   if not finite(key) or key%1~=0 or key<1 or key>#payload or not text(value) or seen[value] then valid=false;break end
   seen[value]=true
  end
 end
 return valid,if valid then nil else 'Invalid action payload.'
end
return U
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="17">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="18">
      <Properties>
        <string name="Name">MountainServer</string>
      </Properties>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">CarryVisuals</string>
          <string name="Source"><![CDATA[-- Cosmetic server models replicate to every player; they never grant ownership.
local C=require(game.ReplicatedStorage.MountainShared.Catalog)
local A=require(game.ServerStorage.MountainWorld.Art)
local V={}
function V.new(world,send)
 local folder=Instance.new('Folder');folder.Name='RaidPresentation';folder.Parent=world
 local carries,tools,shells={},{},{}
 local function clear(player)
  if carries[player] then carries[player]:Destroy();carries[player]=nil end
  if tools[player] then tools[player]:Destroy();tools[player]=nil end
  if player.Character then player.Character:SetAttribute('CarryingCreature',false) end
 end
 local function creature(player,species,position)
  if carries[player] then carries[player]:Destroy() end
  local entry=table.clone(C.byId[species])
  -- Portable adults omit boss-only orbit/crest proportions. Existing boss art is untouched.
  if entry.rarity=='Legendary' then entry.rarity='Mythic';entry.variant=1 end
  local model=A.creature(folder,entry,position,.55,1)
  model.Name='Carried_'..player.UserId;model:SetAttribute('CarryOwner',player.UserId)
  model.ModelStreamingMode=Enum.ModelStreamingMode.Persistent
  for _,part in ipairs(model:GetDescendants()) do
   if part:IsA('BasePart') then
    part.CanCollide=false;part.CanTouch=false;part.CanQuery=false
    if part.Name=='Wing' then
     local localCF=model.PrimaryPart.CFrame:ToObjectSpace(part.CFrame)
     part.CFrame=model.PrimaryPart.CFrame*CFrame.new(localCF.Position.X*.5,localCF.Position.Y,localCF.Position.Z)*localCF.Rotation*CFrame.Angles(0,0,if localCF.Position.X>0 then .8 else -.8)
     part:SetAttribute('RestLocal',model.PrimaryPart.CFrame:ToObjectSpace(part.CFrame))
    end
   end
  end
  carries[player]=model;return model
 end
 local service={}
 function service.shell(egg)
  local shell=A.part(folder,'Egg_'..egg.id,Vector3.new(3,3.9,3),CFrame.new(egg.position+Vector3.new(0,2.4,0)),Color3.fromRGB(247,229,191),Enum.Material.SmoothPlastic,Enum.PartType.Ball,false)
  shell:SetAttribute('RaidEgg',egg.id);shells[egg.id]=shell
 end
 function service.show(player,data)
  local character=player.Character;local rr=character and character:FindFirstChild('HumanoidRootPart')
  if data.kind=='lost' then
   clear(player)
   local shell=shells[data.eggId]
   if shell then shell.Transparency=0;shell:SetAttribute('Hits',0);for _,v in ipairs(shell:GetChildren()) do if v:IsA('BasePart') then v:Destroy() end end end
   send(player,'toast','Unsecured '..C.byId[data.species].name..' lost. Try another egg.');return
  end
  if data.kind=='strike' then
   if character then character:SetAttribute('PickaxeStrikeAt',workspace:GetServerTimeNow()) end
   if not tools[player] then
    local m=Instance.new('Model');m.Name='Pickaxe_'..player.UserId
    m.PrimaryPart=A.part(m,'Handle',Vector3.new(.25,2.6,.25),CFrame.new(),Color3.fromRGB(118,78,48),Enum.Material.Wood,nil,false)
    A.part(m,'SteelHead',Vector3.new(2.3,.35,.48),CFrame.new(0,1,0),Color3.fromRGB(187,215,219),Enum.Material.Metal,nil,false)
    m.Parent=folder;tools[player]=m
   end
   local shell=shells[data.egg.id]
   if shell then
    shell:SetAttribute('Hits',data.run.hits);shell:SetAttribute('RequiredHits',data.hitsRequired)
    local crack=A.part(shell,'Crack',Vector3.new(.08,1.7,.08),shell.CFrame*CFrame.new((data.run.hits-2)*.3,.1,-1.47)*CFrame.Angles(0,0,.35*(data.run.hits%2*2-1)),Color3.fromRGB(107,83,65),Enum.Material.Slate,nil,false)
    if data.run.phase=='revealed' then
     shell.Transparency=.8
     task.delay(18,function() if shell.Parent then shell.Transparency=0;shell:SetAttribute('Hits',0);for _,v in ipairs(shell:GetChildren()) do if v:IsA('BasePart') then v:Destroy() end end end end)
    end
   end
   if data.run.phase=='revealed' then
    creature(player,data.run.species,data.egg.position+Vector3.new(0,1,0))
    send(player,'toast',C.byId[data.run.species].name..' revealed — pick it up and escape!')
   end
  elseif data.kind=='reveal' then creature(player,data.run.species,data.egg.position)
  elseif data.kind=='carry' then
   if character then character:SetAttribute('CarryingCreature',true) end
   if carries[player] then carries[player]:SetAttribute('InArms',true) end
   if tools[player] then tools[player]:Destroy();tools[player]=nil end
  elseif data.kind=='securing' then send(player,'toast','Securing your creature… You are protected while saving.')
  elseif data.kind=='safe' then
   if carries[player] then carries[player]:SetAttribute('Secured',true) end
   send(player,'toast','Safe! '..C.byId[data.species].name..' is yours. Carry it home.')
  end
 end
 function service.tick()
  for player,model in pairs(carries) do
   local rr=player.Character and player.Character:FindFirstChild('HumanoidRootPart')
   if rr and model:GetAttribute('InArms') then model:PivotTo(rr.CFrame*CFrame.new(0,.15,-1.55)*CFrame.Angles(0,math.pi/2,0)) end
  end
  for player,model in pairs(tools) do
   local c=player.Character;local hand=c and (c:FindFirstChild('RightHand') or c:FindFirstChild('Right Arm'))
   if hand then
    local elapsed=workspace:GetServerTimeNow()-(c:GetAttribute('PickaxeStrikeAt') or 0)
    model:PivotTo(hand.CFrame*CFrame.new(0,-.4,-.6)*CFrame.Angles(-.4-math.sin(math.clamp(elapsed/.35,0,1)*math.pi)*1.2,0,0))
   end
  end
 end
 service.clear=clear
 return service
end
return V
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Combat</string>
          <string name="Source"><![CDATA[local C=require(game.ReplicatedStorage.MountainShared.Catalog)
local RaidConfig=require(game.ReplicatedStorage.MountainShared.RaidConfig)
local R=require(game.ReplicatedStorage.MountainShared.Rules)
local A=require(game.ServerStorage.MountainWorld.Art)
local B={battles={},wild={},dodgeUntil={},specialAt={},buffs={},nextId=0}
local profiles,send,changed
local raidContext
local function root(player) local c=player.Character;return c and c:FindFirstChild('HumanoidRootPart') end
local function alive(player) local h=player.Character and player.Character:FindFirstChildOfClass('Humanoid');return h and h.Health>0 and h end
local function inArena(player,b)
 local center=if not b.trial and raidContext then raidContext.guardians.position(b.k) or b.center else b.center
 local r=root(player);return r and (r.Position-center).Magnitude<58 and alive(player)
end
local function power(p,targetElement)
 local damage=0
 for _,id in ipairs(p.team) do local c=R.find(p.creatures,id);if c then local st=R.stats(c);damage+=if targetElement then R.damage(st.element,targetElement,st.attack) else st.attack end end
 return damage
end
local function harm(player,amount)
 local p=profiles.get(player);local h=alive(player);if not p or not h then return end
 local guard=0
 for _,id in ipairs(p.team) do local c=R.find(p.creatures,id);if c then local st=R.stats(c);guard+=st.guard+(if st.role=='Tank' then .05 else 0) end end
 local buff=B.buffs[player]
 if buff and os.clock()<buff.untilTime and buff.shield then guard+=.25 end
 h:TakeDamage(amount*(1-math.min(.65,guard)))
end
local guardianEffects={
 {'burst','control','heal','empower'}, {'burst','break','haste','burst'},
 {'burst','break','shield','empower'}, {'burst','control','haste','break'},
 {'burn','burst','heal','empower'}, {'break','control','empower','burst'},
}
local function warnPart(b,name,pos,size,color)
 local p=A.part(workspace.ImpossibleMountain.Dynamics,name,size,CFrame.new(pos),color,Enum.Material.Neon,nil,false);p.Transparency=.55;table.insert(b.effects,p);return p
end
function B.init(p,s,c) profiles=p;send=s;changed=c end
function B.connectRaids(context) raidContext=context end
function B.start(player,k,trial,center)
 local p=profiles.get(player);if not p or not R.canEnter(p,k) or (trial and not p.wins[tostring(k)]) then return false,'Defeat the normal Guardian first.' end
 if p.run then return false,'Finish your creature run before fighting.' end
 if trial and p.captures[C.guardians[k].id] then return false,'You already secured this Guardian.' end
 if not trial and raidContext and raidContext.guardians.resting(k) then return false,'The Guardian is resting. Use the raid opening.' end
 if B.wild[player] then return false,'Finish your wild encounter first.' end
 for _,other in pairs(B.battles) do if other.members[player] then return false,'Already in another battle.' end end
 local key=if trial then 'trial:'..k else k
 local config=RaidConfig.section(k)
 local b=B.battles[key]
 if b then
  if b.trial~=trial then return false,'A different encounter is already active.' end
  if b.members[player] then return false,'You are already in this encounter.' end
  if b.hp<b.max*.75 then return false,'Battle underway; join the next encounter.' end
  b.max+=config.joinHealth;b.hp+=config.joinHealth
 else
  local health=config.normalHealth*(if trial then config.trialHealthMultiplier else 1)
  b={key=key,k=k,trial=trial,center=center,hp=health,max=health,members={},nextAttack=os.clock()+4,beat=0,resolved=0,effects={},started=os.clock(),regen=false}
  B.battles[key]=b
  if trial and raidContext and raidContext.manifest then b.manifest=raidContext.manifest(k,center) end
 end
 if not trial and raidContext then raidContext.guardians.alert(k,player.UserId,nil,os.clock()) end
 b.members[player]={damage=0,dodges=0,hits=0,joined=os.clock(),approachUntil=os.clock()+RaidConfig.combatApproachSeconds};send(player,'toast',if trial then 'Legendary Trial • master the patterns, then carry the reward to sanctuary.' else 'Guardian battle • approach the moving Guardian to engage.');return true
end
function B.startWild(player,species,part)
 local p=profiles.get(player);local s=C.byId[species]
 if not p or not s or s.rarity=='Legendary' or #p.cargo>=3 then return false,'Make room for an egg first.' end
 if B.wild[player] then return false,'Already in a wild encounter.' end
 for _,b in pairs(B.battles) do if b.members[player] then return false,'Finish the Guardian encounter first.' end end
 if (p.claims['wild:'..species] or 0)>os.time() then return false,'This creature is resting.' end
 B.wild[player]={species=species,part=part,hp=s.health*2,nextAttack=os.clock()+3};return true,'Wild encounter started • stay near the creature.'
end
function B.dodge(player)
 local now=os.clock();if now<(B.dodgeUntil[player] or 0)+3 then return false end
 B.dodgeUntil[player]=now+.65;return true
end
function B.special(player,slot,ability)
 if type(slot)~='number' or slot%1~=0 or slot<1 or slot>3 then return false end
 local p=profiles.get(player);local c=p and R.find(p.creatures,p.team[slot]);if not c then return false end
 local s=C.byId[c.species];ability=if s.rarity=='Legendary' and type(ability)=='number' and ability%1==0 and ability>=1 and ability<=4 then ability else 1
 local key=tostring(player.UserId)..':'..c.id..':'..ability;local now=os.clock()
 if now<(B.specialAt[key] or 0) then return false end
 local battle
 for _,b in pairs(B.battles) do if b.members[player] and inArena(player,b) then battle=b;break end end
 local wild=B.wild[player]
 if not battle and not wild then return false end
 B.specialAt[key]=now+12+(ability-1)*3
 local damage=R.stats(c).attack*(if ability==4 then 6 else 3)
 local effect=if s.rarity=='Legendary' then guardianEffects[s.kingdom][ability] else ({Support='heal',Tank='shield',Control='control',Speed='haste',Magic='burn',Damage='burst'})[s.role]
 if effect=='heal' then
  local h=alive(player);if h then h.Health=math.min(h.MaxHealth,h.Health+40) end
  if battle then for ally in pairs(battle.members) do local ah=alive(ally);if ah and inArena(ally,battle) then ah.Health=math.min(ah.MaxHealth,ah.Health+24) end end end
 elseif effect=='shield' or effect=='haste' or effect=='empower' then
  local targets=if effect=='empower' and battle then battle.members else {[player]=true}
  for ally in pairs(targets) do B.buffs[ally]={untilTime=now+8,shield=effect=='shield',power=if effect=='haste' then 1.35 elseif effect=='empower' then 1.5 else 1} end
 end
 if battle then
  if effect=='control' then battle.weakenUntil=now+8 elseif effect=='break' then battle.breakUntil=now+8 elseif effect=='burn' then battle.burnUntil=now+6;battle.burnPower=damage*.2 end
  if battle.regen then
   local r=root(player)
   if r and battle.core and (r.Position-battle.core.Position).Magnitude<16 then battle.regen=false;for _,m in pairs(battle.members) do m.objective=true end;send(player,'toast','Regeneration interrupted!');damage*=2 end
  end
  damage=R.damage(s.element,C.kingdoms[battle.k].element,damage);battle.hp-=damage;battle.members[player].damage+=damage
 elseif wild and root(player) and (root(player).Position-wild.part.Position).Magnitude<30 then wild.hp-=damage end
 return true
end
local function pattern(b)
 b.beat+=1;local phase=(b.beat-1)%4+1;local center=b.center;local tell=if b.trial then 1.6 else 2.2
 local guardian=if b.trial then b.manifest else workspace.ImpossibleMountain.Encounters:FindFirstChild('Guardian_'..b.k)
 if guardian then guardian:SetAttribute('TellUntil',workspace:GetServerTimeNow()+tell) end
 local effects={};local attackPos=center
 if b.k==5 and phase==3 then
  b.regen=true
  for i=1,3 do
   local p=warnPart(b,if i==2 then 'TrueEmberHeart' else 'EmberDecoy',center+Vector3.new((i-2)*20,4,-8),Vector3.new(4,6,4),if i==2 then Color3.fromRGB(255,220,110) else Color3.fromRGB(209,70,51))
   if i==2 then b.core=p end;table.insert(effects,p)
  end
  for player in pairs(b.members) do send(player,'toast','Find the golden heart. Use a special nearby to interrupt healing!') end
  tell=5
 elseif b.k==6 and phase==3 then
  b.aligned={};b.runeCount=0
  for i=1,3 do
   local p=warnPart(b,'StarAlignment',center+Vector3.new((i-2)*20,3,12),Vector3.new(5,5,5),Color3.fromRGB(150,195,255));table.insert(effects,p)
   local q=Instance.new('ProximityPrompt');q.ActionText='Align constellation';q.HoldDuration=.25;q.MaxActivationDistance=10;q.RequiresLineOfSight=false;q.Parent=p
   q.Triggered:Connect(function(player)
    if not b.members[player] or not inArena(player,b) or not root(player) or (root(player).Position-p.Position).Magnitude>12 or b.aligned[i] then return end
    b.aligned[i]=true;b.runeCount+=1;p.Color=Color3.fromRGB(133,255,175)
    if b.runeCount==3 then for _,m in pairs(b.members) do m.objective=true end end
   end)
  end
  tell=6
  for player in pairs(b.members) do send(player,'toast','Align all three constellation stones before the gravity wave!') end
 elseif phase==1 then
  for player in pairs(b.members) do local r=root(player);if r then attackPos=Vector3.new(r.Position.X,center.Y+.4,r.Position.Z);break end end
  table.insert(effects,warnPart(b,'DodgeCircle',attackPos,Vector3.new(22,.25,22),Color3.fromRGB(255,100,100)))
 elseif phase==2 then
  table.insert(effects,warnPart(b,'CrossBeam',center+Vector3.new(0,.3,0),Vector3.new(13,.3,80),Color3.fromRGB(255,176,91)))
  if b.k==4 or b.k==6 then table.insert(effects,warnPart(b,'PrismCross',center+Vector3.new(0,.3,0),Vector3.new(80,.3,13),Color3.fromRGB(255,176,91))) end
 else
  for i=1,16 do local a=i*math.pi/8;table.insert(effects,warnPart(b,'ExpandingWave',center+Vector3.new(math.cos(a)*25,.3,math.sin(a)*25),Vector3.new(8,.25,8),Color3.fromRGB(235,112,162))) end
 end
 task.delay(tell,function()
  if B.battles[b.key]~=b then for _,e in ipairs(effects) do e:Destroy() end;return end
  for player,m in pairs(b.members) do
   if inArena(player,b) then
    local p=root(player).Position;local d=p-center;local hit
    if b.k==5 and phase==3 then hit=b.regen
    elseif b.k==6 and phase==3 then hit=b.runeCount<3
    elseif phase==1 then hit=(p-attackPos).Magnitude<15
    elseif phase==2 then hit=math.abs(d.X)<7 or ((b.k==4 or b.k==6) and math.abs(d.Z)<7)
    else hit=d.Magnitude>17 and d.Magnitude<34 end
    if hit and os.clock()>(B.dodgeUntil[player] or 0) then
     harm(player,(if b.trial then 30 else 19)*(if os.clock()<(b.weakenUntil or 0) then .7 else 1));m.hits+=1
    else m.dodges+=1 end
   end
  end
  b.resolved+=1
  if b.regen then b.hp=math.min(b.max,b.hp+b.max*.08) end
  b.regen=false;b.core=nil
  for _,e in ipairs(effects) do e:Destroy() end
 end)
end
function B.finish(b)
 if B.battles[b.key]~=b then return false end
 local k=b.k;local contributors={}
 for player,m in pairs(b.members) do if m.damage>=b.max*RaidConfig.section(k).contributionFraction and profiles.get(player) then table.insert(contributors,player.UserId) end end
 local eligible={}
 if not b.trial and raidContext then
  local effects=raidContext.guardians.normalWin(k,contributors)
  for _,id in ipairs(effects.xp) do eligible[id]=true end
 else for _,id in ipairs(contributors) do eligible[id]=true end end
 for player,m in pairs(b.members) do
  local p=profiles.get(player)
  if p and eligible[player.UserId] then
   if not b.trial or R.mastered(k,m) then
    local awarded
    if b.trial then
     awarded=raidContext and raidContext.raids.reward(player,k,C.guardians[k].id,b.center)
     send(player,'toast',if awarded then 'Trial won! Pick up your Guardian reward and escape to sanctuary.' else 'Guardian reward unavailable. Finish your current attempt first.')
    else
     R.winGuardian(p,k,false);awarded=true
     send(player,'toast',C.guardians[k].name..' is resting. The section has a brief raid opening!')
    end
    if awarded then for _,id in ipairs(p.team) do local c=R.find(p.creatures,id);if c then R.addXP(c,RaidConfig.section(k).companionXP) end end end
   else send(player,'toast','Victory, but mastery requires 3 clean dodges. Retry the Trial.') end
   changed(player);task.spawn(profiles.save,player,false)
  end
  send(player,'battle',false)
 end
 B.battles[b.key]=nil;if b.manifest then b.manifest:Destroy() end
 for _,effect in ipairs(b.effects) do effect:Destroy() end
 return true
end
function B.tick()
 local now=os.clock()
 for player,w in pairs(B.wild) do
  local p=profiles.get(player);local rr=root(player)
  if not p or not rr or not alive(player) or not w.part.Parent or (rr.Position-w.part.Position).Magnitude>35 then B.wild[player]=nil;send(player,'battle',false);send(player,'toast','Wild encounter ended.')
  else
   w.hp-=power(p,C.byId[w.species].element)
   send(player,'battle',{name=C.byId[w.species].name,hp=math.max(0,w.hp),max=C.byId[w.species].health*2,trial=false,kingdom=C.byId[w.species].kingdom,resolved=0,objective=false,members={{userId=player.UserId,name=player.DisplayName}},captureOwned=false})
   if now>=w.nextAttack then w.nextAttack=now+4;if now>(B.dodgeUntil[player] or 0) then harm(player,8) end end
   if w.hp<=0 then
    local collected=R.collect(p,w.species,'wild:'..w.species,os.time());for _,id in ipairs(p.team) do local c=R.find(p.creatures,id);if c then R.addXP(c,50) end end
    B.wild[player]=nil;changed(player);send(player,'toast',if collected then 'Encounter won • egg collected. Extract at a checkpoint.' else 'Encounter won • cargo full. Extract eggs before trying again.');send(player,'battle',false)
   end
  end
 end
 for key,b in pairs(B.battles) do
  local k=b.k
  if not b.trial and raidContext then b.center=raidContext.guardians.position(k) or b.center end
  local active=0;local approaching=0
  for player,m in pairs(b.members) do
   local p=profiles.get(player)
   if p and alive(player) and root(player) and not inArena(player,b) and not b.trial and not m.engaged and now<m.approachUntil then
    -- An altar challenger may need to approach a defender pursuing another raider.
    -- Keep the invitation briefly, but apply no damage or patterns out of range.
    approaching+=1
   elseif not p or not inArena(player,b) then b.members[player]=nil;send(player,'battle',false)
   else
    m.engaged=true;active+=1;local buff=B.buffs[player];local damage=power(p,C.kingdoms[k].element)*(if buff and now<buff.untilTime then buff.power else 1)*(if now<(b.breakUntil or 0) then 1.25 else 1)
    if now<(b.burnUntil or 0) then damage+=(b.burnPower or 0)/math.max(1,active) end
    b.hp-=damage;m.damage+=damage
    local members={};for ally in pairs(b.members) do table.insert(members,{userId=ally.UserId,name=ally.DisplayName}) end
    table.sort(members,function(a,c) return a.userId<c.userId end)
    send(player,'battle',{name=C.guardians[k].name,hp=math.max(0,b.hp),max=b.max,trial=b.trial,dodges=m.dodges,phase=b.beat,kingdom=k,resolved=b.resolved,objective=m.objective==true,objectiveText=if k==5 then 'Interrupt the golden heart' elseif k==6 then 'Align all three constellation stones' elseif b.trial then 'Dodge three patterns and win' else 'Defeat the Guardian',members=members,captureOwned=p.captures[C.guardians[k].id]==true})
   end
  end
  if (active==0 and approaching==0) or now-b.started>300 then
   for player in pairs(b.members) do send(player,'battle',false);send(player,'toast','Encounter ended • challenge again at the altar.') end
   B.battles[key]=nil;if b.manifest then b.manifest:Destroy() end;for _,e in ipairs(b.effects) do e:Destroy() end
  elseif active==0 then
   -- Waiting for an entrant to reach the moving defender.
  elseif b.hp<=0 and b.trial and not R.trialReady(k,b.resolved,b.members) then
   b.hp=1
   if now>=b.nextAttack then b.nextAttack=now+5;pattern(b) end
  elseif b.hp<=0 then
   B.finish(b)
  elseif now>=b.nextAttack then b.nextAttack=now+5;pattern(b) end
 end
end
function B.cooldowns(player,serverClock)
 local now=os.clock();local result={};local prefix=tostring(player.UserId)..':'
 for key,deadline in pairs(B.specialAt) do
  if key:sub(1,#prefix)==prefix and deadline>now then result[key:sub(#prefix+1)]=serverClock+(deadline-now) end
 end
 local dodge=B.dodgeUntil[player]
 return result,if dodge then serverClock+math.max(0,dodge+3-now) else 0
end
function B.remove(player,leaving)
 B.wild[player]=nil;B.dodgeUntil[player]=nil;B.buffs[player]=nil
 if leaving then
  local prefix=tostring(player.UserId)..':'
  for key in pairs(B.specialAt) do if key:sub(1,#prefix)==prefix then B.specialAt[key]=nil end end
 end
 for _,b in pairs(B.battles) do b.members[player]=nil end
 send(player,'battle',false)
end
return B
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Competition</string>
          <string name="Source"><![CDATA[-- Async defense snapshots: no online defender or alteration of their inventory is required.
local C=require(game.ReplicatedStorage.MountainShared.Catalog)
local R=require(game.ReplicatedStorage.MountainShared.Rules)
local Store=require(script.Parent.Store)
local S={}
local db=if game:GetService('RunService'):IsStudio() then Store.memory() else Store.datastore('MountainEmpire_Defenses_v1')
function S.snapshot(p,userId)
 local team={}
 for _,id in ipairs(p.team) do local c=R.find(p.creatures,id);if c then table.insert(team,{species=c.species,level=c.level,xp=0,specialization=c.specialization}) end end
 return {userId=userId,team=team,timestamp=os.time(),version=1}
end
function S.register(p,userId)
 local snap=S.snapshot(p,userId)
 local ok=db:update('u'..userId,function() return snap end);return ok
end
local function score(team)
 local hp,atk=0,0
 for _,c in ipairs(team) do local stats=R.stats(c);hp+=stats.health;atk+=stats.attack end
 return hp,atk
end
function S.challenge(p,userId,target)
 local now=os.time()
 if now<p.competitionAt then return false,'Defense challenge available in '..(p.competitionAt-now)..'s.' end
 if type(target)~='number' or target%1~=0 or target<0 or target>9007199254740991 or target==userId then return false,'Enter another player’s numeric UserId, or 0 for practice.' end
 local defense
 if target==0 then
  defense={team={{species='mossbun',level=3},{species='petalyn',level=3},{species='fernox',level=3}},userId=0}
 else
  local ok,snap=db:read('u'..target)
  if not ok or not snap or snap.version~=1 or type(snap.team)~='table' or #snap.team<1 or #snap.team>3 then return false,'No saved defense available for that player.' end
  for _,c in ipairs(snap.team) do if not C.byId[c.species] or type(c.level)~='number' or c.level<1 or c.level>50 then return false,'Defense snapshot is invalid.' end end
  defense=snap
 end
 local attack=S.snapshot(p,userId)
 local ah,aa=score(attack.team);local dh,da=score(defense.team)
 local rounds=0
 while ah>0 and dh>0 and rounds<100 do ah-=da;dh-=aa;rounds+=1 end
 local won=dh<=0 and ah>0
 p.competitionAt=now+120
 if won then p.trophies+=10;p.coins+=35 end
 return true,{won=won,rounds=rounds,trophies=if won then 10 else 0,opponent=target,practice=target==0}
end
return S
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">EggRaids</string>
          <string name="Source"><![CDATA[local Run=if script then require(game.ReplicatedStorage.MountainShared.RunRules) else require('../shared/RunRules')
local Config=if script then require(game.ReplicatedStorage.MountainShared.RaidConfig) else require('../shared/RaidConfig')
local E={}
function E.new(context)
 local P=context.profiles
 local reservations,owners,cooldowns,exits,cancellations={},{},{},{},{}
 local service={}
 local function changed(player) if context.changed then context.changed(player) end end
 local function present(player,data) if context.present then context.present(player,data) end end
 local function release(player,rest)
  local reservation=owners[player]
  if reservation then
   if reservations[reservation.egg.id]==reservation then reservations[reservation.egg.id]=nil end
   if rest then cooldowns[reservation.egg.id]=context.clock()+Config.eggRestSeconds end
  end
  owners[player]=nil
 end
 function service.strike(player,eggId)
  local p=P.get(player);local egg=type(eggId)=='string' and context.eggs[eggId]
  if not p or not egg or not context.alive(player) or exits[player] then return false,'unavailable' end
  if context.inBattle and context.inBattle(player) then return false,'finish_battle' end
  if not context.near(player,egg,Config.strikeRange) then return false,'too_far' end
  local now=context.clock();local config=Config.section(egg.section)
  if not config or now<(cooldowns[eggId] or 0) then return false,'egg_resting' end
  local current=reservations[eggId]
  if current and current.player~=player then return false,'reserved' end
  if p.run and (not current or p.run.id~=current.runId or p.run.phase~='breaking') then return false,'full_hands' end
  if current and now-current.lastStrike<Config.strikeCadence then return false,'cadence' end
  local first=current==nil
  if not current then
   current={player=player,runId=context.guid(),egg=egg,lastStrike=-math.huge,expiresAt=now+Config.reservationSeconds,species=egg.species or context.roll(egg.section)}
  end
  local ok,reason=Run.strike(p,{id=egg.id,runId=current.runId,species=current.species,section=egg.section,hitsRequired=config.hits},now)
  if not ok then return false,reason end
  current.lastStrike=now;current.expiresAt=now+Config.reservationSeconds
  reservations[eggId]=current;owners[player]=current
  if first and context.alert then context.alert(egg.section,player.UserId,eggId,now) end
  present(player,{kind='strike',run=table.clone(p.run),egg=egg,hitsRequired=config.hits})
  changed(player);return true,p.run.phase
 end
 function service.pickup(player,runId)
  local p=P.get(player);local current=owners[player]
  if not p or not current or current.runId~=runId or not context.alive(player) or exits[player] then return false,'no_reveal' end
  if not context.near(player,current.egg,Config.pickupRange) then return false,'too_far' end
  local ok,reason=Run.pickup(p,runId)
  if ok then current.expiresAt=nil;present(player,{kind='carry',run=table.clone(p.run)});changed(player) end
  return ok,reason
 end
 function service.forfeit(player,reason)
  if exits[player] or (P.pending and P.pending(player)) then return false,'save_pending' end
  local p=P.get(player);local lost=p and p.run and table.clone(p.run)
  if not p then cancellations[player]=reason;return false,'profile_unavailable' end
  cancellations[player]=nil;Run.forfeit(p,reason)
  release(player,true)
  if lost then present(player,{kind='lost',reason=reason,species=lost.species,eggId=lost.eggId});changed(player) end
  return lost~=nil
 end
 function service.exit(player,runId)
  local pending=exits[player]
  if pending and pending.runId~=runId then return false,'save_pending' end
  if pending and pending.busy then return false,'saving' end
  if not pending then
   local p=P.get(player)
   if not p or not p.run or p.run.id~=runId or p.run.phase~='carried' or not context.alive(player) or not context.atExit(player) then return false,'not_at_exit' end
   pending={runId=runId,species=p.run.species};exits[player]=pending
   present(player,{kind='securing',run=table.clone(p.run)})
  end
  pending.busy=true
  local ok,reason=P.transact(player,runId,function(draft) return Run.secure(draft,runId) end)
  pending.busy=false;pending.retryAt=context.clock()+Config.saveRetrySeconds
  if ok then
   release(player,true);exits[player]=nil
   present(player,{kind='safe',species=pending.species,runId=runId});changed(player)
  end
  return ok,reason
 end
 -- Only a completed server-authoritative Trial calls this; clients cannot name species.
 function service.reward(player,section,species,position)
  local p=P.get(player)
  if not p or p.run or exits[player] or not context.alive(player) then return false,'full_hands' end
  local runId=context.guid();local egg={id='trial:'..runId,section=section,species=species,position=position}
  local ok,reason=Run.strike(p,{id=egg.id,runId=runId,species=species,section=section,trial=true,hitsRequired=1},context.clock())
  if not ok then return false,reason end
  local record={player=player,runId=runId,egg=egg,species=species,expiresAt=context.clock()+Config.reservationSeconds}
  owners[player]=record;reservations[egg.id]=record
  present(player,{kind='reveal',run=table.clone(p.run),egg=egg});changed(player)
  return true,runId
 end
 function service.remove(player)
  if not exits[player] then service.forfeit(player,'leave') end
  -- Profiles owns pending durable work after disconnect; do not retain this Player.
  exits[player]=nil
  cancellations[player]=nil
  release(player,true)
 end
 function service.tick(now)
  for player,reason in pairs(cancellations) do service.forfeit(player,reason) end
  for player,record in pairs(owners) do
   if record.expiresAt and now>=record.expiresAt then service.forfeit(player,'abandoned') end
  end
  for player,pending in pairs(exits) do
   if not pending.busy and now>=(pending.retryAt or 0) then
    if context.spawn then context.spawn(service.exit,player,pending.runId) else service.exit(player,pending.runId) end
   end
  end
 end
 function service.protected(player) return exits[player]~=nil end
 return service
end
return E
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">Guardians</string>
          <string name="Source"><![CDATA[local Rules=require(game.ReplicatedStorage.MountainShared.GuardianRules)
local Config=require(game.ReplicatedStorage.MountainShared.RaidConfig)
local G={}
function G.new(context)
 local states,models,homes,lastTick={},{},{},context.clock()
 local service={}
 for k=1,6 do
  states[k]=Rules.new(k,lastTick)
  local model=context.world.Encounters:FindFirstChild('Guardian_'..k)
  models[k]=model;homes[k]=model and model:GetPivot()
 end
 function service.alert(k,userId,eggId,now)
  if not states[k] then return end
  Rules.alert(states[k],userId,eggId,now or context.clock())
  if context.warning then context.warning(userId,k) end
 end
 function service.position(k) return models[k] and models[k]:GetPivot().Position-Vector3.new(0,context.rootHeight(k),0) end
 function service.resting(k) return context.clock()<states[k].restUntil end
 function service.normalWin(k,contributors)
  local _,effects=Rules.normalWin(states[k],contributors,context.clock())
  return effects
 end
 function service.remove(player)
  for _,state in pairs(states) do state.threats[player.UserId]=nil end
 end
 function service.tick(now)
  local dt=math.min(.25,now-lastTick);lastTick=now
  local players=context.players()
  for k,state in ipairs(states) do
   local model=models[k];if not model or not model.PrimaryPart then continue end
   local current=model:GetPivot();local observations={};local targets={}
   for _,player in ipairs(players) do
    local r=context.root(player);local p=context.profile(player)
    if r and p and context.alive(player) and not context.protected(player) then
     -- Measure from the defender's feet, including height: a ledge above is not a catch.
     local delta=r.Position-(current.Position-Vector3.new(0,context.rootHeight(k),0))
     observations[player.UserId]={alive=true,inside=context.inside(k,r.Position),distance=delta.Magnitude,breaking=p.run and p.run.section==k and p.run.phase=='breaking'}
     targets[player.UserId]={player=player,root=r}
    end
   end
   local _,effects=Rules.step(state,observations,now)
   local target=state.target and targets[state.target]
   local destination=if target then target.root.Position else homes[k].Position
   local delta=Vector3.new(destination.X-current.X,0,destination.Z-current.Z)
   local speed=Config.section(k).guardianSpeed*(if state.phase=='approaching' then .55 elseif state.phase=='resting' then .5 else 1)
   if delta.Magnitude>.5 then
    local nextPosition=current.Position+delta.Unit*math.min(delta.Magnitude,speed*dt)
    local ground=context.ground(nextPosition,k)
    if ground and context.inside(k,ground) then
     nextPosition=Vector3.new(nextPosition.X,ground.Y+context.rootHeight(k),nextPosition.Z)
     model:PivotTo(CFrame.lookAt(nextPosition,nextPosition+delta.Unit))
    end
   end
   model:SetAttribute('GuardianState',state.phase);model:SetAttribute('TargetUserId',state.target)
   model:SetAttribute('RestUntil',workspace:GetServerTimeNow()+math.max(0,state.restUntil-now))
   if state.phase=='approaching' then model:SetAttribute('TellUntil',workspace:GetServerTimeNow()+.5) end
   if effects.attack and targets[effects.attack] then context.catch(targets[effects.attack].player,k) end
  end
 end
 service.states=states
 return service
end
return G
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">Journey</string>
          <string name="Source"><![CDATA[-- Travel never banks new runs. Confirmation is scoped to the current run identity.
local J={}
function J.new(context)
 local busy={}
 local service={}
 function service.go(player,destination,abandonRunId)
  if busy[player] or type(destination)~='string' then return false end
  local p=context.profile(player)
  if not p or not context.ready(player) or not context.origin(player,destination) then return false end
  local target=context.resolve(player,destination)
  if not target then return false end
  if p.run then
   if abandonRunId~=p.run.id then return false,'abandon_confirmation_required',p.run.id end
   if not context.forfeit or not context.forfeit(player,'travel') then return false,'forfeit_unavailable' end
   p=context.profile(player)
   if not p or p.run or not context.ready(player) or not context.origin(player,destination) then return false end
  elseif abandonRunId then return false,'confirmation_expired' end
  busy[player]=true
  local ok,moved=pcall(context.move,player,target)
  busy[player]=nil
  if not ok or moved~=true then return false end
  if p.schema==1 then context.extract(p) end -- pre-migration test/legacy compatibility only
  context.arrived(player,target)
  return true
 end
 return service
end
return J
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="25">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Players=game:GetService('Players')
Players.CharacterAutoLoads=false
local RS=game:GetService('ReplicatedStorage')
local C=require(RS.MountainShared.Catalog)
local R=require(RS.MountainShared.Rules)
local P=require(script.Parent.Profiles)
local B=require(script.Parent.Combat)
local Competition=require(script.Parent.Competition)
local UIRequests=require(script.Parent.UIRequests)
local UIProtocol=require(RS.MountainShared.UIProtocol)
local A=require(game.ServerStorage.MountainWorld.Art)
if not workspace:FindFirstChild('ImpossibleMountain') then require(game.ServerStorage.MountainWorld.FreeClimb).build() end
local world=workspace.ImpossibleMountain
require(game.ServerStorage.MountainWorld.MountainEntrances).apply(world,workspace:FindFirstChild('Sanctuary'))
local home=require(script.Parent.Sanctuary).new(workspace:FindFirstChild('Sanctuary'))
local tycoonWorld=require(script.Parent.TycoonWorld).new(home)
local areas={}
local Journey=require(script.Parent.Journey)
if not world:GetAttribute('FreeClimbVersion') then
 require(game.ServerStorage.MountainWorld.Polish).apply(world)
 require(game.ServerStorage.MountainWorld.TraversalArt).apply(world)
 require(script.Parent.Traversal).start(world)
end
local remotes=Instance.new('Folder');remotes.Name='MountainRemotes';remotes.Parent=RS
local request=Instance.new('RemoteEvent');request.Name='Request';request.Parent=remotes
local event=Instance.new('RemoteEvent');event.Name='Event';event.Parent=remotes
local uiRequest=Instance.new('RemoteEvent');uiRequest.Name='UIRequest';uiRequest.Parent=remotes
local uiResult=Instance.new('RemoteEvent');uiResult.Name='UIResult';uiResult.Parent=remotes
local sprintRequest=Instance.new('RemoteEvent');sprintRequest.Name='SprintRequest';sprintRequest.Parent=remotes
local movement=require(script.Parent.Movement).new(sprintRequest)
local uiService
local raids,guardians,carryVisuals,raidHazards
local raidEggs={}
local state={}
local contextSnapshots={}
local busy={};local limits={};local companions={};local motion={};local recovering={}
local respawns={}
local function send(player,kind,data) if player.Parent==Players then event:FireClient(player,kind,data) end end
local function root(player) return player.Character and player.Character:FindFirstChild('HumanoidRootPart') end
local function living(player) local h=player.Character and player.Character:FindFirstChildOfClass('Humanoid');return h and h.Health>0 end
local function nearby(player,p,range) local rr=root(player);return rr and living(player) and (rr.Position-p.Position).Magnitude<=range end
local function safe(player) local s=motion[player];return s and os.clock()>s.blockedUntil and living(player) end
local function teleport(player,pos)
 local rr=root(player);if not rr or not living(player) then return false end
 local cf=if typeof(pos)=='CFrame' then pos else CFrame.new(pos)
 player.Character:PivotTo(cf);rr.AssemblyLinearVelocity=Vector3.zero;rr.AssemblyAngularVelocity=Vector3.zero
 pos=cf.Position
 motion[player]={pos=pos,time=os.clock(),blockedUntil=os.clock()+.5,fallTop=pos.Y}
 return true
end
local function checkpoint(p)
 return world.Checkpoints:FindFirstChild(p.checkpoint) or world.Checkpoints:FindFirstChild('1:entrance')
end
local function rebuildTeam(player)
 if companions[player] then companions[player]:Destroy() end
 local p=P.get(player);if not p then return end
 local f=Instance.new('Folder');f.Name='Team_'..player.UserId;f.Parent=world.Encounters;companions[player]=f
 for i,id in ipairs(p.team) do
  local c=R.find(p.creatures,id);if c then
   local m=A.creature(nil,C.byId[c.species],Vector3.new(0,-100,0),if C.byId[c.species].rarity=='Legendary' then 1.2 else .65,R.stage(c.level))
   -- Three companions per player: keep their anchored cosmetic parts available at upper camps.
   m.ModelStreamingMode=Enum.ModelStreamingMode.Persistent;m:SetAttribute('Slot',i);m.Parent=f
  end
 end
 local h=player.Character and player.Character:FindFirstChildOfClass('Humanoid')
 if h then local total=0;for _,id in ipairs(p.team) do local c=R.find(p.creatures,id);if c then total+=R.stats(c).health end end;h.MaxHealth=140+total*.15;h.Health=math.min(h.Health,h.MaxHealth) end
end
local function atHome(player) local rr=root(player);return rr~=nil and home.ownsPosition(player,rr.Position) end
local function atRefuge(player) local rr=root(player);return rr~=nil and (home.ownsPosition(player,rr.Position) or (rr.Position-Vector3.new(0,17,560)).Magnitude<95) end
local function inBattle(player)
 if B.wild[player] then return true end
 for _,battle in pairs(B.battles) do if battle.members[player] then return true end end
 return false
end
local function nearCheckpoint(player)
 local p=P.get(player);if not p then return false end
 for _,cp in ipairs(world.Checkpoints:GetChildren()) do if p.discoveries[cp.Name] and R.canEnter(p,cp:GetAttribute('Kingdom')) and nearby(player,cp,20) then return true end end
 local summit=world.Interactions:FindFirstChild('Impossible Summit')
 return p~=nil and p.discoveries.summit==true and summit~=nil and nearby(player,summit,25) or false
end
local function nearestEgg(player)
 local rr=root(player);if not rr then return nil end
 local nearest,best=nil,12
 for id,egg in pairs(raidEggs) do local distance=(rr.Position-egg.position).Magnitude;if distance<best then nearest=id;best=distance end end
 return nearest
end
local function publish(player,visual)
 local p=P.get(player);if not p then return end
 local s=table.clone(p);s.serverNow=os.time();s.saveMode=P.mode
 local serverClock=workspace:GetServerTimeNow();local cooldowns,dodgeReadyAt=B.cooldowns(player,serverClock)
 tycoonWorld.update(player,p)
 s.ui={nearestEgg=nearestEgg(player),atHome=atHome(player),sanctuaryConnected=true,plot=home.plot(player),inSanctuary=root(player)~=nil and home.inSanctuary(root(player).Position),atRefuge=atRefuge(player),nearCheckpoint=nearCheckpoint(player),serverClock=serverClock,cooldowns=cooldowns,dodgeReadyAt=dodgeReadyAt,settings=UIProtocol.settings(nil,p.settings)}
 send(player,'state',s)
 if visual then rebuildTeam(player) end
end
B.init(P,send,function(player) publish(player,true) end)
local function restoreRecovery(player)
 local p=P.get(player);if not p then return end
 if p.recovery and p.recovery.expires<=os.time() then p.recovery=nil end
 if p.recovery then
  if recovering[player] then recovering[player]:Destroy() end
  local spot=checkpoint(p).Position+Vector3.new(6,2,0)
  local pack=A.part(world.Interactions,'Recoverable eggs • '..player.DisplayName,Vector3.new(3,3,3),CFrame.new(spot),Color3.fromRGB(249,192,117),Enum.Material.Wood)
  pack:SetAttribute('Kind','Recovery');pack:SetAttribute('Owner',player.UserId)
  local q=Instance.new('ProximityPrompt');q.ActionText='Recover eggs';q.MaxActivationDistance=10;q.HoldDuration=.4;q.Parent=pack
  recovering[player]=pack;send(player,'toast','Unsecured eggs recoverable beside your checkpoint for 3 minutes.')
 end
end
local function loseCargo(player)
 if raids then raids.forfeit(player,'fall') end
 local p=P.get(player);if not p then return end
 R.drop(p,os.time());restoreRecovery(player);publish(player)
end
local loadCharacter
local function onCharacter(player,character)
 local h=character:WaitForChild('Humanoid');local rr=character:WaitForChild('HumanoidRootPart');h.WalkSpeed=16;h.UseJumpPower=true;h.JumpPower=48;h.MaxHealth=140;h.Health=140
 movement.bind(player,character)
 local p=P.get(player);if not p then return end
 local pos=if areas[player]=='sanctuary' then home.spawn(player) else checkpoint(p).Position+Vector3.new(0,5,0)
 if not pos then player:Kick('Sanctuary slot unavailable. Please rejoin.');return end
 teleport(player,pos);rebuildTeam(player)
 h.Died:Connect(function() loseCargo(player);if carryVisuals then carryVisuals.clear(player) end;B.remove(player);if guardians then guardians.remove(player) end;respawns[player]=os.clock()+3 end)
end
loadCharacter=function(player)
 player:LoadCharacterAsync()
 -- CharacterAdded fires before Roblox finishes placing the character at its engine spawn.
 if player.Parent==Players and player.Character and P.get(player) then onCharacter(player,player.Character) end
end
local function join(player)
 if not home.reserve(player) then player:Kick('All eight sanctuary plots are occupied. Please join another server.');return end
 areas[player]='sanctuary'
 local p,err=P.load(player)
 if not p then home.release(player);areas[player]=nil;player:Kick('Safe load stopped: '..tostring(err)..' Please retry.');return end
 if player.Parent~=Players then home.release(player);areas[player]=nil;P.save(player,true);return end
 R.settleIncome(p,os.time())
 loadCharacter(player);restoreRecovery(player);publish(player)
end
Players.PlayerAdded:Connect(function(player) task.spawn(join,player) end)
for _,p in ipairs(Players:GetPlayers()) do task.spawn(join,p) end
Players.PlayerRemoving:Connect(function(player)
 movement.clear(player)
 if raids then raids.remove(player) end;if guardians then guardians.remove(player) end;if raidHazards then raidHazards.remove(player) end;if carryVisuals then carryVisuals.clear(player) end
 tycoonWorld.clear(home.plot(player));home.release(player);areas[player]=nil
 B.remove(player,true);if companions[player] then companions[player]:Destroy() end;if recovering[player] then recovering[player]:Destroy() end
 contextSnapshots[player]=nil;respawns[player]=nil;if uiService then uiService.remove(player) end
 P.save(player,true);state[player]=nil;busy[player]=nil;limits[player]=nil;motion[player]=nil;companions[player]=nil;recovering[player]=nil
end)
local rng=Random.new()
local function roll(k)
 local r=rng:NextNumber()*100;for i=1,6 do local s=C.species[(k-1)*6+i];r-=s.weight;if r<=0 then return s.id end end;return C.species[k*6].id
end
carryVisuals=require(script.Parent.CarryVisuals).new(world,send)
for _,part in ipairs(world.Interactions:GetChildren()) do
 if part:GetAttribute('Kind')=='Nest' then
  local id=part:GetAttribute('Id');local egg={id=id,section=part:GetAttribute('Kingdom'),position=part.Position,part=part}
  raidEggs[id]=egg;carryVisuals.shell(egg);part.Transparency=1
  local prompt=part:FindFirstChildOfClass('ProximityPrompt');if prompt then prompt.ActionText='Strike egg';prompt.HoldDuration=0 end
 end
end
raids=require(script.Parent.EggRaids).new({profiles=P,clock=os.clock,guid=function() return game:GetService('HttpService'):GenerateGUID(false) end,
 eggs=raidEggs,roll=roll,alive=living,inBattle=inBattle,spawn=task.spawn,
 near=function(player,egg,range) local rr=root(player);return rr and safe(player) and (rr.Position-egg.position).Magnitude<=range end,
 atExit=function(player)
  local rr=root(player);local exits=world:FindFirstChild('SanctuaryExits');if not rr or not exits then return false end
  for _,v in ipairs(exits:GetChildren()) do local q=v.CFrame:PointToObjectSpace(rr.Position);if math.abs(q.X)<=v.Size.X/2 and math.abs(q.Y)<=v.Size.Y/2 and math.abs(q.Z)<=v.Size.Z/2 then return true end end
  return false
 end,
 alert=function(k,userId,eggId,now) if guardians then guardians.alert(k,userId,eggId,now) end end,
 changed=publish,present=function(player,data) if data.kind=='securing' then areas[player]='sanctuary' end;carryVisuals.show(player,data) end})
local guardianHeights={}
for k=1,6 do
 local m=world.Encounters:FindFirstChild('Guardian_'..k)
 if m and m.PrimaryPart then local cf,size=m:GetBoundingBox();guardianHeights[k]=m.PrimaryPart.Position.Y-cf.Position.Y+size.Y/2 end
end
local groundParams=RaycastParams.new();groundParams.FilterType=Enum.RaycastFilterType.Exclude
local ignore={world.Encounters,world.RaidPresentation,world.Interactions,world.Checkpoints};groundParams.FilterDescendantsInstances=ignore
local function guardianInside(k,position)
 local bounds=world:FindFirstChild('GuardianBounds');local box=bounds and bounds:FindFirstChild(tostring(k))
 if box then local q=box.CFrame:PointToObjectSpace(position);return math.abs(q.X)<=box.Size.X/2 and math.abs(q.Y)<=box.Size.Y/2 and math.abs(q.Z)<=box.Size.Z/2 end
 return position.Y>16+(k-1)*136-35 and position.Y<16+k*136+30 and not home.inSanctuary(position)
end
guardians=require(script.Parent.Guardians).new({world=world,clock=os.clock,players=function() return Players:GetPlayers() end,root=root,profile=P.get,alive=living,
 protected=raids.protected,inside=guardianInside,rootHeight=function(k) return guardianHeights[k] or 12 end,
 ground=function(pos,k)
  local hit=workspace:Raycast(pos+Vector3.new(0,30,0),Vector3.new(0,-95,0),groundParams)
  return hit and hit.Position
 end,
 warning=function(userId,k) local player=Players:GetPlayerByUserId(userId);if player then send(player,'toast',C.guardians[k].name..' heard your strike! Watch its approach.') end end,
 catch=function(player,k)
  if raids.protected(player) or os.clock()<(B.dodgeUntil[player] or 0) then return end
  local p=P.get(player);local h=player.Character and player.Character:FindFirstChildOfClass('Humanoid')
  if p and p.run then raids.forfeit(player,'catch');teleport(player,checkpoint(p).Position+Vector3.new(0,5,0));guardians.remove(player)
  elseif h then h:TakeDamage(14+k*4) end
 end})
B.connectRaids({guardians=guardians,raids=raids,manifest=function(k,center)
 local m=A.creature(world.Encounters,C.guardians[k],center+Vector3.new(0,1,0),3.2,1);m.Name='TrialManifestation_'..k
 for _,v in ipairs(m:GetDescendants()) do if v:IsA('BasePart') then v.Transparency=.38;v.Material=Enum.Material.Neon end end
 return m
end})
raidHazards=require(script.Parent.RaidHazards).new({world=world,players=function() return Players:GetPlayers() end,root=root,
 alive=function(player) local h=player.Character and player.Character:FindFirstChildOfClass('Humanoid');return h and h.Health>0 and h end,
 protected=raids.protected,inSanctuary=home.inSanctuary,dodging=function(player,now) return now<(B.dodgeUntil[player] or 0) end})
local function interact(player,part)
 local p=P.get(player);if not p or not safe(player) or not nearby(player,part,15) then return end
 local kind=part:GetAttribute('Kind');local k=part:GetAttribute('Kingdom') or 1;local id=part:GetAttribute('Id')
 if not R.canEnter(p,k) then send(player,'toast','Defeat the previous Guardian first.');return end
 if kind=='Checkpoint' then
  p.checkpoint=id;local first=not p.discoveries[id]
  p.discoveries[id]=true
  local h=player.Character and player.Character:FindFirstChildOfClass('Humanoid');if h then h.Health=h.MaxHealth end
  if first then for _,cid in ipairs(p.team) do local c=R.find(p.creatures,cid);if c then R.addXP(c,40*k) end end end
  send(player,'toast','Rest point saved. Unsecured creatures still need the sanctuary exit.');task.spawn(P.save,player,false)
 elseif kind=='Nest' then
  local ok,reason
  if p.run and p.run.eggId==id and p.run.phase=='revealed' then ok,reason=raids.pickup(player,p.run.id) else ok,reason=raids.strike(player,id) end
  if not ok then send(player,'toast',if reason=='reserved' then 'Another climber is breaking this egg.' else 'Move closer or finish your current creature run.') end
 elseif kind=='Discovery' then
  if not p.discoveries[id] then p.discoveries[id]=true;p.resources[tostring(k)]=(p.resources[tostring(k)] or 0)+10;p.coins+=20
   for _,cid in ipairs(p.team) do local c=R.find(p.creatures,cid);if c then R.addXP(c,60*k) end end
   send(player,'toast','Landmark discovered • +10 '..C.kingdoms[k].resource)
  else send(player,'toast','Landmark recorded in your expedition journal.') end
 elseif kind=='Shortcut' then
  if p.run then send(player,'toast','Use the map to confirm abandoning your unsecured creature before travel.');return end
  if p.shortcuts[id] then teleport(player,world.Checkpoints[k..':guardian'].Position+Vector3.new(0,5,0));send(player,'toast','Shortcut to the Guardian approach.')
  else p.shortcuts[id]=true;send(player,'toast','Shortcut attuned • use again to reach the Guardian approach.') end
 elseif kind=='Wild' then send(player,'toast','Discover companions by breaking a guarded egg.')
 elseif kind=='Guardian' or kind=='Trial' then
  local center=Vector3.new(part:GetAttribute('ArenaX'),part:GetAttribute('ArenaY'),part:GetAttribute('ArenaZ'))
  local ok,msg=B.start(player,k,kind=='Trial',center);if not ok then send(player,'toast',msg) end
 elseif kind=='Puzzle' then
  state[player]=state[player] or {};local s=state[player];s.puzzle=s.puzzle or {};s.puzzle[id]=(s.puzzle[id] or 0)+1
  local rune=math.floor(workspace:GetServerTimeNow()/2)%3+1
  if rune~=s.puzzle[id] then s.puzzle[id]=0;send(player,'toast','Align runes in order: I → II → III. Wait for the matching rune.');return end
  if s.puzzle[id]>=3 then s.puzzle[id]=0;send(player,'toast','Three runes aligned. Find a guarded egg to discover a companion.') else send(player,'toast','Rune '..s.puzzle[id]..' / 3 aligned. Rotate again.') end
 elseif kind=='Recovery' then
  if part:GetAttribute('Owner')==player.UserId and R.recover(p,os.time()) then part:Destroy();recovering[player]=nil;send(player,'toast','Eggs recovered • extract them now.') end
 elseif kind=='Summit' then
  if not p.discoveries.summit then p.discoveries.summit=true;p.coins+=1000;p.trophies+=100 end
  send(player,'toast','IMPOSSIBLE MOUNTAIN CONQUERED • Sovereign Explorer!')
 elseif table.find({'Incubator','Sanctuary','Training','Competition'},kind) then
  R.settleIncome(p,os.time());send(player,'open',kind)
 end
 publish(player,true)
end
game:GetService('ProximityPromptService').PromptTriggered:Connect(function(prompt,player)
 local part=prompt.Parent
 if not part or not part:IsA('BasePart') or not part:IsDescendantOf(world) or not part:GetAttribute('Kind') then return end
 local now=os.clock();if now<(limits[player] or 0) or busy[player] then return end
 limits[player]=now+.35;interact(player,part)
end)
local journey=Journey.new({profile=P.get,ready=function(player) return safe(player) and not inBattle(player) end,
 origin=function(player,destination)
  local rr=root(player)
  if destination=='blossom' then return rr~=nil and home.nearGate(rr.Position) end
  return atRefuge(player) or nearCheckpoint(player)
 end,
 resolve=function(player,destination)
  if destination=='refuge' then local cf=home.spawn(player);return cf and {cf=cf,area='sanctuary'} end
  if destination=='blossom' then return {cf=world.Checkpoints['1:entrance'].CFrame+Vector3.new(0,5,0),area='mountain'} end
  local p=P.get(player);local cp=world.Checkpoints:FindFirstChild(destination)
  if not p or not cp or not p.discoveries[destination] or not R.canEnter(p,cp:GetAttribute('Kingdom')) then return nil end
  return {cf=cp.CFrame+Vector3.new(0,5,0),area='mountain'}
 end,
 move=function(player,target) return teleport(player,target.cf) end,extract=R.extract,forfeit=raids.forfeit,
 arrived=function(player,target) areas[player]=target.area end,
})
game:GetService('ProximityPromptService').PromptTriggered:Connect(function(prompt,player)
 local rr=root(player);local p=P.get(player)
 if not rr or not p or not safe(player) or busy[player] then return end
 local part=prompt.Parent;if not part or not part:IsA('BasePart') then return end
 local kind=home.prompt(part,player,rr.Position);if not kind then return end
 local now=os.clock();if now<(limits[player] or 0) then return end;limits[player]=now+.35
 if kind=='Gate' then
  local ok=journey.go(player,'blossom');send(player,'toast',if ok then 'Welcome to Blossom Gardens.' else 'Travel unavailable. Finish your encounter and try again.')
 else send(player,'open',kind) end
 publish(player)
end)
local dispatch=UIRequests.actions({profiles=P,rules=R,combat=B,competition=Competition,clock=os.time,
 safe=safe,atHome=atHome,atRefuge=atRefuge,nearCheckpoint=nearCheckpoint,publish=publish,rebuildTeam=rebuildTeam,send=send,
 save=function(player) task.spawn(function() local saved=P.save(player,false);send(player,'save',saved) end) end,
 travel=journey.go,raids=raids,putDown=carryVisuals.clear,
})
local function handle(player,action,data,correlated)
 local ok,message,result=dispatch(player,action,data)
 if action=='Settings' then send(player,'save',ok) end
 if action~='State' then
  if not correlated and (action~='Special' and action~='Dodge' or not ok) then send(player,'toast',message) end
  publish(player)
 end
 return ok,message,result
end
uiService=UIRequests.new({handle=function(player,action,data) return handle(player,action,data,true) end,available=function(player) return P.get(player)~=nil end,
 busy=function(player) return busy[player]==true end,
 setBusy=function(player,value) busy[player]=if value then true else nil end,
 failed=function(err) warn('Mountain UI request failed: '..tostring(err)) end,
})
uiRequest.OnServerEvent:Connect(function(player,id,action,data)
 local result=uiService.process(player,id,action,data)
 if result and player.Parent==Players then uiResult:FireClient(player,result) end
end)
-- The original remote remains supported, with the same rules and honest errors.
request.OnServerEvent:Connect(function(player,action,data)
 if not UIProtocol.validate('legacy:1',action,data) or busy[player] then return end
 local now=os.clock();if now<(limits[player] or 0) then return end;limits[player]=now+.12;busy[player]=true
 local ok,err=pcall(handle,player,action,data);busy[player]=nil
 if not ok then warn('Mountain request failed: '..tostring(err));send(player,'toast','Action unavailable. Your saved data is preserved.') end
end)
-- Server-only integration contract; no Phase 1 coordinate is guessed or written.
local gateway=Instance.new('BindableFunction');gateway.Name='MountainGateway';gateway.Parent=game.ServerStorage
gateway.OnInvoke=function(player) return journey.go(player,'blossom') end
local moving={}
for _,part in ipairs(world.Dynamics:GetChildren()) do if part:GetAttribute('Kind')=='Moving' then
 local decorations={};for _,child in ipairs(part:GetChildren()) do if child:IsA('BasePart') then table.insert(decorations,{part=child,offset=part.CFrame:ToObjectSpace(child.CFrame)}) end end
 table.insert(moving,{part=part,origin=part.CFrame,decorations=decorations})
end end
local combatTick,checkTick,contextTick=0,0,0
game:GetService('RunService').Heartbeat:Connect(function(dt)
 local now=os.clock()
 carryVisuals.tick();raids.tick(now);guardians.tick(now);raidHazards.tick(now)
 for _,m in ipairs(moving) do
  local offset=(math.sin(now*.5)+1)*17
  local k=m.part:GetAttribute('Kingdom')
  local cf=m.origin+Vector3.new(m.part:GetAttribute('AxisX')*offset,if k==4 or k==6 then math.sin(now*.5)*5 else 0,m.part:GetAttribute('AxisZ')*offset)
  if k==4 then cf*=CFrame.Angles(0,math.sin(now*.5)*.25,0) end
  -- Let character physics carry riders while preserving client-owned walking/jumping.
  -- Velocity is the derivative of the anchored platform's sinusoidal trajectory.
  m.part.CFrame=cf
  local speed=8.5*math.cos(now*.5)
  m.part.AssemblyLinearVelocity=Vector3.new(m.part:GetAttribute('AxisX')*speed,if k==4 or k==6 then 2.5*math.cos(now*.5) else 0,m.part:GetAttribute('AxisZ')*speed)
  m.part.AssemblyAngularVelocity=if k==4 then Vector3.new(0,.125*math.cos(now*.5),0) else Vector3.zero
   for _,d in ipairs(m.decorations) do d.part.CFrame=cf*d.offset end
 end
 for player,f in pairs(companions) do local rr=root(player)
  if rr then for _,m in ipairs(f:GetChildren()) do
   local i=m:GetAttribute('Slot');local target=rr.CFrame*CFrame.new((i-2)*4, -1.8+math.sin(now*2+i)*.2,5)
   m.PrimaryPart.CFrame=m.PrimaryPart.CFrame:Lerp(target,1-math.exp(-10*dt))
  end end
 end
 combatTick+=dt;checkTick+=dt;contextTick+=dt
 local contextDue=contextTick>=.5;if contextDue then contextTick=0 end
 if combatTick>=1 then combatTick=0;B.tick() end
 if checkTick<.2 then return end;checkTick=0
 for _,player in ipairs(Players:GetPlayers()) do
  movement.update(player)
  local p=P.get(player);local rr=root(player);local h=player.Character and player.Character:FindFirstChildOfClass('Humanoid')
  if p and respawns[player] and now>=respawns[player] then respawns[player]=nil;task.spawn(loadCharacter,player) end
  if p and contextDue then
   local refuge,near=atRefuge(player),nearCheckpoint(player);local previous=contextSnapshots[player]
   if not previous or previous.atHome~=atHome(player) or previous.atRefuge~=refuge or previous.nearCheckpoint~=near or previous.inSanctuary~=(rr~=nil and home.inSanctuary(rr.Position)) or previous.nearestEgg~=nearestEgg(player) then
    local context={nearestEgg=nearestEgg(player),atHome=atHome(player),sanctuaryConnected=true,plot=home.plot(player),inSanctuary=rr~=nil and home.inSanctuary(rr.Position),atRefuge=refuge,nearCheckpoint=near,serverClock=workspace:GetServerTimeNow()};contextSnapshots[player]=context;send(player,'context',context)
   end
  end
  if p and rr and h and h.Health>0 then
   local m=motion[player]
   if m then
    local elapsed=now-m.time;local distance=(rr.Position-m.pos).Magnitude
    if distance>math.max(22,elapsed*75) and now>m.blockedUntil then teleport(player,m.pos);send(player,'toast','Movement corrected.');m=motion[player] end
    if h.FloorMaterial==Enum.Material.Air then m.fallTop=math.max(m.fallTop,rr.Position.Y)
    else
     if m.fallTop-rr.Position.Y>require(RS.MountainShared.RaidConfig).seriousFall and not raids.protected(player) then loseCargo(player);teleport(player,if areas[player]=='sanctuary' then home.spawn(player) else checkpoint(p).Position+Vector3.new(0,5,0));m=motion[player] end
     m.fallTop=rr.Position.Y
    end
    if rr.Position.Y < -25 then loseCargo(player);teleport(player,if areas[player]=='sanctuary' then home.spawn(player) else checkpoint(p).Position+Vector3.new(0,5,0));m=motion[player] end
    m.pos=rr.Position;m.time=now
    if home.inSanctuary(rr.Position) then areas[player]='sanctuary' elseif world:GetAttribute('FreeClimbVersion') then areas[player]='mountain' end
    if p.run and p.run.phase=='carried' and not raids.protected(player) then task.spawn(raids.exit,player,p.run.id) end
   end
   if p.recovery and os.time()>=p.recovery.expires then p.recovery=nil;if recovering[player] then recovering[player]:Destroy();recovering[player]=nil end;publish(player) end
   for _,hazard in ipairs(world.Dynamics:GetChildren()) do
    if hazard:GetAttribute('Kind')=='Hazard' then
     local active=math.floor(now/3)%2==0;hazard.Transparency=if active then .2 else .85
     if active and (rr.Position-hazard.Position).Magnitude<10 and now>(B.dodgeUntil[player] or 0) then h:TakeDamage(3) end
    elseif hazard:GetAttribute('Kind')=='Crumbling' then
     local crumbled=math.floor(now/4)%3==0;hazard.CanCollide=not crumbled;hazard.Transparency=if crumbled then .9 else 0
    end
   end
  end
 end
 for _,puzzle in ipairs(world.Interactions:GetChildren()) do if puzzle:GetAttribute('Kind')=='Puzzle' then
  local rune=math.floor(workspace:GetServerTimeNow()/2)%3+1;local prompt=puzzle:FindFirstChildOfClass('ProximityPrompt');prompt.ObjectText='Rune '..({'I','II','III'})[rune]..' • align in order';puzzle.Color=({Color3.fromRGB(145,230,191),Color3.fromRGB(247,203,117),Color3.fromRGB(195,169,249)})[rune]
 end end
end)
task.spawn(function()
 while task.wait(2) do
  for player in pairs(P.sessions) do
   local p=P.get(player)
   if p then
    local coins,bag=p.coins,p.tycoon.bag.eggs
    local made=R.tycoon.settle(p,os.time(),false)
    if made>0 or coins~=p.coins or bag~=p.tycoon.bag.eggs then
     tycoonWorld.update(player,p)
     send(player,'production',{tycoon=p.tycoon,coins=p.coins,serverNow=os.time()})
    end
   end
  end
 end
end)
task.spawn(function()
 while task.wait(45) do
  for player,s in pairs(P.sessions) do
   if s.closing then task.spawn(P.save,player,true)
   else task.spawn(function() local ok=P.save(player,false);send(player,'save',ok);if not ok then send(player,'toast','Saving paused. Progress actions are locked to protect your profile.') end end) end
  end
 end
end)
game:BindToClose(function()
 local remaining=0
 for player in pairs(P.sessions) do remaining+=1;task.spawn(function() P.save(player,true);remaining-=1 end) end
 local untilTime=os.clock()+25;while remaining>0 and os.clock()<untilTime do task.wait(.1) end
end)
print('Impossible Mountain ready • six kingdoms • isolated profile namespace')
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">Movement</string>
          <string name="Source"><![CDATA[-- The client sends intent only; the server chooses and reapplies speed.
local R=require(game.ReplicatedStorage.MountainShared.MovementRules)
local M={}
function M.new(remote,clock)
 clock=clock or os.clock
 local states={}
 local service={}
 function service.update(player)
  local s=states[player];local c=player.Character
  local h=c and c:FindFirstChildOfClass('Humanoid')
  if not s or not h then return end
  local active=R.active(s.wanted,h.Health,h.Sit,h.PlatformStand)
  if h.Health<=0 then s.wanted=false end
  h.WalkSpeed=R.speed(active,c:GetAttribute('CarryingCreature')==true)
  if c:GetAttribute('Sprinting')~=active then c:SetAttribute('Sprinting',active) end
 end
 function service.clear(player)
  local s=states[player]
  if s then for _,c in ipairs(s.connections) do c:Disconnect() end end
  states[player]=nil
 end
 function service.bind(player,character)
  service.clear(player)
  local s={wanted=false,lastPress=-math.huge,connections={}};states[player]=s
  local h=character:FindFirstChildOfClass('Humanoid')
  table.insert(s.connections,character:GetAttributeChangedSignal('CarryingCreature'):Connect(function() service.update(player) end))
  if h then table.insert(s.connections,h.Died:Connect(function() s.wanted=false;service.update(player) end)) end
  service.update(player)
 end
 function service.request(player,value)
  local s=states[player];if not s then return false end
  local now=clock()
  -- Never drop a changed intent: the client sends transitions, not a heartbeat.
  if type(value)~='boolean' or (value==s.wanted and not R.intent(value,now,s.lastPress)) then return false end
  if value then s.lastPress=now end
  s.wanted=value;service.update(player);return true
 end
 remote.OnServerEvent:Connect(service.request)
 return service
end
return M
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">Profiles</string>
          <string name="Source"><![CDATA[local C=require(game.ReplicatedStorage.MountainShared.Catalog)
local R=require(game.ReplicatedStorage.MountainShared.Rules)
local UIProtocol=require(game.ReplicatedStorage.MountainShared.UIProtocol)
local Store=require(script.Parent.Store)
local Http=game:GetService('HttpService')
local Run=game:GetService('RunService')
local Custody=R.run
local function create(store,owner)
local P={sessions={},mode=if Run:IsStudio() then 'Studio memory • resets when Play stops' else 'Live DataStore'}
local function copy(t) return Http:JSONDecode(Http:JSONEncode(t)) end
local function finite(n) return type(n)=='number' and n==n and math.abs(n)<math.huge end
local function dense(t)
 if type(t)~='table' then return false end
 local count=0;for k in pairs(t) do if not finite(k) or k%1~=0 or k<1 or k>#t then return false end;count+=1 end
 return count==#t
end
local function valid(p)
 if type(p)~='table' or (p.schema~=1 and p.schema~=2) then return false end
 for _,key in ipairs({'creatures','team','cargo','eggs','wins','captures','discoveries','claims','shortcuts','resources'}) do if type(p[key])~='table' then return false end end
 for _,key in ipairs({'serial','unlocked','coins','trophies','lastIncome','competitionAt'}) do if type(p[key])~='number' or p[key]~=p[key] or math.abs(p[key])==math.huge then return false end end
 if p.unlocked<1 or p.unlocked>6 then return false end
 if p.tycoon~=nil and not R.tycoon.valid(p.tycoon) then return false end
 if p.settings~=nil and not UIProtocol.settings(p.settings) then return false end
 for _,key in ipairs({'creatures','team','cargo','eggs'}) do if not dense(p[key]) then return false end end
 local ids={}
 for _,c in ipairs(p.creatures) do
  if type(c)~='table' or not C.byId[c.species] or type(c.id)~='string' or #c.id==0 or ids[c.id] or not finite(c.level) or c.level%1~=0 or c.level<1 or c.level>50 or not finite(c.xp) or c.xp<0 then return false end
  ids[c.id]=true
 end
 local team={};for _,id in ipairs(p.team) do if not ids[id] or team[id] then return false end;team[id]=true end
 for _,list in ipairs({p.eggs,p.cargo}) do for _,e in ipairs(list) do if type(e)~='table' or not C.byId[e.species] or C.byId[e.species].rarity=='Legendary' or type(e.id)~='string' or (e.readyAt and type(e.readyAt)~='number') then return false end end end
 if p.recovery~=nil then
  if type(p.recovery)~='table' or not dense(p.recovery.eggs) then return false end
  for _,e in ipairs(p.recovery.eggs) do if type(e)~='table' or type(e.id)~='string' or not C.byId[e.species] or C.byId[e.species].rarity=='Legendary' then return false end end
 end
 if p.schema==2 then
  if type(p.legacyEntitlements)~='table' or not dense(p.securedRunIds) or #p.securedRunIds>128 then return false end
  for _,id in ipairs(p.securedRunIds) do if type(id)~='string' or #id>128 then return false end end
  local r=p.run
  if r~=nil and (type(r)~='table' or type(r.id)~='string' or type(r.eggId)~='string' or not C.byId[r.species] or not R.canEnter(p,r.section) or not table.find({'breaking','revealed','carried'},r.phase) or type(r.hits)~='number' or r.hits<0 or r.hits%1~=0 or type(r.trial)~='boolean') then return false end
 end
 return true
end
function P.load(player)
 local now=os.time();local accepted=false
 local ok,data,err=store:update('u'..player.UserId,function(old)
  accepted=false
  if old and (type(old)~='table' or not valid(old.profile)) then return nil end
  if old and old.lock and old.lock.owner~=owner and old.lock.expires>now then return nil end
  local p=if old then old.profile else R.newProfile(now)
  p=Custody.migrate(p);if not p or not valid(p) then return nil end
  Custody.forfeit(p,'leave')
  if not p.tycoon then R.settleIncome(p,now);R.tycoon.ensure(p,now) else R.tycoon.settle(p,now,true) end
  accepted=true;return {profile=p,lock={owner=owner,expires=now+180}}
 end)
 if not ok or not accepted or not data or not valid(data.profile) then return nil,err or 'Profile unavailable or in use; no data overwritten.' end
 data.profile.settings=UIProtocol.settings(nil,data.profile.settings)
 local s={p=data.profile,busy=false,healthy=true,closing=false,lastSave=now,leaseUntil=now+180}
 P.sessions[player]=s;return s.p
end
function P.get(player) local s=P.sessions[player];return s and s.healthy and not s.closing and not s.transacting and not s.pending and os.time()<s.leaseUntil and s.p end
-- A pending draft owns its write ID across uncertain responses. Normal access stays
-- frozen until durable commit; no caller can observe an unsaved ownership grant.
local function commitPending(player,s)
 local pending=s.pending;if not pending then return true end
 s.busy=true;s.transacting=true
 local written=false;local leaseUntil=s.leaseUntil
 for attempt=1,3 do
  local now=os.time();local accepted=false
  local ok=store:update('u'..player.UserId,function(old)
   accepted=false
   if not old or not old.lock or old.lock.owner~=owner or old.lock.expires<=now then return nil end
   if old.writeId==pending.writeId then accepted=true;leaseUntil=old.lock.expires;return old end
   leaseUntil=now+180;accepted=true
   return {profile=pending.draft,writeId=pending.writeId,lock={owner=owner,expires=leaseUntil}}
  end)
  if ok and accepted then written=true;break end
  if attempt<3 then task.wait(attempt) end
 end
 if written then
  -- Preserve the top-level profile identity used by existing synchronous services.
  table.clear(s.p);for k,v in pairs(pending.draft) do s.p[k]=v end
  pending.committed=true;s.pending=nil;s.lastSave=os.time();s.leaseUntil=leaseUntil
 end
 s.busy=false;s.transacting=false;s.healthy=written
 if s.releaseRequested then s.releaseRequested=nil;task.defer(P.save,player,true) end
 return written,if written then pending.reason else 'save_pending'
end
function P.transact(player,transactionId,mutate)
 local s=P.sessions[player]
 if not s or type(transactionId)~='string' or #transactionId<1 or #transactionId>128 then return false,'unavailable' end
 if s.pending and s.pending.id~=transactionId then return false,'save_pending' end
 if s.closing and not s.pending then return false,'closing' end
 if not s.pending then
  if not s.healthy or os.time()>=s.leaseUntil then return false,'unavailable' end
  local copied,draft=pcall(copy,s.p);if not copied then return false,'invalid_profile' end
  local called,ok,reason=pcall(mutate,draft)
  if not called or not ok or not valid(draft) then return false,reason or 'invalid_transaction' end
  s.pending={id=transactionId,writeId=Http:GenerateGUID(false),draft=draft,reason=reason}
 end
 -- Reserve the exact draft BEFORE yielding behind an autosave. Disconnect must
 -- commit this pending exit before releasing its lease, regardless of wait order.
 local requested=s.pending
 local deadline=os.clock()+12
 while s.busy and os.clock()<deadline do task.wait(.1) end
 if requested.committed then return true,requested.reason end
 if s.busy then return false,'busy' end
 return commitPending(player,s)
end
function P.pending(player) local s=P.sessions[player];return s and s.pending and s.pending.id end
function P.save(player,release)
 local s=P.sessions[player];if not s then return false end
 if release then s.closing=true end
 local deadline=os.clock()+12
 while s.busy and os.clock()<deadline do task.wait(.1) end
 if s.busy then s.healthy=false;if release then s.releaseRequested=true end;return false end
 if s.pending and not commitPending(player,s) then return false end
 s.busy=true
 if not valid(s.p) then s.busy=false;s.healthy=false;return false end
 local copied,snapshot=pcall(copy,s.p)
 if not copied then s.busy=false;s.healthy=false;return false end
 local written=false
 local writeId=Http:GenerateGUID(false)
 local leaseUntil=s.leaseUntil
 for attempt=1,3 do
  local now=os.time();local accepted=false
  local ok=store:update('u'..player.UserId,function(old)
   accepted=false
   if old and old.writeId==writeId then accepted=true;return old end
   if not old or not old.lock or old.lock.owner~=owner or old.lock.expires<=now then return nil end
   leaseUntil=now+180
   accepted=true;return {profile=snapshot,writeId=writeId,lock=if release then nil else {owner=owner,expires=leaseUntil}}
  end)
  if ok and accepted then written=true;break end
  if attempt<3 then task.wait(attempt) end
 end
 s.busy=false;s.healthy=written;s.lastSave=os.time();s.leaseUntil=leaseUntil
 if release and written then P.sessions[player]=nil
 elseif s.releaseRequested and not release then
  s.releaseRequested=nil;task.defer(P.save,player,true)
 end
 return written
end
function P.setSettings(player,patch)
 local p=P.get(player);if not p then return false end
 local settings=UIProtocol.settings(patch,p.settings);if not settings then return false end
 p.settings=settings
 local ok=P.save(player,false)
 return ok,if ok then table.clone(settings) else nil
end
P.valid=valid
return P
end
local service=create(if Run:IsStudio() then Store.memory() else Store.datastore('MountainEmpire_FirstDraft_v1'),game.JobId..Http:GenerateGUID(false))
if Run:IsStudio() then service.newForTests=create end
return service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">RaidHazards</string>
          <string name="Source"><![CDATA[local Rules=require(game.ReplicatedStorage.MountainShared.HazardRules)
local Config=require(game.ReplicatedStorage.MountainShared.RaidConfig)
local H={}
function H.new(context)
 local hazards={};local service={}
 for _,p in ipairs(context.world.Dynamics:GetChildren()) do if p:GetAttribute('Kind')=='RaidHazard' then
  local art={};for _,a in ipairs(p:GetDescendants()) do if a:IsA('BasePart') then table.insert(art,{part=a,cf=a.CFrame}) end end
  table.insert(hazards,{part=p,k=p:GetAttribute('Kingdom'),hits={},art=art})
 end end
 function service.remove(player) for _,h in ipairs(hazards) do h.hits[player]=nil end end
 function service.tick(now)
  for _,h in ipairs(hazards) do
   local phase,cycle=Rules.sample(h.k,now);local active=phase=='active';local config=Config.section(h.k)
   local p=h.part;p:SetAttribute('Phase',phase);p.Transparency=if active then .15 elseif phase=='warning' then .4+.15*math.sin(now*10) else .9
   for i,a in ipairs(h.art) do
    a.part.Transparency=if active then .05 elseif phase=='warning' then .2 else .65
    local offset=Vector3.zero
    if active then
     if h.k==1 then offset=Vector3.new(math.sin(now*7)*5,1,0)
     elseif h.k==2 then offset=Vector3.new(0,1,math.sin(now*8)*4)
     elseif h.k==3 then offset=Vector3.new(0,-10,0)
     elseif h.k==5 then offset=Vector3.new(0,2+math.sin(now*13+i),0)
     elseif h.k==6 then offset=Vector3.new(0,2+math.sin(now*4+i),0) end
    end
    a.part.CFrame=a.cf+offset
    if h.k==3 then a.part.CanCollide=not active end
   end
   if active then for _,player in ipairs(context.players()) do
    local r=context.root(player);local humanoid=context.alive(player)
    if r and humanoid and not context.protected(player) and not context.inSanctuary(r.Position) and h.hits[player]~=cycle then
     local q=p.CFrame:PointToObjectSpace(r.Position)
     if Rules.contains(q.X,q.Y,q.Z,p.Size.X/2,p.Size.Z/2) then
      h.hits[player]=cycle
      if not context.dodging(player,now) then
       humanoid:TakeDamage(config.hazardDamage)
       local velocity=if h.k==1 then Vector3.new(-13,4,0) elseif h.k==2 then Vector3.new(0,6,18) elseif h.k==6 then Vector3.new(0,32,0) else Vector3.zero
       r.AssemblyLinearVelocity+=velocity
      end
     end
    end
   end end
  end
 end
 return service
end
return H
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">Sanctuary</string>
          <string name="Source"><![CDATA[local Sessions=require(script.Parent.SanctuarySessions)
local S={}
function S.new(model)
 assert(model and model:IsA('Model'),'Use the baked sanctuary integration review')
 local allocator=Sessions.new(8)
 local plots={}
 for i=1,8 do
  local plot=assert(model.SanctuaryPlots:FindFirstChild(string.format('Plot_%02d',i)))
  local spawn=assert(plot:FindFirstChild('Spawn'))
  spawn.Enabled=false -- Main owns all character spawns, never random shared pads.
  plots[i]={model=plot,spawn=spawn,floor=assert(plot:FindFirstChild('Plot_180x220'))}
 end
 local gates={}
 for _,gate in ipairs(model.ThreeGates_NoGameplay:GetChildren()) do
  local cf=gate:GetBoundingBox()
  local marker=Instance.new('Part');marker.Name='EnterBlossom';marker.Size=Vector3.new(5,5,1)
  marker.CFrame=CFrame.new(cf.X,19,cf.Z+6);marker.Anchored=true;marker.CanCollide=false;marker.CanTouch=false;marker.Transparency=1
  local prompt=Instance.new('ProximityPrompt');prompt.ActionText='Enter Blossom';prompt.ObjectText='Impossible Mountain';prompt.HoldDuration=.35;prompt.MaxActivationDistance=12;prompt.RequiresLineOfSight=false;prompt.Parent=marker
  marker.Parent=gate;gates[marker]=true
 end
 local service={}
 function service.model(index) return plots[index] and plots[index].model end
 local function slot(player) return allocator.plot(player.UserId,player) end
 function service.plot(player) return slot(player) end
 function service.spawn(player)
  local i=slot(player);return i and plots[i].spawn.CFrame+Vector3.new(0,4,0)
 end
 function service.ownsPosition(player,pos)
  local i=slot(player);if not i then return false end
  local floor=plots[i].floor;local q=floor.CFrame:PointToObjectSpace(pos)
  return math.abs(q.X)<=floor.Size.X/2-1 and math.abs(q.Z)<=floor.Size.Z/2-1 and q.Y>=0 and q.Y<=45
 end
 function service.inSanctuary(pos)
  local center=plots[4].floor.Position.X+94
  local mountain=workspace:FindFirstChild('ImpossibleMountain')
  local north=if mountain and mountain:GetAttribute('FreeClimbVersion') then -157 else -1400
  return math.abs(pos.X-center)<1250 and pos.Z>north and pos.Z<550
 end
 function service.nearGate(pos)
  for marker in pairs(gates) do if (marker.Position-pos).Magnitude<=15 then return true end end
  return false
 end
 function service.prompt(part,player,pos)
  if gates[part] and (part.Position-pos).Magnitude<=15 then return 'Gate' end
  local i=slot(player)
  if i and part:GetAttribute('SanctuarySlot')==i and part:IsDescendantOf(plots[i].model) and (part.Position-pos).Magnitude<=15 then return part:GetAttribute('Service') end
 end
 function service.reserve(player)
  local i=allocator.reserve(player.UserId,player);if not i then return nil end
  plots[i].model:SetAttribute('OwnerUserId',player.UserId)
  player:SetAttribute('SanctuaryPlot',i)
  return i
 end
 function service.release(player)
  local i=slot(player)
  if i then plots[i].model:SetAttribute('OwnerUserId',nil) end
  allocator.release(player.UserId,player)
 end
 for i,plot in ipairs(plots) do
  for j,kind in ipairs({'Incubator','Training'}) do
   local marker=Instance.new('Part');marker.Name=kind..'Service';marker.Size=Vector3.new(3,2,3)
   marker.CFrame=plot.spawn.CFrame+Vector3.new(if j==1 then -8 else 8,1,-10)
   marker.Anchored=true;marker.CanCollide=false;marker.CanTouch=false;marker.Material=Enum.Material.Wood
   marker.Color=if j==1 then Color3.fromRGB(133,187,177) else Color3.fromRGB(204,168,105)
   marker:SetAttribute('SanctuarySlot',i);marker:SetAttribute('Service',kind)
   local prompt=Instance.new('ProximityPrompt');prompt.ActionText=if j==1 then 'Incubate / hatch' else 'Train companions'
   prompt.ObjectText='Your sanctuary';prompt.MaxActivationDistance=12;prompt.HoldDuration=.2;prompt.Parent=marker
   marker.Parent=plot.model
  end
 end
 return service
end
return S
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">SanctuarySessions</string>
          <string name="Source"><![CDATA[local S={}
function S.new(capacity)
 local owners,slots,preferred={},{},{}
 local service={}
 function service.plot(uid,session)
  local owner=owners[uid]
  return if owner and owner.session==session then owner.slot else nil
 end
 function service.reserve(uid,session)
  if type(uid)~='number' or uid~=uid or math.abs(uid)==math.huge or uid%1~=0 or uid==0 or session==nil then return nil end
  local owner=owners[uid]
  if owner then return if owner.session==session then owner.slot else nil end
  local slot=preferred[uid]
  if not slot or slots[slot] then
   slot=nil
   for i=1,capacity do if not slots[i] then slot=i;break end end
  end
  if not slot then return nil end
  slots[slot]=uid;owners[uid]={slot=slot,session=session};preferred[uid]=slot
  return slot
 end
 function service.release(uid,session)
  local slot=service.plot(uid,session)
  if slot then slots[slot]=nil;owners[uid]=nil end
 end
 return service
end
return S
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">Store</string>
          <string name="Source"><![CDATA[-- Store (ServerScriptService.CC_CoreServer): persistence adapter. Profile code only sees this interface:
--   store:read(key)        -> ok, value|nil, err
--   store:update(key, fn)  -> ok, value|nil, err   fn(old) returns the new value, or nil to cancel the write
--                            (UpdateAsync semantics: fn may run more than once; keep it free of side effects
--                            other than setting locals the caller resets before each call).
-- Two implementations:
--   Store.datastore(name)  real DataStoreService (UNVERIFIED: the place is unpublished, PlaceId = 0)
--   Store.memory(opts)     in-memory mock for Studio + tests. Values round-trip through JSON like a DataStore,
--                          so non-serializable data fails here too. Failure injection: failNext (n calls),
--                          failAll (bool), latency (s), conflicts (n: run fn twice to mimic a retried write).
local HttpService = game:GetService("HttpService")

local Store = {}

---------------------------------------------------------------- memory mock
local Memory = {}
Memory.__index = Memory

function Store.memory(opts)
	opts = opts or {}
	return setmetatable({
		kind = "memory",
		backend = opts.backend or {}, -- share one backend between two "servers" in tests
		failNext = 0,
		failAll = false,
		latency = opts.latency or 0,
		conflicts = 0,
		failAfterCommit = 0, -- response lost AFTER durable write; exercises uncertain outcome replay
		calls = { read = 0, update = 0, failed = 0 },
	}, Memory)
end

function Memory:_gate(kind)
	self.calls[kind] += 1
	if self.latency > 0 then
		task.wait(self.latency)
	end
	if self.failAll then
		self.calls.failed += 1
		return false, "mock: store unavailable (failAll)"
	end
	if self.failNext > 0 then
		self.failNext -= 1
		self.calls.failed += 1
		return false, "mock: store request failed (failNext)"
	end
	return true
end

function Memory:read(key)
	local ok, err = self:_gate("read")
	if not ok then
		return false, nil, err
	end
	local raw = self.backend[key]
	return true, raw and HttpService:JSONDecode(raw) or nil, nil
end

function Memory:update(key, fn)
	local ok, err = self:_gate("update")
	if not ok then
		return false, nil, err
	end
	local runs = 1 + math.max(0, self.conflicts)
	self.conflicts = 0
	local new
	for _ = 1, runs do
		local raw = self.backend[key]
		local old = raw and HttpService:JSONDecode(raw) or nil
		local okFn, res = pcall(fn, old)
		if not okFn then
			return false, nil, "transform error: " .. tostring(res)
		end
		new = res
	end
	if new == nil then
		local raw = self.backend[key]
		return true, raw and HttpService:JSONDecode(raw) or nil, "cancelled"
	end
	local okEnc, enc = pcall(HttpService.JSONEncode, HttpService, new)
	if not okEnc then
		return false, nil, "serialize: " .. tostring(enc)
	end
	self.backend[key] = enc
	if self.failAfterCommit > 0 then
		self.failAfterCommit -= 1
		return false, nil, "mock: response lost after commit"
	end
	return true, HttpService:JSONDecode(enc), nil
end

---------------------------------------------------------------- real DataStore (UNVERIFIED in Studio)
local DS = {}
DS.__index = DS

function Store.datastore(name)
	local DataStoreService = game:GetService("DataStoreService")
	local ok, ds = pcall(DataStoreService.GetDataStore, DataStoreService, name)
	return setmetatable({ kind = "datastore", ds = ok and ds or nil, initErr = (not ok) and tostring(ds) or nil, service = DataStoreService }, DS)
end

function DS:_budget(reqType)
	-- wait (bounded) for request budget instead of letting the request throttle
	for _ = 1, 20 do
		local okB, b = pcall(self.service.GetRequestBudgetForRequestType, self.service, reqType)
		if not okB or b > 0 then
			return
		end
		task.wait(0.5)
	end
end

function DS:read(key)
	if not self.ds then
		return false, nil, self.initErr
	end
	self:_budget(Enum.DataStoreRequestType.GetAsync)
	local ok, res = pcall(self.ds.GetAsync, self.ds, key)
	if not ok then
		return false, nil, tostring(res)
	end
	return true, res, nil
end

function DS:update(key, fn)
	if not self.ds then
		return false, nil, self.initErr
	end
	self:_budget(Enum.DataStoreRequestType.UpdateAsync)
	local cancelled = false
	local ok, res = pcall(self.ds.UpdateAsync, self.ds, key, function(old)
		local new = fn(old)
		cancelled = new == nil
		return new
	end)
	if not ok then
		return false, nil, tostring(res)
	end
	return true, res, cancelled and "cancelled" or nil
end

---------------------------------------------------------------- choice
-- Real DataStore only in a published place; Studio with PlaceId 0 cannot reach DataStores at all.
function Store.default(name)
	if game.PlaceId ~= 0 then
		return Store.datastore(name)
	end
	return Store.memory()
end

return Store
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">StudioTests</string>
          <string name="Source"><![CDATA[-- Explicit Studio-only test suite, never runs automatically or alters a real player.
local T={}
function T.run()
 assert(game:GetService('RunService'):IsStudio(),'Studio only')
 local P=require(script.Parent.Profiles);local Store=require(script.Parent.Store)
 local R=require(game.ReplicatedStorage.MountainShared.Rules);local C=require(game.ReplicatedStorage.MountainShared.Catalog)
 local checks={};local function check(name,value) assert(value,name);table.insert(checks,name) end
 local backend=Store.memory();local a=P.newForTests(backend,'test-a');local b=P.newForTests(backend,'test-b');local player={UserId=92833001}
 local p=a.load(player);check('new schema loads',p and p.schema==2)
 check('contended session rejects',not b.load(player))
 p.coins=97;R.collect(p,'mossbun','fixture',100);R.extract(p);R.incubate(p,p.eggs[1].id,100)
 check('release save succeeds',a.save(player,true))
 local q=b.load(player);check('reconnect retains coins and incubation',q and q.coins==97 and q.eggs[1].readyAt==130)
 check('early hatch rejected',not R.hatch(q,q.eggs[1].id,129));check('offline hatch ready',R.hatch(q,q.eggs[1].id,130))
 R.collect(q,'mossbun','recover-fixture',200);R.drop(q,200);b.save(player,true)
 q=a.load(player);check('recovery survives reconnect',q.recovery and #q.recovery.eggs==1 and q.recovery.expires==380)
 backend.failAll=true;check('save failure freezes mutations',not a.save(player,false) and not a.get(player))
 backend.failAll=false;check('save retry resumes',a.save(player,false) and a.get(player)==q)
 q.coins=121;backend.failAfterCommit=1;check('uncertain response retry safe',a.save(player,false));check('no duplicate currency',a.get(player).coins==121)
 local payload={q.team[1]};payload.extra='unsafe';check('dictionary team rejected',not R.equip(q,payload))
 q.unsupported={};q.unsupported.self=q.unsupported;check('serialization failure clears busy',not a.save(player,false) and not a.sessions[player].busy);q.unsupported=nil
 check('serialization repair resumes save',a.save(player,true))
 backend.failAll=true;check('failed load does not default',not b.load(player));backend.failAll=false
 check('failed load preserved durable state',b.load(player).coins==121);b.save(player,true)
 backend:update('u92833002',function() return {profile={schema=99},lock=nil} end)
 check('unknown schema never overwritten',not a.load({UserId=92833002}))
 local _,saved=backend:read('u92833002');check('unknown schema retained',saved.profile.schema==99)
 local slowBackend=Store.memory();local slowOnce=false
 local delayed={}
 function delayed:update(key,transform)
  if slowOnce then slowOnce=false;task.wait(13) end
  return slowBackend:update(key,transform)
 end
 local slow=P.newForTests(delayed,'slow-owner');local leaving={UserId=92833005}
 local last=slow.load(leaving);last.coins=10;slowOnce=true
 local autosaveDone=false
 task.spawn(function() slow.save(leaving,false);autosaveDone=true end)
 task.wait(.1);last.coins=42
 check('slow autosave release yields safely',not slow.save(leaving,true))
 local finish=os.clock()+8
 while slow.sessions[leaving] and os.clock()<finish do task.wait(.1) end
 local _,durable=slowBackend:read('u92833005')
 check('slow autosave completes',autosaveDone)
 check('final leave snapshot flushed',durable.profile.coins==42 and durable.lock==nil and slow.sessions[leaving]==nil)
 local profile=R.newProfile(100)
 for k=1,6 do
  check('gate '..k,R.canEnter(profile,k));check('normal win '..k,R.winGuardian(profile,k,false));local id='trial'..k;check('trial reward '..k,R.run.strike(profile,{id=id,runId=id,species=C.guardians[k].id,section=k,trial=true,hitsRequired=1},100) and R.run.pickup(profile,id) and R.run.secure(profile,id));check('duplicate capture '..k,not R.winGuardian(profile,k,true))
 end
 check('six permanent guardian captures',#profile.creatures==9)
 local defense=require(script.Parent.Competition)
 check('register defense snapshot',defense.register(profile,92833003))
 local challenger=R.newProfile(os.time());local ok,result=defense.challenge(challenger,92833004,92833003)
 check('offline snapshot challenge',ok and type(result.rounds)=='number')
 check('challenge replay cooldown',not defense.challenge(challenger,92833004,92833003))
 local guard=profile.creatures[1];guard.level=25;R.specialize(profile,guard.id,'Guard');check('guard has defensive stat',R.stats(guard).guard==.15)
 return {passed=#checks,checks=checks,scope='isolated memory profiles and snapshots; no live DataStore or actual player progression'}
end
return T
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">Traversal</string>
          <string name="Source"><![CDATA[local Players=game:GetService('Players')
local RunService=game:GetService('RunService')
local Rules=require(game.ReplicatedStorage.MountainShared.TraversalRules)
local T={}
function T.start(world)
 local sand,fields={},{}
 for _,part in ipairs(world.Dynamics:GetChildren()) do
  if part:GetAttribute('Kind')=='ShiftingSand' then table.insert(sand,part) end
  if part:GetAttribute('GravityField') then table.insert(fields,part) end
 end
 local forces={}
 local function clear(player)
  local data=forces[player]
  if data then data.force:Destroy();data.attachment:Destroy();forces[player]=nil end
 end
 Players.PlayerRemoving:Connect(clear)
 RunService.Heartbeat:Connect(function()
  for _,part in ipairs(sand) do
   part.AssemblyLinearVelocity=part.CFrame.LookVector*Rules.sandSpeed(workspace:GetServerTimeNow())
  end
  for _,player in ipairs(Players:GetPlayers()) do
   local char=player.Character
   local root=char and char:FindFirstChild('HumanoidRootPart')
   local h=char and char:FindFirstChildOfClass('Humanoid')
   local scale=1
   if root and h and h.Health>0 then
    for _,part in ipairs(fields) do
     local p=part.CFrame:PointToObjectSpace(root.Position)
     scale=math.min(scale,Rules.gravityScale(p.X,p.Y-part.Size.Y/2,p.Z,part.Size.X/2,part.Size.Z/2))
    end
   end
   if scale==1 then clear(player)
   else
    local data=forces[player]
    if data and data.root~=root then clear(player);data=nil end
    if not data then
     local attachment=Instance.new('Attachment');attachment.Name='MountainGravity';attachment.Parent=root
     local force=Instance.new('VectorForce');force.Name='MountainGravity';force.Attachment0=attachment
     force.ApplyAtCenterOfMass=true;force.RelativeTo=Enum.ActuatorRelativeTo.World;force.Parent=root
     data={force=force,attachment=attachment,root=root};forces[player]=data
    end
    data.force.Force=Vector3.new(0,root.AssemblyMass*workspace.Gravity*(1-scale),0)
   end
  end
 end)
end
return T
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">TycoonWorld</string>
          <string name="Source"><![CDATA[-- Additive dressing only. All offsets are inside the existing owned plot's 110x120 grid.
local C=require(game.ReplicatedStorage.MountainShared.Catalog)
local T=require(game.ReplicatedStorage.MountainShared.Tycoon)
local A=require(game.ServerStorage.MountainWorld.Art)
local Tags=game:GetService('CollectionService')
local W={}
function W.new(home)
 local plots={}
 local function part(parent,name,size,cf,color,material)
  local p=Instance.new('Part');p.Name=name;p.Size=size;p.CFrame=cf;p.Color=color;p.Material=material or Enum.Material.SmoothPlastic
  p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false;p.Parent=parent;return p
 end
 local function label(p,text,height)
  local gui=Instance.new('BillboardGui');gui.Size=UDim2.fromOffset(160,42);gui.MaxDistance=45;gui.Parent=p
  if height then gui.StudsOffsetWorldSpace=Vector3.new(0,height,0) else gui.StudsOffset=Vector3.new(0,3,0) end
  local textLabel=Instance.new('TextLabel');textLabel.Size=UDim2.fromScale(1,1);textLabel.BackgroundTransparency=.25;textLabel.BackgroundColor3=Color3.fromRGB(24,40,48)
  textLabel.TextColor3=Color3.fromRGB(245,240,218);textLabel.TextSize=14;textLabel.Font=Enum.Font.GothamMedium;textLabel.TextWrapped=true;textLabel.Text=text;textLabel.Parent=gui
  return textLabel
 end
 for slot=1,8 do
  local model=home.model(slot);local floor=model:FindFirstChild('Plot_180x220')
  local root=Instance.new('Model');root.Name='TycoonProduction';root.Parent=model
  local cf=floor.CFrame*CFrame.new(0,floor.Size.Y/2+.15,-10)
  root:SetAttribute('Width',110);root:SetAttribute('Depth',120)
  local spine=part(root,'ConveyorSpine',Vector3.new(10,.4,100),cf,Color3.fromRGB(40,62,65),Enum.Material.Metal)
  spine:SetAttribute('SanctuarySlot',slot);spine:SetAttribute('ActiveHabitats',0);Tags:AddTag(spine,'TycoonConveyor')
  for _,x in ipairs({-5.2,5.2}) do part(root,'SpineTrim',Vector3.new(.3,.25,100),cf*CFrame.new(x,.4,0),Color3.fromRGB(114,203,177),Enum.Material.Neon) end
  local habitats={}
  for i=1,8 do
   local x=if i%2==1 then -30 else 30;local z=-44+math.floor((i-1)/2)*28
   local center=cf*CFrame.new(x,0,z)
   local pad=part(root,'Habitat_'..i,Vector3.new(36,.5,20),center,Color3.fromRGB(85,123,100),Enum.Material.Grass)
   local rim=part(root,'HabitatRim_'..i,Vector3.new(37,.2,21),center*CFrame.new(0,-.15,0),Color3.fromRGB(219,189,122),Enum.Material.Wood)
   local branch=part(root,'Feeder_'..i,Vector3.new(7,.25,3),cf*CFrame.new(if x<0 then -8.5 else 8.5,.15,z),spine.Color,Enum.Material.Metal)
   local frame={}
   for _,dx in ipairs({-17,17}) do for _,dz in ipairs({-9,9}) do
    table.insert(frame,part(root,'HabitatPost_'..i,Vector3.new(.9,2.4,.9),center*CFrame.new(dx,1.3,dz),rim.Color,Enum.Material.Wood))
   end end
   table.insert(frame,part(root,'HabitatBackRail_'..i,Vector3.new(34,.6,.6),center*CFrame.new(0,2,-9),rim.Color,Enum.Material.Wood))
   local gauge=part(root,'StorageTrack_'..i,Vector3.new(28,.25,.8),center*CFrame.new(0,.5,9),spine.Color,Enum.Material.Metal)
   local fill=part(root,'StorageFill_'..i,Vector3.new(.05,.3,.65),center*CFrame.new(-14,.55,9),rim.Color,Enum.Material.Neon)
   fill.Transparency=1
   habitats[i]={pad=pad,rim=rim,branch=branch,label=label(pad,'Habitat '..i,7),cf=center,frame=frame,gauge=gauge,fill=fill}
  end
  local bank=part(root,'ProductionBank',Vector3.new(12,3,6),cf*CFrame.new(0,1.5,56),Color3.fromRGB(219,189,122),Enum.Material.Metal)
  bank.CanQuery=true;bank:SetAttribute('SanctuarySlot',slot);bank:SetAttribute('Service','Sanctuary')
  local prompt=Instance.new('ProximityPrompt');prompt.ActionText='Manage / collect / bank';prompt.ObjectText='Production eggs';prompt.HoldDuration=.2;prompt.MaxActivationDistance=12;prompt.Parent=bank
  label(bank,'PRODUCTION BANK')
  part(root,'BankPlinth',Vector3.new(14,.6,8),cf*CFrame.new(0,.3,56),spine.Color,Enum.Material.Slate)
  part(root,'BankDepositSlot',Vector3.new(7,.15,1.2),cf*CFrame.new(0,3.1,55),spine.Color,Enum.Material.Metal)
  local machines={}
  for i,name in ipairs({'Processor','Sorter','Collector'}) do
   local machine=part(root,name,Vector3.new(4,3,5),cf*CFrame.new(0,1.6,-30+(i-1)*28),Color3.fromRGB(82,104,114),Enum.Material.Metal)
   local pieces={}
   for _,x in ipairs({-3.8,3.8}) do table.insert(pieces,part(root,name..'Pillar',Vector3.new(1.2,5,2),machine.CFrame*CFrame.new(x,.8,0),machine.Color,Enum.Material.Metal)) end
   table.insert(pieces,part(root,name..'Arch',Vector3.new(9,1,2),machine.CFrame*CFrame.new(0,3.3,0),machine.Color,Enum.Material.Metal))
   local light=part(root,name..'Status',Vector3.new(5,.2,.25),machine.CFrame*CFrame.new(0,3.3,1.15),bank.Color,Enum.Material.Neon)
   table.insert(pieces,light)
   machines[i]={part=machine,label=label(machine,name),pieces=pieces}
  end
  plots[slot]={root=root,spine=spine,habitats=habitats,machines=machines,bank=bank}
  task.wait()
 end
 local service={}
 function service.update(player,p)
  local slot=home.plot(player);local plot=slot and plots[slot];if not plot then return end
  local t=p.tycoon;local active=0
  local palette=table.find(T.config.cosmetics,t.cosmetic) or 1;local accent=Color3.fromRGB(table.unpack(C.kingdoms[palette].accent))
  plot.bank.Color=accent;plot.spine:SetAttribute('Automation',t.levels.automation)
  for i,row in ipairs(plot.habitats) do
   local h=t.habitats[i];local unlocked=i<=t.slots;local c=h.creature and (function() for _,v in ipairs(p.creatures) do if v.id==h.creature then return v end end end)()
   if c and unlocked then active+=1 end
   local species=c and C.byId[c.species]
   local key=if c then c.id..':'..c.level else ''
   if row.key~=key then
    if row.creature then row.creature:Destroy();row.creature=nil end
    if species and unlocked then row.creature=A.creature(plot.root,species,row.cf.Position+Vector3.new(0,2,0),.65,if c.level>=35 then 3 elseif c.level>=15 then 2 else 1) end
    local height=5
    if row.creature then local bounds,size=row.creature:GetBoundingBox();height=math.max(height,bounds.Position.Y+size.Y/2-row.pad.Position.Y+2) end
    row.label.Parent.StudsOffsetWorldSpace=Vector3.new(0,height,0)
    row.key=key
   end
   row.pad.Transparency=if unlocked then 0 else .8;row.rim.Color=accent;row.rim.Transparency=if unlocked then 0 else .8
   row.branch.Transparency=if unlocked then 0 else .8
   for _,piece in ipairs(row.frame) do piece.Color=accent;piece.Transparency=if unlocked then 0 else .9 end
   row.gauge.Transparency=if unlocked then 0 else .9
   local capacity=T.capacity(p,i);local ratio=math.clamp(h.eggs/capacity,0,1)
   row.fill.Size=Vector3.new(math.max(.05,28*ratio),.3,.65)
   row.fill.CFrame=row.cf*CFrame.new(-14+14*ratio,.55,9)
   row.fill.Color=if ratio>=1 then Color3.fromRGB(255,211,103) else accent
   row.fill.Transparency=if unlocked and h.eggs>0 then 0 else 1
   row.label.Text=if not unlocked then 'Habitat '..i..' · locked' else (if species then species.name else 'Assign a creature')..'\n'..h.eggs..' / '..T.capacity(p,i)..' production eggs'
   if unlocked and ratio>=1 then row.label.Text..=' · FULL' end
  end
  for i,v in ipairs(plot.machines) do
   local enabled=t.levels.automation>=i+1;v.part.Transparency=if enabled then .1 else .85;v.label.Text=v.part.Name..(if enabled then ' · active' else ' · locked');v.part.Color=accent
   for _,piece in ipairs(v.pieces) do piece.Color=accent;piece.Transparency=if enabled then 0 else .9 end
  end
  plot.spine:SetAttribute('ActiveHabitats',active);plot.spine:SetAttribute('OwnerUserId',player.UserId)
 end
 function service.clear(slot)
  local plot=plots[slot];if not plot then return end
  plot.spine:SetAttribute('ActiveHabitats',0);plot.spine:SetAttribute('OwnerUserId',nil)
  plot.spine:SetAttribute('Automation',0)
  for _,row in ipairs(plot.habitats) do
   if row.creature then row.creature:Destroy();row.creature=nil end
   row.key=nil;row.label.Text='Unoccupied habitat';row.fill.Transparency=1
   row.pad.Transparency=.8;row.rim.Transparency=.8;row.branch.Transparency=.8;row.gauge.Transparency=.9
   for _,piece in ipairs(row.frame) do piece.Transparency=.9 end
  end
  for _,v in ipairs(plot.machines) do v.part.Transparency=.85;v.label.Text=v.part.Name..' · locked';for _,piece in ipairs(v.pieces) do piece.Transparency=.9 end end
 end
 for slot=1,8 do service.clear(slot) end
 return service
end
return W
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">UIRequests</string>
          <string name="Source"><![CDATA[-- Correlated requests are scoped to one player connection. Retired IDs never execute.

local Protocol=if script then require(game.ReplicatedStorage.MountainShared.UIProtocol) else require('../shared/UIProtocol')

local U={}

function U.new(options)

 local sessions={}

 local clock=options.clock or os.clock

 local maxCached=options.maxCached or 128

 local maxTokens=options.maxTokens or 4

 local interval=options.minInterval or .12

 local service={}

 local function result(id,action,ok,message,data)

  return {id=if type(id)=='string' and #id<=64 then id else '',action=if type(action)=='string' and #action<=32 then action else '',ok=ok==true,message=message,data=data}

 end

 function service.process(player,id,action,payload)

  local token,sequence=Protocol.parseId(id)

  if not token then return result(id,action,false,'Invalid request id.') end

  local session=sessions[player]

  if not session then session={cache={},order={},tokens={},tokenCount=0,nextAt=0};sessions[player]=session end

  if session.cache[id] then return session.cache[id] end

  if session.running==id then return nil end -- The original call owns the eventual terminal reply.

  local high=session.tokens[token]

  if high and sequence<=high then return result(id,action,false,'Request expired. Refresh before trying again.') end

  if not high then

   if session.tokenCount>=maxTokens then return result(id,action,false,'Too many UI sessions. Please reconnect.') end

   session.tokenCount+=1

  end

  session.tokens[token]=sequence

  local function finish(value)

   session.cache[id]=value;table.insert(session.order,id)

   if #session.order>maxCached then session.cache[table.remove(session.order,1)]=nil end

   return value

  end

  local valid,message=Protocol.validate(id,action,payload)

  if not valid then return finish(result(id,action,false,message)) end

  if session.running or (options.busy and options.busy(player)) then return finish(result(id,action,false,'Another action is in progress. Please wait.')) end

  local now=clock()

  if now<session.nextAt then return finish(result(id,action,false,'Please wait before trying another action.')) end

  session.nextAt=now+interval

  if options.available and not options.available(player) then return finish(result(id,action,false,'Profile or saving unavailable. Please retry when saving resumes.')) end

  session.running=id

  if options.setBusy then options.setBusy(player,true) end

  local called,ok,reply,data=pcall(options.handle,player,action,payload)

  session.running=nil

  if options.setBusy then options.setBusy(player,false) end

  if not called then

   if options.failed then options.failed(ok) end

   return finish(result(id,action,false,'Action unavailable. Refresh your state before trying again.'))

  end

  return finish(result(id,action,ok,if type(reply)=='string' then reply else (if ok==true then 'Action complete.' else 'Action rejected.'),data))

 end

 function service.remove(player) sessions[player]=nil end

 return service

end

-- This dispatcher shares the legacy rules rather than creating a second economy.

function U.actions(context)

 local P,R=context.profiles,context.rules

 local function copyCreature(c) return if c then table.clone(c) else nil end

 return function(player,action,payload)

  local p=P.get(player)

  if not p then return false,'Profile or saving unavailable.' end

  if action=='State' then context.publish(player);return true,'State refreshed.' end

  if action=='Settings' then

   local ok,settings=P.setSettings(player,payload)

   return ok,if ok then 'Settings saved.' else 'Settings save unavailable.',if ok then {settings=settings} else nil

  end

  if not context.safe(player) then return false,'Wait until your character is ready and movement is safe.' end

  if action=='Strike' or action=='Pickup' or action=='PutDown' then
   if not context.raids then return false,'Mountain discovery is unavailable.' end
   local ok,reason
   if action=='Strike' then ok,reason=context.raids.strike(player,payload)
   elseif action=='Pickup' then ok,reason=context.raids.pickup(player,payload)
   elseif context.atHome(player) and not p.run then context.putDown(player);ok=true end
   local messages={reserved='Another climber is breaking this egg.',full_hands='Finish your current creature run first.',too_far='Move closer to the egg.',cadence='Tap again after the pickaxe strike.',egg_resting='This egg is resting. Try another.',finish_battle='Finish your fight before breaking an egg.'}
   return ok==true,if ok then (if action=='Strike' then 'Strike landed.' elseif action=='Pickup' then 'Carry your creature downhill to sanctuary.' else 'Creature safely in your collection.') else messages[reason] or 'That action is unavailable.'
  end
  if action=='Tycoon' or (action=='CollectIncome' and p.tycoon) then
   if not context.atHome or not context.atHome(player) then return false,'Use your own sanctuary plot.' end
   local T=R.tycoon;local request=if action=='CollectIncome' then {op='bank'} else payload
   T.settle(p,context.clock(),false)
   local ok=false;local message='Action unavailable.'
   if request.op=='collect' then local amount=T.collect(p,request.slot);ok=amount>0;message=if ok then 'Collected '..amount..' production eggs.' else 'No eggs collected: storage empty or bag full.'
   elseif request.op=='bank' then local amount=T.bank(p);ok=amount>0;message=if ok then 'Banked production eggs for '..amount..' coins.' else 'Your production egg bag is empty.'
   elseif request.op=='assign' then ok=T.assign(p,request.slot,request.id,context.clock());message=if ok then 'Habitat assignment updated.' else 'Choose an owned creature not assigned to another habitat.'
   elseif request.op=='swap' then ok=T.swap(p,request.slot,request.other,context.clock());message=if ok then 'Habitat creatures swapped. Stored eggs preserved.' else 'Choose two unlocked owned habitats.'
   elseif request.op=='attune' then ok=T.attune(p,request.slot,request.kingdom,context.clock());message=if ok then 'Habitat attuned.' else 'Unlock that kingdom first.'
   elseif request.op=='upgrade' then ok=T.upgrade(p,request.path,request.slot,context.clock());message=if ok then 'Upgrade installed.' else 'Check coins, prerequisites and maximum level.'
   elseif request.op=='cosmetic' then ok=T.cosmetic(p,request.id);message=if ok then 'Sanctuary palette updated.' else 'Unknown palette.' end
   if ok and context.save then context.save(player) end
   return ok,message,{tycoon=T.snapshot(p)}
  end
  if action=='Special' then

   local ok=context.combat.special(player,payload.slot,payload.ability)

   return ok,if ok then 'Special activated.' else 'Special unavailable: check the encounter, team and cooldown.'

  elseif action=='Dodge' then

   local ok=context.combat.dodge(player)

   if ok then context.send(player,'dodge',true) end

   return ok,if ok then 'Dodge ready.' else 'Dodge is cooling down.'

  elseif action=='Equip' then

   if not R.equip(p,payload) then return false,'Choose one to three distinct owned companions.' end

   context.rebuildTeam(player);return true,'Team equipped.',{team=table.clone(p.team)}

  elseif action=='Incubate' or action=='Hatch' then

   if not context.atRefuge(player) then return false,'Use incubation on your own plot or at the refuge.' end

   local ok=if action=='Incubate' then R.incubate(p,payload,context.clock()) else R.hatch(p,payload,context.clock())

   if not ok then return false,'Not ready or all three incubators are occupied.' end

   local data=if action=='Hatch' then {creature=copyCreature(p.creatures[#p.creatures])} else {egg=table.clone(R.find(p.eggs,payload))}

   if context.save then context.save(player) end

   return true,if action=='Hatch' then 'A new companion hatched!' else 'Incubation started • hatching is free.',data

  elseif action=='Specialize' then

   if not R.specialize(p,payload.id,payload.choice) then return false,'Specialization requires an owned level 25 companion without an existing choice.' end

   context.rebuildTeam(player);return true,'Specialization selected.',{creature=copyCreature(R.find(p.creatures,payload.id))}

  elseif action=='Train' then

   if not context.atRefuge(player) then return false,'Train on your own plot or at the refuge.' end

   local c=R.find(p.creatures,payload)

   if not c then return false,'Companion unavailable.' end

   if c.level>=50 then return false,'This companion is already at maximum level.' end

   if p.coins<15 then return false,'Training requires 15 coins.' end

   local previousLevel=c.level;local previousStage=R.stage(c.level)

   p.coins-=15;R.addXP(c,80);context.rebuildTeam(player)

   return true,'Training complete • +80 XP',{creature=copyCreature(c),previousLevel=previousLevel,previousStage=previousStage,stage=R.stage(c.level),xp=80,cost=15}

  elseif action=='Travel' or action=='TravelAbandon' then

   if not context.nearCheckpoint(player) and not context.atRefuge(player) then return false,'Fast travel begins at a checkpoint or refuge.' end

   local destination=if action=='TravelAbandon' then payload.destination else payload
   local ok,reason,runId=context.travel(player,destination,if action=='TravelAbandon' then payload.runId else nil)
   if not ok then
    if reason=='abandon_confirmation_required' then return false,'Travel abandons your unsecured creature.',{confirmAbandon=true,destination=destination,runId=runId} end
    return false,'Destination or travel unavailable.'
   end

   return true,'Travel complete.',{destination=payload}

  elseif action=='CollectIncome' then

   if not context.atRefuge(player) then return false,'Collect income on your own plot or at the refuge.' end

   local amount=R.settleIncome(p,context.clock());return true,'Collected '..amount..' sanctuary coins.',{coins=amount}

  elseif action=='RegisterDefense' then

   if not context.atRefuge(player) then return false,'Register a defense on your own plot or at the refuge.' end

   local ok=context.competition.register(p,player.UserId)

   return ok,if ok then 'Defense snapshot saved • others can challenge your UserId while you are offline.' else 'Defense save unavailable. Try again later.'

  elseif action=='ChallengeDefense' then

   if not context.atRefuge(player) then return false,'Challenge a defense on your own plot or at the refuge.' end

   local ok,value=context.competition.challenge(p,player.UserId,payload)

   if not ok then return false,value end

   context.send(player,'competition',value);if context.save then context.save(player) end

   return true,if value.won then 'Defense challenge won.' else 'Defense challenge complete.',value

  end

  return false,'Unknown action.'

 end

end

return U

]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerStorage" referent="36">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
    <Item class="Folder" referent="37">
      <Properties>
        <string name="Name">MountainWorld</string>
      </Properties>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">ArenaBoundary</string>
          <string name="Source"><![CDATA[-- Baked visual guidance for the existing 58-stud combat participation radius.
-- Deliberately adds no obstacles or changes to combat rules.
local A=require(script.Parent.Art)
local C=require(game.ReplicatedStorage.MountainShared.Catalog)
local B={}
function B.apply(world)
 assert(not game:GetService('RunService'):IsRunning() and game.PlaceId==0,'Local Edit only')
 assert(not world:FindFirstChild('ArenaBoundary'),'Already built')
 local root=Instance.new('Folder');root.Name='ArenaBoundary';root.Parent=world
 for ki,k in ipairs(C.kingdoms) do
  local center=world[k.name].ArenaFloor.Position+Vector3.new(0,2.5,0)
  local q=C.route(ki,.875);local frame=CFrame.lookAt(center,center-Vector3.new(math.cos(q.angle),0,math.sin(q.angle)))
  local group=Instance.new('Folder');group.Name=k.id;group.Parent=root
  -- Follow every walkable part of the circle, including diagonal side exits.
  local rays=RaycastParams.new();rays.FilterType=Enum.RaycastFilterType.Include
  rays.FilterDescendantsInstances={world.EnvironmentFinish};rays.RespectCanCollide=true
  for j=-62,62 do
   local a=j*.05;local pos=Vector3.new(math.sin(a)*53,-.35,math.cos(a)*53)
   local hit=workspace:Raycast(frame:PointToWorldSpace(pos+Vector3.new(0,5,0)),Vector3.new(0,-10,0),rays)
   if hit and hit.Instance:GetAttribute('MountainArtSupport') then
    A.part(group,'ArenaThresholdInlay',Vector3.new(2.4,.15,.55),frame*CFrame.new(pos)*CFrame.Angles(0,a,0),Color3.fromRGB(211,198,160),Enum.Material.Metal)
   end
  end
  for _,side in ipairs({-1,1}) do
   local marker=A.part(group,'ArenaExitMarker',Vector3.new(1.4,3.6,1.4),frame*CFrame.new(side*15,1.3,51),Color3.fromRGB(153,155,143),Enum.Material.Limestone)
   if side==1 then
    local board=A.part(group,'ArenaExitPlaque',Vector3.new(12,4,.5),frame*CFrame.new(15,4.8,51),Color3.fromRGB(72,83,78),Enum.Material.Slate)
    local gui=Instance.new('SurfaceGui');gui.Name='ExitGuidance';gui.Face=Enum.NormalId.Front;gui.CanvasSize=Vector2.new(480,160);gui.Parent=board
    local text=Instance.new('TextLabel');text.Size=UDim2.fromScale(1,1);text.BackgroundTransparency=1
    text.Text='LEAVING THE ARENA\nEnds the fight';text.TextColor3=Color3.fromRGB(241,231,206);text.Font=Enum.Font.GothamMedium;text.TextSize=35;text.Parent=gui
   end
  end
  task.wait()
 end
 root:SetAttribute('Revision',2)
end
return B
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">Art</string>
          <string name="Source"><![CDATA[-- Procedural draft models. All scenery is anchored and decorative details do not collide.
local A={}
function A.color(c) return Color3.fromRGB(c[1],c[2],c[3]) end
function A.part(parent,name,size,cf,color,material,shape,collide)
 local p=Instance.new('Part');p.Name=name;p.Size=size;p.CFrame=cf;p.Color=color;p.Material=material or Enum.Material.SmoothPlastic
 p.Anchored=true;p.CanCollide=collide==true;p.CanTouch=false;p.CanQuery=collide==true;p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth
 if shape==Enum.PartType.Ball then
  -- Sphere SpecialMesh honors unequal axes (petals, fins and elongated bodies).
  local mesh=Instance.new('SpecialMesh');mesh.MeshType=Enum.MeshType.Sphere;mesh.Parent=p
 elseif shape then p.Shape=shape end;p.Parent=parent;return p
end
function A.link(parent,name,a,b,width,color,material,collide)
 return A.part(parent,name,Vector3.new(width,width,(b-a).Magnitude),CFrame.lookAt((a+b)/2,b),color,material,nil,collide)
end
function A.label(p,text,offset)
 local b=Instance.new('BillboardGui');b.Name='Label';b.Size=UDim2.fromOffset(230,54);b.StudsOffset=Vector3.new(0,offset or 5,0);b.MaxDistance=115;b.AlwaysOnTop=false;b.Parent=p
 local l=Instance.new('TextLabel');l.Size=UDim2.fromScale(1,1);l.BackgroundTransparency=1;l.Text=text;l.TextColor3=Color3.fromRGB(255,246,220);l.TextStrokeTransparency=.45;l.Font=Enum.Font.GothamBold;l.TextSize=17;l.TextWrapped=true;l.Parent=b
end
function A.creature(parent,s,position,scale,stage)
 local m=Instance.new('Model');m.Name=s.name
 local C=require(game.ReplicatedStorage.MountainShared.Catalog);local k=C.kingdoms[s.kingdom]
 local primary=A.color(k.color);local accent=A.color(k.accent);local dark=primary:Lerp(Color3.new(0,0,0),.35)
 local S=scale*(if s.rarity=='Legendary' then 1 else 1+((stage or 1)-1)*.16);local shape=s.shape
 local function p(n,sz,pos,col,kind,rot)
  return A.part(m,n,sz*S,CFrame.new(position+pos*S)*(rot or CFrame.identity),col,Enum.Material.SmoothPlastic,kind or Enum.PartType.Ball)
 end
 local long=table.find({'fox','otter','dog','cat','deer','rhino','dragon','turtle','whale','serpent','worm'},shape)~=nil
 local floating=table.find({'moth','fish','shard','orb','jelly','ghost','bird','star'},shape)~=nil
 local body=p('Body',Vector3.new(3.2,if floating then 3.2 else 2.5,if long then 4.6 else 3),Vector3.new(0,2.6,0),primary)
 m.PrimaryPart=body
 local head=p('Face',Vector3.new(2.5,2.2,2.5),Vector3.new(0,3.3,if long then -2.1 else -1.3),primary:Lerp(accent,.3))
 for _,sign in ipairs({-1,1}) do
  p('Eye',Vector3.new(.4,.48,.25),Vector3.new(sign*.68,3.6,if long then -3.23 else -2.43),Color3.fromRGB(22,33,52))
  p('EyeLight',Vector3.new(.11,.13,.1),Vector3.new(sign*.68-.06,3.69,if long then -3.36 else -2.56),Color3.new(1,1,1))
 end
 local legs=s.legs or (if floating then 0 elseif shape=='beetle' then 6 elseif shape=='golem' or shape=='sprout' then 2 else 4)
 for i=1,legs do
  local side=if i%2==0 then 1 else -1;local z=(math.ceil(i/2)-(legs/2+1)/2)*1.6
  p('Foot',Vector3.new(.85,1.6,1.25),Vector3.new(side*1.2,1.1,z),dark)
 end
 if shape=='rabbit' or shape=='cat' or shape=='fox' or shape=='dog' or shape=='bear' then
  for _,sign in ipairs({-1,1}) do p('Ear',Vector3.new(.8,if shape=='rabbit' then 2.7 else 1.3,1),Vector3.new(sign*.9,4.7,-1.5),accent,nil,CFrame.Angles(0,0,sign*.18)) end
 end
 if shape=='moth' or shape=='bird' or shape=='dragon' or shape=='fish' or shape=='whale' then
  for _,sign in ipairs({-1,1}) do for wing=1,(if s.id=='pyralune' then 3 else 2) do
   p('Wing',Vector3.new(3,.35,2.3),Vector3.new(sign*2.5,2.8+wing*.35,wing*1.3-2),accent,nil,CFrame.Angles(0,sign*.4,sign*.3))
  end end
 end
 if long then p('Tail',Vector3.new(1.1,1.1,3.8),Vector3.new(0,2.7,3),accent,nil,CFrame.Angles(.35,0,.1)) end
 if shape=='deer' or shape=='rhino' or shape=='hedgehog' or shape=='dragon' or s.rarity=='Legendary' then
  for _,sign in ipairs({-1,1}) do for j=1,3 do
   p('Crest',Vector3.new(.45,1.8+j*.3,.55),Vector3.new(sign*(.4+j*.35),4.2+j*.5,-1.3),accent,Enum.PartType.Block,CFrame.Angles(.2,0,sign*.45))
  end end
 end
 if shape=='turtle' or shape=='beetle' or shape=='rock' then p('Armor',Vector3.new(3.7,1.8,3.8),Vector3.new(0,3.8,.5),accent) end
 if shape=='shard' or shape=='orb' or shape=='jelly' or shape=='star' or shape=='golem' then
  for j=1,(if s.id=='zenthari' then 4 else 6) do local a=j*math.pi/3
   p('Orbit',Vector3.new(.7,1.7,.7),Vector3.new(math.cos(a)*3,3.3+math.sin(a)*2,0),accent,Enum.PartType.Block,CFrame.Angles(0,0,a))
  end
 end
 -- Each species has a different silhouette signature, beyond its biome palette.
 for j=1,(s.variant or 1) do
  local a=j*2.399;p('Signature',Vector3.new(.4,.7+(s.variant or 1)*.12,.4),Vector3.new(math.cos(a)*1.25,4.2,math.sin(a)*1.1),accent,Enum.PartType.Block,CFrame.Angles(0,a,.35))
 end
 if (stage or 1)>=2 and s.rarity~='Legendary' then p('EvolvedMane',Vector3.new(3.2,1.6,2),Vector3.new(0,3.3,-.9),accent) end
 if (stage or 1)>=3 and s.rarity~='Legendary' then
  for _,sign in ipairs({-1,1}) do p('AscendedCrest',Vector3.new(.6,3.6,1),Vector3.new(sign*1.4,5,-.7),accent,Enum.PartType.Block,CFrame.Angles(0,0,sign*.5)) end
 end
 require(script.Parent.CreatureDetails).decorate(A,m,s,position,S)
 m.Parent=parent;return m
end
function A.tree(parent,pos,k,rng)
 local m=Instance.new('Model');m.Name='Grown_'..k.id
 local h=rng:NextNumber(13,23);local brown=Color3.fromRGB(91,72,63)
 local trunk=A.link(m,'Trunk',pos,pos+Vector3.new(1,h,0),2.1,brown,Enum.Material.Wood)
 for j=1,5 do
  local a=j*2.4;local endP=pos+Vector3.new(math.cos(a)*h*.35,h*(.6+j*.065),math.sin(a)*h*.35)
  A.link(m,'Branch',pos+Vector3.new(0,h*.5,0),endP,1,brown,Enum.Material.Wood)
  local leaf=A.part(m,'Canopy',Vector3.new(9,5,8)*rng:NextNumber(.8,1.3),CFrame.new(endP),A.color(if k.id=='blossom' then k.accent else k.color):Lerp(Color3.new(1,1,1),rng:NextNumber(0,.12)),Enum.Material.Grass,Enum.PartType.Ball)
  if k.id=='inferno' then leaf.Transparency=.75;leaf.Size=Vector3.new(2,2,2) end
 end
 m.Parent=parent;return trunk
end
function A.crystal(parent,pos,k,size)
 local m=Instance.new('Model');m.Name='MineralCluster'
 for i=1,4 do
  local p=A.part(m,'Facet',Vector3.new(size*.3,size*(.6+i*.2),size*.35),CFrame.new(pos+Vector3.new((i-2.5)*size*.25,size*.5,0))*CFrame.Angles(0,i,.15*(i-2)),A.color(k.accent),Enum.Material.Glass,nil,false)
  p.Reflectance=.12;p.Transparency=.12
 end
 m.Parent=parent
end
return A
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">ArtClearance</string>
          <string name="Source"><![CDATA[-- Shared conservative clearance for baked art, including moving-platform riders.
local M={}
local function key(x,y,z) return x..':'..y..':'..z end
function M.build(world,feather)
 local grid={};local boxes={};feather=feather or 36
 local function add(lo,hi)
  lo=Vector3.new(math.floor(lo.X/16)*16,math.floor(lo.Y/16)*16,math.floor(lo.Z/16)*16)
  hi=Vector3.new((math.floor(hi.X/16)+1)*16,(math.floor(hi.Y/16)+1)*16,(math.floor(hi.Z/16)+1)*16)
  local box={lo,hi};table.insert(boxes,box)
  for x=math.floor((lo.X-feather)/64),math.floor((hi.X+feather)/64) do for y=math.floor((lo.Y-feather)/64),math.floor((hi.Y+feather)/64) do for z=math.floor((lo.Z-feather)/64),math.floor((hi.Z+feather)/64) do
   local id=key(x,y,z);grid[id]=grid[id] or {};table.insert(grid[id],box)
  end end end
 end
 for _,p in ipairs(world:GetDescendants()) do
  if p:IsA('BasePart') and (p.CanCollide or p:FindFirstChildOfClass('ProximityPrompt')) then
   local e=Vector3.zero
   for _,v in ipairs({p.CFrame.RightVector*p.Size.X/2,p.CFrame.UpVector*p.Size.Y/2,p.CFrame.LookVector*p.Size.Z/2}) do e+=Vector3.new(math.abs(v.X),math.abs(v.Y),math.abs(v.Z)) end
   add(p.Position-e-Vector3.new(16,20,16),p.Position+e+Vector3.new(16,22,16))
   if p:GetAttribute('Kind')=='Moving' then
    local axis=Vector3.new(p:GetAttribute('AxisX'),0,p:GetAttribute('AxisZ'))*34
    local radius=math.sqrt(p.Size.X^2+p.Size.Z^2)/2+16
    local center=p.Position+axis/2;local extent=Vector3.new(math.abs(axis.X)/2+radius,30,math.abs(axis.Z)/2+radius)
    add(center-extent,center+extent)
   end
  end
 end
 local function distance(pos)
  local nearest=feather
  for _,b in ipairs(grid[key(math.floor(pos.X/64),math.floor(pos.Y/64),math.floor(pos.Z/64))] or {}) do
   local lo,hi=b[1],b[2]
   local dx=math.max(lo.X-pos.X,0,pos.X-hi.X);local dy=math.max(lo.Y-pos.Y,0,pos.Y-hi.Y);local dz=math.max(lo.Z-pos.Z,0,pos.Z-hi.Z)
   local d=math.sqrt(dx*dx+dy*dy+dz*dz);nearest=math.min(nearest,d)
   if nearest==0 then return 0 end
  end
  return nearest
 end
 return {boxes=boxes,distance=distance,weight=function(pos) local v=distance(pos)/feather;return v*v*(3-2*v) end}
end
return M
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">BlossomCanopies</string>
          <string name="Source"><![CDATA[-- Optional baked replacement for the rounded draft crowns, using reviewed mesh assets.
local C=require(game.ReplicatedStorage.MountainShared.Catalog)
local B={}
function B.apply(world)
 assert(not game:GetService('RunService'):IsRunning() and game.PlaceId==0,'Local Edit only')
 assert(not world:FindFirstChild('BlossomCanopies'),'Already built')
 local template=game.ServerStorage.MountainArtAssets:FindFirstChild('BlossomCanopyTemplate')
 assert(template and template:IsA('Model'),'Reviewed canopy template required')
 local sources={}
 for _,p in ipairs(template:GetDescendants()) do if p:IsA('MeshPart') and p.Name=='crown_geom' then table.insert(sources,p) end end
 assert(#sources>0,'No canopy meshes')
 local sourceBox=sources[1].CFrame
 local root=Instance.new('Folder');root.Name='BlossomCanopies';root.Parent=world
 local archive=Instance.new('Folder');archive.Name='RoundedGardenCrownsPrior';archive.Parent=game.ServerStorage
 local q=C.route(1,.875);local center=world['Blossom Gardens'].ArenaFloor.Position+Vector3.new(0,2.5,0)
 local frame=CFrame.lookAt(center,center-Vector3.new(math.cos(q.angle),0,math.sin(q.angle)))
 for _,tree in ipairs(world.HeroGarden:GetChildren()) do
  for _,p in ipairs(tree:GetChildren()) do
   if p.Name=='BlossomCluster' or p.Name=='LeafCluster' then p.Parent=archive end
  end
 end
 for _,side in ipairs({-1,1}) do
  for ci,offset in ipairs({Vector3.new(-7,27,-1),Vector3.new(6,30,3),Vector3.new(0,32,-6)}) do
  for spray=0,5 do
  local a=spray*2.399+ci
  local drift=if spray==0 then Vector3.zero else Vector3.new(math.cos(a)*4,math.sin(a*1.3)*2,math.sin(a)*4)
  local target=frame*CFrame.new(Vector3.new(side*30,0,58)+offset+drift)*CFrame.Angles(.3*math.sin(a),a,side*.2)
  local scale=if side==1 then .72 else .66
  for _,source in ipairs(sources) do
   local p=source:Clone();p.Name='BlossomCrownMesh'
   local offset=sourceBox:ToObjectSpace(source.CFrame)
   p.Size*=scale;p.CFrame=target*CFrame.new(offset.Position*scale)*offset.Rotation
   p.Anchored=true;p.CanCollide=false;p.CanQuery=false;p.CanTouch=false;p.Parent=root
  end
  end
  end
 end
 root:SetAttribute('Revision',1)
 return #root:GetChildren()
end
return B
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">CliffComposition</string>
          <string name="Source"><![CDATA[-- Baked, terrain-rooted visual composition. No terrain or gameplay mutations.
local C=require(game.ReplicatedStorage.MountainShared.Catalog)
local A=require(script.Parent.Art)
local M={}
local function extent(cf,size)
 local e=Vector3.zero
 for _,v in ipairs({cf.RightVector*size.X/2,cf.UpVector*size.Y/2,cf.LookVector*size.Z/2}) do e+=Vector3.new(math.abs(v.X),math.abs(v.Y),math.abs(v.Z)) end
 return e
end
function M.apply(world)
 assert(game.PlaceId==0 and not game:GetService('RunService'):IsRunning(),'Local Edit only')
 assert(world.Name=='ImpossibleMountain' and not world:FindFirstChild('CliffComposition'),'Wrong world or already applied')
 local template=assert(game.ServerStorage.MountainArtAssets:FindFirstChild('WaterfallCliff'))
 local protected={}
 for _,p in ipairs(world:GetDescendants()) do
  if p:IsA('BasePart') and (p.CanCollide or p:FindFirstChildOfClass('ProximityPrompt')) then
   table.insert(protected,{p.Position,extent(p.CFrame,p.Size)})
  end
 end
 local function clear(cf,size)
  local e=extent(cf,size)
  for _,b in ipairs(protected) do
   local d=cf.Position-b[1];local q=b[2]
   if math.abs(d.X)<e.X+q.X+7 and math.abs(d.Z)<e.Z+q.Z+7 and d.Y+e.Y> -q.Y-2 and d.Y-e.Y<q.Y+14 then return false end
  end
  return true
 end
 local root=Instance.new('Folder');root.Name='CliffComposition';root.Parent=world
 local terrain=RaycastParams.new();terrain.FilterType=Enum.RaycastFilterType.Include;terrain.FilterDescendantsInstances={workspace.Terrain}
 local rng=Random.new(241020);local stats={rocks=0,rejected=0,plants=0}
 local function rock(cf,size,color,parent)
  if not clear(cf,size) then stats.rejected+=1;return end
  local model=Instance.new('Model');model.Name='RootedCliff'
  local function triangle(a,b,c,tint)
   local ab,ac,bc=b-a,c-a,c-b
   if ab:Dot(ab)>ac:Dot(ac) and ab:Dot(ab)>bc:Dot(bc) then c,a=a,c
   elseif ac:Dot(ac)>bc:Dot(bc) then a,b=b,a end
   ab,ac,bc=b-a,c-a,c-b
   local right=ac:Cross(ab).Unit;local back=bc.Unit;local up=back:Cross(right)
   local h=math.abs(ab:Dot(up))
   for _,s in ipairs({{(a+b)/2,right,up,back,math.abs(ab:Dot(back))},{(a+c)/2,-right,up,-back,math.abs(ac:Dot(back))}}) do
    local p=Instance.new('WedgePart');p.Name='StoneFace';p.Size=Vector3.new(.05,h,s[5]);p.CFrame=CFrame.fromMatrix(s[1],s[2],s[3],s[4]);p.Color=tint;p.Material=Enum.Material.Rock
    p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Parent=model
   end
  end
  local lower,upper={},{}
  for i=1,6 do
   local a=(i-1)*math.pi/3;local r=.43+.05*math.sin(i*2.4)
   lower[i]=cf:PointToWorldSpace(Vector3.new(math.cos(a)*size.X*r,-size.Y*.5,math.sin(a)*size.Z*r))
   upper[i]=cf:PointToWorldSpace(Vector3.new(math.cos(a)*size.X*r*.72+size.X*.08,size.Y*(.29+.10*math.sin(i*1.7)),math.sin(a)*size.Z*r*.72))
  end
  local tip=cf:PointToWorldSpace(Vector3.new(size.X*.06,size.Y*.46,0));local base=cf:PointToWorldSpace(Vector3.new(0,-size.Y*.5,0))
  for i=1,6 do
   local n=i%6+1;local tint=color:Lerp(Color3.fromRGB(206,207,195),.025*(i%3))
   triangle(lower[i],lower[n],upper[i],tint);triangle(lower[n],upper[n],upper[i],tint)
   triangle(upper[i],upper[n],tip,tint);triangle(lower[n],lower[i],base,tint)
  end
  model.Parent=parent
  stats.rocks+=1
 end
 -- Staggered, unequal outcrops interrupt long horizontal faces. Every mass
 -- embeds its rear half into a measured terrain face; no floating fins.
 for band=1,6 do
  local group=Instance.new('Folder');group.Name=C.kingdoms[band].id;group.Parent=root
  for j=1,22 do
   local angle=j*math.pi*2/22+.17*band+.09*math.sin(j*2.1)
   local out=Vector3.new(math.cos(angle),0,math.sin(angle))
   local y=28+(band-1)*136+rng:NextNumber(8,100)
   local hit=workspace:Raycast(out*780+Vector3.new(0,y,0),-out*760,terrain)
   if hit then
    local h=rng:NextNumber(34,88);local width=rng:NextNumber(24,55);local depth=rng:NextNumber(22,42)
    local pos=hit.Position-out*depth*.36-Vector3.new(0,h*.12,0)
    local cf=CFrame.lookAt(pos,pos-out)*CFrame.Angles(0,rng:NextNumber(-.25,.25),rng:NextNumber(-.13,.13))
    local color=workspace.Terrain:GetMaterialColor(hit.Material):Lerp(Color3.fromRGB(177,181,172),.22)
    rock(cf,Vector3.new(width,h,depth),color,group)
   end
  end
  task.wait()
 end
 -- Underhang clusters break the polygonal shelf fascia without creating
 -- apparent footing beyond the deliberately marked, colliding top surface.
 for ki,k in ipairs(C.kingdoms) do
  local group=root[k.id];local q=C.route(ki,.875)
  local out=Vector3.new(math.cos(q.angle),0,math.sin(q.angle))
  local center=world[k.name].ArenaFloor.Position+Vector3.new(0,2.5,0)
  local frame=CFrame.lookAt(center,center-out)
  for j=1,9 do
   local a=(j-1)*math.pi/8;local x=math.cos(a)*39;local z=48+math.sin(a)*34
   rock(frame*CFrame.new(x,-18-rng:NextNumber(0,7),z)*CFrame.Angles(0,a,.06),Vector3.new(19+rng:NextNumber(0,8),25+rng:NextNumber(0,12),22),A.color(k.rock):Lerp(Color3.fromRGB(185,186,175),.3),group)
  end
  task.wait()
 end
 root:SetAttribute('Revision',1);root:SetAttribute('Report',game.HttpService:JSONEncode(stats))
 return stats
end
return M
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">CreatureDetails</string>
          <string name="Source"><![CDATA[-- Authored silhouette layers. Dimensions are in unscaled creature space.
local D={}
function D.decorate(A,m,s,origin,S)
 local k=require(game.ReplicatedStorage.MountainShared.Catalog).kingdoms[s.kingdom]
 local base=A.color(k.color);local accent=A.color(k.accent)
 local ivory=Color3.fromRGB(250,235,207);local ink=Color3.fromRGB(31,38,64)
 local function part(name,size,pos,color,rotation,shape,role,pivot,phase)
  local p=A.part(m,name,size*S,CFrame.new(origin+pos*S)*(rotation or CFrame.identity),color,Enum.Material.SmoothPlastic,shape or Enum.PartType.Ball)
  if role then p:SetAttribute('MotionRole',role);p:SetAttribute('MotionPivot',m.PrimaryPart.CFrame:PointToObjectSpace(origin+(pivot or pos)*S));p:SetAttribute('MotionPhase',phase or 0) end
  return p
 end
 local function petal(name,pos,size,color,tilt,role,pivot,phase)
  return part(name,size,pos,color,CFrame.Angles(tilt.X,tilt.Y,tilt.Z),nil,role,pivot,phase)
 end
 local long=table.find({'fox','otter','dog','cat','deer','rhino','dragon','turtle','whale','serpent','worm'},s.shape)~=nil
 local faceZ=if long then -2.1 else -1.3
 if s.rarity=='Legendary' then
  for _,p in ipairs(m:GetChildren()) do if p.Name=='Crest' or p.Name=='Signature' then p:Destroy() end end
 end
 -- Overlapping cheek/muzzle volumes and brows give the face a readable expression.
 part('Muzzle',Vector3.new(1.55,.85,.8),Vector3.new(0,2.95,faceZ-1),ivory)
 part('Nose',Vector3.new(.42,.28,.27),Vector3.new(0,3.19,faceZ-1.43),ink)
 for _,side in ipairs({-1,1}) do
  part('Cheek',Vector3.new(.65,.42,.25),Vector3.new(side*.91,3.22,faceZ-1.08),accent)
  petal('Brow',Vector3.new(side*.68,3.94,faceZ-1.11),Vector3.new(.7,.16,.23),base:Lerp(ink,.35),Vector3.new(0,0,side*-.12))
 end
 local footIndex=0
 for _,p in ipairs(m:GetChildren()) do
  if p:IsA('BasePart') then
   if p.Name=='Foot' then
    footIndex+=1;local offset=(p.Position-origin)/S
    part('Haunch',Vector3.new(1.1,2.1,1.25),Vector3.new(offset.X,1.4,offset.Z),base)
    p.Size=Vector3.new(.95,.8,1.5)*S;p.CFrame=CFrame.new(origin+Vector3.new(offset.X,.4,offset.Z-.12)*S)
    p:SetAttribute('MotionRole','Foot');p:SetAttribute('MotionPivot',m.PrimaryPart.CFrame:PointToObjectSpace(origin+Vector3.new(offset.X,1.8,offset.Z)*S));p:SetAttribute('MotionPhase',footIndex*math.pi)
   elseif p.Name=='Wing' then
    local side=if p.Position.X>origin.X then 1 else -1
    p:SetAttribute('MotionRole','Wing');p:SetAttribute('MotionPivot',m.PrimaryPart.CFrame:PointToObjectSpace(origin+Vector3.new(side*1.2,3,0)*S));p:SetAttribute('MotionPhase',side)
   elseif p.Name=='Tail' or p.Name=='Ear' then
    p:SetAttribute('MotionRole',p.Name);p:SetAttribute('MotionPivot',m.PrimaryPart.CFrame:PointToObjectSpace(p.Position));p:SetAttribute('MotionPhase',p.Position.X-origin.X)
   end
  end
 end
 if s.id=='floravelle' or s.id=='caeloryn' then
  local cosmic=s.id=='caeloryn'
  -- Petals/locks follow the neck, with a narrow inner ruff and long outer layers.
  for layer=1,2 do for j=1,11 do
   local a=j*math.pi*2/11;local r=1.25+layer*.35
   local col=if cosmic then Color3.fromRGB(46+layer*12,57+layer*10,116+layer*16) else accent:Lerp(ivory,(j%3)*.18)
   petal(if cosmic then 'CelestialMane' else 'SovereignPetal',Vector3.new(math.cos(a)*r,3.15+math.sin(a)*r,faceZ+.7+layer*.4),Vector3.new(.85,2+layer*.7,.32),col,Vector3.new(.2,0,a-math.pi/2),'Mane',Vector3.new(0,3.15,faceZ+.6),a)
  end end
  for _,side in ipairs({-1,1}) do
   local previous=Vector3.new(side*.7,4.1,faceZ)
   for j=1,4 do
    local tip=Vector3.new(side*(.7+j*.52),4.1+j*.85,faceZ+j*.15)
    A.link(m,'AntlerStem',origin+previous*S,origin+tip*S,(.36-j*.055)*S,if cosmic then accent else ivory)
    local tine=tip+Vector3.new(side*.25,.75,-.55)
    A.link(m,'AntlerTine',origin+tip*S,origin+tine*S,.14*S,if cosmic then ivory else accent)
    if cosmic then part('SuspendedStar',Vector3.new(.22,.22,.22),tip+Vector3.new(side*.5,-.35,-.3),ivory,nil,Enum.PartType.Ball,'Orbit',Vector3.new(0,4,faceZ),j) end
    previous=tip
   end
  end
 elseif s.id=='aquarune' then
  for _,side in ipairs({-1,1}) do for j=1,5 do
   local fin=petal('TidalFin',Vector3.new(side*(1.4+j*.2),2.9,1+j*.35),Vector3.new(.35,1.3+j*.3,2),accent:Lerp(ivory,j*.06),Vector3.new(.35,side*.35,side*.7),'Fin',Vector3.new(side*1.4,2.7,1),side+j*.2)
   fin.Transparency=.22
  end end
  for j=1,5 do petal('SapphireCrest',Vector3.new(0,4.2+j*.12,faceZ+(j-1)*.6),Vector3.new(.5,1.8-j*.2,.85),Color3.fromRGB(49,103,194),Vector3.new(.25,0,0)) end
 elseif s.id=='zenthari' then
  m.Body.Size=Vector3.new(3.8,3.4,3)*S
  for _,p in ipairs(m:GetChildren()) do if p.Name=='Orbit' or p.Name=='Crest' then p:Destroy() end end
  for _,side in ipairs({-1,1}) do for row=1,2 do
   local pos=Vector3.new(side*(2.4+row*.25),4.9-row*2,0)
   part('FloatingFist',Vector3.new(1.65,1.6,1.65),pos,accent,CFrame.Angles(.1,side*.25,side*.18),Enum.PartType.Block,'Fist',pos,side+row)
   for knuckle=1,3 do part('GoldenKnuckle',Vector3.new(.35,.5,.4),pos+Vector3.new((knuckle-2)*.45,.1,-.8),ivory,nil,nil,'Fist',pos,side+row) end
  end end
  for j=1,9 do local a=j*math.pi/5
   petal('SunstoneCrown',Vector3.new(math.cos(a)*1.25,5+math.sin(a)*.3,-1.2),Vector3.new(.38,1.5+j%2*.6,.4),accent,Vector3.new(0,a,math.cos(a)*-.3))
  end
 elseif s.id=='veylith' then
  m.Body.Size=Vector3.new(2.5,4.1,2.5)*S
  for _,p in ipairs(m:GetChildren()) do if p.Name=='Orbit' or p.Name=='Crest' then p:Destroy() end end
  part('CrystalCrown',Vector3.new(1.6,2.8,1.6),Vector3.new(0,5,0),accent,CFrame.Angles(0,math.pi/4,0),Enum.PartType.Block)
  for j=1,6 do local a=j*math.pi/3;local pos=Vector3.new(math.cos(a)*3.2,3.3+math.sin(a)*2.7,.5)
   part('AmethystSatellite',Vector3.new(.6,1.9,.7),pos,accent:Lerp(ivory,j%2*.2),CFrame.Angles(0,.6,a*.25),Enum.PartType.Block,'Orbit',Vector3.new(0,3.3,.5),a)
  end
 elseif s.id=='pyralune' then
  m.Body.Color=Color3.fromRGB(177,65,45);m.Face.Color=Color3.fromRGB(234,116,55)
  part('EmberHeart',Vector3.new(.9,1.1,.35),Vector3.new(0,2.3,-1.5),Color3.fromRGB(255,224,130))
  for _,side in ipairs({-1,1}) do for wing=1,3 do for feather=1,3 do
   petal('FlameFeather',Vector3.new(side*(2+feather*.5),2.5+wing*.4,(wing-2)*1.3),Vector3.new(1.6,.28,.7),accent:Lerp(ivory,feather*.12),Vector3.new(0,side*.4,side*.35),'Wing',Vector3.new(side*1.2,3,0),side)
  end end end
  for j=1,7 do petal('LivingFireCrown',Vector3.new((j-4)*.38,4.7+math.sin(j)*.2,-1),Vector3.new(.4,1.2+j%3*.3,.5),accent,Vector3.new(.2,0,(j-4)*-.14),'Mane',Vector3.new(0,4,-1),j) end
 else
  -- Species families keep their own body plans; named features add more than color.
  if s.shape=='deer' then
   for _,side in ipairs({-1,1}) do for j=1,3 do
    petal('AntlerLeaf',Vector3.new(side*(.8+j*.35),4.6+j*.4,-1.3),Vector3.new(.35,1.1,.65),accent,Vector3.new(0,side*.5,side*.6))
   end end
  elseif s.shape=='rabbit' then
   for _,side in ipairs({-1,1}) do petal('InnerEar',Vector3.new(side*.9,4.8,-2),Vector3.new(.4,1.85,.18),ivory,Vector3.new(0,0,side*.18),'Ear',Vector3.new(side*.9,4.1,-1.5),side) end
  elseif s.shape=='fox' or s.shape=='cat' or s.shape=='dog' then
   for _,side in ipairs({-1,1}) do for j=1,3 do petal('CheekTuft',Vector3.new(side*(1+j*.13),3.2-j*.18,faceZ),Vector3.new(.8,.3,.7),ivory,Vector3.new(0,side*.4,side*.3)) end end
  elseif s.shape=='turtle' or s.shape=='beetle' then
   for j=1,5 do part('ShellPlate',Vector3.new(.8,.4,1.2),Vector3.new((j%3-1)*.95,4.5,math.floor(j/3)*1.3-.6),base:Lerp(ivory,.3)) end
  end
 end
 -- Capture immutable rest transforms after geometry is complete. Root is never animated locally.
 for _,p in ipairs(m:GetChildren()) do if p:IsA('BasePart') and p~=m.PrimaryPart then p:SetAttribute('RestLocal',m.PrimaryPart.CFrame:ToObjectSpace(p.CFrame)) end end
 m:SetAttribute('ArtRevision',2);m:SetAttribute('Species',s.id);m:SetAttribute('CreatureScale',S)
end
return D
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">CrystalFinish</string>
          <string name="Source"><![CDATA[-- Replace decorative rectangular mineral placeholders with closed pointed prisms.
local F={}
local function triangle(parent,a,b,c,color)
 local ab,ac,bc=b-a,c-a,c-b
 if ab:Dot(ab)>ac:Dot(ac) and ab:Dot(ab)>bc:Dot(bc) then c,a=a,c elseif ac:Dot(ac)>bc:Dot(bc) then a,b=b,a end
 ab,ac,bc=b-a,c-a,c-b
 local right=ac:Cross(ab).Unit;local back=bc.Unit;local up=back:Cross(right);local h=math.abs(ab:Dot(up))
 for _,v in ipairs({{(a+b)/2,right,up,back,math.abs(ab:Dot(back))},{(a+c)/2,-right,up,-back,math.abs(ac:Dot(back))}}) do
  local p=Instance.new('WedgePart');p.Name='MineralFace';p.Size=Vector3.new(.035,h,v[5]);p.CFrame=CFrame.fromMatrix(v[1],v[2],v[3],v[4]);p.Color=color;p.Material=Enum.Material.Slate;p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Parent=parent
 end
end
function F.apply(world)
 assert(game.PlaceId==0 and not game:GetService('RunService'):IsRunning(),'Local Edit only')
 assert(not world:GetAttribute('CrystalFinishRevision'),'Already applied')
 local archive=Instance.new('Folder');archive.Name='CrystalRectanglesPrior';archive.Parent=game.ServerStorage
 local parts={};for _,p in ipairs(world.EnvironmentComposition:GetDescendants()) do if p:IsA('BasePart') and p.Name=='Facet' and p.Parent.Name=='MineralCluster' and not p.CanCollide then table.insert(parts,p) end end
 for index,p in ipairs(parts) do
  local cf,size,color=p.CFrame,p.Size,p.Color:Lerp(Color3.fromRGB(165,171,191),.25)
  local model=Instance.new('Model');model.Name='PointedCrystal';model:SetAttribute('SourceCFrame',cf);model:SetAttribute('SourceSize',size)
  local low,high={},{}
  for i=1,5 do local a=(i-1)*math.pi*2/5
   low[i]=cf:PointToWorldSpace(Vector3.new(math.cos(a)*size.X*.5,-size.Y*.5,math.sin(a)*size.Z*.5))
   high[i]=cf:PointToWorldSpace(Vector3.new(math.cos(a)*size.X*.5,size.Y*(.24+.04*math.sin(i)),math.sin(a)*size.Z*.5))
  end
  local tip=cf:PointToWorldSpace(Vector3.new(size.X*.12,size.Y*.5,size.Z*-.08))
  local base=cf:PointToWorldSpace(Vector3.new(0,-size.Y*.5,0))
  for i=1,5 do local n=i%5+1;local tint=color:Lerp(Color3.fromRGB(235,237,245),.04*(i%3))
   triangle(model,low[i],low[n],high[i],tint);triangle(model,low[n],high[n],high[i],tint);triangle(model,high[i],high[n],tip,tint);triangle(model,low[n],low[i],base,tint)
  end
  model.Parent=p.Parent;p.Parent=archive
  if index%12==0 then task.wait() end
 end
 world:SetAttribute('CrystalFinishRevision',1);return {crystals=#parts}
end
return F
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="45">
        <Properties>
          <string name="Name">Environment</string>
          <string name="Source"><![CDATA[-- Deterministic art shell. Never writes terrain or changes a gameplay surface.
local A=require(script.Parent.Art)
local C=require(game.ReplicatedStorage.MountainShared.Catalog)
local E={}
local function folder(parent,name)
 local f=Instance.new('Folder');f.Name=name;f.Parent=parent;return f
end
local function wedge(parent,name,size,cf,color,material)
 local p=Instance.new('WedgePart');p.Name=name;p.Size=size;p.CFrame=cf;p.Color=color;p.Material=material or Enum.Material.Rock
 p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Parent=parent;return p
end
local function arc(parent,name,center,radius,start,finish,color,width,tilt)
 local previous
 for j=0,20 do
  local a=start+(finish-start)*j/20
  local pos=center+Vector3.new(math.cos(a)*radius,math.sin(a)*radius,math.sin(a)*(tilt or 0))
  if previous then A.link(parent,name,previous,pos,width,color,Enum.Material.Marble) end
  previous=pos
 end
end
local function spire(parent,center,width,height,depth,color,material,angle)
 local function triangle(a,b,c,tint)
  local ab,ac,bc=b-a,c-a,c-b
  if ab:Dot(ab)>ac:Dot(ac) and ab:Dot(ab)>bc:Dot(bc) then c,a=a,c
  elseif ac:Dot(ac)>bc:Dot(bc) then a,b=b,a end
  ab,ac,bc=b-a,c-a,c-b
  local right=ac:Cross(ab).Unit;local back=bc.Unit;local up=back:Cross(right)
  local h=math.abs(ab:Dot(up))
  wedge(parent,'SculptedFace',Vector3.new(.08,h,math.abs(ab:Dot(back))),CFrame.fromMatrix((a+b)/2,right,up,back),tint,material)
  wedge(parent,'SculptedFace',Vector3.new(.08,h,math.abs(ac:Dot(back))),CFrame.fromMatrix((a+c)/2,-right,up,-back),tint,material)
 end
 local tip=center+Vector3.new(width*.15,height/2,-depth*.12)
 for face=0,4 do
  local a=angle+face*math.pi*2/5;local b=angle+(face+1)*math.pi*2/5
  local p=center+Vector3.new(math.cos(a)*width,-height/2,math.sin(a)*depth*.6)
  local q=center+Vector3.new(math.cos(b)*width,-height/2,math.sin(b)*depth*.6)
  triangle(tip,p,q,color:Lerp(Color3.fromRGB(223,225,218),face*.035))
 end
end
function E.orient(world)
 assert(not game:GetService('RunService'):IsRunning(),'Orient in Edit only')
 assert(world.Name=='ImpossibleMountain' and not workspace:FindFirstChild('MountainEmpire_Phase1'),'Isolated mountain only')
 local root=world:FindFirstChild('EnvironmentComposition')
 if not root then return end
 for ki,k in ipairs(C.kingdoms) do
  local group=root:FindFirstChild(k.id)
  if group and not group:GetAttribute('OutwardBackdrop') then
   local center=world[k.name].ArenaFloor.Position+Vector3.new(0,2.5,0)
   local q=C.route(ki,.875)
   local outward=Vector3.new(math.cos(q.angle),0,math.sin(q.angle))
   -- Keep the whole backdrop beyond the 41-stud arena, not through its combat lanes.
   local orient=CFrame.lookAt(center,center-outward)*CFrame.new(0,0,24)*CFrame.new(-center)
   for _,p in ipairs(group:GetDescendants()) do
    if p:IsA('BasePart') and p.Name~='BiomeInterleave' then p.CFrame=orient*p.CFrame end
   end
   group:SetAttribute('OutwardBackdrop',true)
   -- Non-colliding rooted rock shoulders connect the displaced scenery to the arena mass.
   local rock=A.color(k.rock)
   A.part(group,'BackdropFoundation',Vector3.new(76,32,62),CFrame.lookAt(center+outward*48-Vector3.new(0,16,0),center+outward*47-Vector3.new(0,16,0)),rock,Enum.Material[k.material],Enum.PartType.Ball)
   A.part(group,'BackdropRoot',Vector3.new(66,42,56),CFrame.lookAt(center+outward*30-Vector3.new(0,36,0),center+outward*29-Vector3.new(0,36,0)),rock,Enum.Material[k.material],Enum.PartType.Ball)
  end
 end
 root:SetAttribute('Revision',2)
end
function E.apply(world)
 assert(not game:GetService('RunService'):IsRunning(),'Build in Edit only')
 assert(world.Name=='ImpossibleMountain' and not workspace:FindFirstChild('MountainEmpire_Phase1'),'Isolated mountain only')
 if world:FindFirstChild('EnvironmentComposition') then E.orient(world);return 'already built; orientation current' end
 local root=folder(world,'EnvironmentComposition')
 local protected={}
 for _,p in ipairs(world:GetDescendants()) do
  if p:IsA('BasePart') and (p.CanCollide or p:FindFirstChildOfClass('ProximityPrompt')) then table.insert(protected,p) end
 end
 -- Conservative world-space AABB exclusion: preserves full height above paths,
 -- not merely collisions. This also protects branches, ladders and reward docks.
 local function clear(cf,size)
  local ext=Vector3.zero
  for _,axis in ipairs({cf.RightVector*size.X/2,cf.UpVector*size.Y/2,cf.LookVector*size.Z/2}) do ext+=Vector3.new(math.abs(axis.X),math.abs(axis.Y),math.abs(axis.Z)) end
  for _,p in ipairs(protected) do
   local d=cf.Position-p.Position;local ps=p.Size/2
   local pe=Vector3.zero
   for _,a in ipairs({p.CFrame.RightVector*ps.X,p.CFrame.UpVector*ps.Y,p.CFrame.LookVector*ps.Z}) do pe+=Vector3.new(math.abs(a.X),math.abs(a.Y),math.abs(a.Z)) end
   if math.abs(d.X)<ext.X+pe.X+5 and math.abs(d.Z)<ext.Z+pe.Z+5 and d.Y+ext.Y> -pe.Y-2 and d.Y-ext.Y<pe.Y+12 then return false end
  end
  return true
 end
 -- Side-fin experiments were visually rejected; retained only in dated checkpoints.
 -- Unequal crown peaks, grounded in the existing summit rather than floating.
 local crown=folder(root,'SplitCrown')
 for i,spec in ipairs({{-72,-22,105,34,65},{35,-75,137,32,60},{81,-28,83,28,60}}) do
  local x,z,height,width,depth=table.unpack(spec)
  local cf=CFrame.new(x,840+height/2,z)*CFrame.Angles(0,i*.9,0)
  local size=Vector3.new(width,height,depth)
  if clear(CFrame.new(cf.Position),Vector3.new(width*2,height,depth*1.2)) then
   spire(crown,cf.Position,width,height,depth,Color3.fromRGB(198,211,226),Enum.Material.Slate,i*.9)
   spire(crown,cf.Position+Vector3.new(0,height*.08,0),width*.65,height*.84,depth*.65,Color3.fromRGB(230,237,243),Enum.Material.Snow,i*.9)
  end
 end
 for ki,k in ipairs(C.kingdoms) do
  local region=world[k.name];local group=folder(root,k.id)
  local center=region.ArenaFloor.Position+Vector3.new(0,2.5,0)
  local stone=A.color(k.rock);local accent=A.color(k.accent)
  local function part(name,size,offset,color,material,shape,rot)
   return A.part(group,name,size,CFrame.new(center+offset)*(rot or CFrame.identity),color or stone,material or Enum.Material.Rock,shape)
  end
  -- Backdrops sit beyond the arena's play space. Original checkpoints retain old art.
  local old=region:FindFirstChild(k.landmarks[1]..'_Signature')
  if old then
   local archive=game.ServerStorage:FindFirstChild('EnvironmentPriorLandmarks') or folder(game.ServerStorage,'EnvironmentPriorLandmarks')
   old.Parent=archive
  end
  if ki==1 then
   for _,side in ipairs({-1,1}) do
    local base=center+Vector3.new(side*31,0,32)
    for j=1,7 do
     local next=base+Vector3.new(-side*(2+j*.25),6,1.2)
     local limb=A.link(group,'LivingGardenArch',base,next,6-j*.55,Color3.fromRGB(105,91,75),Enum.Material.Wood)
     limb.Size=Vector3.new((next-base).Magnitude,6-j*.55,6-j*.55);limb.CFrame*=CFrame.Angles(0,math.pi/2,0);limb.Shape=Enum.PartType.Cylinder;base=next
     if j>3 then
      for b=1,3 do A.part(group,'BlossomCanopy',Vector3.new(19-b,8,14),CFrame.new(base+Vector3.new(side*b*3,2,math.sin(b+j)*5)),accent:Lerp(Color3.fromRGB(255,226,230),b*.18),Enum.Material.Grass,Enum.PartType.Ball) end
     end
    end
   end
   for j=1,9 do local a=j*math.pi/10
    local o=Vector3.new(math.cos(a)*36,0,22+math.sin(a)*18)
    for tier=1,3 do part('GardenMasonry',Vector3.new(7,1.3,5),o+Vector3.new(0,tier*1.3,0),stone:Lerp(Color3.fromRGB(197,198,160),.5),Enum.Material.Limestone) end
   end
  elseif ki==2 then
   for j=1,7 do
    local h=32+18*math.sin(j*.7)^2;local x=(j-4)*10
    wedge(group,'WaterSculptedFin',Vector3.new(14,h+13,20),CFrame.new(center+Vector3.new(x,h/2,43))*CFrame.Angles(0,.14*j,0),stone,Enum.Material.Slate)
    local water=part('SilverCascade',Vector3.new(5.5,h,1.2),Vector3.new(x,h/2,31),accent:Lerp(Color3.new(1,1,1),.18),Enum.Material.SmoothPlastic);water.Transparency=.2
    for rib=1,3 do part('FallFoam',Vector3.new(.2,h,.2),Vector3.new(x-2+rib, h/2,30.2),Color3.fromRGB(218,245,247),Enum.Material.SmoothPlastic).Transparency=.4 end
    part('SplashBasin',Vector3.new(13,.7,12),Vector3.new(x,1,29),accent,Enum.Material.SmoothPlastic,Enum.PartType.Ball)
   end
  elseif ki==3 then
   for _,side in ipairs({-1,1}) do
    part('SolarPylonFoot',Vector3.new(12,3,12),Vector3.new(side*27,1.5,35),stone,Enum.Material.Sandstone)
    wedge(group,'SolarPylon',Vector3.new(9,39,10),CFrame.new(center+Vector3.new(side*27,21,35))*CFrame.Angles(0,side*math.pi/2,0),Color3.fromRGB(218,177,116),Enum.Material.Sandstone)
    for y=1,5 do part('PylonCarving',Vector3.new(5,.7,.4),Vector3.new(side*27,7+y*5,29.7),accent,Enum.Material.Metal) end
   end
   arc(group,'DawnArch',center+Vector3.new(0,12,37),23,0,math.pi,Color3.fromRGB(226,193,141),4)
   arc(group,'SolarDisc',center+Vector3.new(0,30,39),10,0,math.pi*2,accent,1)
   for j=1,12 do local a=j*math.pi/6;local p=center+Vector3.new(math.cos(a)*13,30+math.sin(a)*13,39)
    A.link(group,'Sunray',p,p+Vector3.new(math.cos(a)*4,math.sin(a)*4,0),.8,accent,Enum.Material.Metal)
   end
  elseif ki==4 then
   arc(group,'FracturedObservatory',center+Vector3.new(0,22,37),27,.15,math.pi*.85,stone:Lerp(Color3.new(1,1,1),.3),3)
   arc(group,'BrokenOrbit',center+Vector3.new(0,23,40),20,math.pi*.9,math.pi*1.85,accent,1,9)
   for j=1,7 do A.crystal(group,center+Vector3.new((j-4)*10,0,35+math.abs(j-4)*2),k,12+j%3*7) end
   for _,s in ipairs({-1,1}) do part('MirrorWing',Vector3.new(9,23,1),Vector3.new(s*12,18,35),Color3.fromRGB(168,184,218),Enum.Material.Glass,nil,CFrame.Angles(0,s*.3,s*.2)).Reflectance=.35 end
  elseif ki==5 then
   for j=1,7 do
    local h=24+(j%3)*9;local x=(j-4)*10
    wedge(group,'CrucibleRib',Vector3.new(12,h,15),CFrame.new(center+Vector3.new(x,h/2,37))*CFrame.Angles(0,j*.16,0),stone,Enum.Material.Basalt)
    part('CoolingSeam',Vector3.new(.6,h*.65,.5),Vector3.new(x,h*.4,28),accent:Lerp(Color3.fromRGB(153,53,27),.3),Enum.Material.Neon)
   end
   arc(group,'ForgeLintel',center+Vector3.new(0,9,35),24,.1,math.pi-.1,Color3.fromRGB(88,65,63),5)
  else
   for _,s in ipairs({-1,1}) do
    part('SanctumPier',Vector3.new(6,37,7),Vector3.new(s*28,18.5,34),Color3.fromRGB(215,224,236),Enum.Material.Marble)
    for y=1,4 do part('SilverCollar',Vector3.new(7,.7,8),Vector3.new(s*28,y*8,34),accent,Enum.Material.Metal) end
   end
   arc(group,'SanctumCrown',center+Vector3.new(0,30,35),28,0,math.pi,Color3.fromRGB(229,235,244),3)
   arc(group,'CelestialMeridian',center+Vector3.new(0,38,35),18,0,math.pi*2,accent,.75,12)
   for j=1,5 do A.crystal(group,center+Vector3.new((j-3)*10,37+18-math.abs(j-3)*4,35),k,5) end
  end
  -- Material overlap at the next kingdom: a diagonal seam of small mineral/plant beds.
  if ki<6 then for j=1,12 do
   local q=C.route(ki,.78+j*.017);local out=Vector3.new(math.cos(q.angle),0,math.sin(q.angle))
   local pos=Vector3.new(q.x,q.y,q.z)-out*(18+j%3*3)
   local next=C.kingdoms[ki+1]
   local size=Vector3.new(8,3+j%3,6);local cf=CFrame.new(pos)*CFrame.Angles(.12,q.angle,.12)
   if clear(cf,size) then wedge(group,'BiomeInterleave',size,cf,stone:Lerp(A.color(next.rock),j/12),Enum.Material[next.material]) end
  end end
  task.wait()
 end
 -- Orient backdrops outward without rotating route-relative biome accents.
 E.orient(world)
 return #root:GetDescendants()
end
return E
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">EnvironmentFinish</string>
          <string name="Source"><![CDATA[-- Authored finishing compositions. Cosmetic only; baked in Edit, never on startup.
local A=require(script.Parent.Art)
local C=require(game.ReplicatedStorage.MountainShared.Catalog)
local F={}
local function triangle(parent,a,b,c,color,material,support)
 if support then
  -- Tiny overlap closes exact-edge ray/physics gaps between adjacent facets.
  local mid=(a+b+c)/3
  a+=(a-mid).Unit*.08;b+=(b-mid).Unit*.08;c+=(c-mid).Unit*.08
 end
 local ab,ac,bc=b-a,c-a,c-b
 if ab:Dot(ab)>ac:Dot(ac) and ab:Dot(ab)>bc:Dot(bc) then c,a=a,c
 elseif ac:Dot(ac)>bc:Dot(bc) then a,b=b,a end
 ab,ac,bc=b-a,c-a,c-b
 local right=ac:Cross(ab).Unit;local back=bc.Unit;local up=back:Cross(right)
 local h=math.abs(ab:Dot(up))
 for _,s in ipairs({{(a+b)/2,right,up,back,math.abs(ab:Dot(back))},{(a+c)/2,-right,up,-back,math.abs(ac:Dot(back))}}) do
  local p=Instance.new('WedgePart');p.Name=if support then 'BackdropWalkSurface' else 'ButtressFacet';p.Size=Vector3.new(if support then 1 else .08,h,s[5]);p.CFrame=CFrame.fromMatrix(s[1],s[2],s[3],s[4])
  p.Color=color;p.Material=material;p.Anchored=true;p.CanCollide=support==true;p.CanQuery=support==true;p.CanTouch=false
  if support then p:SetAttribute('MountainArtSupport',true) end;p.Parent=parent
 end
end
local function folder(parent,name)
 local f=Instance.new('Folder');f.Name=name;f.Parent=parent;return f
end
function F.apply(world)
 assert(not game:GetService('RunService'):IsRunning(),'Edit only')
 assert(game.PlaceId==0 and world.Name=='ImpossibleMountain','Isolated local mountain only')
 assert(not world:FindFirstChild('EnvironmentFinish'),'Already finished')
 local root=folder(world,'EnvironmentFinish')
 local archive=folder(game.ServerStorage,'EnvironmentFinishPrior')
 local function block(parent,name,size,cf,color,material)
  return A.part(parent,name,size,cf,color,material)
 end
 local function rock(parent,cf,scale,color,material,seed)
  -- Interlocking wedges form a rooted, broken outcrop with broad faces.
  for i=1,7 do
   local p=Instance.new('WedgePart');p.Name='JointedOutcrop';p.Anchored=true
   p.CanCollide=false;p.CanQuery=false;p.CanTouch=false
   local a=i*2.399+seed
   p.Size=Vector3.new(scale.X*(.36+.05*(i%3)),scale.Y*(.67+.11*(i%4)),scale.Z*(.42+.04*(i%3)))
   p.CFrame=cf*CFrame.new(math.cos(a)*scale.X*.2,-scale.Y*.12,math.sin(a)*scale.Z*.18)*CFrame.Angles(.09*math.sin(a),a,.09*math.cos(a))
   p.Material=material;p.Color=color:Lerp(Color3.fromRGB(219,220,207),.035*(i%4));p.Parent=parent
  end
 end
 local function voussoirs(parent,frame,radius,width,depth,color,material,start,finish)
  local count=math.ceil((finish-start)*radius/5)
  for j=1,count do
   local a=start+(finish-start)*(j-.5)/count
   local pos=Vector3.new(math.cos(a)*radius,math.sin(a)*radius,0)
   block(parent,'ArchStone',Vector3.new((finish-start)*radius/count*.92,width,depth),frame*CFrame.new(pos)*CFrame.Angles(0,0,a+math.pi/2),color:Lerp(Color3.new(1,1,1),.035*(j%3)),material)
  end
 end
 for ki,k in ipairs(C.kingdoms) do
  local group=folder(root,k.id);local old=world.EnvironmentComposition[k.id]
  local center=world[k.name].ArenaFloor.Position+Vector3.new(0,2.5,0)
  local q=C.route(ki,.875);local out=Vector3.new(math.cos(q.angle),0,math.sin(q.angle))
  local frame=CFrame.lookAt(center,center-out)
  local stone=A.color(k.rock);local accent=A.color(k.accent)
  -- Remove only these previous decorative placeholders from the visible composition.
  local prior=folder(archive,k.id)
  -- Closed, tapering buttress: its lower end enters the mountain, its crown
  -- supports the external landmark. No disconnected pile of large wedges.
  for _,p in ipairs(old:GetChildren()) do
   if p.Name=='BackdropFoundation' or p.Name=='BackdropRoot' then p.Parent=prior end
  end
  local rings={}
  for ri,spec in ipairs({{46,58,-1,38},{40,40,-30,9},{30,30,-79,-37}}) do
   local ring={}
   for j=1,8 do
    local a=(j-1)*math.pi/4;local rough=1+.055*math.sin(j*2.7+ki)
    ring[j]=frame:PointToWorldSpace(Vector3.new(math.cos(a)*spec[1]*rough,spec[3],spec[4]+math.sin(a)*spec[2]*rough))
   end
   rings[ri]=ring
  end
  local crownCenter=frame:PointToWorldSpace(Vector3.new(0,-1,38))
  for j=1,8 do triangle(group,crownCenter,rings[1][j],rings[1][j%8+1],stone,Enum.Material[k.material],true) end
  for ri=1,2 do for j=1,8 do
   local n=j%8+1;local tint=stone:Lerp(Color3.fromRGB(176,183,176),.03*(j%4))
   triangle(group,rings[ri][j],rings[ri+1][j],rings[ri][n],tint,Enum.Material[k.material])
   triangle(group,rings[ri][n],rings[ri+1][j],rings[ri+1][n],tint,Enum.Material[k.material])
  end end
  -- The arena buttress is continuous; no separate hanging side-rock props.
  if ki==1 then
   -- Interleaved ivory garden masonry and hanging garden beds.
   for j=0,8 do
    local a=.15+j*math.pi*.105;local x=math.cos(a)*38;local z=58+math.sin(a)*13
    block(group,'GardenCapstone',Vector3.new(7,1.2,6),frame*CFrame.new(x,5,z)*CFrame.Angles(0,-a,0),Color3.fromRGB(191,190,159),Enum.Material.Limestone)
    for b=1,3 do
     local pos=(frame*CFrame.new(x+(b-2)*2,6,z)).Position
     A.part(group,'GardenFern',Vector3.new(2.8,.6,5),CFrame.new(pos)*CFrame.Angles(.3,b*1.3,.15),Color3.fromRGB(89,139,88),Enum.Material.Grass,Enum.PartType.Ball)
     A.part(group,'GardenBlossom',Vector3.new(1.8,.65,1.7),CFrame.new(pos+Vector3.new(0,.8,0)),accent:Lerp(Color3.new(1,1,1),b*.2),Enum.Material.SmoothPlastic,Enum.PartType.Ball)
    end
   end
   voussoirs(group,frame*CFrame.new(0,14,68),22,2.8,4,Color3.fromRGB(189,191,159),Enum.Material.Limestone,.12,math.pi-.12)
   for _,s in ipairs({-1,1}) do
    block(group,'GardenArchPier',Vector3.new(4.5,16,6),frame*CFrame.new(s*21.8,8,68),Color3.fromRGB(189,191,159),Enum.Material.Limestone)
    block(group,'GardenArchCapital',Vector3.new(6,1.2,7),frame*CFrame.new(s*21.8,15,68),Color3.fromRGB(206,205,177),Enum.Material.Limestone)
   end
  elseif ki==2 then
   -- Asymmetric falls: a hero curtain, two stepped tributaries, wet ledges and vines.
   for _,p in ipairs(old:GetChildren()) do
    if p.Name=='SilverCascade' or p.Name=='FallFoam' or p.Name=='SplashBasin' or p.Name=='WaterSculptedFin' then p.Parent=prior end
   end
   for j,spec in ipairs({{-19,55,12,65},{1,39,8,69},{20,29,6,62}}) do
    local x,h,width,z=table.unpack(spec)
    rock(group,frame*CFrame.new(x,h*.38,z+8),Vector3.new(width+14,h+14,22),stone,Enum.Material.Slate,j)
    local water=block(group,'SilkenWaterfall',Vector3.new(width,h,1),frame*CFrame.new(x,h/2,z-4),Color3.fromRGB(115,201,213),Enum.Material.SmoothPlastic);water.Transparency=.24
    for rib=1,5 do
     local f=block(group,'WaterThread',Vector3.new(.12+rib%2*.09,h*.97,.12),frame*CFrame.new(x-width/2+rib*width/6,h*.49,z-4.7),Color3.fromRGB(223,246,242),Enum.Material.SmoothPlastic);f.Transparency=.35+rib%2*.2
    end
    A.part(group,'FoamPool',Vector3.new(width+7,.6,12),frame*CFrame.new(x,.6,z-3),Color3.fromRGB(193,239,230),Enum.Material.SmoothPlastic,Enum.PartType.Ball)
    for s=-1,1,2 do
     for v=0,6 do
      A.part(group,'HangingFern',Vector3.new(2.8,.65,4.3),frame*CFrame.new(x+s*(width/2+2),h-v*3,z-4)*CFrame.Angles(.6,s*.6,.2),Color3.fromRGB(69,119+v*3,92),Enum.Material.Grass,Enum.PartType.Ball)
     end
    end
   end
  elseif ki==3 then
   voussoirs(group,frame*CFrame.new(0,12,61),24,4.8,7,Color3.fromRGB(210,168,108),Enum.Material.Sandstone,0,math.pi)
   for _,s in ipairs({-1,1}) do
    for level=0,4 do
     block(group,'WeatheredColumn',Vector3.new(8-level*.55,4.2,9-level*.5),frame*CFrame.new(s*27,3+level*5,60)*CFrame.Angles(0,s*.04*level,0),Color3.fromRGB(204+level*3,164+level*2,107),Enum.Material.Sandstone)
    end
    for j=1,4 do rock(group,frame*CFrame.new(s*(26+j*4),1,65+j*2),Vector3.new(7,5,8),stone,Enum.Material.Sandstone,j) end
   end
  elseif ki==4 then
   voussoirs(group,frame*CFrame.new(0,22,65),28,4.8,6,Color3.fromRGB(148,137,175),Enum.Material.Marble,.1,2.55)
   for j=1,6 do
    local angle=j*.48
    block(group,'ObservatoryInlay',Vector3.new(1.1,4,.3),frame*CFrame.new(math.cos(angle)*28,22+math.sin(angle)*28,61.8)*CFrame.Angles(0,0,angle),Color3.fromRGB(204,188,226),Enum.Material.Metal)
   end
  elseif ki==5 then
   voussoirs(group,frame*CFrame.new(0,9,59),26,6,9,Color3.fromRGB(78,65,65),Enum.Material.Basalt,.07,math.pi-.07)
   for j=-2,2 do
    block(group,'ForgeKeystone',Vector3.new(5,6+math.abs(j),8),frame*CFrame.new(j*6,35-math.abs(j)*2,60)*CFrame.Angles(0,0,-j*.1),Color3.fromRGB(85,69,65),Enum.Material.Basalt)
    block(group,'EmberInlay',Vector3.new(.6,3,.2),frame*CFrame.new(j*6,35-math.abs(j)*2,55.8),Color3.fromRGB(221,134,65),Enum.Material.Neon)
   end
  else
   voussoirs(group,frame*CFrame.new(0,30,61),29,3.8,6,Color3.fromRGB(214,225,235),Enum.Material.Marble,0,math.pi)
   for _,s in ipairs({-1,1}) do
    for level=0,5 do
     block(group,'SanctumAshlar',Vector3.new(8-level*.45,4.7,8-level*.4),frame*CFrame.new(s*29,3+level*5.2,60),Color3.fromRGB(205+level*4,216+level*3,228+level*2),Enum.Material.Marble)
    end
   end
  end
  task.wait()
 end
 -- Summit's large open meridian reads from below; thin silver rather than neon.
 local crown=folder(root,'CrownMeridian')
 local cf=CFrame.new(0,959,-25)*CFrame.Angles(0,-.65,.12)
 voussoirs(crown,cf,67,2.2,2.2,Color3.fromRGB(179,204,225),Enum.Material.Metal,-.15,math.pi*1.82)
 for j=1,7 do
  local a=j*math.pi/4
  local point=(cf*CFrame.new(math.cos(a)*67,math.sin(a)*67,0)).Position
  A.part(crown,'MeridianStar',Vector3.new(4,7,4),CFrame.new(point)*CFrame.Angles(0,.3,math.pi/4),Color3.fromRGB(204,226,241),Enum.Material.Marble)
 end
 root:SetAttribute('Revision',1)
 return #root:GetDescendants()
end
return F
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">FoliageFinish</string>
          <string name="Source"><![CDATA[-- Break the old smooth pancake canopy into irregular lobes inside its old bounds.
local A=require(script.Parent.Art)
local F={}
function F.apply(world)
 assert(not game:GetService('RunService'):IsRunning() and game.PlaceId==0,'Local Edit only')
 assert(not world:GetAttribute('FoliageFinishRevision'),'Already applied')
 local archive=Instance.new('Folder');archive.Name='FoliageFinishPrior';archive.Parent=game.ServerStorage
 local count=0
 for _,tree in ipairs(world:GetDescendants()) do
  if tree:IsA('Model') and (tree.Name=='Grown_blossom' or tree.Name=='Grown_azure') then
   for _,old in ipairs(tree:GetChildren()) do
    if old:IsA('BasePart') and old.Name=='Canopy' then
     local size=old.Size;local cf=old.CFrame;local color=old.Color
     for j=0,4 do
      local a=j*math.pi/2+.35
      local offset=if j==0 then Vector3.zero else Vector3.new(math.cos(a)*size.X*.23,math.sin(j*2)*size.Y*.07,math.sin(a)*size.Z*.23)
      A.part(tree,'LeafCrown',Vector3.new(size.X*.48,size.Y*.82,size.Z*.48),cf*CFrame.new(offset),color:Lerp(Color3.fromRGB(227,218,207),(j%3)*.065),Enum.Material.Grass,Enum.PartType.Ball)
     end
     old:SetAttribute('OriginalParent',tree:GetFullName());old.Parent=archive;count+=1
    end
   end
  end
 end
 world:SetAttribute('FoliageFinishRevision',1)
 return count
end
return F
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="48">
        <Properties>
          <string name="Name">FreeClimb</string>
          <string name="Source"><![CDATA[-- Open-face review topology. Distances and hazard tuning are provisional.
local F={version=1}
local function point(x,y,z) return {x=x,y=y,z=z} end
function F.layout()
 local g={sections={},eggs={},restPoints={},exit={x=4096,y=24,z=-166,width=180,height=24,depth=18}}
 for k=1,6 do
  local z=-210-(k-1)*200;local y=16+(k-1)*64
  local s={id=k,requiredWins=0,entry=point(4096,y,z),terrace=point(4096,y+64,z-160),finish=point(4096,y+64,z-200),escape={x=4096,width=32},bounds={minX=3924,maxX=4268,minZ=z-198,maxZ=z-2,minY=y-20,maxY=y+100},hazard={x=4168,y=y+64,z=z-154,halfWidth=16}}
  s.normalAltar=point(4068,y+65,z-181);s.trialAltar=point(4215,y+65,z-181)
  table.insert(g.sections,s)
  for i,x in ipairs({-58,58}) do table.insert(g.eggs,{id='raid:'..k..':'..i,section=k,position=point(4096+x,y+64,z-174)}) end
  for _,r in ipairs({{'entrance',point(4096,y,z-2)},{'recovery',point(4000,y+64,z-136)},{'guardian',point(4096,y+64,z-184)}}) do table.insert(g.restPoints,{id=k..':'..r[1],section=k,position=r[2]}) end
 end
 return g
end
function F.build()
 assert(not workspace:FindFirstChild('ImpossibleMountain'),'Build only into a new review with its old mountain removed')
 local C=require(game.ReplicatedStorage.MountainShared.Catalog)
 local Config=require(game.ReplicatedStorage.MountainShared.RaidConfig)
 local A=require(script.Parent.Art)
 local function v(p) return Vector3.new(p.x,p.y,p.z) end
 local function folder(parent,name) local f=Instance.new('Folder');f.Name=name;f.Parent=parent;return f end
 local root=folder(workspace,'ImpossibleMountain');root:SetAttribute('FreeClimbVersion',F.version);root:SetAttribute('GeneratorVersion',C.version)
 local checkpoints=folder(root,'Checkpoints');local interactions=folder(root,'Interactions');local dynamics=folder(root,'Dynamics');local encounters=folder(root,'Encounters')
 local bounds=folder(root,'GuardianBounds');local exits=folder(root,'SanctuaryExits');local meta=folder(root,'Sections')
 local g=F.layout();local rng=Random.new(42961)
 -- New-review terrain authority: only the open face beyond the sanctuary bridge.
 -- The exact historical terrain remains in the immutable baseline and backup.
 -- Eight-stud slices clear above the authored walk surface, with voxel-aligned bounds.
 for _,s in ipairs(g.sections) do for row=0,24 do
  local z=s.entry.z-row*8-4;local surface=s.entry.y+64*math.min(1,row*8/120)
  local bottom=math.floor((surface-12)/4)*4
  workspace.Terrain:FillBlock(CFrame.new(4096,(bottom+1024)/2,z),Vector3.new(384,1024-bottom,8),Enum.Material.Air)
 end end
 root:SetAttribute('TerrainAuthority','FreeClimb v1: x3904..4288 z-1410..-210, stepped floor to y1024; no sanctuary model edits')
 local function part(parent,name,pos,size,color,material,collide)
  return A.part(parent,name,size,CFrame.new(pos),color,material,nil,collide)
 end
 local function prompt(p,kind,k,id,text)
  p:SetAttribute('Kind',kind);p:SetAttribute('Kingdom',k);p:SetAttribute('Id',id)
  local q=Instance.new('ProximityPrompt');q.ActionText=text;q.ObjectText=p.Name;q.HoldDuration=0;q.MaxActivationDistance=12;q.RequiresLineOfSight=false;q.Parent=p
 end
 local function ramp(parent,name,a,b,width,color,thickness)
  local t=thickness or 6
  return A.part(parent,name,Vector3.new(width,t,(b-a).Magnitude+3),CFrame.lookAt((a+b)/2-Vector3.new(0,t/2,0),b-Vector3.new(0,t/2,0)),color,Enum.Material.Rock,nil,true)
 end
 local bridge=part(root,'SanctuaryApproach',Vector3.new(4096,13,-171),Vector3.new(180,6,82),Color3.fromRGB(179,174,151),Enum.Material.Cobblestone,true)
 local e=g.exit;local exit=part(exits,'SanctuaryExit',v(e),Vector3.new(e.width,e.height,e.depth),Color3.fromRGB(153,234,182),Enum.Material.Neon,false);exit.Transparency=1
 for _,x in ipairs({-85,85}) do local p=part(root,'ExitLantern',Vector3.new(4096+x,23,-166),Vector3.new(3,14,3),Color3.fromRGB(188,227,185),Enum.Material.Marble,true);A.label(p,'SAFE RETURN',10) end
 for k,s in ipairs(g.sections) do
  local c=C.kingdoms[k];local region=folder(root,c.name);region:SetAttribute('Kingdom',k)
  local entry=v(s.entry);local terrace=v(s.terrace);local top=Vector3.new(entry.X,terrace.Y,entry.Z-120)
  local stone=A.color(c.rock);local accent=A.color(c.accent);local plant=A.color(c.color)
  local marker=part(meta,tostring(k),terrace,Vector3.new(1,1,1),accent,nil,false);marker.Transparency=1;marker:SetAttribute('RequiredWins',0);marker:SetAttribute('SectionName',c.name)
  ramp(region,'OpenAscent',entry,top,344,stone)
  ramp(region,'DownhillLane',entry+Vector3.new(0,.45,0),top+Vector3.new(0,.45,0),32,stone:Lerp(Color3.fromRGB(240,227,182),.55),.4)
  -- Broad terrace keeps eggs and the shared defender in the same readable space.
  if k==3 then
   -- A shallow, escapable notch under actual breakaway sandstone plates.
   part(region,'TerraceFront',Vector3.new(4096,terrace.Y-4,entry.Z-131.5),Vector3.new(344,8,23),stone,Enum.Material.Sandstone,true)
   part(region,'TerraceBack',Vector3.new(4096,terrace.Y-4,entry.Z-182.5),Vector3.new(344,8,35),stone,Enum.Material.Sandstone,true)
   part(region,'TerraceLeft',Vector3.new(4038,terrace.Y-4,entry.Z-154),Vector3.new(228,8,22),stone,Enum.Material.Sandstone,true)
   part(region,'TerraceRight',Vector3.new(4226,terrace.Y-4,entry.Z-154),Vector3.new(84,8,22),stone,Enum.Material.Sandstone,true)
   part(region,'SandstoneCatch',Vector3.new(4168,terrace.Y-8,entry.Z-154),Vector3.new(32,4,22),stone,Enum.Material.Sandstone,true)
  else part(region,'Terrace',terrace-Vector3.new(0,4,0),Vector3.new(344,8,80),stone,Enum.Material[c.material],true) end
  part(region,'DownhillLane',terrace+Vector3.new(0,.15,0),Vector3.new(32,.3,80),stone:Lerp(Color3.fromRGB(240,227,182),.55),Enum.Material.Cobblestone,true)
  -- Cliff mass sits below the playable face; no terrain edits or camera tunnels.
  part(region,'MountainMass',terrace-Vector3.new(0,terrace.Y/2+25,0),Vector3.new(338,terrace.Y+10,76),stone:Lerp(Color3.new(0,0,0),.16),Enum.Material.Rock,true)
  for side=-1,1,2 do
   for j=1,4 do local p=Vector3.new(4096+side*(178+rng:NextNumber(0,16)),terrace.Y-18,entry.Z-115-j*18)
    local rock=part(region,'BrokenCliff',p,Vector3.new(20,46+rng:NextNumber(0,18),28),stone,Enum.Material.Rock,true);rock.CFrame*=CFrame.Angles(0,j*.3,side*.12)
   end
   for j=1,3 do local p=Vector3.new(4096+side*(130+j*7),terrace.Y,entry.Z-130-j*14)
    if k<=2 then A.tree(region,p,c,rng) else A.crystal(region,p,c,9+j*3) end
   end
  end
  local title=part(region,'SectionWayfinder',Vector3.new(3980,terrace.Y+5,entry.Z-121),Vector3.new(4,10,3),accent,Enum.Material.Marble,true)
  A.label(title,c.name..'\nAll climbers welcome',11)
  for j=1,6 do
   local p=part(region,'DownhillArrow',Vector3.new(4096,entry.Y+64*j/7+.7,entry.Z-120*j/7),Vector3.new(5,.2,3),accent,Enum.Material.Neon,false)
   p.CFrame=CFrame.lookAt(p.Position,p.Position+Vector3.new(0,-64,120))*CFrame.Angles(0,0,math.pi/4)
  end
  local b=s.bounds;local bound=part(bounds,tostring(k),Vector3.new((b.minX+b.maxX)/2,(b.minY+b.maxY)/2,(b.minZ+b.maxZ)/2),Vector3.new(b.maxX-b.minX,b.maxY-b.minY,b.maxZ-b.minZ),accent,nil,false);bound.Transparency=1
  local boss=A.creature(encounters,C.guardians[k],Vector3.new(4096,terrace.Y,entry.Z-185),3.2,1);boss.Name='Guardian_'..k;boss:SetAttribute('Kingdom',k)
  for _,kind in ipairs({'Guardian','Trial'}) do
   local pos=v(if kind=='Guardian' then s.normalAltar else s.trialAltar)
   local altar=part(interactions,if kind=='Guardian' then C.guardians[k].name else 'Trial_'..k,pos,Vector3.new(8,2,8),accent,Enum.Material.Marble,true)
   prompt(altar,kind,k,kind..':'..k,if kind=='Trial' then 'Begin harder Trial' else 'Challenge Guardian')
   altar:SetAttribute('ArenaX',pos.X);altar:SetAttribute('ArenaY',terrace.Y);altar:SetAttribute('ArenaZ',pos.Z)
   A.label(altar,if kind=='Trial' then 'GUARDIAN TRIAL\nCarry the reward home' else 'OPTIONAL FIGHT\nWin a brief raid opening',7)
  end
  local hp=s.hazard;local hazard=part(dynamics,'Hazard_'..k,Vector3.new(hp.x,hp.y+.4,hp.z),Vector3.new(32,.8,22),accent,Enum.Material.Neon,false)
  hazard:SetAttribute('Kind','RaidHazard');hazard:SetAttribute('Kingdom',k);hazard:SetAttribute('Hazard',Config.section(k).hazard);hazard:SetAttribute('Phase','quiet')
  A.label(hazard,({'ROOT SWEEP','WATER PULSE','SHIFTING SANDSTONE','PRISM CROSSING','FIRE VENTS','GRAVITY PULSE'})[k]..'\nWatch the warning • clear lane to the left',6)
  local details=folder(hazard,'TellArt')
  if k==1 then for j=1,3 do A.link(details,'Root',Vector3.new(hp.x-14,hp.y+1,hp.z-6+j*3),Vector3.new(hp.x+14,hp.y+1,hp.z-6+j*3),1.1,Color3.fromRGB(111,87,57),Enum.Material.Wood,false) end
  elseif k==2 then for j=1,3 do part(details,'WaterSheet',Vector3.new(hp.x,hp.y+j*.6,hp.z-7+j*4),Vector3.new(28,.3,2),Color3.fromRGB(114,212,242),Enum.Material.Neon,false) end
  elseif k==3 then for j=1,4 do part(details,'SandstoneSlab',Vector3.new(hp.x-20+j*8,hp.y+.5,hp.z),Vector3.new(8,1,22),stone,Enum.Material.Sandstone,true) end
  elseif k==4 then for side=-1,1,2 do local p=part(details,'PrismBeam',Vector3.new(hp.x,hp.y+2,hp.z),Vector3.new(28,.6,1),accent,Enum.Material.Neon,false);p.CFrame*=CFrame.Angles(0,side*.55,0) end
  elseif k==5 then for j=1,3 do part(details,'Vent',Vector3.new(hp.x-14+j*7,hp.y+1.5,hp.z),Vector3.new(3,3,3),Color3.fromRGB(255,145,72),Enum.Material.Neon,false) end
  else for j=1,5 do local a=j*math.pi*2/5;part(details,'GravityRune',Vector3.new(hp.x+math.cos(a)*10,hp.y+2,hp.z+math.sin(a)*6),Vector3.new(1,3,1),accent,Enum.Material.Neon,false) end end
 end
 for _,r in ipairs(g.restPoints) do
  local p=part(checkpoints,r.id,v(r.position)+Vector3.new(0,.2,0),Vector3.new(13,.4,13),Color3.fromRGB(178,208,173),Enum.Material.Cobblestone,true)
  prompt(p,'Checkpoint',r.section,r.id,'Rest here');A.label(p,'REST POINT\nEscape to sanctuary for safety',4);p.Label.MaxDistance=32
 end
 for _,e in ipairs(g.eggs) do
  local p=part(interactions,e.id,v(e.position)+Vector3.new(0,.4,0),Vector3.new(7,.8,7),A.color(C.kingdoms[e.section].accent),Enum.Material.Slate,true)
  prompt(p,'Nest',e.section,e.id,'Strike egg')
 end
 for _,p in ipairs(root.Interactions:GetChildren()) do local label=p:FindFirstChild('Label');if label then label.MaxDistance=45 end end
 for _,p in ipairs(root.Dynamics:GetChildren()) do local label=p:FindFirstChild('Label');if label then label.MaxDistance=50 end end
 require(script.Parent.MountainQuality).apply(root)
 return root,g
end
return F
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="49">
        <Properties>
          <string name="Name">FrontShoulder</string>
          <string name="Source"><![CDATA[-- A front-left shoulder breaks the tiered silhouette; intentional additive terrain art.
-- Additive only. This does not rerun Sculpt or Relief.
local M={}
local function key(x,y,z) return x..':'..y..':'..z end
function M.apply(world)
 assert(not game:GetService('RunService'):IsRunning() and game.PlaceId==0,'Local Edit only')
 assert(world.Name=='ImpossibleMountain' and world:GetAttribute('MassifRevision')==1,'Requires existing intended massif terrain')
 assert(not world:GetAttribute('FrontShoulderRevision'),'Already applied')
 local protect={}
 for _,p in ipairs(world:GetDescendants()) do
  if p:IsA('BasePart') and (p.CanCollide or p:FindFirstChildOfClass('ProximityPrompt')) then
   local e=Vector3.zero
   for _,a in ipairs({p.CFrame.RightVector*p.Size.X/2,p.CFrame.UpVector*p.Size.Y/2,p.CFrame.LookVector*p.Size.Z/2}) do e+=Vector3.new(math.abs(a.X),math.abs(a.Y),math.abs(a.Z)) end
   local lo=p.Position-e-Vector3.new(16,20,16);local hi=p.Position+e+Vector3.new(16,22,16)
   for x=math.floor(lo.X/16),math.floor(hi.X/16) do for y=math.floor(lo.Y/16),math.floor(hi.Y/16) do for z=math.floor(lo.Z/16),math.floor(hi.Z/16) do protect[key(x,y,z)]=true end end end
  end
 end
 local stats={added=0,tiles=0}
 local profiles={{-420,170,625,230,225,2.1}}
 for bx=-704,-128,64 do for bz=-128,448,64 do
  local region=Region3.new(Vector3.new(bx,0,bz),Vector3.new(bx+64,744,bz+64))
  local mat,occ=workspace.Terrain:ReadVoxels(region,4);local changed=false
  for x=1,16 do for z=1,16 do
   local wx=bx+(x-.5)*4;local wz=bz+(z-.5)*4
   for y=1,186 do
    if not protect[key(math.floor(wx/16),math.floor((y-.5)/4),math.floor(wz/16))] then
     local wy=(y-.5)*4;local value=0
     for _,s in ipairs(profiles) do
      local t=wy/s[3]
      if t<1 then
       local cx=s[1]+t*37;local cz=s[2]+t*25
       local dx=(wx-cx)/s[4];local dz=(wz-cz)/s[5]
       local a=math.atan2(dz,dx)
       local width=(1-t)^.73*(1+.10*math.sin(a*5+s[6])+ .045*math.sin(a*11-t*5))
       local edge=(width-math.sqrt(dx*dx+dz*dz))*math.min(s[4],s[5])+math.noise(wx/47,wy/59,wz/47)*5
       value=math.max(value,math.clamp((edge+2)/4,0,1))
      end
     end
     if value>occ[x][y][z] then
      occ[x][y][z]=value;stats.added+=1;changed=true
      local noise=math.noise(wx/75,wy/85,wz/75)
      mat[x][y][z]=if wy<80+noise*50 then Enum.Material.Grass elseif wy>545+noise*45 then Enum.Material.Snow elseif noise>.12 then Enum.Material.Slate else Enum.Material.Limestone
     end
    end
   end
  end end
  if changed then workspace.Terrain:WriteVoxels(region,4,mat,occ) end
  stats.tiles+=1;task.wait()
 end end
 world:SetAttribute('FrontShoulderRevision',1);world:SetAttribute('FrontShoulderReport',game.HttpService:JSONEncode(stats))
 return stats
end
return M
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="50">
        <Properties>
          <string name="Name">GardenGround</string>
          <string name="Source"><![CDATA[-- Grounded planting and a worn garden path outside the combat floor.
local A=require(script.Parent.Art)
local C=require(game.ReplicatedStorage.MountainShared.Catalog)
local G={}
function G.apply(world)
 assert(not game:GetService('RunService'):IsRunning() and game.PlaceId==0,'Local Edit only')
 assert(not world:FindFirstChild('GardenGround'),'Already built')
 local root=Instance.new('Folder');root.Name='GardenGround';root.Parent=world
 local q=C.route(1,.875);local center=world['Blossom Gardens'].ArenaFloor.Position+Vector3.new(0,2.5,0)
 local frame=CFrame.lookAt(center,center-Vector3.new(math.cos(q.angle),0,math.sin(q.angle)))
 local function part(name,size,pos,color,material,shape,rot)
  return A.part(root,name,size,frame*CFrame.new(pos)*(rot or CFrame.identity),color,material,shape)
 end
 -- Staggered limestone flags lead to the arch. Uneven joints retain visible earth.
 for row=0,6 do for column=0,1 do
  local x=(column-.5)*6.1+math.sin(row*2.1)*.45;local z=56+row*4.3
  part('WornGardenFlag',Vector3.new(5.5,.18,3.8),Vector3.new(x,-.31,z),Color3.fromRGB(176+row%3*4,176+row%3*3,150),Enum.Material.Limestone,nil,CFrame.Angles(0,(row%3-1)*.035,0))
 end end
 for _,side in ipairs({-1,1}) do
  local base=Vector3.new(side*30,-.48,58)
  part('RootBed',Vector3.new(16,.4,14),base,Color3.fromRGB(77,87,62),Enum.Material.Ground,Enum.PartType.Ball)
  -- Roots emerge from each actual trunk and sink into its planting bed.
  for j=1,5 do
   local a=j*1.25+side*.4;local mid=base+Vector3.new(math.cos(a)*3,.8,math.sin(a)*3)
   local tip=base+Vector3.new(math.cos(a)*7,-.05,math.sin(a)*6)
   A.link(root,'ExposedRoot',frame:PointToWorldSpace(base+Vector3.new(0,1.6,0)),frame:PointToWorldSpace(mid),1.4,Color3.fromRGB(94,78,66),Enum.Material.Wood)
   A.link(root,'RootTip',frame:PointToWorldSpace(mid),frame:PointToWorldSpace(tip),.7,Color3.fromRGB(94,78,66),Enum.Material.Wood)
  end
  for j=1,12 do
   local a=j*2.399;local pos=base+Vector3.new(math.cos(a)*(4+j%3),.35,math.sin(a)*(4+j%2))
   local tip=pos+Vector3.new(math.sin(a)*.3,1.2+j%3*.28,0)
   A.link(root,'FlowerStem',frame:PointToWorldSpace(pos),frame:PointToWorldSpace(tip),.1,Color3.fromRGB(67,101,62),Enum.Material.Grass)
   for petal=1,5 do
    local angle=petal*math.pi*.4
    part('GroundBlossom',Vector3.new(.7,.15,.38),tip+Vector3.new(math.cos(angle)*.3,0,math.sin(angle)*.3),Color3.fromRGB(236,182+j%3*12,200),Enum.Material.SmoothPlastic,Enum.PartType.Ball,CFrame.Angles(.1,-angle,0))
   end
   part('BlossomCenter',Vector3.new(.2,.18,.2),tip+Vector3.new(0,.08,0),Color3.fromRGB(230,204,123),Enum.Material.SmoothPlastic,Enum.PartType.Ball)
  end
 end
 root:SetAttribute('Revision',1)
 local sign=world.Interactions[C.guardians[1].name]:FindFirstChild('Label')
 if sign then sign.TextLabel.Text="Sovereign's Garden" end
 return #root:GetDescendants()
end
return G
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="51">
        <Properties>
          <string name="Name">HeroFalls</string>
          <string name="Source"><![CDATA[local C=require(game.ReplicatedStorage.MountainShared.Catalog)
local H={}
function H.dress(world)
 local A=require(script.Parent.Art)
 local root=world.HeroFalls
 assert(not root:FindFirstChild('ConnectedWaterGarden'),'Dressing already applied')
 local garden=Instance.new('Folder');garden.Name='ConnectedWaterGarden';garden.Parent=root
 local center=world['Azure Falls'].ArenaFloor.Position+Vector3.new(0,2.5,0)
 local q=C.route(2,.875);local frame=CFrame.lookAt(center,center-Vector3.new(math.cos(q.angle),0,math.sin(q.angle)))
 for _,p in ipairs(world.EnvironmentFinish.azure:GetChildren()) do
  if p.Name=='FoamPool' or p.Name=='HangingFern' then
   local cf=frame:ToObjectSpace(p.CFrame);local pos=cf.Position
   p.CFrame=frame*CFrame.new(pos.X,pos.Y,if p.Name=='FoamPool' then 58 else 59.6)*cf.Rotation
  end
 end
 for _,spec in ipairs({{-19,55,12},{1,39,8},{20,29,6}}) do
  local x,h,w=table.unpack(spec)
  local backing=game.ServerStorage.MountainArtAssets.WaterfallCliff:Clone()
  backing.Name='TributaryRock';backing.Size=Vector3.new(w+14,h+6,24)
  backing.CFrame=frame*CFrame.new(x,h/2+1,72);backing.Anchored=true
  backing.CanCollide=false;backing.CanQuery=false;backing.CanTouch=false;backing.Parent=garden
  -- Every hanging row has a continuous stem attached to a wet source ledge.
  A.part(garden,'WaterSourceLedge',Vector3.new(w+8,2.4,8),frame*CFrame.new(x,h+1,62),Color3.fromRGB(109,130,131),Enum.Material.Slate)
  A.part(garden,'Headwater',Vector3.new(w,.22,6),frame*CFrame.new(x,h+2.25,61),Color3.fromRGB(153,201,204),Enum.Material.Glass)
  for _,side in ipairs({-1,1}) do
   A.link(garden,'FernStem',frame:PointToWorldSpace(Vector3.new(x+side*(w/2+2),h+1,59.6)),frame:PointToWorldSpace(Vector3.new(x+side*(w/2+2),h-19,59.6)),.3,Color3.fromRGB(65,91,64),Enum.Material.Wood)
  end
 end
 root:SetAttribute('DressingRevision',2)
end
function H.apply(world)
 assert(not game:GetService('RunService'):IsRunning() and game.PlaceId==0,'Local Edit only')
 assert(not world:FindFirstChild('HeroFalls'),'Already built')
 local template=game.ServerStorage.MountainArtAssets:FindFirstChild('WaterfallCliff')
 assert(template and template:IsA('MeshPart'),'Generated cliff template missing')
 local root=Instance.new('Folder');root.Name='HeroFalls';root.Parent=world
 local archive=Instance.new('Folder');archive.Name='HeroFallsPrior';archive.Parent=game.ServerStorage
 local center=world['Azure Falls'].ArenaFloor.Position+Vector3.new(0,2.5,0)
 local q=C.route(2,.875);local frame=CFrame.lookAt(center,center-Vector3.new(math.cos(q.angle),0,math.sin(q.angle)))
 local cliff=template:Clone()
 cliff.Name='CarvedWaterfallCliff';cliff.Size*=1.3;cliff.CFrame=frame*CFrame.new(0,cliff.Size.Y/2-2,84)
 cliff.Anchored=true;cliff.CanCollide=false;cliff.CanQuery=false;cliff.CanTouch=false;cliff.Color=Color3.fromRGB(176,196,203);cliff.Parent=root
 for _,p in ipairs(world.EnvironmentFinish.azure:GetChildren()) do
  if p.Name=='JointedOutcrop' then p.Parent=archive
  elseif p.Name=='SilkenWaterfall' or p.Name=='WaterThread' then
   local cf=frame:ToObjectSpace(p.CFrame);local pos=cf.Position
   p.CFrame=frame*CFrame.new(pos.X,pos.Y,if p.Name=='WaterThread' then 58.3 else 59)
   if p.Name=='SilkenWaterfall' then
    local a=Instance.new('Attachment');a.Name='FoamMist';a.Position=Vector3.new(0,-p.Size.Y/2,0);a.Parent=p
    local mist=Instance.new('ParticleEmitter');mist.Name='WaterfallMist';mist.Texture='rbxasset://textures/particles/smoke_main.dds'
    mist.Rate=5;mist.Lifetime=NumberRange.new(1.2,2);mist.Speed=NumberRange.new(.5,1.8);mist.SpreadAngle=Vector2.new(35,35)
    mist.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,2),NumberSequenceKeypoint.new(1,7)})
    mist.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.8),NumberSequenceKeypoint.new(.35,.88),NumberSequenceKeypoint.new(1,1)})
    mist.Color=ColorSequence.new(Color3.fromRGB(218,241,240));mist.LightInfluence=.6;mist.Parent=a
   end
  end
 end
 H.dress(world)
 root:SetAttribute('Revision',2)
 return #root:GetDescendants()
end
return H
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="52">
        <Properties>
          <string name="Name">HeroGarden</string>
          <string name="Source"><![CDATA[local A=require(script.Parent.Art)
local C=require(game.ReplicatedStorage.MountainShared.Catalog)
local H={}
function H.apply(world)
 assert(not game:GetService('RunService'):IsRunning() and game.PlaceId==0,'Local Edit only')
 assert(not world:FindFirstChild('HeroGarden'),'Already built')
 local template=game.ServerStorage.MountainArtAssets.BlossomTreeTrunk
 local root=Instance.new('Folder');root.Name='HeroGarden';root.Parent=world
 local prior=Instance.new('Folder');prior.Name='HeroGardenPrior';prior.Parent=game.ServerStorage
 for _,p in ipairs(world.EnvironmentComposition.blossom:GetChildren()) do
  if p.Name=='LivingGardenArch' or p.Name=='BlossomCanopy' then p.Parent=prior end
 end
 local q=C.route(1,.875);local center=world['Blossom Gardens'].ArenaFloor.Position+Vector3.new(0,2.5,0)
 local frame=CFrame.lookAt(center,center-Vector3.new(math.cos(q.angle),0,math.sin(q.angle)))
 for _,side in ipairs({-1,1}) do
  local tree=Instance.new('Model');tree.Name='SovereignBlossomTree';tree.Parent=root
  local base=frame*CFrame.new(side*30,-1,58)*CFrame.Angles(0,side*.45,0)
  local trunk=template:Clone();trunk.Name='SculptedTrunk';trunk.Size=Vector3.new(template.Size.X*.52,template.Size.Y*1.65,template.Size.Z*.52)
  trunk.CFrame=base*CFrame.new(0,trunk.Size.Y/2,0);trunk.Anchored=true;trunk.CanCollide=false;trunk.CanQuery=false;trunk.CanTouch=false;trunk.Parent=tree
  local branchEnds={Vector3.new(-8,23,-1),Vector3.new(7,28,2),Vector3.new(0,30,-7)}
  for ci,endpoint in ipairs(branchEnds) do
   local start=base:PointToWorldSpace(Vector3.new(0,18,0));local finish=base:PointToWorldSpace(endpoint)
   A.part(tree,'Branch',Vector3.new((finish-start).Magnitude,1.2-ci*.15,1.2-ci*.15),CFrame.lookAt((start+finish)/2,finish)*CFrame.Angles(0,math.pi/2,0),Color3.fromRGB(99,77,69),Enum.Material.Wood,Enum.PartType.Cylinder)
   -- Round, irregular flower clusters, with overlapping lobe sizes and depths.
   for j=0,10 do
    local a=j*2.399+ci*.4;local spread=if j==0 then 0 else 5+2*math.sin(j*1.7)
    local pos=base:PointToWorldSpace(endpoint+Vector3.new(math.cos(a)*spread,math.sin(j*1.3)*3,math.sin(a)*spread))
    local size=7.6+(j%3)*1.2
    local color=Color3.fromRGB(202,128,163):Lerp(Color3.fromRGB(250,215,221),(j%5)*.17)
    A.part(tree,'BlossomCluster',Vector3.new(size,size*.82,size*.93),CFrame.new(pos)*CFrame.Angles(.2,a,.12),color,Enum.Material.Grass,Enum.PartType.Ball)
    if j%2==0 then
     A.part(tree,'LeafCluster',Vector3.new(size*.62,2.2,size*.7),CFrame.new(pos-Vector3.new(0,3,0))*CFrame.Angles(.2,a,.15),Color3.fromRGB(92,130,91),Enum.Material.Grass,Enum.PartType.Ball)
    end
   end
  end
 end
 root:SetAttribute('Revision',1)
 return #root:GetDescendants()
end
return H
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="53">
        <Properties>
          <string name="Name">Landmarks</string>
          <string name="Source"><![CDATA[local A=require(script.Parent.Art)
local L={}
function L.build(parent,k,index,center)
 local m=Instance.new('Model');m.Name=k.landmarks[1]..'_Signature'
 local stone=A.color(k.rock);local light=A.color(k.accent)
 local function p(name,size,offset,color,material,shape,rot)
  return A.part(m,name,size,CFrame.new(center+offset)*(rot or CFrame.identity),color or stone,material or Enum.Material.Rock,shape,false)
 end
 if index==1 then
  for j=1,16 do
   local a=j*math.pi/8;local pos=Vector3.new(math.cos(a)*35,0,math.sin(a)*35)
   p('GardenTerrace',Vector3.new(9,2,8),pos+Vector3.new(0,1,0),Color3.fromRGB(127,168,104),Enum.Material.Grass)
   for n=1,3 do p('ColosseumBlossom',Vector3.new(2,.8,2),pos+Vector3.new(math.cos(n*2)*2,2.4,math.sin(n*2)*2),light,Enum.Material.Grass,Enum.PartType.Ball) end
  end
  for _,sign in ipairs({-1,1}) do
   local base=center+Vector3.new(sign*28,0,-20)
   for n=1,5 do local next=base+Vector3.new(-sign*3,7,math.sin(n)*2);A.link(m,'AncientRoot',base,next,3.5,Color3.fromRGB(105,87,66),Enum.Material.Wood);base=next end
  end
 elseif index==2 then
  for j=1,5 do
   local offset=Vector3.new((j-3)*12,0,-36)
   p('WatercarvedCrest',Vector3.new(9,40+j%2*12,10),offset+Vector3.new(0,18,0),stone,Enum.Material.Slate)
   local water=p('HeartCascade',Vector3.new(7,36+j%2*12,1),offset+Vector3.new(0,19,6),light,Enum.Material.Glass);water.Transparency=.3
   p('TurquoisePool',Vector3.new(14,.6,12),offset+Vector3.new(0,.5,9),light,Enum.Material.Glass,Enum.PartType.Ball)
  end
 elseif index==3 then
  for tier=1,4 do p('SolarThroneStep',Vector3.new(37-tier*6,3,25-tier*3),Vector3.new(0,tier*3-1.5,-23),Color3.fromRGB(220-tier*8,175-tier*5,109),Enum.Material.Sandstone) end
  p('RoyalBackrest',Vector3.new(15,20,4),Vector3.new(0,19,-30),light,Enum.Material.Sandstone)
  for j=1,16 do local a=j*math.pi/8
   p('SolarCrownRay',Vector3.new(1.2,9,1.2),Vector3.new(math.cos(a)*13,32+math.sin(a)*13,-33),light,Enum.Material.Metal,nil,CFrame.Angles(0,0,a-math.pi/2))
  end
 elseif index==4 then
  for j=1,6 do local a=j*math.pi/3
   A.crystal(m,center+Vector3.new(math.cos(a)*32,0,math.sin(a)*32),k,13+j%2*5)
  end
  for j=1,20 do local a=j*math.pi/10
   p('ObservatoryOrbit',Vector3.new(1.2,1.2,11),Vector3.new(math.cos(a)*32,28+math.sin(a)*8,math.sin(a)*32),light,Enum.Material.Metal,nil,CFrame.Angles(.25,-a,0))
  end
  p('Mirror',Vector3.new(18,22,1),Vector3.new(0,15,-36),Color3.fromRGB(157,166,214),Enum.Material.Glass);m.Mirror.Reflectance=.5
 elseif index==5 then
  for j=1,8 do local a=j*math.pi/4
   p('VolcanicHorn',Vector3.new(5,28,5),Vector3.new(math.cos(a)*32,12,math.sin(a)*32),stone,Enum.Material.Basalt,nil,CFrame.Angles(math.sin(a)*.3,0,math.cos(a)*-.3))
   p('MagmaFissure',Vector3.new(1.2,18,1.2),Vector3.new(math.cos(a)*31,9,math.sin(a)*31),light,Enum.Material.Neon)
  end
  for j=1,20 do local a=j*math.pi/10;p('CrucibleRim',Vector3.new(7,2,3),Vector3.new(math.cos(a)*19,1,math.sin(a)*19),Color3.fromRGB(138,76,55),Enum.Material.Basalt,nil,CFrame.Angles(0,-a,0)) end
 else
  for j=1,8 do local a=j*math.pi/4
   p('AstralSpire',Vector3.new(3,29+j%2*10,3),Vector3.new(math.cos(a)*34,15,math.sin(a)*34),Color3.fromRGB(216,229,244),Enum.Material.Marble)
   A.crystal(m,center+Vector3.new(math.cos(a)*34,32,math.sin(a)*34),k,6)
  end
  for ring=1,2 do for j=1,24 do local a=j*math.pi/12
   p('CelestialOrbit',Vector3.new(.8,.8,9),Vector3.new(math.cos(a)*(25+ring*6),39+math.sin(a)*ring*5,math.sin(a)*(25+ring*6)),light,Enum.Material.Metal,nil,CFrame.Angles(0,-a,0))
  end end
 end
 m.Parent=parent
end

function L.branch(parent,k,index,branch,center)
 local m=Instance.new('Model');m.Name=k.landmarks[branch+1]..'_Composition'
 local stone=A.color(k.rock);local light=A.color(k.accent)
 local function p(name,size,offset,color,material,shape,rot)
  return A.part(m,name,size,CFrame.new(center+offset)*(rot or CFrame.identity),color or stone,material or Enum.Material.Rock,shape,false)
 end
 if index==1 then
  for j=1,8 do local a=j*math.pi/4
   p('MossTerrace',Vector3.new(5,1,4),Vector3.new(math.cos(a)*11,.4,math.sin(a)*11),Color3.fromRGB(115,161,94),Enum.Material.Grass)
   p('GardenBloom',Vector3.new(2,.7,2),Vector3.new(math.cos(a)*11,1.3,math.sin(a)*11),light,Enum.Material.Grass,Enum.PartType.Ball)
  end
  if branch==2 then for j=1,4 do p('FallenRuins',Vector3.new(3,5+j,3),Vector3.new(-11+j*5,3,-11),stone,Enum.Material.Marble,nil,CFrame.Angles(0,0,(j-2)*.12)) end end
 elseif index==2 then
  local water=p('HiddenWaterCurtain',Vector3.new(21,13,.5),Vector3.new(0,6,-5),light,Enum.Material.Glass);water.Transparency=.62
  for j=1,9 do
   A.link(m,'HangingVine',center+Vector3.new(j*3-15,14,-3),center+Vector3.new(j*3-15,4+j%3,-3),.25,Color3.fromRGB(61,125,89),Enum.Material.Grass)
   p('FernBed',Vector3.new(4,2,3),Vector3.new(j*3-15,1,12),Color3.fromRGB(69,141,102),Enum.Material.Grass,Enum.PartType.Ball)
  end
 elseif index==3 then
  if branch==1 then
   local pool=p('OasisWater',Vector3.new(14,.3,13),Vector3.new(0,.2,5),Color3.fromRGB(75,177,179),Enum.Material.Glass,Enum.PartType.Ball);pool.Transparency=.25
   for _,s in ipairs({-1,1}) do
    A.link(m,'PalmTrunk',center+Vector3.new(s*11,0,-7),center+Vector3.new(s*9,16,-7),.8,Color3.fromRGB(121,92,58),Enum.Material.Wood)
    for leaf=1,6 do p('PalmLeaf',Vector3.new(1,1,10),Vector3.new(s*9,16,-7),Color3.fromRGB(86,143,94),Enum.Material.Grass,Enum.PartType.Ball,CFrame.Angles(.3,leaf*math.pi/3,0)) end
   end
  else for j=1,5 do p('DawnObelisk',Vector3.new(2,5+j*2,2),Vector3.new(j*5-15,2.5+j,-10),light,Enum.Material.Sandstone) end end
 elseif index==4 then
  for j=1,7 do A.crystal(m,center+Vector3.new(math.cos(j)*12,0,math.sin(j)*12),k,7+j%3*3) end
  if branch==2 then for j=1,6 do local mirror=p('ReflectionSlab',Vector3.new(4,.3,8),Vector3.new(j*4-14,.3,3),light,Enum.Material.Glass);mirror.Reflectance=.45 end end
 elseif index==5 then
  for _,s in ipairs({-1,1}) do p('TemplePillar',Vector3.new(3,17,3),Vector3.new(s*11,8,-9),stone,Enum.Material.Basalt) end
  p('TempleLintel',Vector3.new(27,3,5),Vector3.new(0,17,-9),stone,Enum.Material.Basalt)
  local basin=p('EmberBasin',Vector3.new(8,.3,8),Vector3.new(0,.3,9),light,Enum.Material.Neon,Enum.PartType.Ball)
  local at=Instance.new('Attachment');at.Parent=basin;local ember=Instance.new('ParticleEmitter');ember.Rate=3;ember.Lifetime=NumberRange.new(1.2,2);ember.Speed=NumberRange.new(2,4);ember.Size=NumberSequence.new(.12);ember.Color=ColorSequence.new(light);ember.LightEmission=.5;ember.Parent=at
 else
  for j=1,12 do local a=j*math.pi/6
   p('StarGardenStone',Vector3.new(2,.8,2),Vector3.new(math.cos(a)*12,.5,math.sin(a)*12),Color3.fromRGB(224,231,242),Enum.Material.Marble)
   A.crystal(m,center+Vector3.new(math.cos(a)*12,1,math.sin(a)*12),k,2.5)
  end
  if branch==2 then for j=1,12 do local a=j*math.pi/6;p('GateConstellation',Vector3.new(2,2,2),Vector3.new(math.cos(a)*12,14+math.sin(a)*12,-6),light,Enum.Material.Glass,Enum.PartType.Ball) end end
 end
 m.Parent=parent
end
return L
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="54">
        <Properties>
          <string name="Name">Massifs</string>
          <string name="Source"><![CDATA[-- Two asymmetrical, non-route mountain shoulders rooted into the original base.
-- Additive only. This does not rerun Sculpt or Relief.
local M={}
local function key(x,y,z) return x..':'..y..':'..z end
function M.apply(world)
 assert(not game:GetService('RunService'):IsRunning() and game.PlaceId==0,'Local Edit only')
 assert(world.Name=='ImpossibleMountain' and world:GetAttribute('SculptRevision')==1 and not world:GetAttribute('ReliefRevision'),'Requires Review10 sculpt')
 assert(not world:GetAttribute('MassifRevision'),'Already applied')
 local protect={}
 for _,p in ipairs(world:GetDescendants()) do
  if p:IsA('BasePart') and (p.CanCollide or p:FindFirstChildOfClass('ProximityPrompt')) then
   local e=Vector3.zero
   for _,a in ipairs({p.CFrame.RightVector*p.Size.X/2,p.CFrame.UpVector*p.Size.Y/2,p.CFrame.LookVector*p.Size.Z/2}) do e+=Vector3.new(math.abs(a.X),math.abs(a.Y),math.abs(a.Z)) end
   local lo=p.Position-e-Vector3.new(16,20,16);local hi=p.Position+e+Vector3.new(16,22,16)
   for x=math.floor(lo.X/16),math.floor(hi.X/16) do for y=math.floor(lo.Y/16),math.floor(hi.Y/16) do for z=math.floor(lo.Z/16),math.floor(hi.Z/16) do protect[key(x,y,z)]=true end end end
  end
 end
 local stats={added=0,tiles=0}
 local profiles={{-325,-265,735,290,245,1.2},{165,-390,595,240,210,3.7}}
 for bx=-640,448,64 do for bz=-640,64,64 do
  local region=Region3.new(Vector3.new(bx,0,bz),Vector3.new(bx+64,744,bz+64))
  local mat,occ=workspace.Terrain:ReadVoxels(region,4);local changed=false
  for x=1,16 do for z=1,16 do
   local wx=bx+(x-.5)*4;local wz=bz+(z-.5)*4
   for y=1,186 do
    if not protect[key(math.floor(wx/16),math.floor((y-.5)/4),math.floor(wz/16))] then
     local wy=(y-.5)*4;local value=0
     for _,s in ipairs(profiles) do
      local t=wy/s[3]
      if t<1 then
       local cx=s[1]+t*37;local cz=s[2]+t*25
       local dx=(wx-cx)/s[4];local dz=(wz-cz)/s[5]
       local a=math.atan2(dz,dx)
       local width=(1-t)^.73*(1+.10*math.sin(a*5+s[6])+ .045*math.sin(a*11-t*5))
       local edge=(width-math.sqrt(dx*dx+dz*dz))*math.min(s[4],s[5])+math.noise(wx/47,wy/59,wz/47)*5
       value=math.max(value,math.clamp((edge+2)/4,0,1))
      end
     end
     if value>occ[x][y][z] then
      occ[x][y][z]=value;stats.added+=1;changed=true
      local noise=math.noise(wx/75,wy/85,wz/75)
      mat[x][y][z]=if wy<80+noise*50 then Enum.Material.Grass elseif wy>655+noise*65 then Enum.Material.Snow elseif noise>.12 then Enum.Material.Slate else Enum.Material.Limestone
     end
    end
   end
  end end
  if changed then workspace.Terrain:WriteVoxels(region,4,mat,occ) end
  stats.tiles+=1;task.wait()
 end end
 world:SetAttribute('MassifRevision',1);world:SetAttribute('MassifReport',game.HttpService:JSONEncode(stats))
 return stats
end
return M
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="55">
        <Properties>
          <string name="Name">MeasuredFinish</string>
          <string name="Source"><![CDATA[-- Baked visual finish for the measured terrain sculpt; no gameplay mutation.
local M={}
function M.apply(world)
 assert(game.PlaceId==0 and not game:GetService('RunService'):IsRunning(),'Local Edit only')
 assert(world:GetAttribute('MeasuredSculptRevision')==42,'Requires measured sculpt 42')
 assert(not world:FindFirstChild('ArenaRockFaces'),'Already applied')
 local palette={Rock={115,123,119},Slate={110,119,115},Limestone={128,137,122},Sandstone={132,137,118},Sand={143,140,112},Basalt={91,101,98},Grass={104,139,90}}
 for name,rgb in pairs(palette) do workspace.Terrain:SetMaterialColor(Enum.Material[name],Color3.fromRGB(unpack(rgb))) end
 local root=Instance.new('Folder');root.Name='ArenaRockFaces'
 local overlap=OverlapParams.new();overlap.FilterType=Enum.RaycastFilterType.Include;overlap.FilterDescendantsInstances={world}
 local catalog=require(game.ReplicatedStorage.MountainShared.Catalog)
 local template=assert(game.ServerStorage.MountainArtAssets:FindFirstChild('WaterfallCliff'))
 for i,k in ipairs(catalog.kingdoms) do
  local arena=world[k.name].ArenaFloor
  local out=Vector3.new(arena.Position.X,0,arena.Position.Z).Unit
  local side=Vector3.new(-out.Z,0,out.X)
  local heights={48,55,44,33,38,30}
  local widths={64,60,62,43,45,40}
  local tints={{190,166,125},{182,193,174},{228,192,126},{204,180,207},{151,137,123},{237,238,225}}
  for j=0,0 do
   local p=template:Clone();p.Name='RootedArenaCliff_'..i..'_'..j
   p.Size=Vector3.new(widths[i],heights[i],48)
   local pos=arena.Position+out*37-Vector3.new(0,p.Size.Y/2+12,0)
   p.CFrame=CFrame.lookAt(pos,pos+out)*CFrame.Angles(0,(i%3-1)*.09,0)
   for _,near in ipairs(workspace:GetPartBoundsInBox(p.CFrame,p.Size+Vector3.new(2,2,2),overlap)) do
    assert(not near.CanCollide and not near:FindFirstChildOfClass('ProximityPrompt'),'Cliff overlaps gameplay: '..near:GetFullName())
   end
   p.Color=Color3.new(1,1,1)
   local surface=p:FindFirstChildOfClass('SurfaceAppearance');if surface then surface.Color=Color3.fromRGB(unpack(tints[i])) end
   p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Parent=root
  end
  task.wait()
 end
 root:SetAttribute('Revision',2)
 root.Parent=world
 return {faces=#root:GetChildren(),densityChanges=0,colliderChanges=0}
end
return M
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="56">
        <Properties>
          <string name="Name">MountainEntrances</string>
          <string name="Source"><![CDATA[-- Review-only frontage revision. Does not resize or move home plots.
local E={version=2}
function E.layout()
 local sides={}
 for _,s in ipairs({{name='West',x=3960,outer=3438,bend=3738},{name='East',x=4232,outer=4754,bend=4454}}) do
  s.width=92;s.exitZ=-166
  s.path={{x=s.outer,y=0,z=-48},{x=s.bend,y=28,z=-108},{x=s.x,y=28,z=-166},{x=s.x,y=28,z=-182},{x=s.x,y=16,z=-210}}
  table.insert(sides,s)
 end
 return {sides=sides}
end
function E.apply(world,sanctuary)
 assert(world:GetAttribute('FreeClimbVersion') and sanctuary,'Free-climb sanctuary only')
 if world:GetAttribute('EntranceVersion')==E.version then return end
 local previous=world:FindFirstChild('MountainApproaches');if previous then previous:Destroy() end
 for _,name in ipairs({'WestSanctuaryExit','EastSanctuaryExit'}) do local exit=world.SanctuaryExits:FindFirstChild(name);if exit then exit:Destroy() end end
 local A=require(script.Parent.Art)
 local root=Instance.new('Folder');root.Name='MountainApproaches';root.Parent=world
 local stone=Color3.fromRGB(179,174,151);local pale=Color3.fromRGB(215,208,174);local green=Color3.fromRGB(153,234,182)
 local function part(name,pos,size,color,collide)
  return A.part(root,name,size,CFrame.new(pos),color,Enum.Material.Cobblestone,nil,collide)
 end
 local function ramp(name,a,b,width,thickness,color)
  local p=A.part(root,name,Vector3.new(width,thickness,(b-a).Magnitude+2),CFrame.lookAt((a+b)/2-Vector3.new(0,thickness/2,0),b-Vector3.new(0,thickness/2,0)),color,Enum.Material.Cobblestone,nil,true)
  return p
 end
 local g=E.layout();local mass=sanctuary.TerrainMassing_NoLandscaping
 -- Preserve lower planted terraces at28; bridge their front retaining wall with a broad slope.
 for _,side in ipairs(g.sides) do
  local sign=if side.name=='West' then -1 else 1
  local center=4096+sign*440
  ramp(side.name..'FrontageSlope',Vector3.new(center,0,-48),Vector3.new(center,28,-108),640,4,stone)
  -- Open the inner end of the upper retaining mass for the new physical passage.
  for _,p in ipairs(mass:GetChildren()) do
   if p.Name=='GateFlankUpper' and (p.Position.X-4096)*sign>0 then
    local outer=p.Position.X+sign*p.Size.X/2
    local inner=side.x+sign*side.width/2
    p.Size=Vector3.new(math.abs(outer-inner),p.Size.Y,p.Size.Z)
    p.Position=Vector3.new((outer+inner)/2,p.Position.Y,p.Position.Z)
   end
  end
  local landscape=sanctuary.AlpineEnvironment_Step3:FindFirstChild(side.name..'GateLandscape')
  local columns={}
  if landscape then
   -- Clear whole planted columns touched by the route, so no detached branches remain.
   for _,p in ipairs(landscape:GetChildren()) do
    if p:IsA('BasePart') and p.Name=='PlantedLowerTerrace' then
     for i=2,#side.path do
      local aa,bb=side.path[i-1],side.path[i]
      local a,b=Vector2.new(aa.x,aa.z),Vector2.new(bb.x,bb.z);local q=Vector2.new(p.Position.X,p.Position.Z)
      local t=math.clamp((q-a):Dot(b-a)/(b-a):Dot(b-a),0,1)
      if (q-(a+(b-a)*t)).Magnitude<60 then table.insert(columns,p.Position.X);break end
     end
    end
   end
   local removed=0
   for _,p in ipairs(landscape:GetChildren()) do
    if p:IsA('BasePart') then
     for _,x in ipairs(columns) do if math.abs(p.Position.X-x)<30 then p:Destroy();removed+=1;break end end
    end
   end
   root:SetAttribute(side.name..'LandscapePartsCleared',removed)
  end
  for i=2,#side.path do
   local a,b=side.path[i-1],side.path[i]
   ramp(side.name..'DirectPath_'..i,Vector3.new(a.x,a.y+.25,a.z),Vector3.new(b.x,b.y+.25,b.z),48,.5,pale)
  end
  -- Wide landing makes the entry join forgiving at either end of the slope.
  part(side.name..'MountainLanding',Vector3.new(side.x,13,-209),Vector3.new(92,6,8),stone,true)
  local exit=Instance.new('Part');exit.Name=side.name..'SanctuaryExit';exit.Size=Vector3.new(side.width,36,18)
  exit.CFrame=CFrame.new(side.x,30,side.exitZ);exit.Anchored=true;exit.CanCollide=false;exit.CanTouch=false;exit.Transparency=1;exit.Parent=world.SanctuaryExits
  local line=part(side.name..'SafeReturnLine',Vector3.new(side.x,28.6,-166),Vector3.new(48,.15,2),green,false);line.Material=Enum.Material.Neon
  for _,dx in ipairs({-28,28}) do
   local post=part(side.name..'EntranceLantern',Vector3.new(side.x+dx,35,-166),Vector3.new(3,14,3),green,true)
   post.Material=Enum.Material.Marble
   A.label(post,'SAFE RETURN\nMountain entrance',7)
  end
  local wayfinder=part(side.name..'Wayfinder',Vector3.new(side.outer+sign*30,6,-30),Vector3.new(3,12,3),green,true)
  A.label(wayfinder,'MOUNTAIN ↗\nSprint: hold Shift / mobile toggle',8)
 end
 world:SetAttribute('EntranceVersion',E.version)
end
return E
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="57">
        <Properties>
          <string name="Name">MountainQuality</string>
          <string name="Source"><![CDATA[-- Mountain-only in-place upgrade. Never clears voxels or rebuilds gameplay anchors.
local Q={version=4}
local S=require(script.Parent.MountainSurface)
local A=require(script.Parent.Art)
local rockPrototype
local function prepareRock()
 if not rockPrototype then
  -- One local CSG prototype, cloned thereafter: material-bearing cut faces without uploads.
  local ball=Instance.new('Part');ball.Shape=Enum.PartType.Ball;ball.Size=Vector3.one*10;ball.CFrame=CFrame.identity
  local cut=Instance.new('Part');cut.Size=Vector3.new(8,8.5,8);cut.CFrame=CFrame.new(.4,-.4,.2)*CFrame.Angles(.12,.22,.17)
  local ok,pieces=pcall(function()
   return game:GetService('GeometryService'):IntersectAsync(ball,{cut},{CollisionFidelity=Enum.CollisionFidelity.Box,RenderFidelity=Enum.RenderFidelity.Automatic,SplitApart=false})
  end)
  ball:Destroy();cut:Destroy()
  assert(ok,'Rock prototype intersection failed: '..tostring(pieces))
  rockPrototype=assert(pieces[1],'Rock prototype intersection returned no geometry')
  for i=2,#pieces do pieces[i]:Destroy() end
 end
end
local function cutRock(parent,name,size,cf,color,material)
 local q=rockPrototype:Clone();q.Name=name;q.Size=size;q.CFrame=cf;q.Material=if material==Enum.Material.Grass then Enum.Material.Rock else material
 q.Color=color;q.UsePartColor=true;q.Anchored=true;q.CanCollide=false;q.CanQuery=false;q.CanTouch=false;q.Parent=parent;return q
end
local function folder(parent,name)
 local f=Instance.new('Folder');f.Name=name;f.Parent=parent;return f
end
local function part(parent,name,size,cf,color,material,collide,shape)
 -- Small accent silhouettes need only a few faces, not a tessellated sphere.
 if name=='Bloom' or name=='DesertBloom' or name=='TrailVerge' or name=='Foam' then shape=nil end
 if name=='DesertSucculent' then
  shape=Enum.PartType.Cylinder;size=Vector3.new(size.Y,size.X,size.Z);cf=cf*CFrame.Angles(0,0,math.pi/2)
 end
 return A.part(parent,name,size,cf,color,material,shape,collide)
end
local function wedge(parent,name,size,cf,color,material,collide)
 local p=Instance.new('WedgePart');p.Name=name;p.Size=size;p.CFrame=cf;p.Color=color;p.Material=material
 p.Anchored=true;p.CanCollide=collide==true;p.CanQuery=p.CanCollide;p.CanTouch=false;p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth;p.Parent=parent;return p
end
local function triangle(parent,a,b,c,color,material,collide)
 -- Longest edge is the shared base of two right triangles; all cells share vertices.
 local ab,ac,bc=b-a,c-a,c-b
 if ab:Dot(ab)>ac:Dot(ac) and ab:Dot(ab)>bc:Dot(bc) then c,a=a,c
 elseif ac:Dot(ac)>bc:Dot(bc) then a,b=b,a end
 ab,ac,bc=b-a,c-a,c-b
 local right=ac:Cross(ab).Unit;local up=bc:Cross(right).Unit;local back=bc.Unit
 local h=math.abs(ab:Dot(up));local thickness=.2
 local shift=Vector3.new(0,-thickness/2,0)
 wedge(parent,'SculptedGround',Vector3.new(thickness,h,math.abs(ab:Dot(back))),CFrame.fromMatrix((a+b)/2+shift,right,up,back),color,material,collide)
 wedge(parent,'SculptedGround',Vector3.new(thickness,h,math.abs(ac:Dot(back))),CFrame.fromMatrix((a+c)/2+shift,-right,up,-back),color,material,collide)
end
local function ramp(parent,a,b,width,color,material)
 return part(parent,'CatchRecovery',Vector3.new(width,.6,(b-a).Magnitude+1),CFrame.lookAt((a+b)/2-Vector3.new(0,.3,0),b-Vector3.new(0,.3,0)),color,material,true)
end
local function rock(parent,p,scale,yaw,color,material,interior)
 -- Buried, tilted bedrock: one broad mass and a lateral fracture, never an oval stack.
 local cf=CFrame.new(p)*CFrame.Angles(0,yaw,0)
 local w,h,d=scale.X,scale.Y,scale.Z
 cutRock(parent,'RockMass',Vector3.new(w*.92,h*1.3,d),cf*CFrame.new(-w*.06,h*.29,0)*CFrame.Angles(.19,.18,-.24),color,material)
 cutRock(parent,'Fracture',Vector3.new(w*.51,h*.81,d*.83),cf*CFrame.new(w*.26,h*.22,d*.12)*CFrame.Angles(-.15,-.32,.18),color:Lerp(Color3.new(0,0,0),.08),material)
 if interior then
  local hull=part(parent,'BoulderCore',Vector3.new(w*.5,h*.65,d*.5),cf*CFrame.new(0,h*.3,0),color,material,true);hull.Transparency=1
 end
end
local function plant(parent,p,scale,color,accent,rng,flower)
 local yaw=rng:NextNumber(0,6.28)
 local biome=parent:GetAttribute('Biome') or 1
 local x=p.X-4096;local d=-210-(biome-1)*200-p.Z
 local up=Vector3.yAxis
 if d>=0 and d<=120 then
  -- Ground on the rendered wedges, not the continuous profile between vertices.
  local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Include
  params.FilterDescendantsInstances={parent.Parent.WalkSurface}
  local hit=workspace:Raycast(Vector3.new(p.X,16+(biome-1)*64+100,p.Z),Vector3.new(0,-120,0),params)
  if hit then p=hit.Position;up=hit.Normal end
 end
 local right=Vector3.new(up.Y,-up.X,0).Unit
 local cf=CFrame.fromMatrix(p-up*.08,right,up)*CFrame.Angles(0,yaw,0)
 if biome<=2 then
  -- Low unequal sprays grow from a buried root rather than a five-legged tripod.
  for j=1,3 do
   local length=scale*(.85+j*.28)
   local leaf=cf*CFrame.Angles(0,j*2.39,0)*CFrame.new(0,scale*.2,-length*.33)*CFrame.Angles(-.22-j*.035,0,.09)
   wedge(parent,'LeafSpray',Vector3.new(scale*(.34+j*.08),scale*.12,length),leaf,color:Lerp(Color3.new(1,1,1),j*.04),Enum.Material.Grass,false)
  end
  if flower then
   part(parent,'Bloom',Vector3.new(scale*.48,.18,scale*.48),cf*CFrame.new(.15,scale*.38,-.2)*CFrame.Angles(0,.7,.1),accent,Enum.Material.SmoothPlastic,false)
  end
 elseif biome==3 then
  for j=1,3 do wedge(parent,'AgaveLeaf',Vector3.new(scale*.3,scale*.15,scale),cf*CFrame.Angles(0,j*2.4,0)*CFrame.new(0,scale*.24,-scale*.18)*CFrame.Angles(-.55,0,0),color,Enum.Material.Grass,false) end
 elseif biome==4 then
  for j=1,2 do wedge(parent,'AmethystShard',Vector3.new(scale*.32,scale*(.5+j*.22),scale*.4),cf*CFrame.new(j*.4,scale*.22,0)*CFrame.Angles(.1,0,j*.19),accent:Lerp(color,.45),Enum.Material.Slate,false) end
 elseif biome==5 then
  for j=1,2 do wedge(parent,'BasaltScree',Vector3.new(scale*.65,scale*.27,scale),cf*CFrame.new(j*.5,0,j*.4)*CFrame.Angles(.08,j,0),color:Lerp(Color3.fromRGB(45,43,46),.55),Enum.Material.Basalt,false) end
 else
  for j=1,2 do wedge(parent,'FrostShard',Vector3.new(scale*.4,scale*.45,scale*.8),cf*CFrame.new(j*.4,.1,j*.3)*CFrame.Angles(.12,j,.2),color:Lerp(accent,.3),Enum.Material.Ice,false) end
 end
end
local function tree(parent,p,scale,color,leaf,rng)
 local yaw=rng:NextNumber(0,6.28);local m=folder(parent,'CanopyGrove');local top=p+Vector3.new(1,scale,0)
 A.link(m,'Trunk',p,top,scale*.1,color,Enum.Material.Wood,false)
 for j=1,5 do
  local a=yaw+j*2.4;local q=p+Vector3.new(math.cos(a)*scale*(.2+j*.025),scale*(.68+j*.055),math.sin(a)*scale*.28)
  A.link(m,'Branch',p+Vector3.new(0,scale*.45,0),q,scale*.045,color,Enum.Material.Wood,false)
  part(m,'LeafCloud',Vector3.new(scale*(.47+j*.025),scale*(.48+j%3*.06),scale*.58),CFrame.new(q)*CFrame.Angles(.17,a,.22),leaf:Lerp(Color3.new(1,1,1),j*.025),Enum.Material.Grass,false,Enum.PartType.Ball)
 end
end
local function crystal(parent,p,height,color,yaw)
 local cf=CFrame.new(p)*CFrame.Angles(.1,yaw,.14)
 -- Opposed tapered faces meet at one ridge; no separate cuboid stem and cap.
 wedge(parent,'CrystalFacet',Vector3.new(height*.3,height,height*.32),cf*CFrame.new(0,height*.43,-height*.16),color,Enum.Material.Slate,false)
 wedge(parent,'CrystalFacet',Vector3.new(height*.3,height,height*.32),cf*CFrame.new(0,height*.43,height*.16)*CFrame.Angles(0,math.pi,0),color:Lerp(Color3.new(1,1,1),.23),Enum.Material.Slate,false)
 local vein=part(parent,'CrystalVein',Vector3.new(.1,height*.48,.12),cf*CFrame.new(height*.152,height*.25,0),color:Lerp(Color3.new(1,1,1),.3),Enum.Material.Neon,false);vein.CastShadow=false
end
function Q.apply(root,onlySection)
 assert(root and root:GetAttribute('FreeClimbVersion')==1,'Requires current free-climb world')
 local C=require(game.ReplicatedStorage.MountainShared.Catalog)
 -- Resolve the yielding CSG dependency before replacing any existing region.
 prepareRock()
 for k,c in C.kingdoms do if not onlySection or onlySection==k then
  local region=assert(root:FindFirstChild(c.name),'Missing biome '..c.name)
  if region:GetAttribute('MountainQualityVersion')==Q.version then continue end
  local old=region:FindFirstChild('MountainQuality');if old then old:Destroy() end
  local y=16+(k-1)*64;local z=-210-(k-1)*200;local top=y+64
  local stone=A.color(c.rock);local accent=A.color(c.accent);local green=A.color(c.color)
  -- Retain the original center floor and all terraces; replace only its two planar shoulders.
  region.OpenAscent.Size=Vector3.new(32,region.OpenAscent.Size.Y,region.OpenAscent.Size.Z)
  for _,p in region:GetChildren() do
   if p.Name=='BrokenCliff' or p.Name=='MineralCluster' or string.sub(p.Name,1,6)=='Grown_' then p:Destroy() end
  end
  local quality=folder(region,'MountainQuality');local surface=folder(quality,'WalkSurface');local art=folder(quality,'Scenery')
  art:SetAttribute('Biome',k)
  local material=Enum.Material[if k<=2 then 'Grass' else c.material]
  local ground=if k<=2 then green:Lerp(stone,.25) else stone:Lerp(green,.22)
  -- The escape shares the surrounding soil instead of forming a dark ruler stripe.
  -- Keep Review03 route physics while changing visible material, including fresh builds.
  region.OpenAscent.CustomPhysicalProperties=region.OpenAscent.CustomPhysicalProperties or PhysicalProperties.new(Enum.Material.Rock)
  region.OpenAscent.Color=ground;region.OpenAscent.Material=material
  for _,p in region:GetChildren() do
   if p:IsA('BasePart') and string.sub(p.Name,1,7)=='Terrace' then p.Color=ground end
   if p.Name=='DownhillLane' then
    p.CustomPhysicalProperties=p.CustomPhysicalProperties or PhysicalProperties.new(Enum.Material[if k<=2 then 'Ground' else c.material])
    p.Color=ground;p.Material=material
   end
   if p.Name=='DownhillArrow' then p.Size=Vector3.new(2,.2,1.4);p.Transparency=.3 end
  end
  for ix=1,#S.widths-1 do if not (S.widths[ix]==-16 and S.widths[ix+1]==16) then
   for iz=1,#S.depths-1 do
    local x1,x2=S.widths[ix],S.widths[ix+1];local d1,d2=S.depths[iz],S.depths[iz+1]
    local function v(x,d) return Vector3.new(4096+x,y+S.height(k,x,d),z-d) end
    local a,b,cc,d=v(x1,d1),v(x2,d1),v(x1,d2),v(x2,d2)
    local col=ground:Lerp(stone,math.clamp((math.noise((x1+x2)*.009,(d1+d2)*.0125,k*.7)+.35)*.18,0,.13))
    triangle(surface,a,b,cc,col,material,true);triangle(surface,b,d,cc,col,material,true)
   end
  end end
  local rng=Random.new(70031+k*397)
  local function groundAt(x,d) return Vector3.new(4096+x,y+S.height(k,x,math.min(d,120)),z-d) end
  -- Asymmetric mid-slope islands make two open climbing lines around the continuous escape.
  -- Their conservative cores stay between x32..76, clear of center and x88 side routes.
  for j=1,4 do
   local side=if j%2==0 then 1 else -1;local d=22+j*19;local x=side*(52+(k+j)%3*3)
   local p=groundAt(x,d)
   rock(art,p-Vector3.new(0,1.5,0),Vector3.new(23,8+j%2*4,19),side*.22,stone,Enum.Material[c.material],true)
   for n=1,3 do plant(art,p+Vector3.new(side*(9+n),0,n*4-8),1.8,if k<=2 then green else stone:Lerp(green,.4),accent,rng,k==1 or k==4 or k==6) end
   if k<=2 and j%2==0 then tree(art,p+Vector3.new(2,0,-3),13,Color3.fromRGB(91,72,63),if k==1 then accent else green,rng)
   elseif k>=4 then crystal(art,p+Vector3.new(side*4,3,0),6+j,accent,j)
   end
  end
  -- Sloped edge buttresses break the ruler-straight side into a composed rock shoulder.
  for side=-1,1,2 do
   for j=1,5 do
    local d=14+j*30;local x=side*(153+rng:NextNumber(-4,9));local h=if d<120 then 8+j*1.5 else 16+j
    rock(art,groundAt(x,d)-Vector3.new(0,3,0),Vector3.new(24+rng:NextNumber(0,7),h,30+rng:NextNumber(0,9)),side*.3+j*.3,stone,Enum.Material[c.material])
    local p=groundAt(side*(133+rng:NextNumber(-4,7)),d+4)
    if k==1 or k==2 then tree(art,p,12+j*1.5,Color3.fromRGB(89,75,62),if k==1 then accent else green:Lerp(accent,.18),rng)
    elseif k==3 then plant(art,p,3.2,Color3.fromRGB(103,131,85),accent,rng,false)
    else crystal(art,p,6+j*1.2,accent,side+j*.7) end
   end
   -- Low vegetation is clustered at rock feet, leaving the center and encounter apron open.
   for j=1,12 do
    local d=12+j*13;local x=side*(114+rng:NextNumber(0,24));local p=groundAt(x,d)
    local col=if k==3 then Color3.fromRGB(117,139,87) elseif k==5 then Color3.fromRGB(111,94,82) elseif k==6 then Color3.fromRGB(130,164,182) else green
    plant(art,p,if k<=2 then rng:NextNumber(1.3,2.5) else rng:NextNumber(.9,1.8),col,accent,rng,k==1 or k==4 or k==6)
   end
  end
  -- A single side landmark per biome, always outside the 32-stud escape and raid apron.
  if k==1 then
   tree(art,groundAt(-118,104),24,Color3.fromRGB(91,72,63),accent,rng)
   for j=1,6 do plant(art,groundAt(-104+j*3,104+j%2*5),2,green,accent,rng,true) end
  elseif k==2 then
   -- Waterfall composition is authored below as one source and basin.
  elseif k==3 then
   for j=1,3 do rock(art,groundAt(-150+j*9,100)-Vector3.new(0,3,0),Vector3.new(13,17+j*3,22),-.3+j*.2,stone:Lerp(accent,.14),Enum.Material.Sandstone) end
   local p=S.sandstoneRecovery();ramp(surface,Vector3.new(p[1].x,p[1].y,p[1].z),Vector3.new(p[2].x,p[2].y,p[2].z),10,stone,Enum.Material.Sandstone)
  elseif k==4 then
   for j=1,5 do crystal(art,groundAt(-145+j*7,99+j%2*8),8+j*2.5,accent,j*.65) end
  elseif k==5 then
   for j=1,4 do
    local p=groundAt(-150+j*9,100);rock(art,p,Vector3.new(14,14+j*2,18),j*.5,stone,Enum.Material.Basalt)
    local ember=part(art,'EmberSeam',Vector3.new(.3,7+j,1),CFrame.new(p+Vector3.new(2,6,9)),accent,Enum.Material.Neon,false);ember.CastShadow=false
   end
  else
   for j=1,4 do
    local p=groundAt(-149+j*10,105);rock(art,p,Vector3.new(15,9+j*2,18),j*.3,stone:Lerp(green,.5),Enum.Material.Snow)
    crystal(art,p+Vector3.new(0,5,0),8+j,accent,j)
   end
  end
  -- Foreground patches make the path read as a worn trail, with a clear center for escape.
  -- Added after the primary geometry pass so every tested collider remains identical.
  for side=-1,1,2 do for j=1,7 do
   local d=8+j*14+math.sin(j*2.3+k)*5;local x=side*(35+((j*23+k*11)%43));local p=groundAt(x,d)
   local col=if k==1 then Color3.fromRGB(81,142,79) elseif k==2 then Color3.fromRGB(70,133,124) elseif k==3 then Color3.fromRGB(143,147,88) elseif k==4 then Color3.fromRGB(123,101,160) elseif k==5 then Color3.fromRGB(114,88,72) else Color3.fromRGB(143,169,191)
   for n=1,3 do
    local px=x+math.sin(n*2.4+j)*4;local pd=d+math.cos(n*2.4+j)*5
    plant(art,groundAt(px,pd),if k<=2 then 2.3+(n%3)*.55 else 1.5+(n%3)*.4,col,accent,rng,k==1)
   end
   -- Low irregular verge stones soften the edge without collision or route narrowing.
   if j%2==0 then wedge(art,'TrailVerge',Vector3.new(2.8,.35,3.8),CFrame.new(groundAt(side*(19+j%2),d))*CFrame.Angles(0,j,.08),stone,Enum.Material.Rock,false) end
  end end
  if k==1 then
   for j=1,3 do tree(art,groundAt(-110-j*6,35+j*18),17+j*1.8,Color3.fromRGB(91,72,63),accent:Lerp(green,.15),rng) end
  elseif k==2 then
   -- Keep the foreground of the falls open.
  elseif k==3 then
   for j=1,3 do rock(art,groundAt(-112-j*5,60+j*10),Vector3.new(14,20+j*2,23),.3,stone:Lerp(accent,.12),Enum.Material.Sandstone) end
   for j=1,5 do
    local p=groundAt((if j%2==0 then 1 else -1)*(44+j*5),14+j*16);local col=Color3.fromRGB(95,134,94)
    part(art,'DesertSucculent',Vector3.new(2.6,4+j*.6,2.6),CFrame.new(p+Vector3.new(0,2+j*.3,0)),col,Enum.Material.Grass,false,Enum.PartType.Ball)
    part(art,'DesertBloom',Vector3.new(1.4,.7,1.4),CFrame.new(p+Vector3.new(0,4.3+j*.6,0)),accent,Enum.Material.SmoothPlastic,false,Enum.PartType.Ball)
   end
  elseif k==4 then
   for j=1,5 do crystal(art,groundAt(-105-j*5,64+j*3),13+j*1.8,accent,j*.9) end
  elseif k==5 then
   for j=1,5 do
    local p=groundAt(-106-j*5,65+j*4)
    rock(art,p,Vector3.new(12,17+j,18),j*.33,stone,Enum.Material.Basalt)
    local seam=part(art,'BasaltFissure',Vector3.new(.4,14+j,.5),CFrame.new(p+Vector3.new(1,8,8)),accent,Enum.Material.Neon,false);seam.CastShadow=false
   end
  else
   local p=groundAt(-123,98);local pale=stone:Lerp(green,.65)
   rock(art,p+Vector3.new(-13,0,0),Vector3.new(12,23,15),-.12,pale,Enum.Material.Snow)
   rock(art,p+Vector3.new(13,0,0),Vector3.new(12,23,15),.12,pale,Enum.Material.Snow)
   for j=-1,1 do part(art,'CrownArch',Vector3.new(15,7,13),CFrame.new(p+Vector3.new(j*9,20+3*(1-math.abs(j)),0))*CFrame.Angles(0,0,-j*.35),pale,Enum.Material.Snow,false,Enum.PartType.Ball) end
   for j=1,5 do local star=part(art,'CrownStar',Vector3.new(1,1,1),CFrame.new(p+Vector3.new((j-3)*4,10+math.sin(j)*3,2))*CFrame.Angles(0,0,.78),accent,Enum.Material.Neon,false);star.CastShadow=false end
  end
  -- Low paired outcrops carry the adjacent palette across the outer terrace seam.
  -- Keep the entire encounter apron and all three escape lines empty.
  if k<6 then
   local nextStone=A.color(C.kingdoms[k+1].rock)
   for side=-1,1,2 do
    local p=groundAt(side*(145-k%2*4),193-side*3)
    rock(art,p-Vector3.new(0,1.5,0),Vector3.new(24,7+k%3,16),side*.7,stone:Lerp(nextStone,.35),Enum.Material[c.material])
    for n=1,3 do plant(art,groundAt(side*(129+n*3),185+n*3),2+n*.3,green:Lerp(nextStone,.25),accent,rng,k==1) end
   end
  end
  -- Authored diagonal shoulders continue through the seam at different offsets.
  -- These low shelves sit outside x=16 escape and x=88 side lines, behind raid aprons.
  for side=-1,1,2 do
   for j=1,3 do
    local x=side*(39+j*9);local d=189+j*2+side*3
    local col=stone:Lerp(ground,.35)
    rock(art,groundAt(x,d)-Vector3.new(0,2,0),Vector3.new(16+j*3,4+j*.8,11+j*2),side*.4+j*.2,col,Enum.Material[c.material])
   end
  end
  -- A single broad asymmetrical outer landform replaces a line of tiny props.
  local flank=if k==3 or k==5 then 1 else -1
  for j=1,3 do
   local x=flank*(121+j*7);local d=30+j*23;local h=if k==5 then 21+j*4 else 12+j*3
   rock(art,groundAt(x,d)-Vector3.new(0,4,0),Vector3.new(30+j*3,h,39-j*3),flank*(.15+j*.22),stone,Enum.Material[c.material])
  end
  if k<=2 then
   -- Unequal drifts around the existing boulders create planted beds, not a grid.
   for j=1,8 do
    local side=if j%3==0 then 1 else -1
    local bx=side*(101+(j*17)%39);local bd=18+(j*29)%139
    for n=1,5 do
     local px=bx+math.sin(n*2.39+j)*7;local pd=bd+math.cos(n*2.39+j)*9
     plant(art,groundAt(px,pd),2.5+(n%3)*.5,green:Lerp(Color3.fromRGB(43,92,65),.25),accent,rng,k==1 and n%2==0)
    end
    local p=groundAt(bx,bd)
    part(art,'Understory',Vector3.new(8+j%3,4+j%2,7),CFrame.new(p+Vector3.new(0,1.6,0))*CFrame.Angles(.12,j,.18),green:Lerp(Color3.fromRGB(48,100,65),.2),Enum.Material.Grass,false,Enum.PartType.Ball)
   end
  end
  if k==2 then
   -- Water starts in a perched source, descends over an exposed lip into a rock basin.
   for _,p in art:GetChildren() do if p.Name=='FallsRibbon' or p.Name=='Foam' or p.Name=='CascadingFalls' or p.Name=='FallsPool' then p:Destroy() end end
   local p=groundAt(-124,87);local waterColor=Color3.fromRGB(94,194,200)
   for j=1,5 do
    local a=j*1.05
    rock(art,p+Vector3.new(math.cos(a)*16,-2,13+math.sin(a)*9),Vector3.new(12,5+j%2*2,10),a,stone,Enum.Material.Slate)
   end
   local function water(name,size,pos,tilt)
    local q=part(art,name,size,CFrame.new(pos)*CFrame.Angles(tilt or 0,0,0),waterColor,Enum.Material.SmoothPlastic,false,Enum.PartType.Ball);q.Transparency=.12;q.CastShadow=false;return q
   end
   water('SourcePool',Vector3.new(18,.4,13),p+Vector3.new(0,24,-2))
   rock(art,p+Vector3.new(-13,15,-5),Vector3.new(13,16,22),-.3,stone,Enum.Material.Slate)
   rock(art,p+Vector3.new(11,15,-8),Vector3.new(14,17,24),.4,stone,Enum.Material.Slate)
   water('WaterCurtain',Vector3.new(10,25,1.8),p+Vector3.new(-1,12,6),-.12)
   water('WaterCurtain',Vector3.new(5,21,1.4),p+Vector3.new(5,10,7),-.15)
   water('FallsBasin',Vector3.new(29,.45,18),p+Vector3.new(0,.4,14))
   for j=1,5 do
    local q=part(art,'FallsFoam',Vector3.new(3+j%2,.18,1.3),CFrame.new(p+Vector3.new((j-3)*3,.7,9+j%2*2))*CFrame.Angles(0,j*.6,0),Color3.fromRGB(210,240,229),Enum.Material.SmoothPlastic,false,Enum.PartType.Ball);q.CastShadow=false
   end
  elseif k==3 then
   -- Warm erosion layers run laterally instead of three equal upright pillars.
   local p=groundAt(-132,74)
   for j=1,4 do
    rock(art,p+Vector3.new(j*4,2+j*4,-j*2),Vector3.new(39-j*5,7,26-j*2),-.22,stone:Lerp(accent,j*.035),Enum.Material.Sandstone)
   end
  elseif k==4 then
   local p=groundAt(-126,76)
   rock(art,p-Vector3.new(0,3,0),Vector3.new(39,14,31),.3,stone:Lerp(Color3.fromRGB(47,36,65),.3),Enum.Material.Slate)
   for j=1,7 do crystal(art,p+Vector3.new(math.sin(j*2.4)*12,3,math.cos(j*2.4)*9),9+(j%4)*4,accent:Lerp(Color3.fromRGB(105,143,192),j*.035),j*.8) end
  elseif k==5 then
   -- Leaning basalt fins and low talus frame one fissure on the outer shoulder.
   for j=1,6 do
    local p=groundAt(116+j*4,51+j*8)
    part(art,'BasaltFin',Vector3.new(8+j%2*4,18+j*2,16),CFrame.new(p+Vector3.new(0,5,0))*CFrame.Angles(-.2,j*.17,-.25),stone:Lerp(Color3.new(0,0,0),.1),Enum.Material.Basalt,false)
    rock(art,p+Vector3.new(-8,-1,7),Vector3.new(17,7,20),j*.6,stone,Enum.Material.Basalt)
   end
  elseif k==6 then
   -- Crown stones lean inward around a luminous opening, with a low snowy foreground.
   for _,q in art:GetChildren() do if q.Name=='CrownArch' or q.Name=='CrownStar' then q:Destroy() end end
   local p=groundAt(-123,98);local pale=stone:Lerp(green,.65)
   for j=-2,2 do
    local a=j*.65
    cutRock(art,'CrownStone',Vector3.new(13,13,13),CFrame.new(p+Vector3.new(math.sin(a)*17,4+math.cos(a)*17,0))*CFrame.Angles(0,.1,-a),pale:Lerp(Color3.new(1,1,1),(j+2)*.018),Enum.Material.Snow)
   end
   crystal(art,p+Vector3.new(0,3,0),13,accent,0)
   for j=1,4 do rock(art,p+Vector3.new((j-2.5)*11,-3,11+j%2*3),Vector3.new(16,5,12),j*.7,pale,Enum.Material.Snow) end
  end
  region:SetAttribute('MountainQualityVersion',Q.version)
  task.wait()
 end end
 if not onlySection then root:SetAttribute('MountainQualityVersion',Q.version) end
 return root
end
return Q
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="58">
        <Properties>
          <string name="Name">MountainSurface</string>
          <string name="Source"><![CDATA[-- Shared, deterministic surface contract. Heights are local to each existing tier.
local S={version=1}
S.widths={-172,-120,-72,-16,16,72,120,172}
S.depths={0,20,40,60,80,100,120}
local profiles={
 {0,16,32,38,42,50,64},
 {0,8,24,40,46,50,64},
 {0,16,28,36,38,48,64},
 {0,16,32,38,40,48,64},
 {0,8,16,32,48,56,64},
 {0,16,28,34,48,56,64},
}
function S.height(k,x,depth)
 local d=math.clamp(depth,0,120);local base=64*d/120
 local a=math.abs(x);local weight=math.clamp(math.min((a-16)/88,(172-a)/52),0,1)
 local profile=profiles[if x<0 then k else k%6+1]
 local segment=math.min(6,math.floor(d/20)+1);local t=(d-(segment-1)*20)/20
 return base+(profile[segment]*(1-t)+profile[segment+1]*t-base)*weight
end
function S.sandstoneRecovery()
 -- A static ramp at the rear of the catch, outside the moving TellArt contract.
 return {{x=4168,y=202,z=-764},{x=4168,y=208,z=-775}}
end
return S
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="59">
        <Properties>
          <string name="Name">NaturalRidges</string>
          <string name="Source"><![CDATA[-- Review32 continuation: connected, asymmetric ridge relief; never rebuild routes.
local M={}
local function key(x,y,z) return x..':'..y..':'..z end
function M.apply(world)
 assert(game.PlaceId==0 and not game:GetService('RunService'):IsRunning(),'Local Edit only')
 assert(world.Name=='ImpossibleMountain' and world:GetAttribute('FrontShoulderRevision')==1,'Requires Review32 terrain')
 assert(not world:GetAttribute('NaturalRidgesRevision'),'Already applied')
 local clearance=require(script.Parent.ArtClearance).build(world,40)
 local stats={added=0,tiles=0}
 local ridges={{.08,105,.27,770},{1.65,100,.25,660},{2.65,86,.3,880},{3.7,76,.23,720},{5.05,110,.28,820}}
 for bx=-640,576,64 do for bz=-640,576,64 do
  local region=Region3.new(Vector3.new(bx,0,bz),Vector3.new(bx+64,928,bz+64))
  local mat,occ=workspace.Terrain:ReadVoxels(region,4);local changed=false
  for x=1,16 do for z=1,16 do
   local wx=bx+(x-.5)*4;local wz=bz+(z-.5)*4
   local radius=math.sqrt(wx*wx+wz*wz);local angle=math.atan2(wz,wx)
   if radius>100 and radius<630 then
    for y=1,232 do
     local wy=(y-.5)*4
     local weight=clearance.weight(Vector3.new(wx,wy,wz))
     if weight>0 then
      local relief=0
      for _,s in ipairs(ridges) do
       local a=s[1]+.16*math.sin(wy/290+s[1])
       local d=math.atan2(math.sin(angle-a),math.cos(angle-a))
       local taper=math.clamp((s[4]-wy)/150,0,1)
       local width=s[3]*(.72+.28*math.sin(wy/170+s[1])^2)
       relief=math.max(relief,s[2]*taper*math.exp(-(d/width)^2))
      end
      local edge=476-wy*.405+relief*weight-105*(1-weight)+math.noise(wx/63,wy/87,wz/63)*18-radius
      local ceiling=math.max(838,970-radius*.85+math.sin(angle*3)*18)
      local value=math.clamp(math.min(edge,ceiling-wy)/4+.5,0,1)
      if value>occ[x][y][z] then
       occ[x][y][z]=value;stats.added+=1;changed=true
       local n=math.noise(wx/95,wy/120,wz/95)
       mat[x][y][z]=if wy>760+n*85 then Enum.Material.Snow elseif wy<150+n*70 then Enum.Material.Grass elseif n>.18 then Enum.Material.Slate else Enum.Material.Limestone
      end
     end
    end
   end
  end end
  if changed then workspace.Terrain:WriteVoxels(region,4,mat,occ) end
  stats.tiles+=1;task.wait()
 end end
 world:SetAttribute('NaturalRidgesRevision',2)
 world:SetAttribute('NaturalRidgesReport',game.HttpService:JSONEncode(stats))
 return stats
end
return M
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="60">
        <Properties>
          <string name="Name">NaturalSurface</string>
          <string name="Source"><![CDATA[-- Sculpt the unoccupied watershed, preserving every rounded gameplay clearance box.
local P=require(game.ReplicatedStorage.MountainShared.TerrainProfile)
local S={}
function S.apply(world)
 assert(game.PlaceId==0 and not game:GetService('RunService'):IsRunning(),'Local Edit only')
 assert(world.Name=='ImpossibleMountain' and world:GetAttribute('NaturalRouteRevision')==51,'Expected route51 study')
 assert(not world:GetAttribute('NaturalSurfaceRevision'),'Already sculpted')
 local protection=require(script.Parent.ArtClearance).build(world,96)
 local terrain=workspace.Terrain
 local peaks={{-240,-180,755,255,235},{245,-80,675,225,210},{-310,200,580,225,205}}
 local function target(x,z)
  local original=P.height(x,z)
  if original<=0 then return original,original end
  local h=original
  for _,p in ipairs(peaks) do
   local dx,dz=(x-p[1])/p[4],(z-p[2])/p[5]
   local r=math.sqrt(dx*dx+dz*dz)
   h=math.max(h,p[3]*(1-r^1.25))
  end
  local rise=110*(1-math.exp(-math.max(0,h-original)/110))
  local relief=math.noise(x/70,z/70,51)*24+math.noise(x/27,z/27,19)*9
  local edge=math.clamp(original/80,0,1)
  edge=edge*edge*(3-2*edge)
  return original+(rise+relief)*edge,original
 end
 local changed,protected=0,0
 for bx=-704,576,64 do for bz=-704,576,64 do
  local heights={};local low,high=1000,-32
  for x=1,16 do heights[x]={};for z=1,16 do
   local h,b=target(bx+(x-.5)*4,bz+(z-.5)*4)
   heights[x][z]={h,b};low=math.min(low,b-32,h-16);high=math.max(high,b+32,h+16)
  end end
  low=math.max(-32,math.floor(low/4)*4);high=math.min(1000,math.ceil(high/4)*4)
  if high>low and high>0 then
   local region=Region3.new(Vector3.new(bx,low,bz),Vector3.new(bx+64,high,bz+64))
   local m,o=terrain:ReadVoxels(region,4);local dirty=false
   for x=1,16 do for z=1,16 do
    local h,b=unpack(heights[x][z]);local wx,wz=bx+(x-.5)*4,bz+(z-.5)*4
    local slope=math.sqrt((target(wx+4,wz)-target(wx-4,wz))^2+(target(wx,wz+4)-target(wx,wz-4))^2)/8
    for y=1,#o[x] do
     local wy=low+(y-.5)*4
     if b>0 and wy>=math.min(h,b)-28 and wy<=math.max(h,b)+16 then
      local weight=protection.weight(Vector3.new(wx,wy,wz))
      if weight==0 then protected+=1 else
       -- Blend signed heights before voxelization, never entire occupancy volumes.
       -- This moves one surface instead of filling thick shells with fractional voxels.
       local surface=b+(h-b)*weight
       local occupancy=math.clamp((surface-(wy-2))/4,0,1)
       if math.abs(occupancy-o[x][y][z])>.001 then
        o[x][y][z]=occupancy;dirty=true;changed+=1
        if occupancy<=0 then m[x][y][z]=Enum.Material.Air
        elseif m[x][y][z]==Enum.Material.Air then
         m[x][y][z]=if wy>surface-8 and surface>760 and slope<.8 then Enum.Material.Snow elseif wy>surface-8 and surface<290 and slope<1.4 then Enum.Material.Grass else Enum.Material.Rock
        end
       end
      end
     end
    end
   end end
   if dirty then terrain:WriteVoxels(region,4,m,o) end
  end
  task.wait()
 end end
 world:SetAttribute('NaturalSurfaceRevision',51)
 return {changedCells=changed,protectedCellsSkipped=protected,scope='Sculpt outside exact gameplay clearance boxes including full mover sweeps; must compare corridor fingerprints before/after.'}
end
return S
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="61">
        <Properties>
          <string name="Name">Polish</string>
          <string name="Source"><![CDATA[-- Additive, idempotent scenery pass: no terrain writes and no gameplay colliders.
local A=require(script.Parent.Art)
local C=require(game.ReplicatedStorage.MountainShared.Catalog)
local P={}
local function plant(parent,pos,k,seed,blend)
 local green=A.color(k.color):Lerp(Color3.fromRGB(62,108,78),.4)
 local flower=A.color(k.accent):Lerp(blend or A.color(k.accent),.25)
 for stem=1,3 do
  local a=seed+stem*2.4;local base=pos+Vector3.new(math.cos(a)*1.2,0,math.sin(a)*1.2)
  local tip=base+Vector3.new(math.cos(a)*.4,1.8+stem*.4,math.sin(a)*.4)
  A.link(parent,'Stem',base,tip,.12,green,Enum.Material.Grass)
  for side=-1,1,2 do
   for leaf=1,3 do
    local center=base:Lerp(tip,leaf*.2)+Vector3.new(side*.6,0,0)
    A.part(parent,'FernFrond',Vector3.new(1.6,.16,.55),CFrame.new(center)*CFrame.Angles(.15,a,side*.4),green:Lerp(flower,.08*leaf),Enum.Material.SmoothPlastic,Enum.PartType.Ball)
   end
  end
  if k.id=='blossom' or k.id=='astral' then
   for j=1,5 do local angle=j*math.pi*2/5
    A.part(parent,'Petal',Vector3.new(.65,.16,.38),CFrame.new(tip+Vector3.new(math.cos(angle)*.3,0,math.sin(angle)*.3))*CFrame.Angles(0,-angle,0),flower,Enum.Material.SmoothPlastic,Enum.PartType.Ball)
   end
   A.part(parent,'Pollen',Vector3.new(.25,.22,.25),CFrame.new(tip+Vector3.new(0,.08,0)),Color3.fromRGB(255,217,139),Enum.Material.SmoothPlastic,Enum.PartType.Ball)
  end
 end
end
function P.apply(world)
 if world:GetAttribute('ArtPassRevision')==1 then return end
 assert(world.Name=='ImpossibleMountain' and not workspace:FindFirstChild('MountainEmpire_Phase1'),'Isolated mountain only')
 -- Keep the old interaction root pose and metadata exactly, even for wild prompts.
 for _,old in ipairs(world.Encounters:GetChildren()) do
  local index=tonumber(old.Name:match('Guardian_(%d+)'))
  local species=if index then C.guardians[index] else C.byId[string.lower(old.Name)]
  assert(species,'Unknown encounter '..old.Name)
  local fresh=A.creature(nil,species,Vector3.zero,if index then 4.5 else 1.3,1)
  fresh.Name=old.Name;fresh:PivotTo(old:GetPivot())
  for name,value in pairs(old:GetAttributes()) do fresh:SetAttribute(name,value) end
  for name,value in pairs(old.PrimaryPart:GetAttributes()) do fresh.PrimaryPart:SetAttribute(name,value) end
  for _,child in ipairs(old.PrimaryPart:GetChildren()) do if not child:IsA('DataModelMesh') then child:Clone().Parent=fresh.PrimaryPart end end
  local label=fresh.PrimaryPart:FindFirstChild('Label')
  if label then local text=label:FindFirstChildOfClass('TextLabel');if text then text.Text=species.name..' / '..species.rarity end end
  fresh.Parent=world.Encounters;old:Destroy()
 end
 local dress=Instance.new('Folder');dress.Name='ArtPassScenery';dress.Parent=world
 for _,p in ipairs(world:GetDescendants()) do if p:IsA('ProximityPrompt') then
  local kind=p.Parent:GetAttribute('Kind')
  if kind=='Checkpoint' then p.ActionText='Rest / extract eggs'
  elseif kind=='Discovery' then p.ActionText='Discover / gather' end
 end end
 -- Repair legacy decorative ellipsoids and turn square wooden links into rounded roots.
 for _,p in ipairs(world:GetDescendants()) do
  if p:IsA('Part') and not p.CanCollide and not p:IsDescendantOf(world.Encounters) then
   if p.Shape==Enum.PartType.Ball and not p:FindFirstChildOfClass('SpecialMesh') then
    p.Shape=Enum.PartType.Block;local mesh=Instance.new('SpecialMesh');mesh.MeshType=Enum.MeshType.Sphere;mesh.Parent=p
   end
   if (p.Name=='Trunk' or p.Name=='Branch' or p.Name=='AncientRoot') and p.Shape~=Enum.PartType.Cylinder then
    local size=p.Size;p.Size=Vector3.new(size.Z,size.Y,size.X);p.CFrame*=CFrame.Angles(0,math.pi/2,0);p.Shape=Enum.PartType.Cylinder
   end
  end
 end
 for ki,k in ipairs(C.kingdoms) do
  local group=Instance.new('Folder');group.Name=k.id;group.Parent=dress
  for _,altar in ipairs(world.Interactions:GetChildren()) do
   if altar:GetAttribute('Kind')=='Guardian' and altar:GetAttribute('Kingdom')==ki then
    local label=altar:FindFirstChild('Label');local text=label and label:FindFirstChildOfClass('TextLabel')
    if text then text.Text=k.landmarks[1] end
   end
  end
  local region=world:FindFirstChild(k.name)
  local floor=region:FindFirstChild('ArenaFloor')
  local signature=region:FindFirstChild(k.landmarks[1]..'_Signature')
  if signature and not signature:GetAttribute('BackdropOriented') then
   -- Guardians face -Z; their non-colliding throne/falls/mirror belong behind them.
   local center=floor.Position+Vector3.new(0,2.5,0)
   local frame=CFrame.new(center)
   signature:PivotTo(frame*CFrame.Angles(0,math.pi,0)*frame:Inverse()*signature:GetPivot())
   signature:SetAttribute('BackdropOriented',true)
  end
  for _,column in ipairs(region:GetChildren()) do if column.Name=='ArenaColumn' then
   local top=column.Position+Vector3.new(0,column.Size.Y/2,0)
   A.part(group,'CarvedCapital',Vector3.new(4.5,.7,4.5),CFrame.new(top),A.color(k.rock):Lerp(Color3.fromRGB(236,222,194),.4),Enum.Material.Marble)
   A.part(group,'ColumnCollar',Vector3.new(3.6,.5,3.6),CFrame.new(top-Vector3.new(0,1.1,0)),A.color(k.accent):Lerp(Color3.fromRGB(218,198,151),.5),Enum.Material.Sandstone)
  end end
  for beat=1,14 do
   local t=(beat-.35)/15;local q=C.route(ki,t)
   local outward=Vector3.new(math.cos(q.angle),0,math.sin(q.angle))
   -- Inside shoulder: 11+ studs off the 16-stud-wide route; outside edge remains readable.
   local pos=Vector3.new(q.x,q.y,q.z)-outward*13
   local stone=A.color(k.rock)
   for layer=1,3 do
    local slab=A.part(group,'WeatheredStratum',Vector3.new(6-layer*.6,.8,3.8),CFrame.new(pos+Vector3.new(0,(layer-1)*.6-.6,0))*CFrame.Angles(.04,q.angle+.25,layer*.025),stone:Lerp(Color3.fromRGB(223,213,192),layer*.06),Enum.Material[k.material])
    slab:SetAttribute('ArtOnly',true)
   end
   local nextColor=if t>.8 and C.kingdoms[ki+1] then A.color(C.kingdoms[ki+1].accent) else nil
   if ki==1 or ki==2 or ki==6 then plant(group,pos+Vector3.new(0,1,0),k,beat,nextColor)
   elseif ki==3 then
    for j=1,7 do local a=j*math.pi*2/7
     A.part(group,'DesertAgave',Vector3.new(.35,3,1),CFrame.new(pos+Vector3.new(math.cos(a),1.7,math.sin(a)))*CFrame.Angles(math.sin(a)*.6,0,math.cos(a)*.6),Color3.fromRGB(113,146,126),Enum.Material.SmoothPlastic,Enum.PartType.Ball)
    end
   elseif ki==4 then A.crystal(group,pos+Vector3.new(0,1,0),k,3.5)
   else
    for j=1,3 do A.part(group,'BasaltShard',Vector3.new(.7,2+j,.8),CFrame.new(pos+Vector3.new(j-2,1+j*.3,0))*CFrame.Angles(0,j,.2),stone:Lerp(Color3.fromRGB(143,101,82),.3),Enum.Material.Basalt) end
   end
  end
  task.wait()
 end
 world:SetAttribute('ArtPassRevision',1)
end
return P
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="62">
        <Properties>
          <string name="Name">Relief</string>
          <string name="Source"><![CDATA[-- Additive geological shoulders over the preserved Sculpt07 terrain.
-- This is a separate revision: never reset or rerun Sculpt to reproduce it.
local R={}
local function key(x,y,z) return x..':'..y..':'..z end
function R.apply(world)
 assert(not game:GetService('RunService'):IsRunning(),'Edit only')
 assert(game.PlaceId==0 and world.Name=='ImpossibleMountain' and world:GetAttribute('SculptRevision')==1,'Requires isolated sculpted checkpoint')
 assert(not world:GetAttribute('ReliefRevision'),'Relief already applied')
 local protected={}
 for _,p in ipairs(world:GetDescendants()) do
  if p:IsA('BasePart') and (p.CanCollide or p:FindFirstChildOfClass('ProximityPrompt')) then
   local e=Vector3.zero
   for _,a in ipairs({p.CFrame.RightVector*p.Size.X/2,p.CFrame.UpVector*p.Size.Y/2,p.CFrame.LookVector*p.Size.Z/2}) do e+=Vector3.new(math.abs(a.X),math.abs(a.Y),math.abs(a.Z)) end
   local lo=p.Position-e-Vector3.new(16,20,16);local hi=p.Position+e+Vector3.new(16,22,16)
   for x=math.floor(lo.X/16),math.floor(hi.X/16) do for y=math.floor(lo.Y/16),math.floor(hi.Y/16) do for z=math.floor(lo.Z/16),math.floor(hi.Z/16) do protected[key(x,y,z)]=true end end end
  end
 end
 -- Soft shoulders around the exclusion cells prevent abrupt walls beside paths.
 local soft={}
 for k in pairs(protected) do
  local x,y,z=k:match('([^:]+):([^:]+):([^:]+)');x=tonumber(x);y=tonumber(y);z=tonumber(z)
  for dx=-2,2 do for dy=-2,2 do for dz=-2,2 do
   local weight=math.clamp(math.sqrt(dx*dx+dy*dy+dz*dz)/2.5,0,1)
   local n=key(x+dx,y+dy,z+dz);soft[n]=math.min(soft[n] or 1,weight)
  end end end
 end
 local stats={added=0,tiles=0,protected=0}
 for bx=-608,576,64 do for bz=-608,576,64 do
  local near=math.max(0,Vector2.new(bx+32,bz+32).Magnitude-46);local far=near+92
  local bottom=math.max(-16,math.floor(((440-far)/.4-100)/4)*4)
  local top=math.min(836,math.ceil(((585-near)/.4+40)/4)*4)
  if top>bottom and far>125 then
   local region=Region3.new(Vector3.new(bx,bottom,bz),Vector3.new(bx+64,top,bz+64))
   local mat,occ=workspace.Terrain:ReadVoxels(region,4);local changed=false
   for x=1,16 do for z=1,16 do
    local wx=bx+(x-.5)*4;local wz=bz+(z-.5)*4;local radius=Vector2.new(wx,wz).Magnitude;local a=math.atan2(wz,wx)
    for y=1,#occ[x] do
     local wy=bottom+(y-.5)*4;local cell=key(math.floor(wx/16),math.floor(wy/16),math.floor(wz/16))
     if protected[cell] then stats.protected+=1
     elseif wy>0 and radius>125 then
      -- Three broad buttresses, irregular secondary ribs and a sloping foot.
      local ridge=math.max(0,math.cos(a*3+.55+wy*.0018))^3
      local ribs=math.max(0,math.sin(a*9-wy*.005))^4
      local fade=math.clamp(wy/55,0,1)*math.clamp((836-wy)/110,0,1)
      local depth=(ridge*(58+28*math.sin(wy*.006+1)^2)+ribs*15)*fade*(soft[cell] or 1)
      local surface=477-wy*.4+depth+math.noise(wx/68,wy/79,wz/68)*9
      local value=math.clamp((surface-radius+2)/4,0,1)
      -- Only positive relief, never removes existing occupied terrain.
      if value>occ[x][y][z] and depth>4 then
       occ[x][y][z]=value;stats.added+=1;changed=true
       local altitude=wy+math.sin(a*3+.55)*85+math.sin(a*7)*25
       local material=if altitude<160 then Enum.Material.Grass elseif altitude<320 then Enum.Material.Slate elseif altitude<455 then Enum.Material.Sandstone elseif altitude<590 then Enum.Material.Rock elseif altitude<735 then Enum.Material.Basalt else Enum.Material.Snow
       -- Continuous neutral rock ribs cross the colored kingdoms.
       if ridge>.65 and altitude<590 then material=Enum.Material.Limestone end
       mat[x][y][z]=material
      end
     end
    end
   end end
   if changed then workspace.Terrain:WriteVoxels(region,4,mat,occ) end
   stats.tiles+=1
  end
  task.wait()
 end end
 world:SetAttribute('ReliefRevision',1)
 world:SetAttribute('ReliefReport',game.HttpService:JSONEncode(stats))
 return stats
end
return R
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="63">
        <Properties>
          <string name="Name">RidgeCrown</string>
          <string name="Source"><![CDATA[-- Final irregular crown relief; preserves all expanded gameplay envelopes.
local M={}
local function key(x,y,z) return x..':'..y..':'..z end
function M.apply(world)
 assert(game.PlaceId==0 and not game:GetService('RunService'):IsRunning(),'Local Edit only')
 assert(world:GetAttribute('NaturalRidgesRevision')==2 and not world:GetAttribute('RidgeCrownRevision'),'Requires first ridge pass')
 local clearance=require(script.Parent.ArtClearance).build(world,32)
 local stats={added=0,trimmed=0}
 for bx=-256,192,64 do for bz=-256,192,64 do
  local r=Region3.new(Vector3.new(bx,752,bz),Vector3.new(bx+64,992,bz+64));local m,o=workspace.Terrain:ReadVoxels(r,4)
  for x=1,16 do for z=1,16 do
   local wx=bx+(x-.5)*4;local wz=bz+(z-.5)*4;local radius=math.sqrt(wx*wx+wz*wz)
   local peaks=0
   for _,p in ipairs({{-82,-96,982,1.65},{88,-102,944,2.05},{-166,38,916,2.0}}) do
    local dx,dz=wx-p[1],wz-p[2];local a=math.atan2(dz,dx)
    peaks=math.max(peaks,p[3]-math.sqrt(dx*dx+dz*dz)*p[4]*(1+.13*math.sin(a*5)))
   end
   local cap=math.max(858,1010-radius*.95+12*math.sin(math.atan2(wz,wx)*3))
   for y=1,60 do
    local wy=752+(y-.5)*4
    local weight=clearance.weight(Vector3.new(wx,wy,wz))
    if weight>0 then
     local old=o[x][y][z]
     local value=math.max(math.min(old,math.clamp((cap-wy)/4+.5,0,1)),math.clamp((peaks-wy-90*(1-weight))/4+.5,0,1))
     if value~=old then
      o[x][y][z]=value
      if value>old then stats.added+=1 else stats.trimmed+=1 end
      m[x][y][z]=if value==0 then Enum.Material.Air elseif wy>peaks-13 then Enum.Material.Snow else Enum.Material.Limestone
     end
    end
   end
  end end
  workspace.Terrain:WriteVoxels(r,4,m,o);task.wait()
 end end
 world:SetAttribute('RidgeCrownRevision',1);world:SetAttribute('RidgeCrownReport',game.HttpService:JSONEncode(stats))
 return stats
end
return M
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="64">
        <Properties>
          <string name="Name">RidgeGroves</string>
          <string name="Source"><![CDATA[-- Grounded lower-mountain groves; silhouettes follow the new ridge shoulders.
local A=require(script.Parent.Art)
local C=require(game.ReplicatedStorage.MountainShared.Catalog)
local G={}
function G.apply(world)
 assert(game.PlaceId==0 and not game:GetService('RunService'):IsRunning(),'Local Edit only')
 assert(not world:FindFirstChild('RidgeGroves'),'Already built')
 local root=Instance.new('Folder');root.Name='RidgeGroves';root.Parent=world
 local crown=game.ServerStorage.MountainArtAssets.BlossomCanopyTemplate:FindFirstChild('crown_geom',true)
 local protected={};local planted={}
 local clearance=require(script.Parent.ArtClearance).build(world,72)
 for _,p in ipairs(world:GetDescendants()) do if p:IsA('BasePart') and (p.CanCollide or p:FindFirstChildOfClass('ProximityPrompt')) then table.insert(protected,p) end end
 local function clear(pos,h,r)
  for _,p in ipairs(planted) do if (p-pos).Magnitude<22 then return false end end
  if clearance.distance(pos+Vector3.new(0,h/2,0))<math.sqrt(r*r+h*h/4)+3 then return false end
  for _,p in ipairs(protected) do
   local localPos=p.CFrame:PointToObjectSpace(pos+Vector3.new(0,h/2,0));local e=p.Size/2
   if math.abs(localPos.X)<e.X+r+5 and math.abs(localPos.Z)<e.Z+r+5 and math.abs(localPos.Y)<e.Y+h/2+10 then return false end
  end
  return true
 end
 local rays=RaycastParams.new();rays.FilterType=Enum.RaycastFilterType.Include;rays.FilterDescendantsInstances={workspace.Terrain}
 local rng=Random.new(232424);local stats={trees=0,rejected=0}
 for ki=1,2 do
  local group=Instance.new('Folder');group.Name=C.kingdoms[ki].id;group.Parent=root
  for n=1,420 do
   local t=(n*.61803398875)%1;local j=1
   local q=C.route(ki,t+(j-2)*.008);local out=Vector3.new(math.cos(q.angle),0,math.sin(q.angle))
   local radius=q.radius+rng:NextNumber(-65,65)
   local target=out*radius
   local hit=workspace:Raycast(Vector3.new(target.X,1000,target.Z),Vector3.new(0,-1010,0),rays)
   local h=rng:NextNumber(19,34);local r=if ki==1 then 11 else 10
   if hit and hit.Normal.Y>.32 and hit.Position.Y>(if ki==1 then 20 else 145) and hit.Position.Y<(if ki==1 then 165 else 320) and clear(hit.Position,h+8,r) then
    local base=hit.Position-Vector3.new(0,.5,0);local tree=Instance.new('Model');tree.Name='ShoulderTree'
    local bend=Vector3.new(rng:NextNumber(-2,2),0,rng:NextNumber(-2,2));local mid=base+Vector3.new(0,h*.55,0)+bend*.4;local top=base+Vector3.new(0,h,0)+bend
    for _,s in ipairs({{base,mid,1.5},{mid,top,.85}}) do A.part(tree,'GrowingTrunk',Vector3.new((s[2]-s[1]).Magnitude,s[3],s[3]),CFrame.lookAt((s[1]+s[2])/2,s[2])*CFrame.Angles(0,math.pi/2,0),Color3.fromRGB(98,82,68),Enum.Material.Wood,Enum.PartType.Cylinder) end
    for b=1,5 do
     local a=b*2.399;local endP=top+Vector3.new(math.cos(a)*6,-2+b%3,math.sin(a)*6)
     A.link(tree,'GrowingBranch',mid:Lerp(top,.5),endP,.32,Color3.fromRGB(98,82,68),Enum.Material.Wood)
     if ki==1 then
      for spray=1,2 do
       local p=crown:Clone();p.Name='BlossomSpray';p.Size=Vector3.new(10,7,9)*rng:NextNumber(.8,1.1);p.CFrame=CFrame.new(endP+Vector3.new(math.cos(a+spray)*2,spray-1,math.sin(a+spray)*2))*CFrame.Angles(.2,a+spray,.3);p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Parent=tree
      end
     else
      for leaf=1,6 do
       local u=leaf/6;local pos=top:Lerp(endP,u)+Vector3.new(math.cos(a)*u*3,math.sin(u*math.pi)*1.5,math.sin(a)*u*3)
       for _,side in ipairs({-1,1}) do
        local endLeaf=pos+Vector3.new(-math.sin(a)*side*(3-u),-.4,math.cos(a)*side*(3-u))
        A.part(tree,'FernLeaf',Vector3.new(.75,.14,(endLeaf-pos).Magnitude*1.8),CFrame.lookAt((pos+endLeaf)/2,endLeaf),Color3.fromRGB(63+leaf*3,106+leaf*4,74+leaf*2),Enum.Material.Grass,Enum.PartType.Ball)
       end
      end
     end
    end
    for rootIndex=1,4 do
     local a=rootIndex*1.57;local offset=Vector3.new(math.cos(a)*4,0,math.sin(a)*4)
     local ground=workspace:Raycast(base+offset+Vector3.new(0,12,0),Vector3.new(0,-28,0),rays)
     if ground then A.link(tree,'Root',base+Vector3.new(0,2,0),ground.Position,.5,Color3.fromRGB(98,82,68),Enum.Material.Wood) end
    end
    tree.Parent=group;table.insert(planted,base);stats.trees+=1
   else stats.rejected+=1 end
  end
  task.wait()
 end
 root:SetAttribute('Revision',1);root:SetAttribute('Report',game.HttpService:JSONEncode(stats));return stats
end
return G
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="65">
        <Properties>
          <string name="Name">RidgeRockwork</string>
          <string name="Source"><![CDATA[-- Geological relief on the connected ridges, measured against actual terrain faces.
local C=require(game.ReplicatedStorage.MountainShared.Catalog)
local A=require(script.Parent.Art)
local M={}
local function extent(cf,size)
 local e=Vector3.zero
 for _,v in ipairs({cf.RightVector*size.X/2,cf.UpVector*size.Y/2,cf.LookVector*size.Z/2}) do e+=Vector3.new(math.abs(v.X),math.abs(v.Y),math.abs(v.Z)) end
 return e
end
function M.apply(world)
 assert(game.PlaceId==0 and not game:GetService('RunService'):IsRunning(),'Local Edit only')
 assert(world.Name=='ImpossibleMountain' and not world:FindFirstChild('RidgeRockwork'),'Wrong world or already applied')
 local clearance=require(script.Parent.ArtClearance).build(world,96)
 local protected={}
 for _,p in ipairs(world:GetDescendants()) do
  if p:IsA('BasePart') and (p.CanCollide or p:FindFirstChildOfClass('ProximityPrompt')) then
   table.insert(protected,{p.Position,extent(p.CFrame,p.Size)})
  end
 end
 local function clear(cf,size)
  local e=extent(cf,size)
  if clearance.distance(cf.Position)<size.Magnitude*.5+3 then return false end
  for _,b in ipairs(protected) do
   local d=cf.Position-b[1];local q=b[2]
   if math.abs(d.X)<e.X+q.X+7 and math.abs(d.Z)<e.Z+q.Z+7 and d.Y+e.Y> -q.Y-2 and d.Y-e.Y<q.Y+14 then return false end
  end
  return true
 end
 local root=Instance.new('Folder');root.Name='RidgeRockwork';root.Parent=world
 local terrain=RaycastParams.new();terrain.FilterType=Enum.RaycastFilterType.Include;terrain.FilterDescendantsInstances={workspace.Terrain}
 local rng=Random.new(241020);local stats={rocks=0,rejected=0,plants=0}
 local function rock(cf,size,color,parent)
  if not clear(cf,size) then stats.rejected+=1;return end
  local model=Instance.new('Model');model.Name='RootedCliff'
  local function triangle(a,b,c,tint)
   local ab,ac,bc=b-a,c-a,c-b
   if ab:Dot(ab)>ac:Dot(ac) and ab:Dot(ab)>bc:Dot(bc) then c,a=a,c
   elseif ac:Dot(ac)>bc:Dot(bc) then a,b=b,a end
   ab,ac,bc=b-a,c-a,c-b
   local right=ac:Cross(ab).Unit;local back=bc.Unit;local up=back:Cross(right)
   local h=math.abs(ab:Dot(up))
   for _,s in ipairs({{(a+b)/2,right,up,back,math.abs(ab:Dot(back))},{(a+c)/2,-right,up,-back,math.abs(ac:Dot(back))}}) do
    local p=Instance.new('WedgePart');p.Name='StoneFace';p.Size=Vector3.new(.05,h,s[5]);p.CFrame=CFrame.fromMatrix(s[1],s[2],s[3],s[4]);p.Color=tint;p.Material=Enum.Material.Slate
    p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Parent=model
   end
  end
  local lower,upper={},{}
  for i=1,6 do
   local a=(i-1)*math.pi/3;local r=.43+.05*math.sin(i*2.4)
   lower[i]=cf:PointToWorldSpace(Vector3.new(math.cos(a)*size.X*r,-size.Y*.5,math.sin(a)*size.Z*r))
   upper[i]=cf:PointToWorldSpace(Vector3.new(math.cos(a)*size.X*r*.72+size.X*.08,size.Y*(.29+.10*math.sin(i*1.7)),math.sin(a)*size.Z*r*.72))
  end
  local tip=cf:PointToWorldSpace(Vector3.new(size.X*.06,size.Y*.46,0));local base=cf:PointToWorldSpace(Vector3.new(0,-size.Y*.5,0))
  for i=1,6 do
   local n=i%6+1;local tint=color:Lerp(Color3.fromRGB(206,207,195),.025*(i%3))
   triangle(lower[i],lower[n],upper[i],tint);triangle(lower[n],upper[n],upper[i],tint)
   triangle(upper[i],upper[n],tip,tint);triangle(lower[n],lower[i],base,tint)
  end
  model.Parent=parent
  stats.rocks+=1
 end
 -- Staggered, unequal outcrops interrupt long horizontal faces. Every mass
 -- embeds its rear half into a measured terrain face; no floating fins.
 for band=1,6 do
  local group=Instance.new('Folder');group.Name=C.kingdoms[band].id;group.Parent=root
  for j=1,16 do
   local angle=j*math.pi*2/16+.21*band+.12*math.sin(j*2.1)
   local out=Vector3.new(math.cos(angle),0,math.sin(angle))
   local y=28+(band-1)*136+rng:NextNumber(8,100)
   local hit=workspace:Raycast(out*780+Vector3.new(0,y,0),-out*760,terrain)
   if hit then
    local h=rng:NextNumber(35,70);local width=rng:NextNumber(42,75);local depth=rng:NextNumber(32,48)
    local pos=hit.Position-out*depth*.08-Vector3.new(0,h*.12,0)
    local cf=CFrame.lookAt(pos,pos-out)*CFrame.Angles(0,rng:NextNumber(-.25,.25),rng:NextNumber(-.27,.27))
    local color=workspace.Terrain:GetMaterialColor(hit.Material):Lerp(Color3.fromRGB(126,134,128),.40)
    local backed=true
    for _,dy in ipairs({-h*.35,h*.25}) do
     local probe=workspace:Raycast(out*780+Vector3.new(0,y+dy,0),-out*760,terrain)
     if not probe or (probe.Position-hit.Position).Magnitude>h*.7+depth*.5 then backed=false end
    end
    if backed then rock(cf,Vector3.new(width,h,depth),color,group) else stats.rejected+=1 end
   end
  end
  task.wait()
 end
 -- Underhang clusters break the polygonal shelf fascia without creating
 -- apparent footing beyond the deliberately marked, colliding top surface.
 for ki,k in ipairs(C.kingdoms) do
  local group=root[k.id];local q=C.route(ki,.875)
  local out=Vector3.new(math.cos(q.angle),0,math.sin(q.angle))
  local center=world[k.name].ArenaFloor.Position+Vector3.new(0,2.5,0)
  local frame=CFrame.lookAt(center,center-out)
  for j=1,9 do
   local a=(j-1)*math.pi/8;local x=math.cos(a)*39;local z=48+math.sin(a)*34
   rock(frame*CFrame.new(x,-18-rng:NextNumber(0,7),z)*CFrame.Angles(0,a,.06),Vector3.new(19+rng:NextNumber(0,8),25+rng:NextNumber(0,12),22),A.color(k.rock):Lerp(Color3.fromRGB(185,186,175),.3),group)
  end
  task.wait()
 end
 root:SetAttribute('Revision',1);root:SetAttribute('Report',game.HttpService:JSONEncode(stats))
 return stats
end
return M
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="66">
        <Properties>
          <string name="Name">Sculpt</string>
          <string name="Source"><![CDATA[-- Controlled erosion/material pass for a NEW local review only.
-- Preserves every voxel within expanded gameplay-part bounds. No Terrain:Clear.
local S={}
local C=require(game.ReplicatedStorage.MountainShared.Catalog)
function S.apply(world)
 assert(not game:GetService('RunService'):IsRunning(),'Edit only')
 assert(game.PlaceId==0 and world.Name=='ImpossibleMountain' and not workspace:FindFirstChild('MountainEmpire_Phase1'),'Isolated local mountain only')
 assert(not world:GetAttribute('SculptRevision'),'Do not repeat erosion on a sculpted checkpoint')
 local bins={}
 local function key(x,y,z) return x..':'..y..':'..z end
 for _,p in ipairs(world:GetDescendants()) do
  if p:IsA('BasePart') and (p.CanCollide or p:FindFirstChildOfClass('ProximityPrompt')) then
   local extent=Vector3.zero
   for _,a in ipairs({p.CFrame.RightVector*p.Size.X/2,p.CFrame.UpVector*p.Size.Y/2,p.CFrame.LookVector*p.Size.Z/2}) do extent+=Vector3.new(math.abs(a.X),math.abs(a.Y),math.abs(a.Z)) end
   local lo=p.Position-extent-Vector3.new(16,20,16);local hi=p.Position+extent+Vector3.new(16,22,16)
   for x=math.floor(lo.X/16),math.floor(hi.X/16) do for y=math.floor(lo.Y/16),math.floor(hi.Y/16) do for z=math.floor(lo.Z/16),math.floor(hi.Z/16) do bins[key(x,y,z)]=true end end end
  end
 end
 local terrain=workspace.Terrain;local stats={carved=0,recolored=0,protected=0,tiles=0}
 for bx=-544,512,64 do for bz=-544,512,64 do
  local near=math.max(0,Vector2.new(bx+32,bz+32).Magnitude-46);local far=near+92
  local bottom=math.max(-32,math.floor(((489-far)/.4-160)/4)*4)
  local top=math.min(840,math.ceil(((489-near)/.4+90)/4)*4)
  if top>bottom and far>110 then
   local region=Region3.new(Vector3.new(bx,bottom,bz),Vector3.new(bx+64,top,bz+64))
   local materials,occupancy=terrain:ReadVoxels(region,4);local changed=false
   for x=1,16 do for z=1,16 do
    local wx=bx+(x-.5)*4;local wz=bz+(z-.5)*4;local radius=Vector2.new(wx,wz).Magnitude;local angle=math.atan2(wz,wx)
    if radius>115 then for y=1,#occupancy[x] do
     local wy=bottom+(y-.5)*4
     if occupancy[x][y][z]>0 then
      if bins[key(math.floor(wx/16),math.floor(wy/16),math.floor(wz/16))] then stats.protected+=1
      else
       -- Broad, wandering ravines cut across the horizontal biome terraces.
       local valley=math.max(0,math.sin(angle*5+.6+wy*.0015))^4
       local depth=valley*(32+12*math.sin(wy*.008)^2)
       local limit=489-wy*.4-depth+math.noise(wx/95,wz/95,24)*10
       if radius>limit and radius<550 and wy>0 then
        local next=math.min(occupancy[x][y][z],math.clamp((limit-radius+2)/4,0,1))
        if next<occupancy[x][y][z] then stats.carved+=1;occupancy[x][y][z]=next;changed=true end
       end
       if occupancy[x][y][z]>0 then
        local shift=math.sin(angle*3+.4)*66+math.sin(angle*7-wy/190)*28
        local k=math.clamp(math.floor((wy+shift-16)/136)+1,1,6)
        local material=Enum.Material[C.kingdoms[k].material]
        if valley>.7 and k<5 then material=Enum.Material.Limestone end
        if materials[x][y][z]~=material then materials[x][y][z]=material;stats.recolored+=1;changed=true end
       end
      end
     end
    end end
   end end
   if changed then terrain:WriteVoxels(region,4,materials,occupancy) end
   stats.tiles+=1
  end
  task.wait()
 end end
 world:SetAttribute('SculptRevision',1)
 world:SetAttribute('SculptReport',game.HttpService:JSONEncode(stats))
 return stats
end
return S
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="67">
        <Properties>
          <string name="Name">ShelfGardens</string>
          <string name="Source"><![CDATA[-- Authored planted margins; center approaches and combat boundary stay readable.
local A=require(script.Parent.Art)
local C=require(game.ReplicatedStorage.MountainShared.Catalog)
local G={}
function G.apply(world)
 assert(game.PlaceId==0 and not game:GetService('RunService'):IsRunning(),'Local Edit only')
 assert(not world:FindFirstChild('ShelfGardens'),'Already built')
 local root=Instance.new('Folder');root.Name='ShelfGardens';root.Parent=world
 local crown=game.ServerStorage.MountainArtAssets.BlossomCanopyTemplate:FindFirstChild('crown_geom',true)
 local rng=Random.new(240922);local count=0
 local rays=RaycastParams.new();rays.FilterType=Enum.RaycastFilterType.Include;rays.FilterDescendantsInstances={world.EnvironmentFinish}
 for ki,k in ipairs(C.kingdoms) do
  local group=Instance.new('Folder');group.Name=k.id;group.Parent=root
  local q=C.route(ki,.875);local center=world[k.name].ArenaFloor.Position+Vector3.new(0,2.5,0)
  local frame=CFrame.lookAt(center,center-Vector3.new(math.cos(q.angle),0,math.sin(q.angle)))
  local stone=A.color(k.rock);local leaf=A.color(k.color);local accent=A.color(k.accent)
  -- Surface treatment matches each landmark, keeping the exact support shape.
  for _,p in ipairs(world.EnvironmentFinish[k.id]:GetChildren()) do
   if p.Name=='BackdropWalkSurface' then
    p.Color=if ki==1 then Color3.fromRGB(139,157,106) elseif ki==2 then Color3.fromRGB(124,151,143) else stone:Lerp(Color3.fromRGB(202,199,178),.23)
   end
  end
  for _,spec in ipairs({{-37,49},{-33,68},{-22,77},{-13,83},{15,82},{26,74},{35,61},{39,48}}) do
   local x,z=spec[1],spec[2];local pos=frame:PointToWorldSpace(Vector3.new(x,0,z))
   local hit=workspace:Raycast(pos+Vector3.new(0,8,0),Vector3.new(0,-16,0),rays)
   if hit then
    pos=hit.Position
    -- Low soil/stone islands interrupt the straight fascia, but never project
    -- a walkable-looking cap beyond the actual support found above.
    A.part(group,'PlantingPocket',Vector3.new(7,.22,5),CFrame.new(pos-Vector3.new(0,.06,0))*CFrame.Angles(0,rng:NextNumber(0,6),0),stone:Lerp(Color3.fromRGB(55,64,47),.35),Enum.Material.Ground,Enum.PartType.Ball)
    for stem=1,5 do
     local a=stem*2.4;local base=pos+Vector3.new(math.cos(a)*1.7,0,math.sin(a)*1.4)
     if ki==1 then
      local tip=base+Vector3.new(math.cos(a)*1.2,2.5+stem%3,math.sin(a)*1.2)
      A.link(group,'ShrubStem',base,tip,.15,Color3.fromRGB(100,82,66),Enum.Material.Wood)
      local p=crown:Clone();p.Name='FloweringSpray';p.Size=Vector3.new(3.4,2.2,2.7);p.CFrame=CFrame.new(tip)*CFrame.Angles(0,a,.2);p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Parent=group
     elseif ki==2 or ki==3 then
      local h=if ki==2 then 3.5 else 2.7
      local tip=base+Vector3.new(math.cos(a)*2,h,math.sin(a)*2)
      A.link(group,'FernRachis',base,tip,.12,leaf:Lerp(Color3.fromRGB(36,74,49),.65),Enum.Material.Grass)
      for pair=1,5 do for _,side in ipairs({-1,1}) do
       local along=base:Lerp(tip,pair/6)
       local right=Vector3.new(-math.sin(a),0,math.cos(a))*side
       local endP=along+right*(1.1-pair*.12)+Vector3.new(math.cos(a)*.4,.25,math.sin(a)*.4)
       A.part(group,'Leaflet',Vector3.new(.35,.10,(endP-along).Magnitude*1.8),CFrame.lookAt((along+endP)/2,endP),leaf:Lerp(Color3.fromRGB(73,113,69),.5),Enum.Material.Grass,Enum.PartType.Ball)
      end end
     elseif ki==5 then
      local tip=base+Vector3.new(math.cos(a)*.8,2+stem%3,math.sin(a)*.8)
      A.link(group,'CharredHeather',base,tip,.22,Color3.fromRGB(64,56,58),Enum.Material.Wood)
      for twig=1,3 do A.link(group,'HeatherTwig',base:Lerp(tip,.3+twig*.15),tip+Vector3.new(math.sin(a+twig)*.8,-.5,math.cos(a+twig)*.8),.10,Color3.fromRGB(99,72,62),Enum.Material.Wood) end
     else
      local h=1.5+stem%3*.8;local p=Instance.new('WedgePart');p.Name='MineralGrowth';p.Size=Vector3.new(.6,h,.8);p.CFrame=CFrame.new(base+Vector3.new(0,h*.4,0))*CFrame.Angles(.15,a,.25);p.Color=accent:Lerp(stone,.35);p.Material=Enum.Material.Slate;p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Parent=group
     end
    end
    count+=1
   end
  end
  task.wait()
 end
 root:SetAttribute('Revision',1);root:SetAttribute('RootedPockets',count)
 return {pockets=count,parts=#root:GetDescendants()}
end
return G
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="68">
        <Properties>
          <string name="Name">SlopeGroves</string>
          <string name="Source"><![CDATA[-- Small composed groves on measured terrain shoulders, outside traversal envelopes.
local A=require(script.Parent.Art)
local C=require(game.ReplicatedStorage.MountainShared.Catalog)
local G={}
function G.apply(world)
 assert(game.PlaceId==0 and not game:GetService('RunService'):IsRunning(),'Local Edit only')
 assert(not world:FindFirstChild('SlopeGroves'),'Already built')
 local root=Instance.new('Folder');root.Name='SlopeGroves';root.Parent=world
 local crown=game.ServerStorage.MountainArtAssets.BlossomCanopyTemplate:FindFirstChild('crown_geom',true)
 local protected={}
 for _,p in ipairs(world:GetDescendants()) do if p:IsA('BasePart') and (p.CanCollide or p:FindFirstChildOfClass('ProximityPrompt')) then table.insert(protected,p) end end
 local function clear(pos,h,r)
  for _,p in ipairs(protected) do
   local localPos=p.CFrame:PointToObjectSpace(pos+Vector3.new(0,h/2,0));local e=p.Size/2
   if math.abs(localPos.X)<e.X+r+5 and math.abs(localPos.Z)<e.Z+r+5 and math.abs(localPos.Y)<e.Y+h/2+10 then return false end
  end
  return true
 end
 local rays=RaycastParams.new();rays.FilterType=Enum.RaycastFilterType.Include;rays.FilterDescendantsInstances={workspace.Terrain}
 local rng=Random.new(232424);local stats={trees=0,rejected=0}
 for ki=1,2 do
  local group=Instance.new('Folder');group.Name=C.kingdoms[ki].id;group.Parent=root
  for _,t in ipairs({.045,.13,.25,.38,.48,.61,.72,.81,.94}) do for j=1,4 do
   local q=C.route(ki,t+(j-2)*.008);local out=Vector3.new(math.cos(q.angle),0,math.sin(q.angle))
   local target=Vector3.new(q.x,q.y,q.z)-out*(24+j*9)
   local hit=workspace:Raycast(Vector3.new(target.X,1000,target.Z),Vector3.new(0,-1010,0),rays)
   local h=rng:NextNumber(12,25);local r=if ki==1 then 7 else 8
   if hit and hit.Normal.Y>.60 and hit.Position.Y<310 and clear(hit.Position,h+8,r) then
    local base=hit.Position-Vector3.new(0,.5,0);local tree=Instance.new('Model');tree.Name='ShoulderTree'
    local bend=Vector3.new(rng:NextNumber(-2,2),0,rng:NextNumber(-2,2));local mid=base+Vector3.new(0,h*.55,0)+bend*.4;local top=base+Vector3.new(0,h,0)+bend
    for _,s in ipairs({{base,mid,1.5},{mid,top,.85}}) do A.part(tree,'GrowingTrunk',Vector3.new((s[2]-s[1]).Magnitude,s[3],s[3]),CFrame.lookAt((s[1]+s[2])/2,s[2])*CFrame.Angles(0,math.pi/2,0),Color3.fromRGB(98,82,68),Enum.Material.Wood,Enum.PartType.Cylinder) end
    for b=1,5 do
     local a=b*2.399;local endP=top+Vector3.new(math.cos(a)*4,-2+b%3,math.sin(a)*4)
     A.link(tree,'GrowingBranch',mid:Lerp(top,.5),endP,.32,Color3.fromRGB(98,82,68),Enum.Material.Wood)
     if ki==1 then
      for spray=1,2 do
       local p=crown:Clone();p.Name='BlossomSpray';p.Size=Vector3.new(7,5.2,6)*rng:NextNumber(.8,1.1);p.CFrame=CFrame.new(endP+Vector3.new(math.cos(a+spray)*2,spray-1,math.sin(a+spray)*2))*CFrame.Angles(.2,a+spray,.3);p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Parent=tree
      end
     else
      for leaf=1,6 do
       local u=leaf/6;local pos=top:Lerp(endP,u)+Vector3.new(math.cos(a)*u*3,math.sin(u*math.pi)*1.5,math.sin(a)*u*3)
       for _,side in ipairs({-1,1}) do
        local endLeaf=pos+Vector3.new(-math.sin(a)*side*(3-u),-.4,math.cos(a)*side*(3-u))
        A.part(tree,'FernLeaf',Vector3.new(.75,.14,(endLeaf-pos).Magnitude*1.8),CFrame.lookAt((pos+endLeaf)/2,endLeaf),Color3.fromRGB(63+leaf*3,106+leaf*4,74+leaf*2),Enum.Material.Grass,Enum.PartType.Ball)
       end
      end
     end
    end
    tree.Parent=group;stats.trees+=1
   else stats.rejected+=1 end
  end end
  task.wait()
 end
 root:SetAttribute('Revision',1);root:SetAttribute('Report',game.HttpService:JSONEncode(stats));return stats
end
return G
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="69">
        <Properties>
          <string name="Name">Strata</string>
          <string name="Source"><![CDATA[-- Material-only diagonal geology. No density changes; original play corridors excluded.
local S={}
local function key(x,y,z) return x..':'..y..':'..z end
function S.apply(world)
 assert(not game:GetService('RunService'):IsRunning() and game.PlaceId==0,'Local Edit only')
 assert(world:GetAttribute('MassifRevision')==1 and not world:GetAttribute('StrataRevision'),'Requires unpainted Massif checkpoint')
 local protect={}
 for _,p in ipairs(world:GetDescendants()) do
  if p:IsA('BasePart') and (p.CanCollide or p:FindFirstChildOfClass('ProximityPrompt')) then
   local e=Vector3.zero
   for _,a in ipairs({p.CFrame.RightVector*p.Size.X/2,p.CFrame.UpVector*p.Size.Y/2,p.CFrame.LookVector*p.Size.Z/2}) do e+=Vector3.new(math.abs(a.X),math.abs(a.Y),math.abs(a.Z)) end
   local lo=p.Position-e-Vector3.new(16,20,16);local hi=p.Position+e+Vector3.new(16,22,16)
   for x=math.floor(lo.X/16),math.floor(hi.X/16) do for y=math.floor(lo.Y/16),math.floor(hi.Y/16) do for z=math.floor(lo.Z/16),math.floor(hi.Z/16) do protect[key(x,y,z)]=true end end end
  end
 end
 local painted=0
 for bx=-544,480,64 do for bz=-544,480,64 do
  local near=math.max(0,Vector2.new(bx+32,bz+32).Magnitude-46);local far=near+92
  local bottom=math.max(0,math.floor(((489-far)/.4-160)/4)*4)
  local top=math.min(824,math.ceil(((489-near)/.4+90)/4)*4)
  if top>bottom and far>110 then
   local region=Region3.new(Vector3.new(bx,bottom,bz),Vector3.new(bx+64,top,bz+64))
   local mat,occ=workspace.Terrain:ReadVoxels(region,4);local changed=false
   for x=1,16 do for z=1,16 do
    local wx=bx+(x-.5)*4;local wz=bz+(z-.5)*4;local angle=math.atan2(wz,wx)
    for y=1,#occ[x] do
     local wy=bottom+(y-.5)*4
     if occ[x][y][z]>0 and not protect[key(math.floor(wx/16),math.floor(wy/16),math.floor(wz/16))] then
      -- Broad, irregular seams cross several biome heights instead of following level bands.
      local seam=math.sin(angle*3-wy*.0038+.7)+math.noise(wx/73,wy/95,wz/73)*.36
      if seam>.62 then
       local material=if seam>.95 then Enum.Material.Limestone else Enum.Material.Slate
       if mat[x][y][z]~=material then mat[x][y][z]=material;painted+=1;changed=true end
      end
     end
    end
   end end
   if changed then workspace.Terrain:WriteVoxels(region,4,mat,occ) end
  end
  task.wait()
 end end
 world:SetAttribute('StrataRevision',1);world:SetAttribute('StrataPaintedCells',painted)
 return {painted=painted,occupancyChanges=0}
end
return S
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="70">
        <Properties>
          <string name="Name">TraversalArt</string>
          <string name="Source"><![CDATA[-- Idempotent additions to the isolated baked world. Never touches Phase 1 or Terrain.
local A=require(script.Parent.Art)
local C=require(game.ReplicatedStorage.MountainShared.Catalog)
local T={}
function T.repairBranches(world)
 T.repairLabels(world)
 if world:GetAttribute('BranchAccessRevision')==1 then return end
 for k,kingdom in ipairs(C.kingdoms) do
  local q=C.route(k,.29);local outward=Vector3.new(math.cos(q.angle),0,math.sin(q.angle))
  local center=Vector3.new(q.x,q.y,q.z)+outward*48
  local frame=CFrame.lookAt(center,center-outward)
  local walls={}
  for _,part in ipairs(world[kingdom.name]:GetChildren()) do
   if part.Name=='CaveWall' and (part.Position-center).Magnitude<30 then table.insert(walls,part)
   elseif part.Name=='CaveVault' and (part.Position-center).Magnitude<30 then part.CFrame=frame*CFrame.new(0,14,5) end
  end
  table.sort(walls,function(a,b)return a.Position.X<b.Position.X end)
  for i,part in ipairs(walls) do part.CFrame=frame*CFrame.new(if i==1 then -14 else 14,7,5) end
 end
 world:SetAttribute('BranchAccessRevision',1)
end
function T.repairLabels(world)
 -- Earlier baked checkpoints contain repeatedly mis-decoded UTF-8 separators.
 -- Rebuild known display labels from catalog data; leave prompt contracts intact.
 local count=0
 for _,model in ipairs(world.Encounters:GetChildren()) do
  local species=C.byId[string.lower(model.Name)]
  if species and model.PrimaryPart then
   local gui=model.PrimaryPart:FindFirstChild('Label')
   local label=gui and gui:FindFirstChildOfClass('TextLabel')
   if label then label.Text=species.name..' / '..species.rarity;count+=1 end
  end
 end
 for _,v in ipairs(world:GetDescendants()) do
  if v:IsA('TextLabel') and v.Parent.Name=='Label' then
   local part=v.Parent.Parent
   if part.Name=='ClimbLadder' and part:GetAttribute('RopeLadder') then v.Text='Rope ascent / move toward rope';count+=1
   elseif part.Name=='ShiftingSand' then v.Text='Shifting sand / walk against the flow';count+=1
   elseif part.Name=='KingdomLift_6' then v.Text='Gravity platform / jump lightly';count+=1 end
  end
 end
 return count
end
function T.apply(world)
 assert(world.Name=='ImpossibleMountain' and not workspace:FindFirstChild('MountainEmpire_Phase1'),'Wrong world')
 T.repairBranches(world)
 T.repairLabels(world)
 if world:GetAttribute('TraversalRevision')==1 then return end
 local azure=world:FindFirstChild('Azure Falls')
 local index=0
 for _,ladder in ipairs(azure:GetChildren()) do
  if ladder:IsA('TrussPart') then
   index+=1
   if index%2==0 then
    ladder.Transparency=1;ladder:SetAttribute('RopeLadder',true)
    local f=Instance.new('Folder');f.Name='FunctionalRopeLadder';f.Parent=azure
    local half=ladder.Size.Y/2
    for _,side in ipairs({-1,1}) do
     A.link(f,'LoadBearingRope',ladder.Position+Vector3.new(side*1.2,-half,0),ladder.Position+Vector3.new(side*1.2,half,0),.3,Color3.fromRGB(186,156,102),Enum.Material.Fabric)
    end
    for y=-half,half,1.5 do
     A.part(f,'RopeRung',Vector3.new(2.7,.3,.4),CFrame.new(ladder.Position+Vector3.new(0,y,0)),Color3.fromRGB(142,107,67),Enum.Material.Wood)
    end
    A.label(ladder,'Rope ascent / move toward rope',half+2)
   end
  end
 end
 local sand=world:FindFirstChild('Sunstone Desert'):FindFirstChild('ChallengeAccess')
 assert(sand and sand:IsA('BasePart'),'Missing sand challenge approach')
 sand.Name='ShiftingSand';sand.Material=Enum.Material.Sand;sand.Color=Color3.fromRGB(225,184,111)
 sand:SetAttribute('Kind','ShiftingSand');sand:SetAttribute('Kingdom',3);sand.Parent=world.Dynamics
 A.label(sand,'Shifting sand / walk against the flow',5)
 local lift=world.Dynamics:FindFirstChild('KingdomLift_6')
 assert(lift,'Missing Astral platform')
 lift:SetAttribute('GravityField',true)
 A.label(lift,'Gravity platform / jump lightly',5)
 for i=1,12 do
  local angle=i*math.pi/6
  A.part(lift,'GravityInlay',Vector3.new(.25,.12,1.5),lift.CFrame*CFrame.new(math.cos(angle)*4.8,.57,math.sin(angle)*4.8)*CFrame.Angles(0,-angle,0),Color3.fromRGB(147,196,233),Enum.Material.Metal)
 end
 world:SetAttribute('TraversalRevision',1)
end
return T
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="71">
        <Properties>
          <string name="Name">WallGrowth</string>
          <string name="Source"><![CDATA[-- Terrain-following ivy ribbons above the lower trails.
local A=require(script.Parent.Art)
local C=require(game.ReplicatedStorage.MountainShared.Catalog)
local G={}
function G.apply(world)
 assert(game.PlaceId==0 and not game:GetService('RunService'):IsRunning(),'Local Edit only')
 assert(not world:FindFirstChild('WallGrowth'),'Already applied')
 local root=Instance.new('Folder');root.Name='WallGrowth';root.Parent=world
 local rays=RaycastParams.new();rays.FilterType=Enum.RaycastFilterType.Include;rays.FilterDescendantsInstances={workspace.Terrain}
 local count=0
 for ki=1,2 do
  for j=1,16 do
   local q=C.route(ki,(j-.5)/16);local phase=j*2.399
   local out=Vector3.new(math.cos(q.angle),0,math.sin(q.angle));local tangent=Vector3.new(-out.Z,0,out.X)
   local prior
   for step=0,12 do
    local y=q.y+28+step*2.2;local drift=tangent*math.sin(step*.4+phase)*1.6
    local hit=workspace:Raycast(out*700+Vector3.new(0,y,0)+drift,-out*690,rays)
    if hit and hit.Normal.Y<.6 then
     local p=hit.Position+hit.Normal*.35
     if prior and (p-prior).Magnitude<6 then
      A.link(root,'ClingingStem',prior,p,.18,Color3.fromRGB(75,86,55),Enum.Material.Wood)
      for _,side in ipairs({-1,1}) do
       local endP=p+tangent*side*(1.8+math.sin(step*.7)*.5)+Vector3.new(0,.7,0)
       A.part(root,'IvyLeaf',Vector3.new(1.2,.20,(endP-p).Magnitude*1.6),CFrame.lookAt((p+endP)/2,endP),Color3.fromRGB(70+step%3*8,107+step%4*6,62+ki*8),Enum.Material.Grass,Enum.PartType.Ball)
      end
      count+=1
     end
     prior=p
    else prior=nil end
   end
   task.wait()
  end
 end
 root:SetAttribute('Revision',1);root:SetAttribute('RootedSegments',count);return {segments=count}
end
return G
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="72">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[local C=require(game.ReplicatedStorage.MountainShared.Catalog)
local TerrainProfile=require(game.ReplicatedStorage.MountainShared.TerrainProfile)
local A=require(script.Parent.Art)
local Landmarks=require(script.Parent.Landmarks)
local W={}
local function v(p) return Vector3.new(p.x,p.y,p.z) end
local function folder(parent,name) local f=Instance.new('Folder');f.Name=name;f.Parent=parent;return f end
local function attrs(p,t) for k,x in pairs(t) do p:SetAttribute(k,x) end end
local function prompt(p,action,kind,k,id)
 attrs(p,{Kind=kind,Kingdom=k,Id=id or p.Name})
 local q=Instance.new('ProximityPrompt');q.ActionText=action;q.ObjectText=p.Name;q.HoldDuration=.4;q.MaxActivationDistance=12;q.RequiresLineOfSight=false;q.Parent=p;return p
end
local function deck(parent,name,pos,size,color,material)
 return A.part(parent,name,size,CFrame.new(pos-Vector3.new(0,size.Y/2,0)),color,material,nil,true)
end
local function walkway(parent,name,a,b,width,k)
 local delta=b-a;local len=delta.Magnitude
 workspace.Terrain:FillBlock(CFrame.lookAt((a+b)/2+Vector3.new(0,10,0),b+Vector3.new(0,10,0)),Vector3.new(width+6,20,len+4),Enum.Material.Air)
 return A.part(parent,name,Vector3.new(width,1.2,len+1),CFrame.lookAt((a+b)/2,b),A.color(k.color):Lerp(Color3.fromRGB(211,201,173),.5),Enum.Material.Cobblestone,nil,true)
end
local function arch(parent,pos,k,radius,frame)
 frame=frame or CFrame.new(pos)
 local col=A.color(k.rock):Lerp(Color3.new(1,1,1),.3)
 for i=0,10 do local a=math.pi*i/10
  A.part(parent,'ArchVoussoir',Vector3.new(4,5,6),frame*CFrame.new(math.cos(a)*radius,7+math.sin(a)*radius,0)*CFrame.Angles(0,0,a-math.pi/2),col,Enum.Material.Marble,nil,true)
 end
 for _,s in ipairs({-1,1}) do A.part(parent,'Pillar',Vector3.new(4,9,6),frame*CFrame.new(s*radius,4.5,0),col,Enum.Material.Marble,nil,true) end
end
function W.build()
 assert(not workspace:FindFirstChild('MountainEmpire_Phase1'),'Never build in Phase 1')
 assert(not workspace:FindFirstChild('ImpossibleMountain'),'Mountain already built; use a new review place')
 local root=folder(workspace,'ImpossibleMountain');root:SetAttribute('GeneratorVersion',C.version)
 local checkpoints=folder(root,'Checkpoints');local interactions=folder(root,'Interactions');local dynamics=folder(root,'Dynamics');local encounters=folder(root,'Encounters')
 local terrain=workspace.Terrain
 for name,rgb in pairs({Grass={104,139,98},Slate={105,116,117},Sandstone={179,161,128},Rock={116,123,120},Basalt={70,68,73},Snow={219,225,226}}) do
  terrain:SetMaterialColor(Enum.Material[name],Color3.fromRGB(rgb[1],rgb[2],rgb[3]))
 end
 -- Continuous solid mass, bounded to a new place. No Terrain:Clear call.
 -- Irregular ridged heightfield, smooth voxel occupancy and asymmetric buttresses.
 -- Write in 64-stud tiles so the editor remains responsive.
 for bx=-704,640,64 do for bz=-704,640,64 do
  local heights,topMaterials={},{};local maxH=-32
  for x=1,16 do heights[x]={};topMaterials[x]={};for z=1,16 do
   local wx=bx+(x-.5)*4;local wz=bz+(z-.5)*4
   local h=TerrainProfile.height(wx,wz)
   h=math.max(-32,h);heights[x][z]=h;maxH=math.max(maxH,h)
   local slope=math.sqrt((TerrainProfile.height(wx+4,wz)-TerrainProfile.height(wx-4,wz))^2+(TerrainProfile.height(wx,wz+4)-TerrainProfile.height(wx,wz-4))^2)/8
   local material=Enum.Material.Rock
   if h<330 and slope<1.9 then material=Enum.Material.Grass
   elseif h>740 and slope<1.65 then material=Enum.Material.Snow
   elseif math.sin(wx/110+wz/170)>.4 then material=Enum.Material.Slate end
   topMaterials[x][z]=material
  end end
  if maxH>-28 then
   local ny=math.ceil((maxH+36)/4);local materials,occupancy={},{}
   for x=1,16 do materials[x]={};occupancy[x]={};for y=1,ny do
    materials[x][y]={};occupancy[x][y]={};local wy=-32+(y-.5)*4
    for z=1,16 do
     local h=heights[x][z]
     materials[x][y][z]=topMaterials[x][z];occupancy[x][y][z]=math.clamp((h-(wy-2))/4,0,1)
    end
   end end
   terrain:WriteVoxels(Region3.new(Vector3.new(bx,-32,bz),Vector3.new(bx+64,-32+ny*4,bz+64)),4,materials,occupancy)
  end
  task.wait()
 end end
 local rng=Random.new(C.seed);local allLadderClearances={};local routeOpenings={}
 for ki,k in ipairs(C.kingdoms) do
  local region=folder(root,k.name);region:SetAttribute('Kingdom',ki)
  -- Larger naturally broken rock silhouettes behind routes; path is carved afterward.
  for j=1,28 do
   local t=(j-.5)/28;local q=C.route(ki,t);local a=q.angle+.2
   local pos=Vector3.new(math.cos(a)*(q.radius-33),q.y-6,math.sin(a)*(q.radius-33))
   terrain:FillBall(pos,rng:NextNumber(16,24),Enum.Material[k.material])
  end
  local last=v(C.route(ki,0));local ladderClearances={}
  for i=1,48 do
   local q=C.route(ki,i/48);local p=v(q)
   local delta=p-last
   -- Stable natural ledge support at the trail's outer rim.
   local carveEnd=if i%12==0 then Vector3.new(p.X,last.Y,p.Z) else p
   local carveDelta=carveEnd-last
   table.insert(routeOpenings,{a=last,b=carveEnd})
   terrain:FillBlock(CFrame.lookAt((carveEnd+last)/2-Vector3.new(0,7,0),carveEnd-Vector3.new(0,7,0)),Vector3.new(23,12,carveDelta.Magnitude+4),Enum.Material.Rock)
   terrain:FillBlock(CFrame.lookAt((carveEnd+last)/2+Vector3.new(0,10,0),carveEnd+Vector3.new(0,10,0)),Vector3.new(27,22,carveDelta.Magnitude+4),Enum.Material.Air)
   if i%12==0 then terrain:FillBlock(CFrame.new((p+carveEnd)/2+Vector3.new(0,4,0)),Vector3.new(18,p.Y-carveEnd.Y+12,18),Enum.Material.Air) end
   if i%12==0 then
    local foot=Vector3.new(p.X,last.Y,p.Z)
    walkway(region,'CliffApproach',last,foot,14,k)
    local approach=(foot-last).Unit;local ladderPosition=p-approach*C.ladderSetback(ki,i)
    local truss=Instance.new('TrussPart');truss.Name='ClimbLadder';truss.Anchored=true;truss.Size=Vector3.new(2,p.Y-last.Y+5,2);truss.CFrame=CFrame.new(ladderPosition-Vector3.new(0,(p.Y-last.Y)/2,0));truss.Color=A.color(k.accent);truss.Parent=region
    table.insert(ladderClearances,{pos=ladderPosition,low=last.Y})
    table.insert(allLadderClearances,{pos=ladderPosition,low=last.Y,top=p})
    local setback=C.ladderSetback(ki,i)
    local landingCenter=p+approach*((9.5-setback)/2)+Vector3.new(0,-.4,0)
    local landing=deck(region,'ClimbLanding',landingCenter,Vector3.new(18,1,setback+2.5),A.color(k.rock),Enum.Material[k.material])
    landing.CFrame=CFrame.lookAt(landing.Position,landing.Position+approach)
    for _,sign in ipairs({-1,1}) do A.link(region,'ClimbingRope',foot+Vector3.new(sign*2,0,0),p+Vector3.new(sign*2,2,0),.22,Color3.fromRGB(201,175,126),Enum.Material.Fabric) end
   else walkway(region,'PrimaryAscent',last,p,16,k) end
   if i%3==0 then
    local side=Vector3.new(math.cos(q.angle),0,math.sin(q.angle));local pos=p+side*13
    local post=A.part(region,'Wayfinder',Vector3.new(.6,4,.6),CFrame.new(pos+Vector3.new(0,2,0)),A.color(k.rock),Enum.Material.Wood)
    A.part(region,'RouteFlag',Vector3.new(2.5,1.5,.2),post.CFrame*CFrame.new(1,1,0),A.color(k.accent),Enum.Material.Fabric)
    if i%3==0 then
     local point=p-side*18
     if ki==3 or ki==4 or ki==6 then A.crystal(region,point,k,8) else A.tree(region,point,k,rng) end
     for plant=1,3 do
      local plantPos=p-side*(14+plant*3)+Vector3.new(math.cos(plant*2)*7,0,math.sin(plant*2)*7)
      if ki==1 or ki==2 then
       for leaf=1,4 do A.part(region,'FernFrond',Vector3.new(.5,3.6,1.2),CFrame.new(plantPos+Vector3.new(0,1,0))*CFrame.Angles(.8,leaf*math.pi/2,0),A.color(k.color):Lerp(Color3.fromRGB(57,111,74),.5),Enum.Material.Grass,Enum.PartType.Ball) end
      elseif ki==3 then
       A.part(region,'DesertSucculent',Vector3.new(1.5,5+plant,1.5),CFrame.new(plantPos+Vector3.new(0,2.5,0)),Color3.fromRGB(103,144,102),Enum.Material.Grass,Enum.PartType.Ball)
      else A.crystal(region,plantPos,k,3+plant) end
     end
     for n=1,6 do
      local pt=p+side*(10+n*.8)+Vector3.new(math.cos(n*2)*5,0,math.sin(n*2)*5)
      A.part(region,'Wildflower',Vector3.new(1.1,.5,1.1),CFrame.new(pt+Vector3.new(0,.6,0)),A.color(k.accent),Enum.Material.Grass,Enum.PartType.Ball)
     end
    end
   end
   last=p
   if i%12==0 then task.wait() end
  end
  for _,climb in ipairs(ladderClearances) do
   terrain:FillBlock(CFrame.new(climb.pos.X,(climb.pos.Y+climb.low)/2+4,climb.pos.Z),Vector3.new(9,climb.pos.Y-climb.low+13,9),Enum.Material.Air)
  end
  -- Checkpoints at the entrance, mid-route recovery and Guardian approach.
  for _,spec in ipairs({{'entrance',0},{'recovery',.50},{'guardian',.875}}) do
   local pos=v(C.route(ki,spec[2]));local p=deck(checkpoints,ki..':'..spec[1],pos+Vector3.new(0,.3,0),Vector3.new(18,1,18),A.color(k.accent),Enum.Material.Slate)
   local ladderKingdom,ladderStep=ki,24
   if spec[1]=='entrance' then ladderKingdom,ladderStep=ki-1,48 end
   if spec[1]=='recovery' or (spec[1]=='entrance' and ki>1) then
    local before=v(C.route(ladderKingdom,(ladderStep-1)/48))
    local direction=Vector3.new(pos.X-before.X,0,pos.Z-before.Z).Unit
    local center=p.Position+direction*math.max(0,12.5-C.ladderSetback(ladderKingdom,ladderStep))
    p.CFrame=CFrame.lookAt(center,center+direction)
   end
   prompt(p,'Rest / extract eggs','Checkpoint',ki,p.Name);A.label(p,k.name..'\n'..spec[1],5)
  end
  -- Two optional discoveries, with readable branches and varied environmental compositions.
  for branch,t in ipairs({.29,.66}) do
   local q=C.route(ki,t);local base=v(q);local outward=Vector3.new(math.cos(q.angle),0,math.sin(q.angle));local pos=base+outward*48
   walkway(region,'ExplorationBranch_'..branch,base,pos,10,k)
   terrain:FillBall(pos-Vector3.new(0,28,0),32,Enum.Material[k.material])
   for n=1,4 do terrain:FillBall(pos-outward*n*10-Vector3.new(0,28+n*12,0),26,Enum.Material[k.material]) end
   terrain:FillBlock(CFrame.new(pos+Vector3.new(0,12,0)),Vector3.new(36,24,34),Enum.Material.Air)
   deck(region,'BranchTerrace',pos,Vector3.new(34,5,32),A.color(k.rock),Enum.Material[k.material])
   local archPos=pos-outward*7
   arch(region,archPos,k,10,CFrame.lookAt(archPos,archPos-outward))
   Landmarks.branch(region,k,ki,branch,pos)
   local marker=A.part(interactions,k.landmarks[branch+1],Vector3.new(3,3,3),CFrame.new(pos+Vector3.new(-8,2,0)),A.color(k.accent),Enum.Material.Marble,Enum.PartType.Ball)
   prompt(marker,'Discover / gather','Discovery',ki,ki..':branch'..branch);A.label(marker,k.landmarks[branch+1],7)
   local nest=A.part(interactions,'Hidden nest',Vector3.new(3,4,3),CFrame.new(pos+Vector3.new(7,2,0)),A.color(k.accent),Enum.Material.SmoothPlastic,Enum.PartType.Ball)
   prompt(nest,'Collect egg','Nest',ki,ki..':nest'..branch)
   if branch==2 then
    local short=A.part(interactions,'Ancient shortcut',Vector3.new(3,5,3),CFrame.new(pos+Vector3.new(0,2,8)),A.color(k.accent),Enum.Material.Marble)
    prompt(short,'Attune shortcut','Shortcut',ki,tostring(ki))
   end
   -- Roofed side cavern entrance; the main mountain remains solid.
   if branch==1 then
    for _,side in ipairs({-1,1}) do A.part(region,'CaveWall',Vector3.new(5,14,18),CFrame.new(pos+Vector3.new(side*14,7,5)),A.color(k.rock),Enum.Material[k.material],nil,true) end
    A.part(region,'CaveVault',Vector3.new(32,5,18),CFrame.new(pos+Vector3.new(0,14,5)),A.color(k.rock),Enum.Material[k.material],nil,true)
   end
  end
  -- Habitat encounter for every regular species, six distinct silhouettes per kingdom.
  for j=1,6 do
   local s=C.species[(ki-1)*6+j];local q=C.route(ki,.08+j*.115);local pos=v(q)+Vector3.new(math.cos(q.angle)*19,1,math.sin(q.angle)*19)
   deck(region,'EncounterLedge',pos-Vector3.new(0,1,0),Vector3.new(16,2,16),A.color(k.rock),Enum.Material[k.material])
   local pet=A.creature(encounters,s,pos,1.3,1);local trigger=pet.PrimaryPart
   prompt(trigger,'Wild encounter','Wild',ki,s.id);A.label(trigger,s.name..' / '..s.rarity,5)
  end
  local q=C.route(ki,.875);local entry=v(q);local outward=Vector3.new(math.cos(q.angle),0,math.sin(q.angle));local arena=entry+outward*66
  walkway(region,'GuardianApproach',entry,arena,18,k)
  terrain:FillBall(arena-Vector3.new(0,42,0),48,Enum.Material[k.material])
  for n=1,5 do terrain:FillBall(arena-outward*n*12-Vector3.new(0,42+n*12,0),36,Enum.Material[k.material]) end
  terrain:FillBlock(CFrame.new(arena+Vector3.new(0,18,0)),Vector3.new(86,36,86),Enum.Material.Air)
  local floor=A.part(region,'ArenaFloor',Vector3.new(5,82,82),CFrame.new(arena-Vector3.new(0,2.5,0))*CFrame.Angles(0,0,math.pi/2),A.color(k.rock),Enum.Material[k.material],Enum.PartType.Cylinder,true)
  floor:SetAttribute('Arena',ki)
  Landmarks.build(region,k,ki,arena)
  for _,angle in ipairs(C.guardianColumnAngles(ki)) do
   local j=math.floor(angle/(math.pi/6)+.5)
   local pos=arena+Vector3.new(math.cos(angle)*38,0,math.sin(angle)*38)
   A.part(region,'ArenaColumn',Vector3.new(3,12+(j%3)*3,3),CFrame.new(pos+Vector3.new(0,6,0)),A.color(k.rock):Lerp(Color3.new(1,1,1),.25),Enum.Material.Marble,nil,true)
   A.crystal(region,pos+Vector3.new(0,12,0),k,3)
  end
  local boss=A.creature(encounters,C.guardians[ki],arena+Vector3.new(0,1,-10),4.5,1);boss.Name='Guardian_'..ki
  local altar=A.part(interactions,C.guardians[ki].name,Vector3.new(4,3,4),CFrame.new(arena+Vector3.new(0,2,25)),A.color(k.accent),Enum.Material.Marble)
  attrs(altar,{ArenaX=arena.X,ArenaY=arena.Y,ArenaZ=arena.Z});prompt(altar,'Challenge Guardian','Guardian',ki,tostring(ki));A.label(altar,k.landmarks[1],8)
  local trial=A.part(interactions,'Legendary Trial',Vector3.new(3,4,3),CFrame.new(arena+Vector3.new(11,2,24)),A.color(k.accent),Enum.Material.Glass)
  prompt(trial,'Begin mastery trial','Trial',ki,tostring(ki))
  -- Biome signature: falls, oasis, crystals, lava and celestial rings.
  if ki==2 or ki==5 then
   for j=1,3 do
    local qp=C.route(ki,.15+j*.16);local pos=v(qp)-Vector3.new(math.cos(qp.angle)*32,0,math.sin(qp.angle)*32)
    local fall=A.part(region,if ki==2 then 'TurquoiseCascade' else 'Lavafall',Vector3.new(9,65,2),CFrame.new(pos-Vector3.new(0,22,0))*CFrame.Angles(0,-qp.angle,0),A.color(k.accent),if ki==2 then Enum.Material.Glass else Enum.Material.Neon)
    fall.Transparency=if ki==2 then .3 else .12
    A.part(region,'MistPool',Vector3.new(26,1,22),CFrame.new(pos-Vector3.new(0,54,0)),A.color(k.accent),Enum.Material.Glass,Enum.PartType.Ball)
   end
  end
  if ki==6 then
   for ring=1,3 do for j=1,24 do local a=j*math.pi/12;local r=25+ring*10
    A.part(region,'ConstellationRing',Vector3.new(1,1,10),CFrame.new(Vector3.new(math.cos(a)*r,850+ring*8,math.sin(a)*r))*CFrame.Angles(0,-a,0),A.color(k.accent),Enum.Material.Metal)
   end end
   arch(region,Vector3.new(0,837,0),k,25)
   local summitStart=v(C.route(6,1));local summitEnd=Vector3.new(0,840,0)
   terrain:FillBlock(CFrame.lookAt((summitStart+summitEnd)/2+Vector3.new(0,10,0),summitEnd+Vector3.new(0,10,0)),Vector3.new(24,22,(summitEnd-summitStart).Magnitude+4),Enum.Material.Air)
   walkway(region,'FinalSummitAscent',summitStart,summitEnd,16,k)
   local summit=deck(interactions,'Impossible Summit',Vector3.new(0,840,0),Vector3.new(55,3,55),A.color(k.color),Enum.Material.Marble)
   terrain:FillBlock(CFrame.new(0,853,0),Vector3.new(70,24,70),Enum.Material.Air)
   prompt(summit,'Celebrate summit','Summit',6,'summit');A.label(summit,'IMPOSSIBLE MOUNTAIN\nEternal Astral Sanctum',14)
  end
  -- Moving bonus platform and a timed hazard sit on an optional challenge ledge.
  local dp=v(C.route(ki,.42));local radial=Vector3.new(math.cos(C.route(ki,.42).angle),0,math.sin(C.route(ki,.42).angle))
  local start=dp+radial*22;walkway(region,'ChallengeAccess',dp,start,10,k)
  local mover=deck(dynamics,'KingdomLift_'..ki,start,Vector3.new(12,1,12),A.color(k.accent),Enum.Material[k.material]);attrs(mover,{Kind='Moving',Kingdom=ki,AxisX=radial.X,AxisZ=radial.Z})
  if ki==1 then for j=1,6 do local a=j*math.pi/3;A.part(mover,'FlowerPetal',Vector3.new(5,.6,3),CFrame.new(start+Vector3.new(math.cos(a)*5,0,math.sin(a)*5))*CFrame.Angles(0,-a,0),A.color(k.accent),Enum.Material.Grass,Enum.PartType.Ball) end end
  local endP=dp+radial*57;deck(region,'ChallengeRewardLedge',endP,Vector3.new(18,2,18),A.color(k.rock),Enum.Material[k.material])
  local puzzle=A.part(interactions,'Constellation mechanism',Vector3.new(3,4,3),CFrame.new(endP+Vector3.new(0,2,0)),A.color(k.accent),Enum.Material.Marble)
  prompt(puzzle,'Align three runes','Puzzle',ki,ki..':puzzle')
  if ki==3 then
   local crumble=walkway(dynamics,'CrumblingSandstone',endP,endP+Vector3.new(18,0,0),8,k);attrs(crumble,{Kind='Crumbling',Kingdom=ki})
  end
  local hazard=deck(dynamics,'TimedHazard_'..ki,dp+radial*42+Vector3.new(0,-2,0),Vector3.new(14,.5,14),A.color(k.accent),Enum.Material.Neon);attrs(hazard,{Kind='Hazard',Kingdom=ki});hazard.CanCollide=false
  task.wait()
 end
 -- Open the outer side of each trail to the sky, preserving its supported floor.
 for _,opening in ipairs(routeOpenings) do
  local a,b=opening.a,opening.b;local mid=(a+b)/2
  local outward=Vector3.new(mid.X,0,mid.Z).Unit*22
  terrain:FillBlock(CFrame.lookAt(mid+outward+Vector3.new(0,12,0),b+outward+Vector3.new(0,12,0)),Vector3.new(55,24,(b-a).Magnitude+5),Enum.Material.Air)
 end
 for _,climb in ipairs(allLadderClearances) do
  terrain:FillBlock(CFrame.new(climb.pos.X,(climb.pos.Y+climb.low)/2+5,climb.pos.Z),Vector3.new(11,climb.pos.Y-climb.low+16,11),Enum.Material.Air)
  local a=climb.pos+Vector3.new(0,8,0);local b=climb.top+Vector3.new(0,8,0)
  terrain:FillBlock(CFrame.lookAt((a+b)/2,b),Vector3.new(22,16,(b-a).Magnitude+20),Enum.Material.Air)
 end
 local refuge=folder(root,'ExpeditionRefuge_IntegrationFixture')
 deck(refuge,'RefugeIsland',Vector3.new(0,16,560),Vector3.new(130,14,110),Color3.fromRGB(121,150,125),Enum.Material.Grass)
 walkway(refuge,'GatewayInterface',Vector3.new(0,16,515),v(C.route(1,0)),20,C.kingdoms[1])
 terrain:FillBlock(CFrame.new(0,66,502),Vector3.new(30,100,62),Enum.Material.Air)
 arch(refuge,Vector3.new(0,16,515),C.kingdoms[1],14)
 local spawn=Instance.new('SpawnLocation');spawn.Name='MountainArrival';spawn.Anchored=true;spawn.Size=Vector3.new(8,1,8);spawn.CFrame=CFrame.new(0,17,555);spawn.Transparency=1;spawn.Neutral=true;spawn.Duration=0;spawn.Parent=refuge
 for i,name in ipairs({'Incubator','Sanctuary','Training','Competition'}) do
  local pos=Vector3.new(-45+(i-1)*30,16,585)
  deck(refuge,name..'Dais',pos,Vector3.new(21,2,18),Color3.fromRGB(194,183,159),Enum.Material.Cobblestone)
  local p=A.part(interactions,name,Vector3.new(5,4,5),CFrame.new(pos+Vector3.new(0,2,0)),Color3.fromRGB(171,218,203),Enum.Material.Marble)
  prompt(p,'Open '..name,name,1,name);A.label(p,name,6)
 end
 local gateway=Instance.new('Attachment');gateway.Name='MountainGatewayEntry';gateway.CFrame=CFrame.new(0,20,545);gateway.Parent=workspace.Terrain
 for j=1,12 do A.tree(refuge,Vector3.new(if j%2==0 then 54 else -54,16,510+j*7),C.kingdoms[1],rng) end
 local L=game:GetService('Lighting');L.ClockTime=13.5;L.Brightness=2.5;L.Ambient=Color3.fromRGB(119,133,151);L.OutdoorAmbient=Color3.fromRGB(149,165,181)
 local atmosphere=Instance.new('Atmosphere');atmosphere.Density=.23;atmosphere.Offset=.12;atmosphere.Color=Color3.fromRGB(203,226,241);atmosphere.Decay=Color3.fromRGB(132,153,179);atmosphere.Parent=L
 local bloom=Instance.new('BloomEffect');bloom.Intensity=.18;bloom.Size=20;bloom.Threshold=1.4;bloom.Parent=L
 for name,id in pairs({['Mountain Birds 1 (SFX)']='9112832288',WaterfallLoop='137800539959141',AstralWind='9125742262',LavaLoop='318794788'}) do
  local sound=game:GetService('SoundService'):FindFirstChild(name)
  if not sound then sound=Instance.new('Sound');sound.Name=name;sound.SoundId='rbxassetid://'..id;sound.Parent=game:GetService('SoundService') end
  sound.Volume=0;sound.Looped=true
 end
 require(script.Parent.TraversalArt).apply(root)
 root:SetAttribute('Ready',true)
 return {kingdoms=6,species=36,guardians=6,checkpoints=#checkpoints:GetChildren(),instances=#root:GetDescendants()}
end
return W
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="73">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="74">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="75">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="76">
        <Properties>
          <string name="Name">MountainClient</string>
        </Properties>
        <Item class="LocalScript" referent="77">
          <Properties>
            <string name="Name">AltitudeAtmosphere</string>
            <string name="Source"><![CDATA[-- Local, cosmetic altitude response; never changes weather, physics or game state.
local Players=game:GetService('Players')
local Run=game:GetService('RunService')
local Lighting=game:GetService('Lighting')
local Input=game:GetService('UserInputService')
local P=require(game:GetService('ReplicatedStorage'):WaitForChild('MountainShared'):WaitForChild('AlpineProfile'))
local player=Players.LocalPlayer
local fx=Instance.new('Folder');fx.Name='LocalAltitudeAtmosphere';fx.Parent=workspace
local anchor=Instance.new('Part');anchor.Name='AirVolume';anchor.Size=Vector3.new(54,14,46)
anchor.Anchored=true;anchor.Transparency=1;anchor.CanCollide=false;anchor.CanTouch=false;anchor.CanQuery=false;anchor.CastShadow=false;anchor.Parent=fx
local tint=Instance.new('ColorCorrectionEffect');tint.Name='MountainAltitudeTint';tint.Enabled=false;tint.Parent=Lighting
local function emitter(name,texture,size,life,speed,color)
 local e=Instance.new('ParticleEmitter');e.Name=name;e.Texture=texture;e.Rate=0;e.Enabled=false
 e.Size=NumberSequence.new(size);e.Lifetime=NumberRange.new(life*.7,life);e.Speed=NumberRange.new(speed*.7,speed)
 e.SpreadAngle=Vector2.new(45,30);e.EmissionDirection=Enum.NormalId.Right;e.Acceleration=Vector3.new(2,-.7,0)
 e.Rotation=NumberRange.new(0,360);e.RotSpeed=NumberRange.new(-12,12);e.Color=ColorSequence.new(color)
 e.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(.2,.42),NumberSequenceKeypoint.new(.75,.62),NumberSequenceKeypoint.new(1,1)})
 e.LightEmission=.18;e.LightInfluence=.75;e.Parent=anchor;return e
end
local snow=emitter('Spindrift','rbxasset://textures/particles/sparkles_main.dds',.15,2.4,9,Color3.fromRGB(217,235,245))
local motes=emitter('AlpineMotes','rbxasset://textures/particles/sparkles_main.dds',.27,3.5,2,Color3.fromRGB(158,204,236))
local wisps=emitter('WindVeil','rbxasset://textures/particles/smoke_main.dds',3.5,2,7,Color3.fromRGB(185,207,223))
wisps.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(.4,.94),NumberSequenceKeypoint.new(1,1)})
local intensity,elapsed,average=0,0,1/60
local function quality()
 local factor=if Input.TouchEnabled then .55 else 1
 local ok,level=pcall(function() return UserSettings():GetService('UserGameSettings').SavedQualityLevel.Value end)
 if ok and level>0 and level<=3 then factor=math.min(factor,.4) end
 if average>1/35 then factor=math.min(factor,.35) end
 return factor
end
local connection
connection=Run.Heartbeat:Connect(function(dt)
 average+=(math.min(dt,.25)-average)*math.min(dt*2,1);elapsed+=dt
 if elapsed<.1 then return end
 local step=elapsed;elapsed=0
 local character=player.Character;local root=character and character:FindFirstChild('HumanoidRootPart')
 local humanoid=character and character:FindFirstChildOfClass('Humanoid')
 local target=0
 if root and humanoid and humanoid.Health>0 then local p=root.Position;target=P.intensity(p.X,p.Y,p.Z) end
 intensity+=(target-intensity)*(1-math.exp(-step*2.5))
 local active=target>0 or intensity>.003
 tint.Enabled=active;tint.TintColor=Color3.new(1,1,1):Lerp(Color3.fromRGB(219,233,255),intensity*.28)
 tint.Contrast=intensity*.035;tint.Saturation=-intensity*.045
 local scale=quality();snow.Rate=28*intensity^2*scale;motes.Rate=8*intensity*scale;wisps.Rate=2.5*intensity^2*scale
 for _,e in {snow,motes,wisps} do e.Enabled=target>0;if target==0 then e:Clear() end end
 if root then anchor.CFrame=CFrame.new(root.Position+Vector3.new(-16,12,0)) end
 fx:SetAttribute('Intensity',intensity);fx:SetAttribute('QualityScale',scale);fx:SetAttribute('Target',target)
end)
script.Destroying:Connect(function() connection:Disconnect();fx:Destroy();tint:Destroy() end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="78">
          <Properties>
            <string name="Name">CreatureMotion</string>
            <string name="Source"><![CDATA[-- Cosmetic articulation only. Authoritative roots, prompts and collision never move here.
local Run=game:GetService('RunService')
local rigs={}
local candidates={}
local function register(model)
 if not model:IsA('Model') then return end
 candidates[model]=true
 if model:GetAttribute('ArtRevision')~=2 or not model.PrimaryPart then return end
 local parts=rigs[model] or {}
 local known={};for _,joint in ipairs(parts) do known[joint.part]=true end
 for _,p in ipairs(model:GetChildren()) do
  if not known[p] and p:IsA('BasePart') and p~=model.PrimaryPart and not p.CanCollide and p:GetAttribute('RestLocal') then
   p.LocalTransparencyModifier=parts.fade or 0
   table.insert(parts,{part=p,rest=p:GetAttribute('RestLocal'),pivot=p:GetAttribute('MotionPivot') or Vector3.zero,role=p:GetAttribute('MotionRole'),phase=p:GetAttribute('MotionPhase') or 0})
  end
 end
 rigs[model]=parts
end
for _,m in ipairs(workspace:GetDescendants()) do register(m) end
workspace.DescendantAdded:Connect(register)
local elapsed=0
local discovery=0
Run:BindToRenderStep('MountainCreatureMotion',Enum.RenderPriority.Camera.Value+10,function(dt)
 discovery+=dt
 if discovery>=1 then
  discovery=0
  -- Replication can deliver the model before its root, children and pose attributes.
  for model in pairs(candidates) do
   if model:IsDescendantOf(workspace) then register(model) else candidates[model]=nil;rigs[model]=nil end
  end
 end
 elapsed+=dt;if elapsed<1/30 then return end;elapsed=0
 local camera=workspace.CurrentCamera;if not camera then return end
 local now=workspace:GetServerTimeNow()
 for model,parts in pairs(rigs) do
  local root=model.PrimaryPart
  if not model:IsDescendantOf(workspace) or not root then rigs[model]=nil;continue end
  local distance=(root.Position-camera.CFrame.Position).Magnitude
  if model:GetAttribute('Slot') then
   -- Hide the whole companion before skipping updates; never leave frozen limbs visible.
   local fade=math.clamp((distance-150)/30,0,1)
   if parts.fade~=fade then
    parts.fade=fade;root.LocalTransparencyModifier=fade
    for _,joint in ipairs(parts) do if joint.part.Parent then joint.part.LocalTransparencyModifier=fade end end
   end
  end
  if distance>180 then continue end
  local cue=math.clamp(((model:GetAttribute('TellUntil') or 0)-now)/1.6,0,1)
  for _,joint in ipairs(parts) do if joint.part.Parent then
   local phase=joint.phase;local role=joint.role;local swing=CFrame.identity
   if role=='Wing' then swing=CFrame.Angles(0,0,phase*(math.sin(now*3)*.18+cue*.35))
   elseif role=='Fin' then swing=CFrame.Angles(math.sin(now*2+phase)*.12,0,math.sin(now*2+phase)*.12)
   elseif role=='Mane' then swing=CFrame.Angles(math.sin(now*1.6+phase)*.06,0,math.sin(now*1.2+phase)*.045)
   elseif role=='Tail' then swing=CFrame.Angles(0,math.sin(now*1.8+phase)*.18,0)
   elseif role=='Ear' then swing=CFrame.Angles(math.sin(now*.8+phase)^8*.12,0,0)
   elseif role=='Foot' then swing=CFrame.Angles(math.sin(now*1.2+phase)*.035,0,0)
   elseif role=='Fist' then swing=CFrame.new(0,math.sin(now*1.4+phase)*.2+cue*.35,0)*CFrame.Angles(cue*-.3,0,math.sin(now+phase)*.06)
   elseif role=='Orbit' then swing=CFrame.Angles(0,math.sin(now*.7+phase)*.12,math.sin(now*.9)*.08)
   end
   joint.part.CFrame=root.CFrame*CFrame.new(joint.pivot)*swing*CFrame.new(-joint.pivot)*joint.rest
  end end
 end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="79">
          <Properties>
            <string name="Name">EggCarry</string>
            <string name="Source"><![CDATA[-- Local arm pose and short impact feedback. Custody and world models are server-owned.
local Players=game:GetService('Players')
local Run=game:GetService('RunService')
Run.PreSimulation:Connect(function()
 for _,player in ipairs(Players:GetPlayers()) do
  local c=player.Character
  if not c then continue end
  local carry=c:GetAttribute('CarryingCreature')
  local t=workspace:GetServerTimeNow()-(c:GetAttribute('PickaxeStrikeAt') or -100)
  for _,joint in ipairs(c:GetDescendants()) do
   if not (joint:IsA('Motor6D') or joint:IsA('AnimationConstraint')) then continue end
   local name=joint.Name
   if carry then
    if name=='RightShoulder' or name=='Right Shoulder' then joint.Transform=CFrame.Angles(1.05,0,-.42)
    elseif name=='LeftShoulder' or name=='Left Shoulder' then joint.Transform=CFrame.Angles(1.05,0,.42)
    elseif name=='RightElbow' or name=='LeftElbow' then joint.Transform=CFrame.Angles(.9,0,0) end
   elseif t>=0 and t<.4 and (name=='RightShoulder' or name=='Right Shoulder') then
    joint.Transform=CFrame.Angles(.7+math.sin(t/.4*math.pi)*1.2,0,-.2)
   end
  end
 end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="80">
          <Properties>
            <string name="Name">HUD</string>
            <string name="Source"><![CDATA[require(script.Parent.UI.Controller)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="81">
          <Properties>
            <string name="Name">Sprint</string>
            <string name="Source"><![CDATA[-- Shift holds sprint; touch uses a toggle. Speed remains server-owned.
local Players=game:GetService('Players')
local Input=game:GetService('UserInputService')
local Run=game:GetService('RunService')
local player=Players.LocalPlayer
local remote=game.ReplicatedStorage:WaitForChild('MountainRemotes'):WaitForChild('SprintRequest')
local P=require(game.ReplicatedStorage.MountainShared.UIPresentation)
local W=require(script.Parent.UI.Widgets)
local T=require(script.Parent.UI.Theme)
local gui=Instance.new('ScreenGui');gui.Name='MountainSprint';gui.ResetOnSpawn=false;gui.DisplayOrder=15;gui.Parent=player:WaitForChild('PlayerGui')
gui.ScreenInsets=Enum.ScreenInsets.CoreUISafeInsets;gui.ClipToDeviceSafeArea=true
local root=W.frame(gui,'SafeRoot',UDim2.fromScale(1,1));root.BackgroundTransparency=1
local button=W.button(root,'SprintToggle','Sprint',UDim2.fromOffset(94,48),nil,nil,'quiet')
button.Position=UDim2.new(1,-22,1,-170);button.BackgroundColor3=Color3.fromRGB(34,67,60);button.TextColor3=Color3.fromRGB(248,244,216)
button.Font=T.bold;button.TextSize=14
local stroke=button.UIStroke;stroke.Color=T.sky
local wanted=false;local held={};local toggle=false;local character,humanoid,track,animation
local function label()
 button.Visible=Input.TouchEnabled
 button.Text=if wanted then 'Sprint ON' else 'Sprint'
 button.BackgroundColor3=if wanted then T.green else T.card
 button.TextColor3=if wanted then T.navy else T.ink
end
local function set(value)
 if wanted~=value then wanted=value;remote:FireServer(value) end
 label()
end
local function reset() held={};toggle=false;set(false) end
button.Activated:Connect(function() toggle=not toggle;set(toggle) end)
Input.InputBegan:Connect(function(input,processed)
 if processed or Input:GetFocusedTextBox() then return end
 if input.KeyCode==Enum.KeyCode.LeftShift or input.KeyCode==Enum.KeyCode.RightShift then held[input.KeyCode]=true;set(true) end
end)
Input.InputEnded:Connect(function(input)
 if held[input.KeyCode] then held[input.KeyCode]=nil;set(toggle or next(held)~=nil) end
end)
Input.WindowFocusReleased:Connect(reset)
Input.TextBoxFocused:Connect(reset)
Input:GetPropertyChangedSignal('TouchEnabled'):Connect(label)
local function bind(c)
 reset();if track then track:Stop(0);track:Destroy();track=nil end;if animation then animation:Destroy() end
 character=c;humanoid=c:WaitForChild('Humanoid')
 local animator=humanoid:WaitForChild('Animator')
 -- Roblox's standard run, already used by the default R15 Animate controller.
 -- R6 uses its standard locomotion clip at sprint cadence.
 animation=Instance.new('Animation');animation.AnimationId=if humanoid.RigType==Enum.HumanoidRigType.R15 then 'rbxassetid://507767714' else 'rbxassetid://180426354'
 track=animator:LoadAnimation(animation);track.Looped=true;track.Priority=Enum.AnimationPriority.Movement
 humanoid.Died:Connect(reset)
end
player.CharacterAdded:Connect(bind)
if player.Character then task.spawn(bind,player.Character) end
Run.PreAnimation:Connect(function()
 if not humanoid or not track or not character then return end
 local state=humanoid:GetState()
 local running=character:GetAttribute('Sprinting')==true and humanoid.MoveDirection.Magnitude>.1 and humanoid.Health>0
  and humanoid.FloorMaterial~=Enum.Material.Air and not humanoid.Sit and not humanoid.PlatformStand
  and state~=Enum.HumanoidStateType.Jumping and state~=Enum.HumanoidStateType.Freefall and state~=Enum.HumanoidStateType.Climbing and state~=Enum.HumanoidStateType.Swimming
 if running then
  if not track.IsPlaying then track:Play(.15) end
  track:AdjustSpeed(humanoid.WalkSpeed/(if humanoid.RigType==Enum.HumanoidRigType.R15 then 20 else 16))
 elseif track.IsPlaying then track:Stop(.15) end
end)
local age=0
Run.Heartbeat:Connect(function(dt)
 age+=dt;if age<.2 then return end;age=0
 local hud=player.PlayerGui:FindFirstChild('MountainHUD');local safe=hud and hud:FindFirstChild('SafeRoot')
 button.Visible=Input.TouchEnabled and safe~=nil and not safe:FindFirstChild('HubShade') and not safe:FindFirstChild('Confirmation') and not safe.Loading.Visible
 if not button.Visible then return end
 local obstacles={};local touch=player.PlayerGui:FindFirstChild('TouchGui')
 for _,name in ipairs({'DynamicThumbstickFrame','ThumbstickFrame','JumpButton'}) do
  local o=touch and touch:FindFirstChild(name,true)
  if o and o.Visible then table.insert(obstacles,{x=o.AbsolutePosition.X-root.AbsolutePosition.X,y=o.AbsolutePosition.Y-root.AbsolutePosition.Y,w=o.AbsoluteSize.X,h=o.AbsoluteSize.Y}) end
 end
 local r=P.hudLayout(root.AbsoluteSize.X,root.AbsoluteSize.Y,obstacles).sprint
 button.Position=UDim2.fromOffset(r.x,r.y)
end)
label()
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="82">
          <Properties>
            <string name="Name">TycoonConveyors</string>
            <string name="Source"><![CDATA[-- Cosmetic samples, never the authoritative egg inventory. One bounded local pool.
local Players=game:GetService('Players')
local Tags=game:GetService('CollectionService')
local Run=game:GetService('RunService')
local UIS=game:GetService('UserInputService')
local player=Players.LocalPlayer
local folder=Instance.new('Folder');folder.Name='LocalProductionEggs';folder.Parent=workspace
local pool={};local belts={};local elapsed=0
local max=if UIS.TouchEnabled then 12 else 24
for i=1,max do
 local egg=Instance.new('Part');egg.Name='VisualProductionEgg';egg.Shape=Enum.PartType.Ball;egg.Size=Vector3.new(1.1,1.5,1.1)
 egg.Anchored=true;egg.CanCollide=false;egg.CanTouch=false;egg.CanQuery=false;egg.CastShadow=false;egg.Material=Enum.Material.SmoothPlastic;egg.Transparency=1;egg.Parent=folder;pool[i]=egg
end
for _,belt in ipairs(Tags:GetTagged('TycoonConveyor')) do belts[belt]=true end
local added=Tags:GetInstanceAddedSignal('TycoonConveyor'):Connect(function(v) belts[v]=true end)
local removed=Tags:GetInstanceRemovedSignal('TycoonConveyor'):Connect(function(v) belts[v]=nil end)
local connection=Run.RenderStepped:Connect(function(dt)
 elapsed+=dt;if elapsed<1/30 then return end;elapsed=0
 local root=player.Character and player.Character:FindFirstChild('HumanoidRootPart');local camera=workspace.CurrentCamera;local candidates={}
 if root and camera then for belt in pairs(belts) do
  if belt.Parent and (belt:GetAttribute('ActiveHabitats') or 0)>0 and (belt.Position-root.Position).Magnitude<220 then
   local _,visible=camera:WorldToViewportPoint(belt.Position);if visible then table.insert(candidates,belt) end
  end
 end end
 table.sort(candidates,function(a,b) return (a.Position-root.Position).Magnitude<(b.Position-root.Position).Magnitude end)
 local used=0;local reduced=player:GetAttribute('MountainReducedMotion');local simple=player:GetAttribute('MountainSimplifiedVFX')
 for _,belt in ipairs(candidates) do
  local count=if simple or reduced then 2 else 6
  for i=1,count do
   if used>=max then break end;used+=1;local egg=pool[used]
   local phase=if reduced or (belt:GetAttribute('Automation') or 0)<1 then i/count else (workspace:GetServerTimeNow()*.08+i/count)%1
   egg.CFrame=belt.CFrame*CFrame.new(if i%2==0 then 1.5 else -1.5,1.4,-46+phase*92)
   egg.Color=if (belt:GetAttribute('Automation') or 0)>=2 then Color3.fromRGB(246,211,137) else Color3.fromRGB(205,238,214)
   egg.Transparency=0
  end
 end
 for i=used+1,max do pool[i].Transparency=1 end
end)
script.Destroying:Connect(function() connection:Disconnect();added:Disconnect();removed:Disconnect();folder:Destroy() end)
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="83">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="84">
            <Properties>
              <string name="Name">ClientState</string>
              <string name="Source"><![CDATA[-- Authoritative state and correlated intents. A timeout means unknown outcome;
-- it deliberately keeps the action locked until an acknowledgment arrives.
local ClientState = {}
local Store = {}
Store.__index = Store
local actions = {Strike=true,Pickup=true,PutDown=true,Tycoon=true,State=true,Equip=true,Train=true,Specialize=true,Incubate=true,Hatch=true,
 Travel=true,TravelAbandon=true,CollectIncome=true,RegisterDefense=true,ChallengeDefense=true,Special=true,Dodge=true,Settings=true}
local function finite(value)
 return type(value)=='number' and value==value and math.abs(value)<math.huge
end
local function copy(value,seen)
 if type(value)~='table' then return value end
 seen=seen or {};if seen[value] then return seen[value] end
 local clone={};seen[value]=clone
 for k,v in pairs(value) do clone[k]=copy(v,seen) end
 return clone
end
local function safeCall(fn,...)
 local ok,err=pcall(fn,...)
 if not ok and warn then warn('Mountain UI listener: '..tostring(err)) end
end
local function defaultRuntime()
 return {delay=task.delay,cancel=task.cancel,monotonic=os.clock,epoch=os.time,
  clock=function() return workspace:GetServerTimeNow() end,
  token=function() return game:GetService('HttpService'):GenerateGUID(false) end}
end
function Store:_emit(kind,payload)
 if self._destroyed then return end
 for token,fn in pairs(table.clone(self._listeners)) do
  if self._listeners[token] then safeCall(fn,kind,payload) end
 end
end
function Store:_cancel(record)
 if record.timer then
  pcall(self._runtime.cancel,record.timer)
  record.timer=nil
 end
end
function Store:_available()
 return self._eventRemote~=nil and self._requestRemote~=nil and self._resultRemote~=nil
end
function Store:_receive(kind,payload)
 if self._destroyed then return end
 if kind=='state' then
  if type(payload)~='table' then return end
  self.profile=payload
  local mono=self._runtime.monotonic()
  if finite(payload.serverNow) then self._epochOffset=payload.serverNow-mono end
  if type(payload.ui)=='table' and finite(payload.ui.serverClock) then self._clockOffset=payload.ui.serverClock-mono end
  self.status=if self:_available() then 'ready' else 'error'
 elseif kind=='production' then
  if not self.profile or type(payload)~='table' or type(payload.tycoon)~='table' or not finite(payload.coins) then return end
  self.profile=table.clone(self.profile);self.profile.tycoon=payload.tycoon;self.profile.coins=payload.coins
  if finite(payload.serverNow) then self._epochOffset=payload.serverNow-self._runtime.monotonic() end
 elseif kind=='battle' then
  if payload~=false and type(payload)~='table' then return end
  self.battle=payload
 elseif kind=='context' then
  if type(payload)~='table' or not self.profile then return end
  local ui=table.clone(self.profile.ui or {})
  for key,value in pairs(payload) do ui[key]=value end
  self.profile=table.clone(self.profile);self.profile.ui=ui
  if finite(payload.serverClock) then self._clockOffset=payload.serverClock-self._runtime.monotonic() end
 elseif kind~='open' and kind~='toast' and kind~='save' then return end
 self:_emit(kind,payload)
end
function Store:_result(result)
 if self._destroyed or type(result)~='table' or type(result.id)~='string' or type(result.ok)~='boolean' or type(result.message)~='string' then return end
 local record=self._requests[result.id]
 if not record or result.action~=record.action then return end
 self:_cancel(record)
 self._requests[result.id]=nil;self._byAction[record.action]=nil;self.pending[result.id]=nil
 local confirmed={id=result.id,action=result.action,ok=result.ok,message=result.message,data=result.data}
 self.lastResult=confirmed
 self._completed[result.id]=true;table.insert(self._history,result.id)
 if #self._history>64 then self._completed[table.remove(self._history,1)]=nil end
 if record.action=='State' and not self.profile then self.status='error' end
 self:_emit('pending',{id=record.id,action=record.action,status='complete'})
 self:_emit('result',confirmed)
 if record.callback and not self._destroyed then safeCall(record.callback,confirmed) end
end
function Store:_discover()
 if self._destroyed then return end
 local function child(name)
  if not self._remotes then return nil end
  return self._remotes:FindFirstChild(name)
 end
 local event,result,request=child('Event'),child('UIResult'),child('UIRequest')
 if event~=self._eventRemote then
  if self._eventConnection then self._eventConnection:Disconnect();self._eventConnection=nil end
  self._eventRemote=event
  if event and event.OnClientEvent then self._eventConnection=event.OnClientEvent:Connect(function(kind,payload) self:_receive(kind,payload) end) end
 end
 if result~=self._resultRemote then
  if self._resultConnection then self._resultConnection:Disconnect();self._resultConnection=nil end
  self._resultRemote=result
  if result and result.OnClientEvent then self._resultConnection=result.OnClientEvent:Connect(function(payload) self:_result(payload) end) end
 end
 self._requestRemote=request
 if self:_available() then
  if self.profile then self.status='ready' end
  if self._hasSubscribed and not self._started then
   self._started=true;self:request('State')
  end
 elseif self._hasSubscribed then
  self.status='error'
  self:_emit('toast','Mountain UI service unavailable. Waiting for the server connection.')
 end
end
function Store:subscribe(fn)
 assert(type(fn)=='function','subscribe expects a function')
 if self._destroyed then return function() end end
 local token={};self._listeners[token]=fn
 self._hasSubscribed=true
 self:_discover()
 local connected=true
 return function()
  if connected then connected=false;self._listeners[token]=nil end
 end
end
function Store:_timeout(record,message)
 if self._destroyed or self._requests[record.id]~=record then return end
 record.timer=nil;record.status='timeout'
 local visible=self.pending[record.id]
 visible.status='timeout';visible.message=message or 'No confirmation yet. Retry checks the same request; it does not start a new action.'
 if record.action=='State' and not self.profile then self.status='error' end
 self:_emit('pending',visible)
 self:_emit('timeout',visible)
end
function Store:_send(record)
 self:_cancel(record)
 record.status='pending';record.attempts+=1;record.sentAt=self._runtime.monotonic()
 local visible={id=record.id,action=record.action,payload=copy(record.payload),status='pending',sentAt=record.sentAt,attempts=record.attempts}
 self.pending[record.id]=visible
 if record.action=='State' and not self.profile then self.status='loading' end
 record.timer=self._runtime.delay(8,function() self:_timeout(record) end)
 self:_emit('pending',visible)
 if self._destroyed then return end
 local ok=pcall(function() self._requestRemote:FireServer(record.id,record.action,copy(record.payload)) end)
 if not ok and self._requests[record.id]==record then
  self:_cancel(record)
  self:_timeout(record,'Connection unavailable. The outcome is unknown; retry this same request when connected.')
 end
end
function Store:request(action,payload,callback)
 if self._destroyed or not actions[action] then return nil end
 if self._byAction[action] then return nil end
 if not self:_available() then
  self.status='error';self:_emit('toast','Mountain UI service unavailable. No action was confirmed.');return nil
 end
 self._sequence+=1
 local id=self._token..':'..tostring(self._sequence)
 local record={id=id,action=action,payload=copy(payload),callback=if type(callback)=='function' then callback else nil,attempts=0}
 self._requests[id]=record;self._byAction[action]=id
 self:_send(record)
 return id
end
function Store:retry(id)
 if self._destroyed or not self:_available() then return false end
 local record=self._requests[id]
 if not record or record.status~='timeout' then return false end
 self:_send(record);return true
end
function Store:now()
 return math.floor(self._runtime.monotonic()+self._epochOffset)
end
function Store:clock()
 local ok,now=pcall(self._runtime.clock)
 if ok and finite(now) then return now end
 return self._runtime.monotonic()+self._clockOffset
end
function Store:destroy()
 if self._destroyed then return end
 self._destroyed=true
 for _,record in pairs(self._requests) do self:_cancel(record) end
 for _,name in ipairs({'_eventConnection','_resultConnection','_addedConnection','_removedConnection'}) do
  if self[name] then self[name]:Disconnect();self[name]=nil end
 end
 table.clear(self._listeners);table.clear(self._requests);table.clear(self._byAction)
 table.clear(self._history);table.clear(self._completed);table.clear(self.pending)
 self._requestRemote=nil;self._resultRemote=nil;self._eventRemote=nil;self._remotes=nil
end
-- The optional runtime provides scheduler/time/network-ID dependencies for
-- deterministic off-engine verification; normal clients pass only remotes.
function ClientState.new(remotes,runtime)
 runtime=runtime or defaultRuntime()
 local self=setmetatable({profile=nil,battle=false,status='loading',pending={},lastResult=nil,
  _runtime=runtime,_remotes=remotes,_listeners={},_requests={},_byAction={},_history={},_completed={},
  _sequence=0,_token=runtime.token(),_epochOffset=runtime.epoch()-runtime.monotonic(),_clockOffset=0},Store)
 self:_discover()
 if remotes and remotes.ChildAdded then self._addedConnection=remotes.ChildAdded:Connect(function() self:_discover() end) end
 if remotes and remotes.ChildRemoved then self._removedConnection=remotes.ChildRemoved:Connect(function() self:_discover() end) end
 return self
end
return ClientState
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="85">
            <Properties>
              <string name="Name">Controller</string>
              <string name="Source"><![CDATA[local Players=game:GetService('Players')
local RS=game:GetService('ReplicatedStorage')
local UIS=game:GetService('UserInputService')
local Run=game:GetService('RunService')
local GuiService=game:GetService('GuiService')
local player=Players.LocalPlayer
local T=require(script.Parent.Theme)
local W=require(script.Parent.Widgets)
local Feedback=require(script.Parent.Feedback)
local pg=player:WaitForChild('PlayerGui')
if pg:FindFirstChild('MountainHUD') then return {} end
local gui=W.new('ScreenGui',pg,{Name='MountainHUD',ResetOnSpawn=false,DisplayOrder=10,ZIndexBehavior=Enum.ZIndexBehavior.Sibling,ScreenInsets=Enum.ScreenInsets.CoreUISafeInsets,ClipToDeviceSafeArea=true})
gui:SetAttribute('BlueprintVersion',2);gui:SetAttribute('VisualSystem','E+B')
local root=W.frame(gui,'SafeRoot',UDim2.fromScale(1,1));root.BackgroundTransparency=1
local loading=W.frame(root,'Loading',UDim2.fromScale(1,1),nil,T.navy);loading.ZIndex=90
local mountain=W.mountain(loading);mountain.Size=UDim2.fromScale(.7,.8);mountain.Position=UDim2.fromScale(.15,.1)
local brand=W.text(loading,'CLIMB & COLLECT',UDim2.new(.9,0,0,58),UDim2.fromScale(.05,.26),T.display,32,T.ink);brand.TextXAlignment=Enum.TextXAlignment.Center
W.text(loading,'MOUNTAIN EMPIRE',UDim2.new(.9,0,0,30),UDim2.fromScale(.05,.44),T.bold,15,T.gold).TextXAlignment=Enum.TextXAlignment.Center
local loadStatus=W.text(loading,'Connecting to your expedition…',UDim2.new(.9,0,0,38),UDim2.fromScale(.05,.62),nil,15,T.muted);loadStatus.TextXAlignment=Enum.TextXAlignment.Center
local feedback=Feedback.new(root)
local C=require(RS:WaitForChild('MountainShared'):WaitForChild('Catalog'))
local R=require(RS.MountainShared.Rules)
local P=require(RS.MountainShared.UIPresentation)
local ClientState=require(script.Parent.ClientState)
local Screens=require(script.Parent.Screens)
local remotes=RS:WaitForChild('MountainRemotes',8)
while not remotes and gui.Parent do
 loadStatus.Text='The mountain service is taking longer to connect. Retrying…'
 remotes=RS:WaitForChild('MountainRemotes',5)
end
if not remotes then feedback:destroy();return {} end
local store=ClientState.new(remotes)
local screens
local connections={};local activeAbility=1;local expanded=false;local ready=false;local elapsed=0;local age=0;local lastSecond=-1;local saveFailed=false;local previousProfile;local memberStamp='';local wasInBattle=false
local function connect(signal,fn) local c=signal:Connect(fn);table.insert(connections,c);return c end
local click=W.new('Sound',gui,{Name='UIFeedback',SoundId='rbxasset://sounds/volume_slider.ogg',Volume=.15})
local function sound() click.Volume=.16*(T.prefs.sfxVolume or .8);click:Play() end
local function open(name) if ready then sound();screens:open(name) end end
local top=W.panel(root,'Status',UDim2.fromOffset(320,48),UDim2.fromOffset(12,8))
W.icon(top,'Coin',UDim2.fromOffset(32,32),UDim2.fromOffset(6,6))
local coins=W.text(top,'—',UDim2.new(.55,-30,1,0),UDim2.fromOffset(42,0),T.display,19,T.gold)
local timer=W.text(top,'00:00',UDim2.new(.45,-16,1,0),UDim2.new(.55,0,0,0),T.bold,14,T.muted);timer.TextXAlignment=Enum.TextXAlignment.Right
local progress=W.panel(root,'Journey',UDim2.fromOffset(292,80),UDim2.new(1,-304,0,8))
local location=W.text(progress,'Blossom Gardens',UDim2.new(1,-20,0,25),UDim2.fromOffset(10,6),T.bold,14)
local heightLabel=W.text(progress,'0 studs',UDim2.new(1,-20,0,21),UDim2.fromOffset(10,31),nil,12,T.muted)
local heightFill=W.progress(progress,0,UDim2.new(1,-20,0,7),UDim2.fromOffset(10,63),T.sky)
local quest=W.panel(root,'QuestTracker',UDim2.fromOffset(292,76),UDim2.new(1,-304,0,96))
local questTitle=W.text(quest,'Explore the mountain',UDim2.new(1,-20,0,29),UDim2.fromOffset(10,5),T.bold,13,T.gold)
local questDetail=W.text(quest,'',UDim2.new(1,-20,0,34),UDim2.fromOffset(10,34),nil,12,T.muted)
local menu=W.tile(root,'Menu','Menu','Menu',UDim2.fromOffset(80,70),UDim2.fromOffset(12,60),function() expanded=not expanded;sound() end,T.gold)
local sidebar=W.panel(root,'Navigation',UDim2.fromOffset(172,350),UDim2.fromOffset(12,120));sidebar.Visible=false
local nav=W.scroll(sidebar,'Items',UDim2.new(1,-12,1,-12),UDim2.fromOffset(6,6))
local hubNames={'Creatures','Discovery','Sanctuary','Mountain','Social','Profile','Shop','Settings'}
for i,name in ipairs(hubNames) do local b=W.tile(nav,'Nav'..name,name,name,UDim2.fromOffset(78,72),nil,function() expanded=false;open(name) end,({T.sky,T.purple,T.green,T.sky,T.purple,T.gold,T.gold,T.line})[i]);b.LayoutOrder=i end
local team=W.frame(root,'Team',UDim2.fromOffset(342,60),UDim2.new(.5,-171,1,-72));team.BackgroundTransparency=1
local function selectedAbility(slot)
 local p=store.profile;local c=p and R.find(p.creatures,p.team[slot])
 return if c and C.byId[c.species].rarity=='Legendary' then activeAbility else 1
end
local slots={};local slotNames={};local slotStates={};local slotPortraits={};local slotSpecies={}
for i=1,3 do
 local index=i
 slots[i]=W.button(team,'Slot'..i,'['..i..'] Empty slot',UDim2.new(1/3,-6,1,0),UDim2.new((i-1)/3,3,0,0),function() if store.battle then store:request('Special',{slot=index,ability=selectedAbility(index)}) else open('Creatures') end end,'quiet')
 slots[i].Text=''
 slotNames[i]=W.text(slots[i],'Empty slot',UDim2.new(1,-6,0,22),UDim2.new(0,3,1,-23),T.bold,11)
 slotNames[i].TextXAlignment=Enum.TextXAlignment.Center
 slotStates[i]=W.text(slots[i],tostring(i),UDim2.new(1,-8,0,18),UDim2.new(0,4,1,-41),T.bold,11,T.gold)
 slotStates[i].TextXAlignment=Enum.TextXAlignment.Center
 slotStates[i].ZIndex=3;slotStates[i].BackgroundColor3=T.navy;slotStates[i].BackgroundTransparency=.1;W.round(slotStates[i],5)
 slots[i]:SetAttribute('Tooltip','Open your collection, or activate this companion’s special during combat.')
end
local actionbar=W.frame(root,'Actions',UDim2.fromOffset(342,48),UDim2.new(.5,-171,1,-128))
actionbar.BackgroundTransparency=1
local context=W.button(actionbar,'Context','Explore',UDim2.fromScale(1,1),UDim2.new(),function() local p=store.profile;local run=p and p.run;local ui=p and p.ui or {}
 if run and run.phase=='revealed' then store:request('Pickup',run.id)
 elseif ui.nearestEgg and (not run or run.phase=='breaking') then store:request('Strike',ui.nearestEgg)
 elseif ui.atHome then open('Sanctuary')
 else open('Mountain') end end,'blue')
local quickCreatures=W.tile(root,'QuickCreatures','Creatures','Creatures',UDim2.fromOffset(76,70),UDim2.fromOffset(100,60),function() open('Creatures') end,T.sky)
local quickMountain=W.tile(root,'QuickMountain','Mountain','Mountain',UDim2.fromOffset(76,70),UDim2.fromOffset(184,60),function() open('Mountain') end,T.green)
local quick=W.tile(root,'Quick','Settings','Settings',UDim2.fromOffset(68,70),UDim2.fromOffset(268,60),function() open('Settings');if screens.hub then screens.tab='Quick';screens:render(false) end end,T.line)
local dodge=W.button(root,'Dodge','Dodge [Q]',UDim2.fromOffset(122,48),UDim2.new(1,-148,1,-218),function() store:request('Dodge') end,'gold');dodge.Visible=false
local ability=W.button(root,'Ability','Ability 1',UDim2.fromOffset(122,44),UDim2.new(1,-148,1,-270),function() activeAbility=activeAbility%4+1;sound() end,'quiet');ability.Visible=false
 ability:SetAttribute('Tooltip','Choose a captured Guardian’s special. Regular companions use their role special.')
 dodge:SetAttribute('Tooltip','Dodge the highlighted danger. A successful clean dodge advances Trial mastery.')
local battle=W.panel(root,'Battle',UDim2.fromOffset(410,100),UDim2.new(.5,-205,0,8));battle.Visible=false
local boss=W.text(battle,'Guardian',UDim2.new(1,-24,0,28),UDim2.fromOffset(12,6),T.display,21,T.gold)
local hp=W.progress(battle,1,UDim2.new(1,-24,0,10),UDim2.fromOffset(12,38),T.coral)
 local combatText=W.text(battle,'',UDim2.new(1,-24,0,50),UDim2.fromOffset(12,53),nil,12,T.ink)
local save=W.text(top,'Connecting…',UDim2.new(1,-16,0,14),UDim2.fromOffset(8,28),nil,9,T.muted);save.TextXAlignment=Enum.TextXAlignment.Center
coins.Size=UDim2.new(.60,-35,0,29);timer.Size=UDim2.new(.40,-16,0,29);timer.Position=UDim2.new(.60,0,0,0)
local hint=W.panel(root,'Hint',UDim2.fromOffset(320,64),UDim2.new(.5,-160,0,78));hint.Visible=false
local hintText=W.text(hint,'',UDim2.new(1,-60,1,-12),UDim2.fromOffset(12,6),nil,13,T.ink)
local dismissHint=false
W.button(hint,'DismissHint','×',UDim2.fromOffset(44,44),UDim2.new(1,-50,0,10),function() dismissHint=true;hint.Visible=false end,'quiet')
local retry=W.button(loading,'RetryLoad','Retry connection',UDim2.fromOffset(210,46),UDim2.new(.5,-105,.82,0),function()
 for id,pending in pairs(store.pending) do if pending.action=='State' then store:retry(id);return end end
 store:request('State')
end,'gold');retry.Visible=false
screens=Screens.new(root,store,feedback,function() GuiService.SelectedObject=nil end)
local defaultEffects={};local soundBases={};local settingsStamp=''
local function applyPreferences(prefs)
 T.configure(prefs);player:SetAttribute('MountainReducedMotion',prefs.reducedMotion==true)
 player:SetAttribute('MountainSimplifiedVFX',prefs.simplifiedVFX==true)
 for _,o in ipairs(root:GetDescendants()) do
  if o:IsA('UIStroke') then local base=o:GetAttribute('BaseThickness') or 1;o.Transparency=if prefs.highContrast then 0 else .15;o.Thickness=if prefs.highContrast then math.max(2,base) else base
  elseif o:IsA('TextLabel') or o:IsA('TextButton') then local base=o:GetAttribute('BaseTextSize');if base then o.TextSize=T.size(base) end end
 end
 for _,o in ipairs(workspace:GetDescendants()) do
  if o:IsA('ParticleEmitter') and not o:FindFirstAncestor('Dynamics') then
   if defaultEffects[o]==nil then defaultEffects[o]=o.Enabled end;o.Enabled=defaultEffects[o] and not prefs.simplifiedVFX
  end
 end
end
connect(workspace.DescendantAdded,function(o) if o:IsA('ParticleEmitter') and not o:FindFirstAncestor('Dynamics') then defaultEffects[o]=o.Enabled;if T.prefs.simplifiedVFX then o.Enabled=false end end end)
connect(workspace.DescendantRemoving,function(o) defaultEffects[o]=nil end)
local nativeWatched=setmetatable({},{__mode='k'})
local function layout()
 local v=root.AbsoluteSize;if v.X<=0 then return end
 local obstacles={}
 if UIS.TouchEnabled then
  local touch=pg:FindFirstChild('TouchGui')
  for _,name in ipairs({'DynamicThumbstickFrame','ThumbstickFrame','JumpButton'}) do
   local o=touch and touch:FindFirstChild(name,true)
   if o and o.Visible then
    table.insert(obstacles,{x=o.AbsolutePosition.X-root.AbsolutePosition.X,y=o.AbsolutePosition.Y-root.AbsolutePosition.Y,w=o.AbsoluteSize.X,h=o.AbsoluteSize.Y})
    if not nativeWatched[o] then nativeWatched[o]=true
     connect(o:GetPropertyChangedSignal('AbsolutePosition'),function() task.defer(layout) end)
     connect(o:GetPropertyChangedSignal('AbsoluteSize'),function() task.defer(layout) end)
    end
   end
  end
 end
 local l=P.hudLayout(v.X,v.Y,obstacles,UIS.TouchEnabled)
 local function place(o,r) o.Size=UDim2.fromOffset(r.w,r.h);o.Position=UDim2.fromOffset(r.x,r.y) end
 place(top,l.status);place(progress,l.journey);place(menu,l.menu);place(quickCreatures,l.quickCreatures);place(quickMountain,l.quickMountain);place(team,l.team);place(actionbar,l.context);place(dodge,l.dodge);place(ability,l.ability)
 quick.Position=UDim2.fromOffset(268,60);quick.Visible=not l.short
 -- One compact corner panel carries location, real height and the minimal objective.
 location.Size=UDim2.new(1,-20,0,22);location.Position=UDim2.fromOffset(10,3)
 heightLabel.Size=UDim2.new(1,-20,0,18);heightLabel.Position=UDim2.fromOffset(10,24)
 heightFill.Parent.Position=UDim2.new(0,10,1,-8);heightFill.Parent.Size=UDim2.new(1,-20,0,5)
 quest.BackgroundTransparency=1;quest.UIStroke.Enabled=false;quest.UIGradient.Enabled=false
 quest.Size=UDim2.new(1,-16,0,20);quest.Position=UDim2.fromOffset(8,40);quest.Parent=progress
 questTitle.Size=UDim2.fromScale(1,1);questTitle.Position=UDim2.new();questTitle.TextSize=T.size(11)
 questDetail.Visible=false
 sidebar.Size=UDim2.fromOffset(184,326);sidebar.Position=UDim2.fromOffset(12,140)
 nav.Size=UDim2.new(1,-8,1,-8);nav.Position=UDim2.fromOffset(4,4)
 local list=nav:FindFirstChildOfClass('UIListLayout');if list then list:Destroy() end
 local grid=nav:FindFirstChildOfClass('UIGridLayout') or W.new('UIGridLayout',nav,{SortOrder=Enum.SortOrder.LayoutOrder,CellPadding=UDim2.fromOffset(8,8)})
 if l.horizontalNavigation then
  place(sidebar,l.navigation)
  nav.Size=UDim2.new(1,-8,1,-4)
  nav.ScrollingDirection=Enum.ScrollingDirection.X;nav.AutomaticCanvasSize=Enum.AutomaticSize.X
  nav.UIPadding.PaddingTop=UDim.new(0,0);nav.UIPadding.PaddingBottom=UDim.new(0,0)
  grid.FillDirection=Enum.FillDirection.Vertical;grid.FillDirectionMaxCells=1;grid.CellSize=UDim2.fromOffset(78,if v.Y<550 then 44 else 70)
 else
  nav.UIPadding.PaddingTop=UDim.new(0,4);nav.UIPadding.PaddingBottom=UDim.new(0,4)
  nav.ScrollingDirection=Enum.ScrollingDirection.Y;nav.AutomaticCanvasSize=Enum.AutomaticSize.Y
  grid.FillDirection=Enum.FillDirection.Horizontal;grid.FillDirectionMaxCells=2;grid.CellSize=UDim2.fromOffset(78,70)
 end
 for _,b in ipairs(root:GetDescendants()) do
  if b:IsA('TextButton') then
   for _,o in ipairs(b:GetChildren()) do
    if o:IsA('Frame') and o.Name:sub(1,4)=='Icon' then
     local small=l.short or (b.Parent==nav and v.Y<550)
     o.Size=UDim2.fromOffset(if small then 26 else 42,if small then 26 else 42);o.Position=UDim2.new(.5,if small then -13 else -21,0,2)
     local caption=b:FindFirstChild('Text');if caption then caption.Size=UDim2.new(1,-6,0,if small then 18 else 22);caption.Position=UDim2.new(0,3,1,if small then -19 else -25) end
    end
   end
  end
 end
 for _,b in ipairs(slots) do
  local portrait=b:FindFirstChild('Portrait');if portrait then portrait.Size=UDim2.new(1,-14,1,-34);portrait.Position=UDim2.fromOffset(7,1) end
 end
 hint.Size=UDim2.fromOffset(math.min(360,v.X-380),54);hint.Position=UDim2.new(.5,-hint.Size.X.Offset/2,0,66)
 battle.Size=UDim2.fromOffset(math.min(410,v.X-230),100);battle.Position=UDim2.new(.5,-battle.Size.X.Offset/2,0,8)
 feedback.host.Size=UDim2.fromOffset(math.min(440,v.X-210),58);feedback.host.Position=UDim2.new(.5,-feedback.host.Size.X.Offset/2,0,if store.battle then 116 else 80)
 feedback.tooltip.Position=UDim2.new(.5,-140,0,if store.battle then 116 else 144)
 if screens.hub then screens:render(true) end
end
local function updateProfile()
 local data=store.profile;if not data then return end
 coins.Text=tostring(data.coins);local q=P.quest(data);questTitle.Text=q.title;questDetail.Text=if root.AbsoluteSize.Y<390 then q.progress..' / '..q.total..' objectives' else q.detail
 local prefs=data.ui and data.ui.settings or {};local stamp=game:GetService('HttpService'):JSONEncode(prefs)
 if stamp~=settingsStamp then settingsStamp=stamp;applyPreferences(prefs) end
 save.Text=if saveFailed then 'SAVING PAUSED · Progress actions unavailable' elseif tostring(data.saveMode):find('Studio') then 'STUDIO · Resets on Stop' else 'Profile synchronized'
 if previousProfile then

  for id in pairs(data.captures) do if not previousProfile.captures[id] then feedback:reveal('Guardian captured!',C.byId[id].name..' joins your collection. This Guardian can be captured once.',C.byId[id]) end end
 end
 previousProfile={unlocked=data.unlocked,captures=table.clone(data.captures)}
 if screens.hub then screens:render(true) end
end
local disconnect=store:subscribe(function(kind,payload)
 if kind=='state' or kind=='context' or kind=='production' then updateProfile()
 elseif kind=='battle' then
  local active=payload~=nil and payload~=false;if active~=wasInBattle then wasInBattle=active;layout() end
  if payload then
   boss.Text=payload.name..(if payload.trial then ' · TRIAL' else '');hp.Size=UDim2.fromScale(math.clamp(payload.hp/math.max(1,payload.max),0,1),1)
   combatText.Text=math.ceil(payload.hp)..' HP · Phase '..math.max(1,((payload.phase or 1)-1)%4+1)..' · '..#(payload.members or {})..' climber(s)'
   if payload.trial then combatText.Text..='\n'..(payload.dodges or 0)..'/3 dodges · '..(payload.resolved or 0)..'/4 patterns · '..(if payload.captureOwned then 'Already captured' elseif payload.objective then 'Objective complete' else payload.objectiveText or 'Master the patterns') end
  end
  local stamp=game:GetService('HttpService'):JSONEncode(if payload then payload.members or {} else {})
  if stamp~=memberStamp then memberStamp=stamp;if screens.hub=='Social' and screens.tab=='Party' then screens:render(true) end end
 elseif kind=='open' then open(payload)
 elseif kind=='toast' then feedback:toast(payload,store.battle and (string.find(payload,'golden heart',1,true)~=nil or string.find(payload,'constellation stones',1,true)~=nil))
 elseif kind=='result' then
  screens:pending()
  if payload.action~='State' and payload.ok then
   sound();local d=payload.data
   if payload.action=='Hatch' and d and d.creature then feedback:reveal('A new companion!',C.byId[d.creature.species].name..' joins your collection.',C.byId[d.creature.species])
   elseif payload.action=='Train' and d and d.creature and d.stage and d.previousStage and d.stage>d.previousStage then feedback:reveal('Evolution unlocked!',C.byId[d.creature.species].name..' reached evolution stage '..d.stage..'.',C.byId[d.creature.species])
   elseif payload.action=='ChallengeDefense' and d then feedback:reveal(if d.won then 'Challenge won!' else 'Challenge complete',(if d.practice then 'Practice defense' else 'Opponent '..tostring(d.opponent))..' · '..tostring(d.rounds)..' rounds\n'..tostring(d.trophies)..' trophies awarded.')
   elseif payload.action~='Special' and payload.action~='Dodge' then feedback:toast(payload.message or 'Confirmed.') end
  elseif not payload.ok and payload.data and payload.data.confirmAbandon then
   local d=payload.data
   feedback:confirm('Abandon this creature?', 'Travel loses your unsecured attempt. Your owned creatures and coins stay safe. Cancel to keep climbing.',function() store:request('TravelAbandon',{destination=d.destination,runId=d.runId}) end)
  elseif not payload.ok then feedback:toast(payload.message or 'That action is unavailable.') end
 elseif kind=='timeout' then screens:pending();feedback:toast('Still waiting for the server. Open a menu to retry safely.')
 elseif kind=='pending' then screens:pending()
 elseif kind=='save' then saveFailed=not payload;save.Text=if not payload then 'SAVING PAUSED · Actions unavailable' elseif store.profile and tostring(store.profile.saveMode):find('Studio') then 'STUDIO · Resets on Stop' else 'Profile saved' end
end)
connect(UIS.InputBegan,function(input,processed)
 if processed or UIS:GetFocusedTextBox() then return end
 local key=input.KeyCode
 if key==Enum.KeyCode.M or key==Enum.KeyCode.Tab or key==Enum.KeyCode.ButtonSelect then if screens.hub then screens:close() else open('Creatures') end
 elseif key==Enum.KeyCode.Escape or key==Enum.KeyCode.ButtonB then if not feedback:close() then screens:back() end
 elseif not screens.hub and not feedback.modal and ready then
  if key==Enum.KeyCode.One or key==Enum.KeyCode.Two or key==Enum.KeyCode.Three then local slot=({[Enum.KeyCode.One]=1,[Enum.KeyCode.Two]=2,[Enum.KeyCode.Three]=3})[key];store:request('Special',{slot=slot,ability=selectedAbility(slot)})
  elseif (key==Enum.KeyCode.Q or key==Enum.KeyCode.ButtonY) and store.battle then store:request('Dodge') end
 end
end)
connect(root:GetPropertyChangedSignal('AbsoluteSize'),layout)
 connect(pg.DescendantAdded,function(o) if o.Name=='JumpButton' or o.Name=='DynamicThumbstickFrame' then task.defer(layout) end end)
 connect(UIS:GetPropertyChangedSignal('TouchEnabled'),layout)
local start=os.clock()
connect(Run.Heartbeat,function(dt)
 elapsed+=dt;age+=dt;if elapsed<.2 then return end;elapsed=0
 local data=store.profile;local rr=player.Character and player.Character:FindFirstChild('HumanoidRootPart');ready=data~=nil and rr~=nil
 loading.Visible=not ready;retry.Visible=not ready and os.clock()-start>8
 if not ready then loadStatus.Text=if data then 'Waiting for your character…' elseif store.status=='error' then 'Connection delayed. Retry when ready.' else 'Synchronizing your collection…' end
 sidebar.Visible=expanded and ready and not screens.hub and not store.battle;if store.battle then expanded=false end
 top.Visible=ready and not store.battle;progress.Visible=ready and not store.battle and not (expanded and P.horizontalNavigation(root.AbsoluteSize.Y,UIS.TouchEnabled));quest.Visible=ready and not store.battle and not expanded
 menu.Visible=ready and not screens.hub;quickCreatures.Visible=ready and not screens.hub and not expanded and not store.battle;quickMountain.Visible=quickCreatures.Visible;quick.Visible=ready and not screens.hub and not expanded and root.AbsoluteSize.Y>=400;team.Visible=ready and not screens.hub;actionbar.Visible=ready and not screens.hub and not store.battle and data~=nil and ((data.ui and data.ui.atHome) or (data.ui and data.ui.nearestEgg) or (data.run and data.run.phase=='revealed'))
 dodge.Visible=P.combatVisible(store.battle,ready,screens.hub~=nil);ability.Visible=dodge.Visible;battle.Visible=dodge.Visible
 if data then
  local clock=store:clock();local ui=data.ui or {};local cooldowns=ui.cooldowns or {}
  for i,b in ipairs(slots) do
   local c=R.find(data.creatures,data.team[i]);local remain=c and P.remaining(cooldowns[c.id..':'..selectedAbility(i)] or 0,clock) or 0
   if slotSpecies[i]~=(c and c.species) then
    if slotPortraits[i] then slotPortraits[i]:Destroy();slotPortraits[i]=nil end
    slotSpecies[i]=c and c.species
    if c then slotPortraits[i]=W.portrait(b,C.byId[c.species],UDim2.new(1,-14,1,-34),UDim2.fromOffset(7,1)) end
   end
   slotNames[i].Text=if c then C.byId[c.species].name else 'Empty slot'
   slotStates[i].Text=if not c then tostring(i) elseif store.battle then (if remain>0 then remain..'s' else 'READY') else 'Lv '..c.level
   slotStates[i].TextColor3=if remain>0 then T.muted else T.gold
   b.UIStroke.Color=if c then T.rarity[C.byId[c.species].rarity] else T.line;b.UIStroke.Thickness=2
   W.enable(b,not store.battle or (c~=nil and remain==0))
   b.BackgroundColor3=if remain>0 then T.panel else T.navy
  end
  local dr=P.remaining(ui.dodgeReadyAt or 0,clock);W.enable(dodge,dr==0,if dr>0 then 'Dodge · '..dr..'s' else 'Dodge [Q]');ability.Text='Ability '..activeAbility
  local run=data.run
  context.Text=if run and run.phase=='revealed' then 'Pick up creature' elseif run and run.phase=='carried' then 'Escape to sanctuary' elseif ui.nearestEgg then 'Strike egg' elseif ui.atHome then 'Manage sanctuary' else 'Mountain map'
  game:GetService('ProximityPromptService').Enabled=not screens.hub and not feedback.modal
  hint.Visible=ready and not expanded and not dismissHint and T.prefs.hints~=false and age<24 and not screens.hub and not store.battle and root.AbsoluteSize.Y>=550
  hintText.Text=if data.run then 'Unsecured creature: return through the sanctuary exit. Catch, serious fall or leaving loses this attempt.' elseif ui.inSanctuary then 'Choose your companions, then climb freely into any section.' else 'Find an egg. Tap each strike, pick up the creature, escape downhill.'
 end
 if math.floor(age)~=lastSecond then
  lastSecond=math.floor(age);timer.Text=P.formatTime(age);screens:tick();screens:pending()
  if data then local q=P.quest(data);questDetail.Text=if root.AbsoluteSize.Y<390 then (if T.prefs.hints~=false and age<24 then 'Break · carry · escape' else q.progress..' / '..q.total..' objectives') else q.detail end
  if rr then
   local mountain=workspace:FindFirstChild('ImpossibleMountain');local free=mountain and mountain:GetAttribute('FreeClimbVersion')
   local k=math.clamp(math.floor((rr.Position.Y-16)/(if free then 64 else 136))+1,1,6)
   if free and mountain:FindFirstChild('GuardianBounds') then
    for _,bound in ipairs(mountain.GuardianBounds:GetChildren()) do local q=bound.CFrame:PointToObjectSpace(rr.Position);if math.abs(q.X)<=bound.Size.X/2 and math.abs(q.Z)<=bound.Size.Z/2 then k=tonumber(bound.Name) or k;break end end
   end
   location.Text=if data and data.ui and data.ui.inSanctuary then 'Sanctuary · Plot '..tostring(data.ui.plot or '—') else C.kingdoms[k].name
   heightLabel.Text=math.max(0,math.floor(rr.Position.Y-16))..' studs · '..'6/6 open';heightFill.Size=UDim2.fromScale(math.clamp((rr.Position.Y-16)/(if free then 384 else 824),0,1),1)
   for name,volume in pairs({['Mountain Birds 1 (SFX)']=if k==1 then .14 elseif k==2 then .05 else 0,WaterfallLoop=if k==2 then .12 else 0,AstralWind=if k>=3 then .08 else 0,LavaLoop=if k==5 then .1 else 0}) do
    local s=game:GetService('SoundService'):FindFirstChild(name);if s then if soundBases[s]==nil then soundBases[s]=s.Volume end;s.Volume=volume*(T.prefs.musicVolume or .7);if not s.IsPlaying then s:Play() end end
   end
  end
 end
end)
layout()
connect(gui.Destroying,function()
 disconnect();store:destroy();feedback:destroy();screens:destroy();for _,c in ipairs(connections) do c:Disconnect() end
 for o,value in pairs(defaultEffects) do if o.Parent then o.Enabled=value end end;for s,value in pairs(soundBases) do if s.Parent then s.Volume=value end end;GuiService.SelectedObject=nil
end)
if Run:IsStudio() then
 local probe=W.new('BindableFunction',gui,{Name='UIProbe'})
 probe.OnInvoke=function(action,value)
  if action=='open' and table.find(hubNames,value) then open(value)
  elseif action=='close' then screens:close()
  elseif action=='tab' and screens.hub and screens.shade.Hub.Tabs:FindFirstChild('Tab'..tostring(value)) then screens.tab=value;screens.detail=nil;screens.page=1;screens:render(false) end
  return {ready=ready,hub=screens.hub,tab=screens.tab,view={root.AbsoluteSize.X,root.AbsoluteSize.Y},instances=#gui:GetDescendants(),pending=store.pending,status=store.status}
 end
end
return {}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="86">
            <Properties>
              <string name="Name">Feedback</string>
              <string name="Source"><![CDATA[local T=require(script.Parent.Theme)
local W=require(script.Parent.Widgets)
local GuiService=game:GetService('GuiService')
local F={};F.__index=F
function F.new(root)
 local self=setmetatable({root=root,queue={},serial=0,alive=true},F)
 self.host=W.panel(root,'Toast',UDim2.new(.6,0,0,58),UDim2.new(.2,0,0,68));self.host.ZIndex=40;self.host.Visible=false
 local icon=W.icon(self.host,'Profile',UDim2.fromOffset(40,40),UDim2.fromOffset(8,8));icon.ZIndex=41
 self.label=W.text(self.host,'',UDim2.new(1,-68,1,-12),UDim2.fromOffset(56,6),T.bold,14);self.label.ZIndex=41
 self.tooltip=W.panel(root,'Tooltip',UDim2.fromOffset(280,64),UDim2.new(.5,-140,0,124));self.tooltip.ZIndex=80;self.tooltip.Visible=false
 self.tooltipText=W.text(self.tooltip,'',UDim2.new(1,-24,1,-12),UDim2.fromOffset(12,6),nil,14);self.tooltipText.ZIndex=81
 local function attach(o)
  if not o:IsA('GuiButton') then return end
  local function show() local text=o:GetAttribute('Tooltip');if text and self.alive and not self.host.Visible then self.tooltipText.Text=text;self.tooltip.Visible=true;self.tooltipOwner=o end end
  local function hide() if self.tooltipOwner==o then self.tooltip.Visible=false;self.tooltipOwner=nil end end
  o.MouseEnter:Connect(show);o.MouseLeave:Connect(hide);o.SelectionGained:Connect(show);o.SelectionLost:Connect(hide);o.Destroying:Connect(hide)
 end
 self.added=root.DescendantAdded:Connect(attach)
 self.focus=GuiService:GetPropertyChangedSignal('SelectedObject'):Connect(function()
  local selected=GuiService.SelectedObject
  if self.modal and selected and not selected:IsDescendantOf(self.modal) then GuiService.SelectedObject=self.modal.Dialog.Confirm end
 end)
 return self
end
function F:toast(message,priority)
 if not self.alive or type(message)~='string' or message=='' then return end
 self.tooltip.Visible=false;self.tooltipOwner=nil
 if message==self.label.Text and self.host.Visible or table.find(self.queue,message) then return end
 if priority then self.serial+=1;self.host.Visible=false;table.clear(self.queue) end
 if #self.queue>=4 then table.remove(self.queue,1) end
 table.insert(self.queue,message)
 if self.host.Visible then return end
 self.serial+=1;local serial=self.serial
 local function nextToast()
  if not self.alive or serial~=self.serial then return end
  local m=table.remove(self.queue,1)
  if not m then self.host.Visible=false;return end
  self.host.Visible=true;self.label.Text=m
  task.delay(4,nextToast)
 end
 nextToast()
end
function F:confirm(title,description,onConfirm)
 self:close();self.previousFocus=GuiService.SelectedObject
 local shade=W.frame(self.root,'Confirmation',UDim2.fromScale(1,1),nil,T.navy);shade.BackgroundTransparency=.15;shade.ZIndex=70;shade.Active=true;self.modal=shade
 local f=W.panel(shade,'Dialog',UDim2.new(.86,0,0,226),UDim2.fromScale(.5,.5));f.AnchorPoint=Vector2.new(.5,.5);f.ZIndex=71
 W.new('UISizeConstraint',f,{MaxSize=Vector2.new(480,226)})
 W.text(f,title,UDim2.new(1,-32,0,40),UDim2.fromOffset(16,14),T.display,22).ZIndex=72
 local descriptionLabel=W.text(f,description,UDim2.new(1,-32,0,86),UDim2.fromOffset(16,58),nil,15,T.muted);descriptionLabel.Name='Description';descriptionLabel.ZIndex=72
 W.button(f,'Cancel','Cancel',UDim2.new(.5,-24,0,48),UDim2.new(0,16,1,-64),function() self:close() end,'quiet').ZIndex=72
 local confirm=W.button(f,'Confirm','Confirm',UDim2.new(.5,-24,0,48),UDim2.new(.5,8,1,-64),function() self:close();onConfirm() end,'gold');confirm.ZIndex=72
 if game:GetService('UserInputService').GamepadEnabled then GuiService.SelectedObject=confirm end
end
function F:reveal(title,description,species)
 -- Called only by authoritative state transitions or acknowledged outcomes.
 self:confirm(title,description,function() end)
 local f=self.modal and self.modal:FindFirstChild('Dialog')
 if f then
  f.Confirm.Text='Continue';f.Cancel.Visible=false;f.Confirm.Size=UDim2.new(1,-32,0,48);f.Confirm.Position=UDim2.new(0,16,1,-64)
  if species then
   f.Size=UDim2.new(.86,0,0,300);f.UISizeConstraint.MaxSize=Vector2.new(480,300)
   f.Description.Position=UDim2.fromOffset(16,158);f.Description.Size=UDim2.new(1,-32,0,64);f.Description.TextXAlignment=Enum.TextXAlignment.Center
   local portrait=W.portrait(f,species,UDim2.fromOffset(80,80),UDim2.new(.5,-40,0,70));portrait.ZIndex=72
   for _,o in ipairs(portrait:GetDescendants()) do if o:IsA('GuiObject') then o.ZIndex=73 end end
  end
  if not T.prefs.reducedMotion then
   local scale=W.new('UIScale',f,{Scale=.94})
   game:GetService('TweenService'):Create(scale,TweenInfo.new(.2,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Scale=1}):Play()
  end
 end
end
function F:close()
 if not self.modal then return false end
 local modal=self.modal;self.modal=nil;modal:Destroy()
 if self.previousFocus and self.previousFocus.Parent then GuiService.SelectedObject=self.previousFocus else GuiService.SelectedObject=nil end
 self.previousFocus=nil;return true
end
function F:destroy() self.alive=false;self:close();self.added:Disconnect();self.focus:Disconnect();self.host:Destroy();self.tooltip:Destroy() end
return F
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="87">
            <Properties>
              <string name="Name">Screens</string>
              <string name="Source"><![CDATA[local Players=game:GetService('Players')
local GuiService=game:GetService('GuiService')
local UIS=game:GetService('UserInputService')
local C=require(game.ReplicatedStorage.MountainShared.Catalog)
local R=require(game.ReplicatedStorage.MountainShared.Rules)
local P=require(game.ReplicatedStorage.MountainShared.UIPresentation)
local T=require(script.Parent.Theme)
local W=require(script.Parent.Widgets)
local TycoonHub=require(script.Parent.TycoonHub)
local S={};S.__index=S
local tabs={Creatures={'Collection','Team','Training','Evolution'},Discovery={'Eggs','Field guide'},Sanctuary={'Overview','Habitats','Upgrades','Automation','Cosmetics','Facilities'},Mountain={'Map','Quests','Trials'},Social={'Party','Challenges','Defense'},Profile={'Overview','Achievements','Recognition'},Shop={'Cosmetics','Convenience'},Settings={'Accessibility','Audio','Quick'}}
local aliases={Collection='Creatures',Training='Creatures',Incubator='Discovery',Eggs='Discovery',Travel='Mountain',Journal='Mountain',Competition='Social'}
local aliasTabs={Training='Training',Incubator='Eggs',Eggs='Eggs',Travel='Map',Journal='Quests',Competition='Challenges'}
function S.new(root,store,feedback,onClose)
 local self=setmetatable({root=root,store=store,feedback=feedback,onClose=onClose,selected={},query='',rarity='All',sort='Name',page=1,tickers={},actionButtons={},touches={}},S)
 self.touchBegin=UIS.TouchStarted:Connect(function(input) self.touches[input]=true end)
 self.touchEnd=UIS.TouchEnded:Connect(function(input) self.touches[input]=nil end)
 return self
end
function S:open(name)
 if not tabs[aliases[name] or name] then return end
 self.tycoonRoster=nil;self.tycoonPage=1
 self.hub=aliases[name] or name;self.tab=aliasTabs[name] or tabs[self.hub][1];self.detail=nil;self.page=1
 if self.store.profile then self.selected=table.clone(self.store.profile.team) end
 self:render(false)
end
function S:close()
 if self.shade then self.shade:Destroy();self.shade=nil end
 self.hub=nil;self.detail=nil;self.tickers={};self.actionButtons={};GuiService.SelectedObject=nil
 if self.onClose then self.onClose() end
end
function S:destroy()
 self:close();self.touchBegin:Disconnect();self.touchEnd:Disconnect();table.clear(self.touches)
end
function S:back() if self.detail then self.detail=nil;self:render(false) else self:close() end end
function S:send(action,payload)
 local id=self.store:request(action,payload)
 if not id then self.feedback:toast('That action is already waiting for a response. Check the status below.') end
end
function S:action(parent,name,label,action,payload,enabled,pos,size)
 if parent:FindFirstChild('Description') then parent.Description.Size=UDim2.new(1,-28,0,math.max(40,parent.Size.Y.Offset-106)) end
 local b=W.button(parent,name,label,size or UDim2.new(1,-28,0,44),pos or UDim2.new(0,14,1,-56),function() self:send(action,if type(payload)=='function' then payload() else payload) end,'blue',enabled)
 table.insert(self.actionButtons,{button=b,action=action,enabled=enabled~=false,label=label});return b
end
function S:blocked(title,description,actionLabel)
 local f=W.row(self.body,title,description,182)
 f.Description.Size=UDim2.new(1,-28,0,74)
 W.button(f,'Unavailable',actionLabel or 'Not available in this build',UDim2.new(1,-28,0,44),UDim2.new(0,14,1,-56),nil,'quiet',false)
 return f
end
function S:note(title,description,height) return W.row(self.body,title,description,height or 105) end
function S:pending()
 for _,v in ipairs(self.actionButtons) do
  local busy=false
  for _,p in pairs(self.store.pending) do if p.action==v.action then busy=true;break end end
  W.enable(v.button,v.enabled and not busy and not self.deferredRender,if busy then 'Waiting…' else v.label)
 end
 if self.status then
  local message='Changes are confirmed by the server.';local retryId=nil
  for id,p in pairs(self.store.pending) do
   if p.status=='timeout' then message='No reply yet. Retry safely with the same request.';retryId=id;break
   else message='Waiting for '..p.action..'…' end
  end
  if not next(self.store.pending) and self.store.lastResult then message=self.store.lastResult.message or message end
  if self.deferredRender then message='Release your touch or finish editing to refresh actions.' end
  self.status.Text=message;self.retry.Visible=retryId~=nil;self.retryId=retryId
 end
end
function S:tick()
 if self.deferredRender then self:render(true) end
 for _,fn in ipairs(self.tickers) do fn() end
end
function S:focusTarget(path,name)
 local target=self.shade
 for _,part in ipairs(path) do target=target and target:FindFirstChild(part) end
 return target or (name and self.shade:FindFirstChild(name,true))
end
function S:render(preserve)
 if not self.hub or not self.store.profile then return end
 local focused=UIS:GetFocusedTextBox()
 if preserve and self.shade and ((focused and focused:IsDescendantOf(self.shade)) or UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) or next(self.touches)~=nil) then self.deferredRender=true;self:pending();return end
 self.deferredRender=false
 local selected=GuiService.SelectedObject;local selectedName=if selected then selected.Name else nil;local selectedPath={}
 if preserve and selected and self.shade and selected:IsDescendantOf(self.shade) then
  local cursor=selected;while cursor and cursor~=self.shade do table.insert(selectedPath,1,cursor.Name);cursor=cursor.Parent end
 end
 local tabScrollPosition=if preserve and self.shade then self.shade.Hub.Tabs.CanvasPosition else Vector2.zero
 local scroll=if preserve and self.body then self.body.CanvasPosition else Vector2.zero
 if self.shade then self.shade:Destroy() end
 self.tickers={};self.actionButtons={}
 local data=self.store.profile;local view=self.root.AbsoluteSize
 local width=math.min(850,view.X-20);local height=math.min(660,view.Y-16)
 self.shade=W.frame(self.root,'HubShade',UDim2.fromScale(1,1),nil,T.navy);self.shade.BackgroundTransparency=.23;self.shade.ZIndex=20;self.shade.Active=true
 local f=W.panel(self.shade,'Hub',UDim2.fromOffset(width,height),UDim2.fromScale(.5,.5));f.AnchorPoint=Vector2.new(.5,.5);f.ZIndex=21
 local title=if self.detail then 'Creature details' else self.hub
 W.icon(f,self.hub,UDim2.fromOffset(40,40),UDim2.fromOffset(12,7))
 W.text(f,title,UDim2.new(1,-196,0,44),UDim2.fromOffset(62,5),T.display,24,T.ink)
 W.button(f,'Back',if self.detail then 'Back' else 'Close',UDim2.fromOffset(86,44),UDim2.new(1,-98,0,7),function() self:back() end,'quiet')
 local tabScroll=W.new('ScrollingFrame',f,{Name='Tabs',Size=UDim2.new(1,-24,0,48),Position=UDim2.fromOffset(12,57),BackgroundTransparency=1,BorderSizePixel=0,CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.X,ScrollingDirection=Enum.ScrollingDirection.X,ScrollBarThickness=0})
 W.list(tabScroll,8,true)
 for _,name in ipairs(tabs[self.hub]) do
  W.button(tabScroll,'Tab'..name,name,UDim2.fromOffset(if #name>10 then 136 else 112,44),nil,function() self.tab=name;self.detail=nil;self.page=1;self:render(false) end,if name==self.tab then 'gold' else 'quiet')
 end
 self.body=W.scroll(f,'Content',UDim2.new(1,-24,1,-158),UDim2.fromOffset(12,108))
 self.status=W.text(f,'',UDim2.new(1,-124,0,38),UDim2.new(0,16,1,-44),nil,12,T.muted)
 self.retry=W.button(f,'Retry','Retry',UDim2.fromOffset(88,44),UDim2.new(1,-100,1,-48),function() if self.retryId then self.store:retry(self.retryId) end end,'gold');self.retry.Visible=false
 if self.hub=='Creatures' then self:creatures(data,width)
 elseif self.hub=='Discovery' then self:discovery(data)
 elseif self.hub=='Sanctuary' then self:sanctuary(data)
 elseif self.hub=='Mountain' then self:mountain(data)
 elseif self.hub=='Social' then self:social(data)
 elseif self.hub=='Profile' then self:profile(data)
 elseif self.hub=='Shop' then self:shop()
 elseif self.hub=='Settings' then self:settings(data) end
 self.body.CanvasPosition=scroll;tabScroll.CanvasPosition=tabScrollPosition;self:pending();self:tick()
 if UIS.GamepadEnabled and UIS:GetLastInputType()==Enum.UserInputType.Gamepad1 then
  local target=nil
  if preserve and #selectedPath>0 then target=self:focusTarget(selectedPath,selectedName) end
  GuiService.SelectedObject=if target and target:IsA('GuiButton') and target.Selectable then target else f.Back
 end
end
function S:creatures(data,width)
 if self.detail then
  local c=R.find(data.creatures,self.detail);if not c then self.detail=nil;self:render(false);return end
  local info=P.creature(c);local species=C.byId[c.species]
  local hero=self:note(info.name..'  ·  Lv '..c.level,species.rarity..'  /  '..species.element..'  /  '..species.role..'\n'..species.feature,146)
  hero.Title.Size=UDim2.new(1,-130,0,28);hero.Description.Size=UDim2.new(1,-130,0,94)
  W.portrait(hero,species,UDim2.fromOffset(92,92),UDim2.new(1,-108,0,12))
  self:note('Companion statistics',string.format('Attack %d     Health %d\nXP %d / %d   ·   Evolution stage %d',math.floor(info.attack),math.floor(info.health),c.xp,info.xpRequired,R.stage(c.level)),108)
  local abilities=info.abilityNames or {species.role..' special'}
  self:note('Manual specials',table.concat(abilities,'  /  ')..'\nBasic attacks run automatically during encounters.',110)
  local evo=self:note('Evolution journey','Stage I: Lv 1   →   Stage II: Lv 15   →   Stage III: Lv 35\nEvolution happens automatically when your creature reaches the level.',122)
  W.progress(evo,math.min(c.level/35,1),UDim2.new(1,-28,0,8),UDim2.new(0,14,1,-17),T.purple)
  local at=data.ui and data.ui.atRefuge
  local train=self:note('Training session','15 coins grants 80 XP. '..(if at then 'Your creature is at the training area.' else 'Visit the training station on your plot or at the refuge.'),150)
  self:action(train,'Train','Train · 15 coins','Train',c.id,at and data.coins>=15 and c.level<50)
  if c.specialization then self:note('Specialization',c.specialization..' is your permanent focus.',88)
  elseif c.level>=25 then
   local row=self:note('Choose a permanent focus','Power: attack +20% · Guard: 15% defense · Vitality: health +25%.',154)
   for i,choice in ipairs({'Power','Guard','Vitality'}) do
    W.button(row,'Focus'..choice,choice,UDim2.new(1/3,-14,0,44),UDim2.new((i-1)/3,10,1,-56),function()
     self.feedback:confirm('Choose '..choice..'?',species.name..' will keep this specialization permanently.',function() self:send('Specialize',{id=c.id,choice=choice}) end)
    end,'gold')
   end
  else self:note('Specialization unlocks at Lv 25','Choose Power, Guard or Vitality when this creature reaches level 25.',96) end
  return
 end
 if self.tab=='Team' then
  local team=self:note('Three companions. One expedition.','Select up to three creatures below, then save your team. '..#self.selected..' / 3 selected.',152)
  self:action(team,'Equip','Save team ('..#self.selected..'/3)','Equip',function() return table.clone(self.selected) end,#self.selected>0)
 elseif self.tab=='Training' then
  self:note('Grow your team','Train on your plot or at the refuge for 15 coins / 80 XP. Open a creature to see its statistics and train.',110)
 elseif self.tab=='Evolution' then
  self:note('A journey, not a second purchase','Your creatures evolve automatically at levels 15 and 35. Specialization opens at 25. Select a creature for its timeline.',112)
 end
 local compact=self.root.AbsoluteSize.Y<390
 local filters=W.panel(self.body,'Filters',UDim2.new(1,-8,0,if compact then 54 else 110))
 local box=W.round(W.new('TextBox',filters,{Name='Search',Size=UDim2.new(1,-24,0,44),Position=UDim2.fromOffset(12,10),Text=self.query,PlaceholderText='Search your creatures',ClearTextOnFocus=false,TextColor3=T.ink,PlaceholderColor3=T.muted,BackgroundColor3=T.navy,Font=T.body,TextSize=T.size(15),BorderSizePixel=0}),8)
 box.FocusLost:Connect(function() self.query=box.Text;self.page=1;self:render(false) end)
 local rarities={'All','Common','Uncommon','Rare','Epic','Mythic','Legendary'}
 local rarityButton=W.button(filters,'Rarity','Rarity: '..self.rarity,UDim2.new(.6,-18,0,44),UDim2.fromOffset(12,62),function() self.rarity=rarities[(table.find(rarities,self.rarity) or 1)%#rarities+1];self.page=1;self:render(false) end,'quiet')
 local sortButton=W.button(filters,'Sort','Sort: '..self.sort,UDim2.new(.4,-18,0,44),UDim2.new(.6,6,0,62),function() self.sort=if self.sort=='Name' then 'Level' elseif self.sort=='Level' then 'Rarity' else 'Name';self:render(true) end,'quiet')
 if compact then
  box.Size=UDim2.new(.4,-12,0,44);box.Position=UDim2.fromOffset(6,5);box.PlaceholderText='Search'
  rarityButton.Size=UDim2.new(.3,-8,0,44);rarityButton.Position=UDim2.new(.4,0,0,5)
  sortButton.Size=UDim2.new(.3,-8,0,44);sortButton.Position=UDim2.new(.7,0,0,5)
 end
 local list=P.filterCreatures(data,self.query,self.rarity,self.sort)
 if #list==0 then self:note('No matching companions','Try another filter, or discover eggs on your next climb. Your collection stays safe.',108);return end
 local columns=if width<600 then 2 else 3
 local cardHeight=if compact then 150 else 210
 local grid=W.frame(self.body,'CreatureGrid',UDim2.new(1,-8,0,math.ceil(math.min(12,#list-(self.page-1)*12)/columns)*(cardHeight+12)));grid.BackgroundTransparency=1
 W.new('UIGridLayout',grid,{CellSize=UDim2.new(1/columns,-8,0,cardHeight),CellPadding=UDim2.fromOffset(10,12),SortOrder=Enum.SortOrder.LayoutOrder})
 for index=(self.page-1)*12+1,math.min(#list,self.page*12) do
  local c=list[index];local s=C.byId[c.species];local card=W.panel(grid,'Creature_'..c.id,nil,nil,T.card);card.UIStroke.Color=T.rarity[s.rarity]
  W.portrait(card,s,UDim2.fromOffset(if compact then 48 else 76,if compact then 48 else 76),UDim2.new(.5,if compact then -24 else -38,0,5))
  W.text(card,s.name,UDim2.new(1,-16,0,24),UDim2.fromOffset(8,if compact then 50 else 87),T.bold,16).TextXAlignment=Enum.TextXAlignment.Center
  W.text(card,'Lv '..c.level..' · '..s.rarity,UDim2.new(1,-16,0,24),UDim2.fromOffset(8,if compact then 72 else 114),nil,12,T.rarity[s.rarity]).TextXAlignment=Enum.TextXAlignment.Center
  local selected=table.find(self.selected,c.id)
  local label=if self.tab=='Team' then (if selected then 'Selected '..selected else 'Select') else 'Details'
  W.button(card,'Details_'..c.id,label,UDim2.new(1,-20,0,44),UDim2.new(0,10,1,-56),function()
   if self.tab=='Team' then
    local n=table.find(self.selected,c.id)
    if n then table.remove(self.selected,n) elseif #self.selected<3 then table.insert(self.selected,c.id) else self.feedback:toast('Your team has three slots. Deselect one first.') end
   else self.detail=c.id end
   self:render(self.tab=='Team')
  end,if selected and self.tab=='Team' then 'gold' else 'blue')
 end
 if #list>12 then
  local pages=W.frame(self.body,'Pages',UDim2.new(1,-8,0,50));pages.BackgroundTransparency=1
  W.button(pages,'Previous','Previous',UDim2.new(.5,-8,0,44),nil,function() self.page=math.max(1,self.page-1);self:render(false) end,'quiet',self.page>1)
  W.button(pages,'Next','Next',UDim2.new(.5,-8,0,44),UDim2.fromScale(.5,0),function() self.page+=1;self:render(false) end,'quiet',self.page*12<#list)
 end
end
function S:discovery(data)
 if self.tab=='Field guide' then
  local owned={};for _,c in ipairs(data.creatures) do owned[c.species]=true end
  for k,kingdom in ipairs(C.kingdoms) do
   local found=0;for _,s in ipairs(C.species) do if s.kingdom==k and owned[s.id] then found+=1 end end
   self:note(kingdom.name,found..' / 6 regular species discovered.\nLook for nests, wild encounters, puzzles and exploration branches.',105)
  end;return
 end
 local active=0;for _,e in ipairs(data.eggs) do if e.readyAt then active+=1 end end
 self:note('Legacy eggs & incubation',#data.eggs..' secured legacy eggs  ·  '..active..' / 3 incubators\nYour old eggs remain safe. Incubation and hatching are free at home. New mountain creatures are revealed on the mountain and secured at the sanctuary exit.',140)
 if #data.cargo+#data.eggs==0 then self:note('Your next companion is out there','Climb into any section. Break a visible egg, pick up the creature and escape through the sanctuary exit.',120) end
 for _,e in ipairs(data.cargo) do self:note(C.byId[e.species].name..' egg · unsecured','Carry to a checkpoint. A fall leaves your eggs in a recoverable pack for three minutes.',106) end
 for _,e in ipairs(data.eggs) do
  local species=C.byId[e.species];local card=self:note(species.name..' egg',species.rarity..' · secured',178)
  local timer=W.text(card,'',UDim2.new(1,-28,0,26),UDim2.fromOffset(14,78),T.bold,14,T.gold)
  local at=data.ui and data.ui.atRefuge
  local b=self:action(card,'Egg_'..e.id,if e.readyAt then 'Hatch free' else 'Incubate free',if e.readyAt then 'Hatch' else 'Incubate',e.id,at and (if e.readyAt then e.readyAt<=self.store:now() else active<3))
  table.insert(self.tickers,function()
   local remain=if e.readyAt then P.remaining(e.readyAt,self.store:now()) else nil
   timer.Text=if remain then (if remain==0 then 'Ready to hatch' else P.formatTime(remain)..' remaining') else P.formatTime(C.incubation[species.rarity])..' incubation'
   if not at then timer.Text..=' · visit your plot' end
   for _,v in ipairs(self.actionButtons) do if v.button==b then v.enabled=at and (if remain then remain==0 else active<3) end end
  end)
 end
end
function S:sanctuary(data) TycoonHub.render(self,data) end
function S:mountain(data)
 if self.tab=='Quests' then
  local q=P.quest(data);local card=self:note(q.title,q.detail,122)
  W.progress(card,q.progress/math.max(q.total,1),UDim2.new(1,-28,0,8),UDim2.new(0,14,1,-18),T.green)
  for k,kingdom in ipairs(C.kingdoms) do self:note(kingdom.name,if data.wins[tostring(k)] then 'Open to all · normal Guardian defeated · Trial available' else 'Open to all · break eggs or optionally challenge '..C.guardians[k].name,94) end
  self:blocked('Daily missions','Daily objectives and claimable daily rewards are not connected. This journal tracks your actual mountain progression.','Daily rewards unavailable')
 elseif self.tab=='Trials' then
  for k,g in ipairs(C.guardians) do
   local owned=data.captures[g.id];local won=data.wins[tostring(k)]
   self:note(g.name..' · '..g.title,(if owned then 'CAPTURED · this Guardian is already in your collection.' elseif won then 'Trial available at the kingdom altar.' else 'Defeat the normal Guardian to unlock its Trial.')..'\n3 clean dodges + 4 resolved patterns'..(if k==5 then ' + interrupt the golden heart.' elseif k==6 then ' + align three constellation stones.' else '.'),132)
  end
 else
  local f=self:note('Six open sections','Walk freely into any section. Fast travel uses discovered rest points and requires abandoning an unsecured creature. Only the sanctuary exit secures it.',146)
  self:action(f,'ReturnRefuge','Return to sanctuary','Travel','refuge',data.ui and (data.ui.atRefuge or data.ui.nearCheckpoint))
  for k,kingdom in ipairs(C.kingdoms) do
   local unlocked=R.canEnter(data,k);local color=Color3.fromRGB(table.unpack(kingdom.accent))
   local f=self:note(kingdom.name,(if data.wins[tostring(k)] then 'Open · Guardian defeated' else 'Open · eggs and optional Guardian encounters')..'\n'..(data.resources[tostring(k)] or 0)..' '..kingdom.resource,174)
   W.stroke(f,color,2)
   for i,point in ipairs({'entrance','recovery','guardian'}) do
    local id=k..':'..point;local found=data.discoveries[id]==true
    self:action(f,'Travel_'..k..'_'..point,if found then point:gsub('^%l',string.upper) else 'Undiscovered','Travel',id,unlocked and found and data.ui and (data.ui.atRefuge or data.ui.nearCheckpoint),UDim2.new((i-1)/3,10,1,-58),UDim2.new(1/3,-14,0,46))
   end
  end
 end
end
function S:social(data)
 if self.tab=='Party' then
  local battle=self.store.battle
  self:note('Climb together','Friends can join the same Guardian at its altar while the encounter is open. Your teammates attack automatically and share the battle.',116)
  if battle and battle.members then
   for _,m in ipairs(battle.members) do self:note(m.name or tostring(m.userId),'In your current Guardian encounter',82) end
  else self:note('No active co-op encounter','Meet other climbers at a Guardian altar to battle together.',92) end
  self:blocked('Party finder & invitations','Persistent parties, invitations and readiness are not connected in this review. No invitations are sent from this screen.','Invitations unavailable')
 elseif self.tab=='Defense' then
  local f=self:note('Your equipped team is your defense','Register a snapshot for asynchronous challenges. Your creatures and eggs cannot be stolen. UserId: '..Players.LocalPlayer.UserId,164)
  self:action(f,'RegisterDefense','Register defense','RegisterDefense',nil,data.ui and data.ui.atRefuge)
  for i,id in ipairs(data.team) do local c=R.find(data.creatures,id);if c then self:note('Slot '..i..' · '..C.byId[c.species].name,'Level '..c.level..' · '..(c.specialization or 'No specialization'),82) end end
  self:blocked('Sanctuary defense layout','Raid defense buildings are not available yet. Production habitats are managed in Sanctuary; team defense registration is available above.')
 else
  self:note('Sanctuary challenges',data.trophies..' trophies · challenge a saved defense\nA registered opponent can be offline. Practice is clearly separate from another player.',116)
  local f=self:note('Challenge a defense','Enter another player’s numeric UserId. Use 0 for the existing practice defense.',222)
  local box=W.round(W.new('TextBox',f,{Name='OpponentId',Size=UDim2.new(1,-28,0,44),Position=UDim2.fromOffset(14,106),Text=self.opponent or '',PlaceholderText='Player UserId (0 = practice)',ClearTextOnFocus=false,TextColor3=T.ink,PlaceholderColor3=T.muted,BackgroundColor3=T.navy,Font=T.body,TextSize=T.size(15),BorderSizePixel=0}),8)
  box.FocusLost:Connect(function() self.opponent=box.Text;if self.deferredRender then task.defer(function() self:render(true) end) end end)
  self:action(f,'ChallengeDefense','Challenge','ChallengeDefense',function() self.opponent=box.Text;return tonumber(box.Text) end,data.ui and data.ui.atRefuge)
  local timer=W.text(f,'',UDim2.new(1,-28,0,23),UDim2.fromOffset(14,79),nil,12,T.gold)
  table.insert(self.tickers,function() local n=P.remaining(data.competitionAt,self.store:now());timer.Text=if n>0 then 'Next challenge in '..P.formatTime(n) else 'Ready at refuge' end)
  self:blocked('Raids & friend challenges','Live raid management and friend matchmaking are not connected. Saved defense challenges use the existing server rules.','Live raids unavailable')
 end
end
function S:profile(data)
 local captures,wins=0,0;for _ in pairs(data.captures) do captures+=1 end;for _ in pairs(data.wins) do wins+=1 end
 if self.tab=='Overview' then
  self:note(Players.LocalPlayer.DisplayName,'@'..Players.LocalPlayer.Name..'\n'..#data.creatures..' companions · '..captures..' / 6 Guardians · '..data.trophies..' trophies',124)
  self:note('Expedition record',wins..' / 6 kingdom Guardians defeated\n'..(if data.discoveries.summit then 'Summit reached · Sovereign Explorer' else 'Summit journey in progress'),112)
 elseif self.tab=='Achievements' then
  for k,g in ipairs(C.guardians) do self:note(g.name..' mastery',(if data.wins[tostring(k)] then '✓ Normal victory earned' else '○ Normal victory not yet earned')..'\n'..(if data.captures[g.id] then '✓ Trial capture earned' else '○ Trial capture not yet earned'),104) end
  self:note('Sovereign Explorer',if data.discoveries.summit then '✓ Summit reached' else '○ Defeat Caeloryn and reach the summit',88)
 else
  self:note('Trophy gallery',data.trophies..' trophies earned in the existing mountain and challenge systems. Guardian captures and summit achievements appear in your profile.',108)
  self:blocked('Leaderboards & in-world rankings','A ranking service and authoritative in-world display feed are not connected. No sample players or invented ranks are shown.','Rankings unavailable')
  self:blocked('Badges & equipped titles','Badge awards and title selection need their platform/profile services. Earned mountain milestones remain visible in Achievements.','Title selection unavailable')
 end
end
function S:shop()
 if self.tab=='Cosmetics' then
  local free=self:note('Sanctuary palettes','Your unlocked kingdom palettes are free. Personalize habitat trim and machines at your plot.',156)
  W.button(free,'FreePalettes','Open free palettes',UDim2.new(1,-28,0,44),UDim2.new(0,14,1,-56),function() self:open('Sanctuary');self.tab='Cosmetics';self:render(false) end,'gold')
  self:note('Make the mountain yours','Cosmetics and personal style belong here: appearances, decorations and visual effects. Your combat strength comes from play.',118)
  self:blocked('Cosmetic collection','No approved product catalog or entitlement service is connected to this review. Items and prices will appear when available.','Checkout unavailable')
 else
  self:note('Fair conveniences','Only noncompetitive convenience belongs here. No paid creature odds, capture advantage or power purchases.',112)
  self:blocked('Convenience catalog','No approved convenience products or receipt validation are connected. There are no purchases available.','Checkout unavailable')
 end
end
function S:settings(data)
 local prefs=(data.ui and data.ui.settings) or {}
 local function toggle(key,title,description)
  local f=self:note(title,description,148)
  self:action(f,'Setting_'..key,if prefs[key] then 'On · tap to turn off' else 'Off · tap to turn on','Settings',function() return {[key]=not prefs[key]} end,true)
 end
 if self.tab=='Audio' then
  for _,v in ipairs({{'musicVolume','Music & ambience'},{'sfxVolume','Sound effects'}}) do
   local key,title=v[1],v[2];local value=prefs[key] or 0
   local f=self:note(title,'Volume '..math.floor(value*100)..'% · visual cues always remain available.',150)
   self:action(f,'Volume_'..key,'Adjust volume','Settings',function() return {[key]=if value>=1 then 0 else math.min(1,value+.25)} end,true)
  end
 elseif self.tab=='Quick' then
  toggle('reducedMotion','Reduced motion','Keep feedback still and remove cinematic movement.')
  toggle('hints','Contextual hints','Short guidance during your expedition, never a mandatory slideshow.')
  toggle('simplifiedVFX','Simplified effects','Reduce decorative particles while retaining encounter cues.')
 else
  toggle('largeText','Larger text','Larger menu labels and descriptions. Panels remain scrollable.')
  toggle('highContrast','High contrast','Opaque panels and brighter outlines improve readability.')
  toggle('reducedMotion','Reduced motion','Reduce UI animation and camera feedback.')
  toggle('simplifiedVFX','Simplified effects','Reduce decorative effects without hiding danger.')
  toggle('hints','Contextual hints','Show short, nonblocking expedition guidance.')
 end
 self:note('Preference storage',data.saveMode or 'Preferences follow your profile save status.',88)
end
return S
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="88">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[local T={
 navy=Color3.fromRGB(7,23,39),panel=Color3.fromRGB(14,43,65),card=Color3.fromRGB(25,66,91),
 sky=Color3.fromRGB(33,184,255),blue=Color3.fromRGB(52,120,246),gold=Color3.fromRGB(255,194,71),
 green=Color3.fromRGB(66,217,121),purple=Color3.fromRGB(163,107,255),coral=Color3.fromRGB(255,102,95),
 ink=Color3.fromRGB(248,253,255),muted=Color3.fromRGB(190,218,231),line=Color3.fromRGB(100,178,209),
 display=Enum.Font.FredokaOne,body=Enum.Font.GothamMedium,bold=Enum.Font.GothamBold,
 prefs={},
 rarity={Common=Color3.fromRGB(190,211,227),Uncommon=Color3.fromRGB(89,222,153),Rare=Color3.fromRGB(70,186,255),Epic=Color3.fromRGB(181,133,255),Mythic=Color3.fromRGB(255,136,185),Legendary=Color3.fromRGB(255,204,91)},
}
function T.configure(p) T.prefs=p or {} end
function T.size(n) return n+(if T.prefs.largeText then 2 else 0) end
return T
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="89">
            <Properties>
              <string name="Name">TycoonHub</string>
              <string name="Source"><![CDATA[local C=require(game.ReplicatedStorage.MountainShared.Catalog)
local T=require(game.ReplicatedStorage.MountainShared.Tycoon)
local W=require(script.Parent.Widgets)
local Hub={}
function Hub.render(screen,data)
 local t=data.tycoon;if not t then screen:note('Sanctuary loading','Waiting for your production profile.');return end
 local s=T.snapshot(data);local at=data.ui and data.ui.atHome==true
 local function action(card,name,label,payload,enabled)
  if not at then label='Return to your plot' end
  return screen:action(card,name,label,'Tycoon',payload,at and enabled~=false)
 end
 local function upgrade(path,slot)
  local q=T.quote(data,path,slot);local def=T.config.paths[path]
  local detail=if q then 'Level '..q.level..' → '..q.next..' · '..q.cost..' coins\n'..T.upgradeEffect(data,path)..(if q.requirement~='' then '\n'..q.requirement else '') else 'Maximum level reached. No resets required.'
  local card=screen:note(def.label..(if slot then ' '..slot else ''),detail,if q and q.requirement~='' then 205 else 180)
  action(card,'Upgrade_'..path..tostring(slot or ''),if q then 'Upgrade · '..q.cost..' coins' else 'Maximum level',{op='upgrade',path=path,slot=slot},q~=nil and q.ready and data.coins>=q.cost)
 end
 if not at then screen:note('Manage from your sanctuary','You can inspect production anywhere. Return to your own plot to collect, bank, assign and upgrade.',118) end
 if screen.tab=='Habitats' then
  if screen.tycoonRoster then
   local index=screen.tycoonRoster
   local header=screen:note('Assign habitat '..index,'Choose an owned creature. Combat team stays unchanged. Each creature can produce in one habitat.',155)
   W.button(header,'BackHabitats','Back to habitats',UDim2.new(1,-28,0,44),UDim2.new(0,14,1,-56),function() screen.tycoonRoster=nil;screen:render(false) end)
   local assigned={};for i,h in ipairs(t.habitats) do if h.creature then assigned[h.creature]=i end end
   local page=screen.tycoonPage or 1;local pages=math.max(1,math.ceil(#data.creatures/12));page=math.min(page,pages)
   for i=(page-1)*12+1,math.min(page*12,#data.creatures) do
    local c=data.creatures[i];local species=C.byId[c.species];local where=assigned[c.id]
    local card=screen:note(species.name..' · '..species.rarity,'Level '..c.level..' · '..species.element..(if where then '\nAssigned to habitat '..where else '\nAvailable for production'),160)
    local payload=if where and where~=index then {op='swap',slot=index,other=where} else {op='assign',slot=index,id=c.id}
    action(card,'Assign_'..c.id,if where==index then 'Assigned here' elseif where then 'Swap with habitat '..where else 'Assign to habitat '..index,payload,where~=index)
   end
   local pageRow=screen:note('Roster '..page..' / '..pages,'12 creatures per page',150)
   W.button(pageRow,'RosterNext','Next page',UDim2.new(1,-28,0,44),UDim2.new(0,14,1,-56),function() screen.tycoonPage=page%pages+1;screen:render(false) end)
   return
  end
  screen:note('Production assignments','Two habitats to start, eight at full expansion. Match a kingdom for +5%; shared creature kingdoms add up to +10%.',130)
  for i,h in ipairs(s.habitats) do
   if h.unlocked then
    local c=h.creature and (function() for _,v in ipairs(data.creatures) do if v.id==h.creature then return v end end end)()
    local title='Habitat '..i..' · '..(if c then C.byId[c.species].name else 'Empty')
    local card=screen:note(title,string.format('%d / %d eggs · %.1f / hour\n%s · bonus %.0f%% · comfort %d',h.eggs,h.capacity,h.rate,C.kingdoms[h.kingdom].name,h.bonus*100,h.level),205)
    W.button(card,'Choose_'..i,'Choose creature',UDim2.new(.5,-21,0,44),UDim2.new(0,14,1,-56),function() screen.tycoonRoster=i;screen.tycoonPage=1;screen:render(false) end,'blue',at)
    action(card,'Unassign_'..i,'Unassign',{op='assign',slot=i},c~=nil).Position=UDim2.new(.5,7,1,-56)
    card['Unassign_'..i].Size=UDim2.new(.5,-21,0,44)
    local collect=screen:note('Habitat '..i..' storage','Stored eggs stay here when you change creatures.',145)
    action(collect,'Collect_'..i,if h.eggs==0 then 'Producing eggs...' elseif s.bag.eggs>=s.bagCapacity then 'Bag full · bank eggs' else 'Collect batch',{op='collect',slot=i},h.eggs>0 and s.bag.eggs<s.bagCapacity)
    upgrade('habitat',i)
    local attune=screen:note('Habitat '..i..' kingdom',C.kingdoms[h.kingdom].name..' · cycle through your unlocked kingdoms',150)
    action(attune,'Attune_'..i,if data.unlocked<=1 then 'Unlock another kingdom' else 'Attune next kingdom',{op='attune',slot=i,kingdom=h.kingdom%data.unlocked+1},data.unlocked>1)
   else screen:note('Habitat '..i..' · locked','Expand habitat modules in Upgrades. Your existing creatures and progress are never reset.',100) end
  end
 elseif screen.tab=='Upgrades' then
  screen:note('Linear progression',data.coins..' coins · buy each next level. No prestige, resets or daily streaks.',105)
  for _,path in ipairs({'habitats','production','storage','bag','banking'}) do upgrade(path) end
 elseif screen.tab=='Automation' then
  for i,name in ipairs(T.config.automation) do screen:note('Stage '..i..' · '..name,if t.levels.automation>=i then 'Installed' elseif t.levels.automation+1==i then 'Next upgrade · prerequisites and price below' else 'Unlock earlier stages first',95) end
  upgrade('automation')
  screen:note('Offline storage protection','Offline production stops at eight hours or full habitat storage. Automation resumes online; stored eggs never expire.',120)
 elseif screen.tab=='Cosmetics' then
  screen:note('Sanctuary palette','Free visual palettes reuse your kingdoms. They do not affect production or combat.',105)
  for _,id in ipairs(T.config.cosmetics) do local card=screen:note(id,if t.cosmetic==id then 'Selected palette' else 'Apply to habitat trim and machines',145);action(card,'Palette_'..id,'Apply '..id,{op='cosmetic',id=id},t.cosmetic~=id) end
 elseif screen.tab=='Facilities' then
  for _,v in ipairs({{'Training','Training','Train and specialize your existing companions.'},{'Hatchery','Eggs','Hatchable creature eggs stay separate from production eggs. Three free incubators.'}}) do
   local card=screen:note(v[1],v[3],155);W.button(card,'Open'..v[1],'Open '..v[1],UDim2.new(1,-28,0,44),UDim2.new(0,14,1,-56),function() screen:open(v[2]) end)
  end
 else
  screen:note('Your production sanctuary',string.format('%d / 8 habitats · %.1f eggs / hour\n%d stored eggs · %d coins',s.slots,s.rate,s.eggs,data.coins),130)
  local collect=screen:note('Batch collection','Bag '..s.bag.eggs..' / '..s.bagCapacity..' · production eggs cannot hatch. Collect from all active habitats.',165)
  action(collect,'CollectProduction',if s.eggs==0 then 'No eggs ready yet' elseif s.bag.eggs>=s.bagCapacity then 'Bag full · bank eggs' else 'Collect all production eggs',{op='collect',slot=0},s.eggs>0 and s.bag.eggs<s.bagCapacity)
  local bank=screen:note('Bank production eggs','Bag base value: '..s.bag.value..' coins · banking bonus '..(t.levels.banking*2.5)..'%\nBank manually until advanced automation.',165)
  action(bank,'BankProduction',if s.bag.eggs==0 then 'Collect eggs first' else 'Bank eggs for coins',{op='bank'},s.bag.eggs>0)
  screen:note('How production works','Assign both starter habitats. Every tenth egg has bonus value. Full storage pauses production; collect and bank to make room. Upgrade storage for longer expeditions.',140)
 end
end
return Hub
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="90">
            <Properties>
              <string name="Name">Widgets</string>
              <string name="Source"><![CDATA[local T=require(script.Parent.Theme)
local W={}
function W.new(class,parent,props)
 local o=Instance.new(class)
 for k,v in pairs(props or {}) do o[k]=v end
 o.Parent=parent;return o
end
function W.round(o,r) W.new('UICorner',o,{CornerRadius=UDim.new(0,r or 14)});return o end
function W.stroke(o,color,thickness)
 local base=thickness or 1
 local stroke=W.new('UIStroke',o,{ApplyStrokeMode=Enum.ApplyStrokeMode.Border,Color=color or T.line,Thickness=if T.prefs.highContrast then math.max(2,base) else base,Transparency=if T.prefs.highContrast then 0 else .15})
 stroke:SetAttribute('BaseThickness',base);return stroke
end
function W.frame(parent,name,size,pos,color)
 return W.new('Frame',parent,{Name=name,Size=size or UDim2.fromScale(1,1),Position=pos or UDim2.new(),BackgroundColor3=color or T.panel,BorderSizePixel=0})
end
function W.panel(parent,name,size,pos,color)
 local o=W.round(W.frame(parent,name,size,pos,color));W.stroke(o,nil,2)
 W.new('UIGradient',o,{Color=ColorSequence.new(Color3.fromRGB(255,255,255),Color3.fromRGB(173,202,222)),Rotation=90})
 return o
end
function W.text(parent,content,size,pos,font,n,color)
 local label=W.new('TextLabel',parent,{Name='Text',Size=size or UDim2.new(1,0,0,26),Position=pos or UDim2.new(),BackgroundTransparency=1,Text=tostring(content),TextColor3=color or T.ink,Font=font or T.body,TextSize=T.size(n or 15),TextWrapped=true,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Center,RichText=false})
 label:SetAttribute('BaseTextSize',n or 15);return label
end
function W.button(parent,name,label,size,pos,fn,variant,enabled)
 local isEnabled=enabled~=false
 local color=if variant=='gold' then T.gold elseif variant=='quiet' then T.card elseif variant=='danger' then T.coral else T.blue
 local b=W.round(W.new('TextButton',parent,{Name=name,Size=size or UDim2.new(1,0,0,44),Position=pos or UDim2.new(),BackgroundColor3=if isEnabled then color else T.panel,BorderSizePixel=0,Text=label,TextColor3=if not isEnabled then T.muted elseif variant=='gold' then T.navy else T.ink,TextSize=T.size(14),Font=T.bold,TextWrapped=true,AutoButtonColor=isEnabled,Active=isEnabled,Selectable=isEnabled}),10)
 W.stroke(b,if isEnabled then color:Lerp(T.ink,.45) else T.line,2)
 W.new('UIGradient',b,{Color=ColorSequence.new(Color3.new(1,1,1),Color3.fromRGB(208,220,244)),Rotation=90})
 b:SetAttribute('ButtonColor',color);b:SetAttribute('ButtonInk',if variant=='gold' then T.navy else T.ink)
 b:SetAttribute('QAControl',true);b:SetAttribute('Enabled',isEnabled)
 b:SetAttribute('BaseTextSize',14)
 b.Activated:Connect(function() if b:GetAttribute('Enabled') and fn then fn() end end)
 return b
end
function W.enable(b,on,label)
 b:SetAttribute('Enabled',on);b.Active=on;b.Selectable=on;b.AutoButtonColor=on
 b.BackgroundColor3=if on then b:GetAttribute('ButtonColor') or T.blue else T.panel
 b.TextColor3=if on then b:GetAttribute('ButtonInk') or T.ink else T.muted
 b.TextTransparency=0;if label then b.Text=label end
end
function W.padding(o,n) return W.new('UIPadding',o,{PaddingTop=UDim.new(0,n),PaddingBottom=UDim.new(0,n),PaddingLeft=UDim.new(0,n),PaddingRight=UDim.new(0,n)}) end
function W.list(parent,gap,horizontal)
 return W.new('UIListLayout',parent,{Padding=UDim.new(0,gap or 10),FillDirection=if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical,SortOrder=Enum.SortOrder.LayoutOrder})
end
function W.scroll(parent,name,size,pos)
 local s=W.new('ScrollingFrame',parent,{Name=name,Size=size,Position=pos or UDim2.new(),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=4,ScrollBarImageColor3=T.sky,CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y,ScrollingDirection=Enum.ScrollingDirection.Y})
 W.padding(s,4);W.list(s,10);return s
end
function W.row(parent,title,description,height,color)
 local f=W.panel(parent,(title:gsub('[^%w]','')),UDim2.new(1,-8,0,height or 112),nil,color or T.card)
 W.text(f,title,UDim2.new(1,-28,0,28),UDim2.fromOffset(14,10),T.bold,16).Name='Title'
 local desc=W.text(f,description,UDim2.new(1,-28,0,(height or 112)-52),UDim2.fromOffset(14,42),nil,14,T.muted);desc.Name='Description';desc.TextYAlignment=Enum.TextYAlignment.Top
 local accent=W.round(W.frame(f,'Accent',UDim2.new(0,4,1,-28),UDim2.fromOffset(0,14),T.sky),3)
 return f
end
function W.progress(parent,value,size,pos,color)
 local track=W.round(W.frame(parent,'Progress',size,pos,T.navy),5)
 local fill=W.round(W.frame(track,'Fill',UDim2.fromScale(math.clamp(value or 0,0,1),1),nil,color or T.sky),5)
 return fill
end
function W.tag(parent,label,pos,color)
 local f=W.round(W.frame(parent,'Tag',UDim2.fromOffset(100,24),pos,color or T.navy),7)
 local t=W.text(f,label,UDim2.fromScale(1,1),nil,T.bold,11);t.TextXAlignment=Enum.TextXAlignment.Center
 return f
end
-- Local vector artwork: no external asset permissions or network loading dependency.
function W.icon(parent,kind,size,pos)
 local f=W.frame(parent,'Icon'..kind,size,pos);f.BackgroundTransparency=1
 local function shape(name,x,y,w,h,color,round,rotation)
  local p=W.round(W.frame(f,name,UDim2.fromScale(w,h),UDim2.fromScale(x,y),color),round or 4)
  p.Rotation=rotation or 0;return p
 end
 local gold=T.gold;local white=T.ink;local blue=T.sky
 if kind=='Creatures' then
  shape('EarL',.16,.12,.25,.42,blue,7,-24);shape('EarR',.59,.12,.25,.42,blue,7,24)
  local face=shape('Face',.16,.30,.68,.58,blue,18);W.stroke(face,T.navy,2)
  for _,x in ipairs({.31,.59}) do shape('Eye',x,.48,.12,.20,T.navy,20);shape('EyeLight',x+.02,.49,.04,.06,white,20) end
  shape('Muzzle',.40,.70,.20,.09,white,10)
 elseif kind=='Discovery' then
  local egg=shape('Egg',.24,.08,.53,.80,white,100);W.stroke(egg,T.navy,2)
  shape('Spot',.31,.31,.14,.18,T.purple,20,-25);shape('Spot',.58,.48,.13,.19,blue,20,20);shape('Spot',.37,.67,.15,.12,T.green,20)
 elseif kind=='Mountain' then
  shape('Peak',.20,.30,.48,.48,white,3,45);shape('Peak',.50,.45,.34,.34,blue,3,45)
  shape('MountainBase',.10,.65,.80,.24,T.line,4)
 elseif kind=='Sanctuary' then
  shape('Roof',.25,.12,.50,.50,T.green,4,45);shape('House',.21,.43,.60,.44,gold,6);shape('Door',.43,.59,.18,.29,T.navy,4)
 elseif kind=='Shop' then
  shape('Handle',.35,.12,.30,.31,gold,10);shape('Inner',.42,.19,.16,.25,T.navy,5)
  local bag=shape('Bag',.17,.34,.66,.53,Color3.fromRGB(255,162,42),8);W.stroke(bag,T.navy,2)
  shape('Belt',.18,.56,.64,.12,gold,2);shape('Buckle',.44,.51,.14,.24,white,3)
 elseif kind=='Profile' then
  shape('Medal',.25,.22,.50,.50,gold,100);shape('Ribbon',.26,.63,.19,.28,T.blue,3,18);shape('Ribbon',.55,.63,.19,.28,T.blue,3,-18)
  local star=W.text(f,'★',UDim2.fromScale(.5,.5),UDim2.fromScale(.25,.20),T.bold,24,T.navy);star.TextScaled=true;star.TextXAlignment=Enum.TextXAlignment.Center
 elseif kind=='Social' then
  for _,x in ipairs({.12,.56}) do shape('Head',x+.04,.17,.24,.27,blue,100);shape('Body',x,.49,.33,.34,T.purple,10) end
 elseif kind=='Settings' then
  for i=0,7 do shape('Cog',.39,.06,.22,.88,T.line,3,i*45) end
  shape('Gear',.20,.20,.60,.60,white,100);shape('Center',.37,.37,.26,.26,T.navy,100)
 elseif kind=='Menu' then
  for i=0,2 do shape('Bar',.18,.23+i*.23,.64,.10,white,4) end
 elseif kind=='Coin' then
  local coin=shape('Coin',.13,.13,.74,.74,gold,100);W.stroke(coin,Color3.fromRGB(255,239,160),2)
  shape('Shine',.30,.28,.12,.33,white,4,20);shape('Stamp',.52,.33,.12,.34,Color3.fromRGB(213,126,21),4)
 elseif kind=='Interact' then
  shape('Palm',.27,.39,.48,.45,white,10)
  for i=0,3 do shape('Finger',.27+i*.12,.10+math.abs(i-1.5)*.06,.10,.47,white,6) end
  shape('Thumb',.12,.43,.17,.32,white,6,-35)
 end
 return f
end
function W.tile(parent,name,label,kind,size,pos,fn,color)
 local b=W.button(parent,name,'',size,pos,fn,'quiet');b.BackgroundColor3=T.navy
 b.UIStroke.Color=color or T.sky
 local icon=W.icon(b,kind,UDim2.fromOffset(42,42),UDim2.new(.5,-21,0,3))
 local caption=W.text(b,label,UDim2.new(1,-6,0,22),UDim2.new(0,3,1,-25),T.bold,12)
 caption.TextXAlignment=Enum.TextXAlignment.Center
 return b
end
function W.portrait(parent,species,size,pos)
 local C=require(game.ReplicatedStorage.MountainShared.Catalog)
 local accent=Color3.fromRGB(table.unpack(C.kingdoms[species.kingdom].accent))
 local color=if species.kingdom==1 and species.shape=='rabbit' then T.green elseif species.kingdom==1 and species.shape=='fox' then T.gold else accent
 local f=W.round(W.frame(parent,'Portrait',size,pos,T.navy),12)
 -- Species silhouette badge stays legible even before 3D world streaming completes.
 local halo=W.round(W.frame(f,'Medallion',UDim2.fromScale(.70,.70),UDim2.fromScale(.15,.15),color),100)
 halo.BackgroundTransparency=.55
 local shape=species.shape
 local tall=shape=='rabbit';local wing=shape=='moth' or shape=='bird'
 if shape=='deer' then
  for _,x in ipairs({.25,.67}) do
   local antler=W.round(W.frame(f,'Antler',UDim2.fromScale(.09,.34),UDim2.fromScale(x,.06),T.gold),3);antler.Rotation=if x<.5 then -18 else 18
   local branch=W.round(W.frame(f,'AntlerBranch',UDim2.fromScale(.20,.07),UDim2.fromScale(x-.05,.15),T.gold),3);branch.Rotation=if x<.5 then 32 else -32
  end
 end
 for _,x in ipairs({.24,.59}) do
  local ear=W.round(W.frame(f,'Silhouette',UDim2.fromScale(if wing then .28 else .19,if tall then .38 else .25),UDim2.fromScale(x,if tall then .08 else .16),color),8)
  ear.Rotation=if x<.4 then -20 else 20
  local inner=W.round(W.frame(ear,'InnerEar',UDim2.fromScale(.45,.7),UDim2.fromScale(.28,.12),color:Lerp(T.ink,.55)),5)
 end
 local face=W.round(W.frame(f,'Face',UDim2.fromScale(.64,.52),UDim2.fromScale(.18,.31),color),18);W.stroke(face,color:Lerp(T.ink,.5),1)
 W.new('UIGradient',face,{Color=ColorSequence.new(Color3.new(1,1,1),Color3.fromRGB(150,186,212)),Rotation=90})
 for _,x in ipairs({.22,.62}) do
  local eye=W.round(W.frame(face,'Eye',UDim2.fromScale(.17,.33),UDim2.fromScale(x,.26),T.navy),20)
  W.round(W.frame(eye,'Glint',UDim2.fromScale(.38,.36),UDim2.fromScale(.17,.12),T.ink),20)
 end
 W.round(W.frame(face,'Muzzle',UDim2.fromScale(.30,.18),UDim2.fromScale(.35,.66),color:Lerp(T.ink,.75)),20)
 local nose=W.round(W.frame(face,'Nose',UDim2.fromScale(.11,.10),UDim2.fromScale(.45,.59),T.navy),5)
 local rarity=W.round(W.frame(f,'Rarity',UDim2.fromScale(.10,.10),UDim2.fromScale(.82,.08),T.rarity[species.rarity]),3);rarity.Rotation=45
 return f
end
function W.mountain(parent)
 local f=W.frame(parent,'MountainMark',UDim2.fromScale(1,1));f.BackgroundTransparency=1;f.ClipsDescendants=true
 for i,v in ipairs({{.24,.57,.34,T.panel},{.51,.54,.45,T.card},{.70,.68,.26,T.blue}}) do
  local p=W.frame(f,'Peak'..i,UDim2.fromScale(v[3],v[3]*1.5),UDim2.fromScale(v[1],v[2]),v[4]);p.AnchorPoint=Vector2.new(.5,.5);p.Rotation=45
 end
 local star=W.text(f,'✦',UDim2.fromOffset(42,42),UDim2.fromScale(.49,.16),T.display,34,T.gold);star.AnchorPoint=Vector2.new(.5,.5)
 return f
end
return W
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="91">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="FallenPartsDestroyHeight">-200</float>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">true</bool>
    </Properties>
  </Item>
</roblox>