          <Item class="ModuleScript" referent="35">
            <Properties>
              <string name="Name">ClientState</string>
              <string name="Source"><![CDATA[-- Authoritative state and correlated intents. A timeout means unknown outcome;
-- it deliberately keeps the action locked until an acknowledgment arrives.
local ClientState = {}
local Store = {}
Store.__index = Store
local actions = {State=true,Equip=true,Train=true,Specialize=true,Incubate=true,Hatch=true,
 Travel=true,CollectIncome=true,RegisterDefense=true,ChallengeDefense=true,Special=true,Dodge=true,Settings=true}
local function finite(value)
 return type(value)=='number' and value==value and math.abs(value)<math.huge
end
local function copy(value,seen)
 if type(value)~='table' then return value end
 seen=seen or {};if seen[value] then return seen[value] end
 local clone={};seen[value]=clone
 for k,v in pairs(value) do clone[k]=copy(v,seen) end
 return clone
end
local function safeCall(fn,...)
 local ok,err=pcall(fn,...)
 if not ok and warn then warn('Mountain UI listener: '..tostring(err)) end
end
local function defaultRuntime()
 return {delay=task.delay,cancel=task.cancel,monotonic=os.clock,epoch=os.time,
  clock=function() return workspace:GetServerTimeNow() end,
  token=function() return game:GetService('HttpService'):GenerateGUID(false) end}
end
function Store:_emit(kind,payload)
 if self._destroyed then return end
 for token,fn in pairs(table.clone(self._listeners)) do
  if self._listeners[token] then safeCall(fn,kind,payload) end
 end
end
function Store:_cancel(record)
 if record.timer then
  pcall(self._runtime.cancel,record.timer)
  record.timer=nil
 end
end
function Store:_available()
 return self._eventRemote~=nil and self._requestRemote~=nil and self._resultRemote~=nil
end
function Store:_receive(kind,payload)
 if self._destroyed then return end
 if kind=='state' then
  if type(payload)~='table' then return end
  self.profile=payload
  local mono=self._runtime.monotonic()
  if finite(payload.serverNow) then self._epochOffset=payload.serverNow-mono end
  if type(payload.ui)=='table' and finite(payload.ui.serverClock) then self._clockOffset=payload.ui.serverClock-mono end
  self.status=if self:_available() then 'ready' else 'error'
 elseif kind=='battle' then
  if payload~=false and type(payload)~='table' then return end
  self.battle=payload
 elseif kind=='context' then
  if type(payload)~='table' or not self.profile then return end
  local ui=table.clone(self.profile.ui or {})
  for key,value in pairs(payload) do ui[key]=value end
  self.profile=table.clone(self.profile);self.profile.ui=ui
  if finite(payload.serverClock) then self._clockOffset=payload.serverClock-self._runtime.monotonic() end
 elseif kind~='open' and kind~='toast' and kind~='save' then return end
 self:_emit(kind,payload)
end
function Store:_result(result)
 if self._destroyed or type(result)~='table' or type(result.id)~='string' or type(result.ok)~='boolean' or type(result.message)~='string' then return end
 local record=self._requests[result.id]
 if not record or result.action~=record.action then return end
 self:_cancel(record)
 self._requests[result.id]=nil;self._byAction[record.action]=nil;self.pending[result.id]=nil
 local confirmed={id=result.id,action=result.action,ok=result.ok,message=result.message,data=result.data}
 self.lastResult=confirmed
 self._completed[result.id]=true;table.insert(self._history,result.id)
 if #self._history>64 then self._completed[table.remove(self._history,1)]=nil end
 if record.action=='State' and not self.profile then self.status='error' end
 self:_emit('pending',{id=record.id,action=record.action,status='complete'})
 self:_emit('result',confirmed)
 if record.callback and not self._destroyed then safeCall(record.callback,confirmed) end
end
function Store:_discover()
 if self._destroyed then return end
 local function child(name)
  if not self._remotes then return nil end
  return self._remotes:FindFirstChild(name)
 end
 local event,result,request=child('Event'),child('UIResult'),child('UIRequest')
 if event~=self._eventRemote then
  if self._eventConnection then self._eventConnection:Disconnect();self._eventConnection=nil end
  self._eventRemote=event
  if event and event.OnClientEvent then self._eventConnection=event.OnClientEvent:Connect(function(kind,payload) self:_receive(kind,payload) end) end
 end
 if result~=self._resultRemote then
  if self._resultConnection then self._resultConnection:Disconnect();self._resultConnection=nil end
  self._resultRemote=result
  if result and result.OnClientEvent then self._resultConnection=result.OnClientEvent:Connect(function(payload) self:_result(payload) end) end
 end
 self._requestRemote=request
 if self:_available() then
  if self.profile then self.status='ready' end
  if self._hasSubscribed and not self._started then
   self._started=true;self:request('State')
  end
 elseif self._hasSubscribed then
  self.status='error'
  self:_emit('toast','Mountain UI service unavailable. Waiting for the server connection.')
 end
end
function Store:subscribe(fn)
 assert(type(fn)=='function','subscribe expects a function')
 if self._destroyed then return function() end end
 local token={};self._listeners[token]=fn
 self._hasSubscribed=true
 self:_discover()
 local connected=true
 return function()
  if connected then connected=false;self._listeners[token]=nil end
 end
end
function Store:_timeout(record,message)
 if self._destroyed or self._requests[record.id]~=record then return end
 record.timer=nil;record.status='timeout'
 local visible=self.pending[record.id]
 visible.status='timeout';visible.message=message or 'No confirmation yet. Retry checks the same request; it does not start a new action.'
 if record.action=='State' and not self.profile then self.status='error' end
 self:_emit('pending',visible)
 self:_emit('timeout',visible)
end
function Store:_send(record)
 self:_cancel(record)
 record.status='pending';record.attempts+=1;record.sentAt=self._runtime.monotonic()
 local visible={id=record.id,action=record.action,payload=copy(record.payload),status='pending',sentAt=record.sentAt,attempts=record.attempts}
 self.pending[record.id]=visible
 if record.action=='State' and not self.profile then self.status='loading' end
 record.timer=self._runtime.delay(8,function() self:_timeout(record) end)
 self:_emit('pending',visible)
 if self._destroyed then return end
 local ok=pcall(function() self._requestRemote:FireServer(record.id,record.action,copy(record.payload)) end)
 if not ok and self._requests[record.id]==record then
  self:_cancel(record)
  self:_timeout(record,'Connection unavailable. The outcome is unknown; retry this same request when connected.')
 end
end
function Store:request(action,payload,callback)
 if self._destroyed or not actions[action] then return nil end
 if self._byAction[action] then return nil end
 if not self:_available() then
  self.status='error';self:_emit('toast','Mountain UI service unavailable. No action was confirmed.');return nil
 end
 self._sequence+=1
 local id=self._token..':'..tostring(self._sequence)
 local record={id=id,action=action,payload=copy(payload),callback=if type(callback)=='function' then callback else nil,attempts=0}
 self._requests[id]=record;self._byAction[action]=id
 self:_send(record)
 return id
end
function Store:retry(id)
 if self._destroyed or not self:_available() then return false end
 local record=self._requests[id]
 if not record or record.status~='timeout' then return false end
 self:_send(record);return true
end
function Store:now()
 return math.floor(self._runtime.monotonic()+self._epochOffset)
end
function Store:clock()
 local ok,now=pcall(self._runtime.clock)
 if ok and finite(now) then return now end
 return self._runtime.monotonic()+self._clockOffset
end
function Store:destroy()
 if self._destroyed then return end
 self._destroyed=true
 for _,record in pairs(self._requests) do self:_cancel(record) end
 for _,name in ipairs({'_eventConnection','_resultConnection','_addedConnection','_removedConnection'}) do
  if self[name] then self[name]:Disconnect();self[name]=nil end
 end
 table.clear(self._listeners);table.clear(self._requests);table.clear(self._byAction)
 table.clear(self._history);table.clear(self._completed);table.clear(self.pending)
 self._requestRemote=nil;self._resultRemote=nil;self._eventRemote=nil;self._remotes=nil
end
-- The optional runtime provides scheduler/time/network-ID dependencies for
-- deterministic off-engine verification; normal clients pass only remotes.
function ClientState.new(remotes,runtime)
 runtime=runtime or defaultRuntime()
 local self=setmetatable({profile=nil,battle=false,status='loading',pending={},lastResult=nil,
  _runtime=runtime,_remotes=remotes,_listeners={},_requests={},_byAction={},_history={},_completed={},
  _sequence=0,_token=runtime.token(),_epochOffset=runtime.epoch()-runtime.monotonic(),_clockOffset=0},Store)
 self:_discover()
 if remotes and remotes.ChildAdded then self._addedConnection=remotes.ChildAdded:Connect(function() self:_discover() end) end
 if remotes and remotes.ChildRemoved then self._removedConnection=remotes.ChildRemoved:Connect(function() self:_discover() end) end
 return self
end
return ClientState
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="36">
            <Properties>
              <string name="Name">Controller</string>
              <string name="Source"><![CDATA[local Players=game:GetService('Players')
local RS=game:GetService('ReplicatedStorage')
local UIS=game:GetService('UserInputService')
local Run=game:GetService('RunService')
local GuiService=game:GetService('GuiService')
local player=Players.LocalPlayer
local T=require(script.Parent.Theme)
local W=require(script.Parent.Widgets)
local Feedback=require(script.Parent.Feedback)
local pg=player:WaitForChild('PlayerGui')
if pg:FindFirstChild('MountainHUD') then return {} end
local gui=W.new('ScreenGui',pg,{Name='MountainHUD',ResetOnSpawn=false,DisplayOrder=10,ZIndexBehavior=Enum.ZIndexBehavior.Sibling,ScreenInsets=Enum.ScreenInsets.CoreUISafeInsets,ClipToDeviceSafeArea=true})
gui:SetAttribute('BlueprintVersion',1)
local root=W.frame(gui,'SafeRoot',UDim2.fromScale(1,1));root.BackgroundTransparency=1
local loading=W.frame(root,'Loading',UDim2.fromScale(1,1),nil,T.navy);loading.ZIndex=90
local mountain=W.mountain(loading);mountain.Size=UDim2.fromScale(.7,.8);mountain.Position=UDim2.fromScale(.15,.1)
local brand=W.text(loading,'CLIMB & COLLECT',UDim2.new(.9,0,0,58),UDim2.fromScale(.05,.26),T.display,32,T.ink);brand.TextXAlignment=Enum.TextXAlignment.Center
W.text(loading,'MOUNTAIN EMPIRE',UDim2.new(.9,0,0,30),UDim2.fromScale(.05,.44),T.bold,15,T.gold).TextXAlignment=Enum.TextXAlignment.Center
local loadStatus=W.text(loading,'Connecting to your expedition…',UDim2.new(.9,0,0,38),UDim2.fromScale(.05,.62),nil,15,T.muted);loadStatus.TextXAlignment=Enum.TextXAlignment.Center
local feedback=Feedback.new(root)
local C=require(RS:WaitForChild('MountainShared'):WaitForChild('Catalog'))
local R=require(RS.MountainShared.Rules)
local P=require(RS.MountainShared.UIPresentation)
local ClientState=require(script.Parent.ClientState)
local Screens=require(script.Parent.Screens)
local remotes=RS:WaitForChild('MountainRemotes',8)
while not remotes and gui.Parent do
 loadStatus.Text='The mountain service is taking longer to connect. Retrying…'
 remotes=RS:WaitForChild('MountainRemotes',5)
end
if not remotes then feedback:destroy();return {} end
local store=ClientState.new(remotes)
local screens
local connections={};local activeAbility=1;local expanded=false;local ready=false;local elapsed=0;local age=0;local lastSecond=-1;local saveFailed=false;local previousProfile;local memberStamp='';local wasInBattle=false
local function connect(signal,fn) local c=signal:Connect(fn);table.insert(connections,c);return c end
local click=W.new('Sound',gui,{Name='UIFeedback',SoundId='rbxasset://sounds/volume_slider.ogg',Volume=.15})
local function sound() click.Volume=.16*(T.prefs.sfxVolume or .8);click:Play() end
local function open(name) if ready then sound();screens:open(name) end end
local top=W.panel(root,'Status',UDim2.fromOffset(320,48),UDim2.fromOffset(12,8))
local coins=W.text(top,'— coins',UDim2.new(.55,-10,1,0),UDim2.fromOffset(12,0),T.bold,17,T.gold)
local timer=W.text(top,'00:00',UDim2.new(.45,-16,1,0),UDim2.new(.55,0,0,0),T.bold,14,T.muted);timer.TextXAlignment=Enum.TextXAlignment.Right
local progress=W.panel(root,'Journey',UDim2.fromOffset(292,80),UDim2.new(1,-304,0,8))
local location=W.text(progress,'Blossom Gardens',UDim2.new(1,-20,0,25),UDim2.fromOffset(10,6),T.bold,14)
local heightLabel=W.text(progress,'0 studs',UDim2.new(1,-20,0,21),UDim2.fromOffset(10,31),nil,12,T.muted)
local heightFill=W.progress(progress,0,UDim2.new(1,-20,0,7),UDim2.fromOffset(10,63),T.sky)
local quest=W.panel(root,'QuestTracker',UDim2.fromOffset(292,76),UDim2.new(1,-304,0,96))
local questTitle=W.text(quest,'Explore the mountain',UDim2.new(1,-20,0,29),UDim2.fromOffset(10,5),T.bold,13,T.gold)
local questDetail=W.text(quest,'',UDim2.new(1,-20,0,34),UDim2.fromOffset(10,34),nil,12,T.muted)
local menu=W.button(root,'Menu','MENU',UDim2.fromOffset(78,46),UDim2.fromOffset(12,66),function() expanded=not expanded;sound() end,'gold')
local sidebar=W.panel(root,'Navigation',UDim2.fromOffset(172,350),UDim2.fromOffset(12,120));sidebar.Visible=false
local nav=W.scroll(sidebar,'Items',UDim2.new(1,-12,1,-12),UDim2.fromOffset(6,6))
local hubNames={'Creatures','Discovery','Sanctuary','Mountain','Social','Profile','Shop','Settings'}
for _,name in ipairs(hubNames) do W.button(nav,'Nav'..name,name,UDim2.new(1,-4,0,44),nil,function() expanded=false;open(name) end,'quiet') end
local team=W.frame(root,'Team',UDim2.fromOffset(342,60),UDim2.new(.5,-171,1,-72));team.BackgroundTransparency=1
local function selectedAbility(slot)
 local p=store.profile;local c=p and R.find(p.creatures,p.team[slot])
 return if c and C.byId[c.species].rarity=='Legendary' then activeAbility else 1
end
local slots={}
for i=1,3 do
 local index=i
 slots[i]=W.button(team,'Slot'..i,'['..i..'] Empty slot',UDim2.new(1/3,-6,1,0),UDim2.new((i-1)/3,3,0,0),function() if store.battle then store:request('Special',{slot=index,ability=selectedAbility(index)}) else open('Creatures') end end,'quiet')
 slots[i].TextSize=13;slots[i]:SetAttribute('BaseTextSize',13)
 slots[i]:SetAttribute('Tooltip','Open your collection, or activate this companion’s special during combat.')
end
local actionbar=W.panel(root,'Actions',UDim2.fromOffset(342,48),UDim2.new(.5,-171,1,-128))
local context=W.button(actionbar,'Context','Explore',UDim2.new(.66,-12,1,-8),UDim2.fromOffset(4,4),function() open(if store.profile and store.profile.ui and store.profile.ui.atRefuge then 'Sanctuary' else 'Mountain') end,'blue')
W.button(actionbar,'Quick','Settings',UDim2.new(.34,-4,1,-8),UDim2.new(.66,0,0,4),function() open('Settings');if screens.hub then screens.tab='Quick';screens:render(false) end end,'quiet')
local dodge=W.button(root,'Dodge','Dodge [Q]',UDim2.fromOffset(122,48),UDim2.new(1,-148,1,-218),function() store:request('Dodge') end,'gold');dodge.Visible=false
local ability=W.button(root,'Ability','Ability 1',UDim2.fromOffset(122,44),UDim2.new(1,-148,1,-270),function() activeAbility=activeAbility%4+1;sound() end,'quiet');ability.Visible=false
 ability:SetAttribute('Tooltip','Choose a captured Guardian’s special. Regular companions use their role special.')
 dodge:SetAttribute('Tooltip','Dodge the highlighted danger. A successful clean dodge advances Trial mastery.')
local battle=W.panel(root,'Battle',UDim2.fromOffset(410,100),UDim2.new(.5,-205,0,8));battle.Visible=false
local boss=W.text(battle,'Guardian',UDim2.new(1,-24,0,28),UDim2.fromOffset(12,6),T.display,21,T.gold)
local hp=W.progress(battle,1,UDim2.new(1,-24,0,10),UDim2.fromOffset(12,38),T.coral)
 local combatText=W.text(battle,'',UDim2.new(1,-24,0,50),UDim2.fromOffset(12,53),nil,12,T.ink)
local save=W.text(root,'Connecting…',UDim2.new(.6,0,0,20),UDim2.new(.2,0,1,-23),nil,10,T.muted);save.TextXAlignment=Enum.TextXAlignment.Center
local hint=W.panel(root,'Hint',UDim2.fromOffset(320,64),UDim2.new(.5,-160,0,78));hint.Visible=false
local hintText=W.text(hint,'',UDim2.new(1,-60,1,-12),UDim2.fromOffset(12,6),nil,13,T.ink)
local dismissHint=false
W.button(hint,'DismissHint','×',UDim2.fromOffset(44,44),UDim2.new(1,-50,0,10),function() dismissHint=true;hint.Visible=false end,'quiet')
local retry=W.button(loading,'RetryLoad','Retry connection',UDim2.fromOffset(210,46),UDim2.new(.5,-105,.82,0),function()
 for id,pending in pairs(store.pending) do if pending.action=='State' then store:retry(id);return end end
 store:request('State')
end,'gold');retry.Visible=false
screens=Screens.new(root,store,feedback,function() GuiService.SelectedObject=nil end)
local defaultEffects={};local soundBases={};local settingsStamp=''
local function applyPreferences(prefs)
 T.configure(prefs);player:SetAttribute('MountainReducedMotion',prefs.reducedMotion==true)
 player:SetAttribute('MountainSimplifiedVFX',prefs.simplifiedVFX==true)
 for _,o in ipairs(root:GetDescendants()) do
  if o:IsA('UIStroke') then o.Transparency=if prefs.highContrast then 0 else .15;o.Thickness=if prefs.highContrast then 2 else 1
  elseif o:IsA('TextLabel') or o:IsA('TextButton') then local base=o:GetAttribute('BaseTextSize');if base then o.TextSize=T.size(base) end end
 end
 for _,o in ipairs(workspace:GetDescendants()) do
  if o:IsA('ParticleEmitter') and not o:FindFirstAncestor('Dynamics') then
   if defaultEffects[o]==nil then defaultEffects[o]=o.Enabled end;o.Enabled=defaultEffects[o] and not prefs.simplifiedVFX
  end
 end
end
connect(workspace.DescendantAdded,function(o) if o:IsA('ParticleEmitter') and not o:FindFirstAncestor('Dynamics') then defaultEffects[o]=o.Enabled;if T.prefs.simplifiedVFX then o.Enabled=false end end end)
connect(workspace.DescendantRemoving,function(o) defaultEffects[o]=nil end)
local nativeWatched=setmetatable({},{__mode='k'})
local function layout()
 local v=root.AbsoluteSize;if v.X<=0 then return end
 local compact=v.X<950 or v.Y<550;local short=v.Y<390;local tw=math.clamp(v.X-360,276,366);local center=v.X/2
 if UIS.TouchEnabled then
  local touch=pg:FindFirstChild('TouchGui');local stick=touch and (touch:FindFirstChild('DynamicThumbstickFrame',true) or touch:FindFirstChild('ThumbstickFrame',true));local jump=touch and touch:FindFirstChild('JumpButton',true)
  local left=if stick then stick.AbsolutePosition.X+stick.AbsoluteSize.X-root.AbsolutePosition.X+10 else v.X*.4+10
  local right=if jump then jump.AbsolutePosition.X-root.AbsolutePosition.X-10 else v.X-130
  left=math.min(left,v.X*.45);right=math.min(right,v.X-104)
  for _,o in ipairs({stick,jump}) do if o and not nativeWatched[o] then
   nativeWatched[o]=true
   connect(o:GetPropertyChangedSignal('AbsolutePosition'),function() task.defer(layout) end)
   connect(o:GetPropertyChangedSignal('AbsoluteSize'),function() task.defer(layout) end)
  end end
  tw=math.min(366,math.max(216,right-left));center=(left+right)/2
 end
 team.Size=UDim2.fromOffset(tw,if short then 48 else 58);team.Position=UDim2.new(0,center-tw/2,1,if short then -76 else -80)
 actionbar.Size=UDim2.fromOffset(tw,56);actionbar.Position=UDim2.new(0,center-tw/2,1,if short then -136 else -144)
 top.Size=UDim2.fromOffset(if compact then 225 else 320,48)
 progress.Size=UDim2.fromOffset(if compact then 238 else 292,if short then 58 else 80);progress.Position=UDim2.new(1,-progress.Size.X.Offset-12,0,8)
 heightFill.Parent.Position=UDim2.new(0,10,1,-12);heightLabel.Size=UDim2.new(1,-20,0,18);heightLabel.Position=UDim2.fromOffset(10,29)
 quest.Position=UDim2.new(1,-250,0,if short then 74 else 96);quest.Size=UDim2.fromOffset(238,if short then 44 else 70)
 questTitle.Size=UDim2.new(1,-20,0,if short then 20 else 29);questTitle.Position=UDim2.fromOffset(10,if short then 2 else 5)
 questDetail.Size=UDim2.new(1,-20,0,if short then 20 else 34);questDetail.Position=UDim2.fromOffset(10,if short then 22 else 34)
 sidebar.Size=UDim2.fromOffset(174,math.min(414,v.Y-132));sidebar.Position=UDim2.fromOffset(12,118)
 menu.Position=UDim2.fromOffset(12,if short then 58 else 66)
 if short then
  sidebar.Size=UDim2.fromOffset(v.X-110,46);sidebar.Position=UDim2.fromOffset(98,58)
  nav.Size=UDim2.fromScale(1,1);nav.Position=UDim2.new();nav.ScrollingDirection=Enum.ScrollingDirection.X;nav.AutomaticCanvasSize=Enum.AutomaticSize.X;nav.CanvasSize=UDim2.new()
  nav.UIListLayout.FillDirection=Enum.FillDirection.Horizontal;nav.UIPadding.PaddingTop=UDim.new(0,1);nav.UIPadding.PaddingBottom=UDim.new(0,1)
  for _,b in ipairs(nav:GetChildren()) do if b:IsA('TextButton') then b.Size=UDim2.fromOffset(120,44) end end
 else
  nav.Size=UDim2.new(1,-12,1,-12);nav.Position=UDim2.fromOffset(6,6);nav.ScrollingDirection=Enum.ScrollingDirection.Y;nav.AutomaticCanvasSize=Enum.AutomaticSize.Y;nav.CanvasSize=UDim2.new()
  nav.UIListLayout.FillDirection=Enum.FillDirection.Vertical;nav.UIPadding.PaddingTop=UDim.new(0,4);nav.UIPadding.PaddingBottom=UDim.new(0,4)
  for _,b in ipairs(nav:GetChildren()) do if b:IsA('TextButton') then b.Size=UDim2.new(1,-4,0,44) end end
 end
 hint.Size=UDim2.fromOffset(if short then tw else 320,64);hint.Position=if short then UDim2.new(0,center-tw/2,1,-198) else UDim2.new(.5,-160,0,110)
 battle.Size=UDim2.fromOffset(math.min(410,v.X-300),108);battle.Position=UDim2.new(.5,-battle.Size.X.Offset/2,0,8)
 dodge.Position=UDim2.new(1,-142,1,if short then -191 else -230);ability.Position=UDim2.new(1,-142,1,if short then -242 else -282)
 if UIS.TouchEnabled then
  local touch=pg:FindFirstChild('TouchGui');local jump=touch and touch:FindFirstChild('JumpButton',true)
  if jump then
   local y=math.min(v.Y+(if short then -191 else -230),jump.AbsolutePosition.Y-root.AbsolutePosition.Y-58)
   dodge.Position=UDim2.new(1,-142,0,y);ability.Position=UDim2.new(1,-142,0,y-52)
  end
 end
 feedback.host.Size=UDim2.new(.66,0,0,58);feedback.host.Position=UDim2.new(.17,0,0,if store.battle then 120 else 72)
 feedback.tooltip.Position=UDim2.new(.5,-140,0,if store.battle then 120 else 124)
 if screens.hub then screens:render(true) end
end
local function updateProfile()
 local data=store.profile;if not data then return end
 coins.Text=tostring(data.coins)..' coins';local q=P.quest(data);questTitle.Text=q.title;questDetail.Text=if root.AbsoluteSize.Y<390 then q.progress..' / '..q.total..' objectives · Map for details' else q.detail
 local prefs=data.ui and data.ui.settings or {};local stamp=game:GetService('HttpService'):JSONEncode(prefs)
 if stamp~=settingsStamp then settingsStamp=stamp;applyPreferences(prefs) end
 save.Text=if saveFailed then 'SAVING PAUSED · Progress actions unavailable' elseif tostring(data.saveMode):find('Studio') then 'STUDIO REVIEW · Progress resets on Stop' else 'Profile synchronized'
 if previousProfile then
  if data.unlocked>previousProfile.unlocked then feedback:reveal('A new kingdom awaits',C.kingdoms[data.unlocked].name..' is now open. Follow the mountain map to continue.') end
  for id in pairs(data.captures) do if not previousProfile.captures[id] then feedback:reveal('Guardian captured!',C.byId[id].name..' joins your collection. This Guardian can be captured once.',C.byId[id]) end end
 end
 previousProfile={unlocked=data.unlocked,captures=table.clone(data.captures)}
 if screens.hub then screens:render(true) end
end
local disconnect=store:subscribe(function(kind,payload)
 if kind=='state' or kind=='context' then updateProfile()
 elseif kind=='battle' then
  local active=payload~=nil and payload~=false;if active~=wasInBattle then wasInBattle=active;layout() end
  if payload then
   boss.Text=payload.name..(if payload.trial then ' · TRIAL' else '');hp.Size=UDim2.fromScale(math.clamp(payload.hp/math.max(1,payload.max),0,1),1)
   combatText.Text=math.ceil(payload.hp)..' HP · Phase '..math.max(1,((payload.phase or 1)-1)%4+1)..' · '..#(payload.members or {})..' climber(s)'
   if payload.trial then combatText.Text..='\n'..(payload.dodges or 0)..'/3 dodges · '..(payload.resolved or 0)..'/4 patterns · '..(if payload.captureOwned then 'Already captured' elseif payload.objective then 'Objective complete' else payload.objectiveText or 'Master the patterns') end
  end
  local stamp=game:GetService('HttpService'):JSONEncode(if payload then payload.members or {} else {})
  if stamp~=memberStamp then memberStamp=stamp;if screens.hub=='Social' and screens.tab=='Party' then screens:render(true) end end
 elseif kind=='open' then open(payload)
 elseif kind=='toast' then feedback:toast(payload,store.battle and (string.find(payload,'golden heart',1,true)~=nil or string.find(payload,'constellation stones',1,true)~=nil))
 elseif kind=='result' then
  screens:pending()
  if payload.action~='State' and payload.ok then
   sound();local d=payload.data
   if payload.action=='Hatch' and d and d.creature then feedback:reveal('A new companion!',C.byId[d.creature.species].name..' joins your collection.',C.byId[d.creature.species])
   elseif payload.action=='Train' and d and d.creature and d.stage and d.previousStage and d.stage>d.previousStage then feedback:reveal('Evolution unlocked!',C.byId[d.creature.species].name..' reached evolution stage '..d.stage..'.',C.byId[d.creature.species])
   elseif payload.action=='ChallengeDefense' and d then feedback:reveal(if d.won then 'Challenge won!' else 'Challenge complete',(if d.practice then 'Practice defense' else 'Opponent '..tostring(d.opponent))..' · '..tostring(d.rounds)..' rounds\n'..tostring(d.trophies)..' trophies awarded.')
   elseif payload.action~='Special' and payload.action~='Dodge' then feedback:toast(payload.message or 'Confirmed.') end
  elseif not payload.ok then feedback:toast(payload.message or 'That action is unavailable.') end
 elseif kind=='timeout' then screens:pending();feedback:toast('Still waiting for the server. Open a menu to retry safely.')
 elseif kind=='pending' then screens:pending()
 elseif kind=='save' then saveFailed=not payload;save.Text=if payload then 'Profile saved' else 'SAVING PAUSED · Progress actions unavailable' end
end)
connect(UIS.InputBegan,function(input,processed)
 if processed or UIS:GetFocusedTextBox() then return end
 local key=input.KeyCode
 if key==Enum.KeyCode.M or key==Enum.KeyCode.Tab or key==Enum.KeyCode.ButtonSelect then if screens.hub then screens:close() else open('Creatures') end
 elseif key==Enum.KeyCode.Escape or key==Enum.KeyCode.ButtonB then if not feedback:close() then screens:back() end
 elseif not screens.hub and not feedback.modal and ready then
  if key==Enum.KeyCode.One or key==Enum.KeyCode.Two or key==Enum.KeyCode.Three then local slot=({[Enum.KeyCode.One]=1,[Enum.KeyCode.Two]=2,[Enum.KeyCode.Three]=3})[key];store:request('Special',{slot=slot,ability=selectedAbility(slot)})
  elseif key==Enum.KeyCode.Q or key==Enum.KeyCode.ButtonY then store:request('Dodge') end
 end
end)
connect(root:GetPropertyChangedSignal('AbsoluteSize'),layout)
 connect(pg.DescendantAdded,function(o) if o.Name=='JumpButton' or o.Name=='DynamicThumbstickFrame' then task.defer(layout) end end)
 connect(UIS:GetPropertyChangedSignal('TouchEnabled'),layout)
local start=os.clock()
connect(Run.Heartbeat,function(dt)
 elapsed+=dt;age+=dt;if elapsed<.2 then return end;elapsed=0
 local data=store.profile;local rr=player.Character and player.Character:FindFirstChild('HumanoidRootPart');ready=data~=nil and rr~=nil
 loading.Visible=not ready;retry.Visible=not ready and os.clock()-start>8
 if not ready then loadStatus.Text=if data then 'Waiting for your character…' elseif store.status=='error' then 'Connection delayed. Retry when ready.' else 'Synchronizing your collection…' end
 sidebar.Visible=expanded and ready and not screens.hub and not store.battle;if store.battle then expanded=false end
 top.Visible=ready and not store.battle;progress.Visible=ready and not store.battle and not (expanded and root.AbsoluteSize.Y<390);quest.Visible=ready and not store.battle and not expanded
 menu.Visible=ready and not screens.hub;team.Visible=ready and not screens.hub;actionbar.Visible=ready and not screens.hub and not store.battle
 dodge.Visible=ready and not screens.hub;ability.Visible=dodge.Visible and store.battle~=nil and store.battle~=false;battle.Visible=ability.Visible
 if data then
  local clock=store:clock();local ui=data.ui or {};local cooldowns=ui.cooldowns or {}
  for i,b in ipairs(slots) do
   local c=R.find(data.creatures,data.team[i]);local remain=c and P.remaining(cooldowns[c.id..':'..selectedAbility(i)] or 0,clock) or 0
   b.Text=if c then C.byId[c.species].name..'\n'..(if store.battle then (if remain>0 then remain..'s' else 'Special ['..i..']') else 'Lv '..c.level) else 'Empty slot\nChoose companion'
   W.enable(b,not store.battle or (c~=nil and remain==0))
  end
  local dr=P.remaining(ui.dodgeReadyAt or 0,clock);W.enable(dodge,dr==0,if dr>0 then 'Dodge · '..dr..'s' else 'Dodge [Q]');ability.Text='Ability '..activeAbility
  context.Text=if ui.atRefuge then 'Sanctuary' elseif ui.nearCheckpoint then 'Checkpoint travel' else 'Mountain map'
  hint.Visible=ready and not dismissHint and T.prefs.hints~=false and age<24 and not screens.hub and not store.battle and root.AbsoluteSize.Y>=390
  hintText.Text=if #data.cargo>0 then 'Eggs on board! Reach a checkpoint to secure them.' else 'Follow the flags. Discover eggs and rest at checkpoints.'
 end
 if math.floor(age)~=lastSecond then
  lastSecond=math.floor(age);timer.Text=P.formatTime(age);screens:tick();screens:pending()
  if data then local q=P.quest(data);questDetail.Text=if root.AbsoluteSize.Y<390 then (if T.prefs.hints~=false and age<24 then 'Follow flags · secure eggs' else q.progress..' / '..q.total..' objectives · Map for details') else q.detail end
  if rr then
   local k=math.clamp(math.floor((rr.Position.Y-16)/136)+1,1,6);location.Text=C.kingdoms[k].name
   heightLabel.Text=math.max(0,math.floor(rr.Position.Y-16))..' studs · '..(if data then data.unlocked else 1)..'/6 unlocked';heightFill.Size=UDim2.fromScale(math.clamp((rr.Position.Y-16)/824,0,1),1)
   for name,volume in pairs({['Mountain Birds 1 (SFX)']=if k==1 then .14 elseif k==2 then .05 else 0,WaterfallLoop=if k==2 then .12 else 0,AstralWind=if k>=3 then .08 else 0,LavaLoop=if k==5 then .1 else 0}) do
    local s=game:GetService('SoundService'):FindFirstChild(name);if s then if soundBases[s]==nil then soundBases[s]=s.Volume end;s.Volume=volume*(T.prefs.musicVolume or .7);if not s.IsPlaying then s:Play() end end
   end
  end
 end
end)
layout()
connect(gui.Destroying,function()
 disconnect();store:destroy();feedback:destroy();screens:close();for _,c in ipairs(connections) do c:Disconnect() end
 for o,value in pairs(defaultEffects) do if o.Parent then o.Enabled=value end end;for s,value in pairs(soundBases) do if s.Parent then s.Volume=value end end;GuiService.SelectedObject=nil
end)
if Run:IsStudio() then
 local probe=W.new('BindableFunction',gui,{Name='UIProbe'})
 probe.OnInvoke=function(action,value)
  if action=='open' and table.find(hubNames,value) then open(value)
  elseif action=='close' then screens:close()
  elseif action=='tab' and screens.hub and screens.shade.Hub.Tabs:FindFirstChild('Tab'..tostring(value)) then screens.tab=value;screens.detail=nil;screens.page=1;screens:render(false) end
  return {ready=ready,hub=screens.hub,tab=screens.tab,view={root.AbsoluteSize.X,root.AbsoluteSize.Y},instances=#gui:GetDescendants(),pending=store.pending,status=store.status}
 end
end
return {}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="37">
            <Properties>
              <string name="Name">Feedback</string>
              <string name="Source"><![CDATA[local T=require(script.Parent.Theme)
local W=require(script.Parent.Widgets)
local GuiService=game:GetService('GuiService')
local F={};F.__index=F
function F.new(root)
 local self=setmetatable({root=root,queue={},serial=0,alive=true},F)
 self.host=W.panel(root,'Toast',UDim2.new(.6,0,0,58),UDim2.new(.2,0,0,68));self.host.ZIndex=40;self.host.Visible=false
 self.label=W.text(self.host,'',UDim2.new(1,-26,1,-12),UDim2.fromOffset(13,6),T.bold,14);self.label.ZIndex=41
 self.tooltip=W.panel(root,'Tooltip',UDim2.fromOffset(280,64),UDim2.new(.5,-140,0,124));self.tooltip.ZIndex=80;self.tooltip.Visible=false
 self.tooltipText=W.text(self.tooltip,'',UDim2.new(1,-24,1,-12),UDim2.fromOffset(12,6),nil,14);self.tooltipText.ZIndex=81
 local function attach(o)
  if not o:IsA('GuiButton') then return end
  local function show() local text=o:GetAttribute('Tooltip');if text and self.alive and not self.host.Visible then self.tooltipText.Text=text;self.tooltip.Visible=true;self.tooltipOwner=o end end
  local function hide() if self.tooltipOwner==o then self.tooltip.Visible=false;self.tooltipOwner=nil end end
  o.MouseEnter:Connect(show);o.MouseLeave:Connect(hide);o.SelectionGained:Connect(show);o.SelectionLost:Connect(hide);o.Destroying:Connect(hide)
 end
 self.added=root.DescendantAdded:Connect(attach)
 self.focus=GuiService:GetPropertyChangedSignal('SelectedObject'):Connect(function()
  local selected=GuiService.SelectedObject
  if self.modal and selected and not selected:IsDescendantOf(self.modal) then GuiService.SelectedObject=self.modal.Dialog.Confirm end
 end)
 return self
end
function F:toast(message,priority)
 if not self.alive or type(message)~='string' or message=='' then return end
 self.tooltip.Visible=false;self.tooltipOwner=nil
 if message==self.label.Text and self.host.Visible or table.find(self.queue,message) then return end
 if priority then self.serial+=1;self.host.Visible=false;table.clear(self.queue) end
 if #self.queue>=4 then table.remove(self.queue,1) end
 table.insert(self.queue,message)
 if self.host.Visible then return end
 self.serial+=1;local serial=self.serial
 local function nextToast()
  if not self.alive or serial~=self.serial then return end
  local m=table.remove(self.queue,1)
  if not m then self.host.Visible=false;return end
  self.host.Visible=true;self.label.Text=m
  task.delay(4,nextToast)
 end
 nextToast()
end
function F:confirm(title,description,onConfirm)
 self:close();self.previousFocus=GuiService.SelectedObject
 local shade=W.frame(self.root,'Confirmation',UDim2.fromScale(1,1),nil,T.navy);shade.BackgroundTransparency=.15;shade.ZIndex=70;shade.Active=true;self.modal=shade
 local f=W.panel(shade,'Dialog',UDim2.new(.86,0,0,226),UDim2.fromScale(.5,.5));f.AnchorPoint=Vector2.new(.5,.5);f.ZIndex=71
 W.new('UISizeConstraint',f,{MaxSize=Vector2.new(480,226)})
 W.text(f,title,UDim2.new(1,-32,0,40),UDim2.fromOffset(16,14),T.display,22).ZIndex=72
 local descriptionLabel=W.text(f,description,UDim2.new(1,-32,0,86),UDim2.fromOffset(16,58),nil,15,T.muted);descriptionLabel.Name='Description';descriptionLabel.ZIndex=72
 W.button(f,'Cancel','Cancel',UDim2.new(.5,-24,0,48),UDim2.new(0,16,1,-64),function() self:close() end,'quiet').ZIndex=72
 local confirm=W.button(f,'Confirm','Confirm',UDim2.new(.5,-24,0,48),UDim2.new(.5,8,1,-64),function() self:close();onConfirm() end,'gold');confirm.ZIndex=72
 if game:GetService('UserInputService').GamepadEnabled then GuiService.SelectedObject=confirm end
end
function F:reveal(title,description,species)
 -- Called only by authoritative state transitions or acknowledged outcomes.
 self:confirm(title,description,function() end)
 local f=self.modal and self.modal:FindFirstChild('Dialog')
 if f then
  f.Confirm.Text='Continue';f.Cancel.Visible=false;f.Confirm.Size=UDim2.new(1,-32,0,48);f.Confirm.Position=UDim2.new(0,16,1,-64)
  if species then
   f.Size=UDim2.new(.86,0,0,300);f.UISizeConstraint.MaxSize=Vector2.new(480,300)
   f.Description.Position=UDim2.fromOffset(16,158);f.Description.Size=UDim2.new(1,-32,0,64);f.Description.TextXAlignment=Enum.TextXAlignment.Center
   local portrait=W.portrait(f,species,UDim2.fromOffset(80,80),UDim2.new(.5,-40,0,70));portrait.ZIndex=72
   for _,o in ipairs(portrait:GetDescendants()) do if o:IsA('GuiObject') then o.ZIndex=73 end end
  end
  if not T.prefs.reducedMotion then
   local scale=W.new('UIScale',f,{Scale=.94})
   game:GetService('TweenService'):Create(scale,TweenInfo.new(.2,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Scale=1}):Play()
  end
 end
end
function F:close()
 if not self.modal then return false end
 local modal=self.modal;self.modal=nil;modal:Destroy()
 if self.previousFocus and self.previousFocus.Parent then GuiService.SelectedObject=self.previousFocus else GuiService.SelectedObject=nil end
 self.previousFocus=nil;return true
end
function F:destroy() self.alive=false;self:close();self.added:Disconnect();self.focus:Disconnect();self.host:Destroy();self.tooltip:Destroy() end
return F
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="38">
            <Properties>
              <string name="Name">Screens</string>
              <string name="Source"><![CDATA[local Players=game:GetService('Players')
local GuiService=game:GetService('GuiService')
local UIS=game:GetService('UserInputService')
local C=require(game.ReplicatedStorage.MountainShared.Catalog)
local R=require(game.ReplicatedStorage.MountainShared.Rules)
local P=require(game.ReplicatedStorage.MountainShared.UIPresentation)
local T=require(script.Parent.Theme)
local W=require(script.Parent.Widgets)
local S={};S.__index=S
local tabs={Creatures={'Collection','Team','Training','Evolution'},Discovery={'Eggs','Field guide'},Sanctuary={'Overview','Habitats','Facilities'},Mountain={'Map','Quests','Trials'},Social={'Party','Challenges','Defense'},Profile={'Overview','Achievements','Recognition'},Shop={'Cosmetics','Convenience'},Settings={'Accessibility','Audio','Quick'}}
local aliases={Collection='Creatures',Training='Creatures',Incubator='Discovery',Eggs='Discovery',Travel='Mountain',Journal='Mountain',Competition='Social'}
local aliasTabs={Training='Training',Incubator='Eggs',Eggs='Eggs',Travel='Map',Journal='Quests',Competition='Challenges'}
function S.new(root,store,feedback,onClose)
 return setmetatable({root=root,store=store,feedback=feedback,onClose=onClose,selected={},query='',rarity='All',sort='Name',page=1,tickers={},actionButtons={}},S)
end
function S:open(name)
 if not tabs[aliases[name] or name] then return end
 self.hub=aliases[name] or name;self.tab=aliasTabs[name] or tabs[self.hub][1];self.detail=nil;self.page=1
 if self.store.profile then self.selected=table.clone(self.store.profile.team) end
 self:render(false)
end
function S:close()
 if self.shade then self.shade:Destroy();self.shade=nil end
 self.hub=nil;self.detail=nil;self.tickers={};self.actionButtons={};GuiService.SelectedObject=nil
 if self.onClose then self.onClose() end
end
function S:back() if self.detail then self.detail=nil;self:render(false) else self:close() end end
function S:send(action,payload)
 local id=self.store:request(action,payload)
 if not id then self.feedback:toast('That action is already waiting for a response. Check the status below.') end
end
function S:action(parent,name,label,action,payload,enabled,pos,size)
 if parent:FindFirstChild('Description') then parent.Description.Size=UDim2.new(1,-28,0,math.max(40,parent.Size.Y.Offset-106)) end
 local b=W.button(parent,name,label,size or UDim2.new(1,-28,0,44),pos or UDim2.new(0,14,1,-56),function() self:send(action,if type(payload)=='function' then payload() else payload) end,'blue',enabled)
 table.insert(self.actionButtons,{button=b,action=action,enabled=enabled~=false,label=label});return b
end
function S:blocked(title,description,actionLabel)
 local f=W.row(self.body,title,description,182)
 f.Description.Size=UDim2.new(1,-28,0,74)
 W.button(f,'Unavailable',actionLabel or 'Not available in this build',UDim2.new(1,-28,0,44),UDim2.new(0,14,1,-56),nil,'quiet',false)
 return f
end
function S:note(title,description,height) return W.row(self.body,title,description,height or 105) end
function S:pending()
 for _,v in ipairs(self.actionButtons) do
  local busy=false
  for _,p in pairs(self.store.pending) do if p.action==v.action then busy=true;break end end
  W.enable(v.button,v.enabled and not busy,if busy then 'Waiting…' else v.label)
 end
 if self.status then
  local message='Changes are confirmed by the server.';local retryId=nil
  for id,p in pairs(self.store.pending) do
   if p.status=='timeout' then message='No reply yet. Retry safely with the same request.';retryId=id;break
   else message='Waiting for '..p.action..'…' end
  end
  if not next(self.store.pending) and self.store.lastResult then message=self.store.lastResult.message or message end
  self.status.Text=message;self.retry.Visible=retryId~=nil;self.retryId=retryId
 end
end
function S:tick()
 for _,fn in ipairs(self.tickers) do fn() end
end
function S:render(preserve)
 if not self.hub or not self.store.profile then return end
 local focused=UIS:GetFocusedTextBox()
 if preserve and focused and self.shade and focused:IsDescendantOf(self.shade) then self.deferredRender=true;return end
 self.deferredRender=false
 local selected=GuiService.SelectedObject;local selectedName=if selected then selected.Name else nil;local selectedPath={}
 if preserve and selected and self.shade and selected:IsDescendantOf(self.shade) then
  local cursor=selected;while cursor and cursor~=self.shade do table.insert(selectedPath,1,cursor.Name);cursor=cursor.Parent end
 end
 local scroll=if preserve and self.body then self.body.CanvasPosition else Vector2.zero
 if self.shade then self.shade:Destroy() end
 self.tickers={};self.actionButtons={}
 local data=self.store.profile;local view=self.root.AbsoluteSize
 local width=math.min(850,view.X-20);local height=math.min(660,view.Y-16)
 self.shade=W.frame(self.root,'HubShade',UDim2.fromScale(1,1),nil,T.navy);self.shade.BackgroundTransparency=.23;self.shade.ZIndex=20;self.shade.Active=true
 local f=W.panel(self.shade,'Hub',UDim2.fromOffset(width,height),UDim2.fromScale(.5,.5));f.AnchorPoint=Vector2.new(.5,.5);f.ZIndex=21
 local title=if self.detail then 'Creature details' else self.hub
 W.text(f,title,UDim2.new(1,-140,0,44),UDim2.fromOffset(18,5),T.display,24,T.ink)
 W.button(f,'Back',if self.detail then 'Back' else 'Close',UDim2.fromOffset(86,44),UDim2.new(1,-98,0,7),function() self:back() end,'quiet')
 local tabScroll=W.new('ScrollingFrame',f,{Name='Tabs',Size=UDim2.new(1,-24,0,48),Position=UDim2.fromOffset(12,57),BackgroundTransparency=1,BorderSizePixel=0,CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.X,ScrollingDirection=Enum.ScrollingDirection.X,ScrollBarThickness=0})
 W.list(tabScroll,8,true)
 for _,name in ipairs(tabs[self.hub]) do
  W.button(tabScroll,'Tab'..name,name,UDim2.fromOffset(if #name>10 then 136 else 112,44),nil,function() self.tab=name;self.detail=nil;self.page=1;self:render(false) end,if name==self.tab then 'gold' else 'quiet')
 end
 self.body=W.scroll(f,'Content',UDim2.new(1,-24,1,-158),UDim2.fromOffset(12,108))
 self.status=W.text(f,'',UDim2.new(1,-124,0,38),UDim2.new(0,16,1,-44),nil,12,T.muted)
 self.retry=W.button(f,'Retry','Retry',UDim2.fromOffset(88,44),UDim2.new(1,-100,1,-48),function() if self.retryId then self.store:retry(self.retryId) end end,'gold');self.retry.Visible=false
 if self.hub=='Creatures' then self:creatures(data,width)
 elseif self.hub=='Discovery' then self:discovery(data)
 elseif self.hub=='Sanctuary' then self:sanctuary(data)
 elseif self.hub=='Mountain' then self:mountain(data)
 elseif self.hub=='Social' then self:social(data)
 elseif self.hub=='Profile' then self:profile(data)
 elseif self.hub=='Shop' then self:shop()
 elseif self.hub=='Settings' then self:settings(data) end
 self.body.CanvasPosition=scroll;self:pending();self:tick()
 if UIS.GamepadEnabled and UIS:GetLastInputType()==Enum.UserInputType.Gamepad1 then
  local target=if selectedName and preserve then self.shade:FindFirstChild(selectedName,true) else nil
  GuiService.SelectedObject=if target and target:IsA('GuiButton') and target.Selectable then target else f.Back
 end
end
function S:creatures(data,width)
 if self.detail then
  local c=R.find(data.creatures,self.detail);if not c then self.detail=nil;self:render(false);return end
  local info=P.creature(c);local species=C.byId[c.species]
  local hero=self:note(info.name..'  ·  Lv '..c.level,species.rarity..'  /  '..species.element..'  /  '..species.role..'\n'..species.feature,146)
  hero.Title.Size=UDim2.new(1,-130,0,28);hero.Description.Size=UDim2.new(1,-130,0,94)
  W.portrait(hero,species,UDim2.fromOffset(92,92),UDim2.new(1,-108,0,12))
  self:note('Companion statistics',string.format('Attack %d     Health %d\nXP %d / %d   ·   Evolution stage %d',math.floor(info.attack),math.floor(info.health),c.xp,info.xpRequired,R.stage(c.level)),108)
  local abilities=info.abilityNames or {species.role..' special'}
  self:note('Manual specials',table.concat(abilities,'  /  ')..'\nBasic attacks run automatically during encounters.',110)
  local evo=self:note('Evolution journey','Stage I: Lv 1   →   Stage II: Lv 15   →   Stage III: Lv 35\nEvolution happens automatically when your creature reaches the level.',122)
  W.progress(evo,math.min(c.level/35,1),UDim2.new(1,-28,0,8),UDim2.new(0,14,1,-17),T.purple)
  local at=data.ui and data.ui.atRefuge
  local train=self:note('Training session','15 coins grants 80 XP. '..(if at then 'Your creature is at the training refuge.' else 'Visit the training station at the refuge.'),150)
  self:action(train,'Train','Train · 15 coins','Train',c.id,at and data.coins>=15 and c.level<50)
  if c.specialization then self:note('Specialization',c.specialization..' is your permanent focus.',88)
  elseif c.level>=25 then
   local row=self:note('Choose a permanent focus','Power: attack +20% · Guard: 15% defense · Vitality: health +25%.',154)
   for i,choice in ipairs({'Power','Guard','Vitality'}) do
    W.button(row,'Focus'..choice,choice,UDim2.new(1/3,-14,0,44),UDim2.new((i-1)/3,10,1,-56),function()
     self.feedback:confirm('Choose '..choice..'?',species.name..' will keep this specialization permanently.',function() self:send('Specialize',{id=c.id,choice=choice}) end)
    end,'gold')
   end
  else self:note('Specialization unlocks at Lv 25','Choose Power, Guard or Vitality when this creature reaches level 25.',96) end
  return
 end
 if self.tab=='Team' then
  local team=self:note('Three companions. One expedition.','Select up to three creatures below, then save your team. '..#self.selected..' / 3 selected.',152)
  self:action(team,'Equip','Save team ('..#self.selected..'/3)','Equip',function() return table.clone(self.selected) end,#self.selected>0)
 elseif self.tab=='Training' then
  self:note('Grow your team','Train at the refuge for 15 coins / 80 XP. Open a creature to see its statistics and train.',110)
 elseif self.tab=='Evolution' then
  self:note('A journey, not a second purchase','Your creatures evolve automatically at levels 15 and 35. Specialization opens at 25. Select a creature for its timeline.',112)
 end
 local compact=self.root.AbsoluteSize.Y<390
 local filters=W.panel(self.body,'Filters',UDim2.new(1,-8,0,if compact then 54 else 110))
 local box=W.round(W.new('TextBox',filters,{Name='Search',Size=UDim2.new(1,-24,0,44),Position=UDim2.fromOffset(12,10),Text=self.query,PlaceholderText='Search your creatures',ClearTextOnFocus=false,TextColor3=T.ink,PlaceholderColor3=T.muted,BackgroundColor3=T.navy,Font=T.body,TextSize=T.size(15),BorderSizePixel=0}),8)
 box.FocusLost:Connect(function() self.query=box.Text;self.page=1;self:render(false) end)
 local rarities={'All','Common','Uncommon','Rare','Epic','Mythic','Legendary'}
 local rarityButton=W.button(filters,'Rarity','Rarity: '..self.rarity,UDim2.new(.6,-18,0,44),UDim2.fromOffset(12,62),function() self.rarity=rarities[(table.find(rarities,self.rarity) or 1)%#rarities+1];self.page=1;self:render(false) end,'quiet')
 local sortButton=W.button(filters,'Sort','Sort: '..self.sort,UDim2.new(.4,-18,0,44),UDim2.new(.6,6,0,62),function() self.sort=if self.sort=='Name' then 'Level' elseif self.sort=='Level' then 'Rarity' else 'Name';self:render(true) end,'quiet')
 if compact then
  box.Size=UDim2.new(.4,-12,0,44);box.Position=UDim2.fromOffset(6,5);box.PlaceholderText='Search'
  rarityButton.Size=UDim2.new(.3,-8,0,44);rarityButton.Position=UDim2.new(.4,0,0,5)
  sortButton.Size=UDim2.new(.3,-8,0,44);sortButton.Position=UDim2.new(.7,0,0,5)
 end
 local list=P.filterCreatures(data,self.query,self.rarity,self.sort)
 if #list==0 then self:note('No matching companions','Try another filter, or discover eggs on your next climb. Your collection stays safe.',108);return end
 local columns=if width<600 then 2 else 3
 local cardHeight=if compact then 150 else 210
 local grid=W.frame(self.body,'CreatureGrid',UDim2.new(1,-8,0,math.ceil(math.min(12,#list-(self.page-1)*12)/columns)*(cardHeight+12)));grid.BackgroundTransparency=1
 W.new('UIGridLayout',grid,{CellSize=UDim2.new(1/columns,-8,0,cardHeight),CellPadding=UDim2.fromOffset(10,12),SortOrder=Enum.SortOrder.LayoutOrder})
 for index=(self.page-1)*12+1,math.min(#list,self.page*12) do
  local c=list[index];local s=C.byId[c.species];local card=W.panel(grid,'Creature_'..c.id,nil,nil,T.card)
  W.portrait(card,s,UDim2.fromOffset(if compact then 48 else 76,if compact then 48 else 76),UDim2.new(.5,if compact then -24 else -38,0,5))
  W.text(card,s.name,UDim2.new(1,-16,0,24),UDim2.fromOffset(8,if compact then 50 else 87),T.bold,16).TextXAlignment=Enum.TextXAlignment.Center
  W.text(card,'Lv '..c.level..' · '..s.rarity,UDim2.new(1,-16,0,24),UDim2.fromOffset(8,if compact then 72 else 114),nil,12,T.rarity[s.rarity]).TextXAlignment=Enum.TextXAlignment.Center
  local selected=table.find(self.selected,c.id)
  local label=if self.tab=='Team' then (if selected then 'Selected '..selected else 'Select') else 'Details'
  W.button(card,'Details_'..c.id,label,UDim2.new(1,-20,0,44),UDim2.new(0,10,1,-56),function()
   if self.tab=='Team' then
    local n=table.find(self.selected,c.id)
    if n then table.remove(self.selected,n) elseif #self.selected<3 then table.insert(self.selected,c.id) else self.feedback:toast('Your team has three slots. Deselect one first.') end
   else self.detail=c.id end
   self:render(self.tab=='Team')
  end,if selected and self.tab=='Team' then 'gold' else 'blue')
 end
 if #list>12 then
  local pages=W.frame(self.body,'Pages',UDim2.new(1,-8,0,50));pages.BackgroundTransparency=1
  W.button(pages,'Previous','Previous',UDim2.new(.5,-8,0,44),nil,function() self.page=math.max(1,self.page-1);self:render(false) end,'quiet',self.page>1)
  W.button(pages,'Next','Next',UDim2.new(.5,-8,0,44),UDim2.fromScale(.5,0),function() self.page+=1;self:render(false) end,'quiet',self.page*12<#list)
 end
end
function S:discovery(data)
 if self.tab=='Field guide' then
  local owned={};for _,c in ipairs(data.creatures) do owned[c.species]=true end
  for k,kingdom in ipairs(C.kingdoms) do
   local found=0;for _,s in ipairs(C.species) do if s.kingdom==k and owned[s.id] then found+=1 end end
   self:note(kingdom.name,found..' / 6 regular species discovered.\nLook for nests, wild encounters, puzzles and exploration branches.',105)
  end;return
 end
 local active=0;for _,e in ipairs(data.eggs) do if e.readyAt then active+=1 end end
 self:note('Carry. Secure. Hatch.','#'..#data.cargo..' / 3 carried eggs  ·  '..#data.eggs..' secured  ·  '..active..' / 3 incubators\nExtract at a checkpoint. Incubation and hatching are free at the refuge.',116)
 if #data.cargo+#data.eggs==0 then self:note('Your next companion is out there','Follow the Blossom Gardens flags. Find a nest or win a wild encounter, then secure the egg at a checkpoint.',120) end
 for _,e in ipairs(data.cargo) do self:note(C.byId[e.species].name..' egg · unsecured','Carry to a checkpoint. A fall leaves your eggs in a recoverable pack for three minutes.',106) end
 for _,e in ipairs(data.eggs) do
  local species=C.byId[e.species];local card=self:note(species.name..' egg',species.rarity..' · secured',178)
  local timer=W.text(card,'',UDim2.new(1,-28,0,26),UDim2.fromOffset(14,78),T.bold,14,T.gold)
  local at=data.ui and data.ui.atRefuge
  local b=self:action(card,'Egg_'..e.id,if e.readyAt then 'Hatch free' else 'Incubate free',if e.readyAt then 'Hatch' else 'Incubate',e.id,at and (if e.readyAt then e.readyAt<=self.store:now() else active<3))
  table.insert(self.tickers,function()
   local remain=if e.readyAt then P.remaining(e.readyAt,self.store:now()) else nil
   timer.Text=if remain then (if remain==0 then 'Ready to hatch' else P.formatTime(remain)..' remaining') else P.formatTime(C.incubation[species.rarity])..' incubation'
   if not at then timer.Text..=' · visit refuge' end
   for _,v in ipairs(self.actionButtons) do if v.button==b then v.enabled=at and (if remain then remain==0 else active<3) end end
  end)
 end
end
function S:sanctuary(data)
 if self.tab=='Habitats' then
  self:blocked('Creature habitats','Habitat construction and creature placement are not connected to this mountain review. Your owned creatures already contribute to its income.','Habitat placement unavailable')
  self:blocked('Building upgrades','The sanctuary environment exists separately. Building levels, costs and plot ownership need its gameplay service.','Building upgrades unavailable')
 elseif self.tab=='Facilities' then
  local row=self:note('Training refuge','Open your collection to train, inspect evolution stages and select a specialization.',150)
  W.button(row,'OpenTraining','Open training',UDim2.new(1,-28,0,44),UDim2.new(0,14,1,-56),function() self:open('Training') end,'gold')
  local egg=self:note('Incubation','Three incubators. Free incubation. Secured eggs only. Visit the refuge to start or hatch.',150)
  W.button(egg,'OpenEggs','Open hatchery',UDim2.new(1,-28,0,44),UDim2.new(0,14,1,-56),function() self:open('Eggs') end)
  self:blocked('Facility upgrades','Facility expansion has no purchase service in this review. Existing training and incubation remain available.')
 else
  self:note('Your sanctuary collection',#data.creatures..' companions · '..data.coins..' coins\nThis review uses the expedition refuge. Personal sanctuary arrival is awaiting the sanctuary connection.',120)
  local income=self:note('Collect creature income','All owned creatures contribute. Offline accrual is capped at eight hours. Collection settles the current server balance.',160)
  self:action(income,'CollectIncome','Collect income','CollectIncome',nil,data.ui and data.ui.atRefuge)
  local at=data.ui and data.ui.atRefuge
  self:note(if at then 'At the refuge' else 'Return to the refuge',if at then 'Use the nearby training, incubation and challenge stations, or manage your collection here.' else 'Fast travel from a discovered checkpoint. The mountain menu shows available destinations.',104)
 end
end
function S:mountain(data)
 if self.tab=='Quests' then
  local q=P.quest(data);local card=self:note(q.title,q.detail,122)
  W.progress(card,q.progress/math.max(q.total,1),UDim2.new(1,-28,0,8),UDim2.new(0,14,1,-18),T.green)
  for k,kingdom in ipairs(C.kingdoms) do self:note(kingdom.name,if data.wins[tostring(k)] then 'Guardian defeated · next ascent unlocked' elseif R.canEnter(data,k) then 'Explore, strengthen your team and challenge '..C.guardians[k].name else 'Defeat '..C.guardians[k-1].name..' to unlock this kingdom.',94) end
  self:blocked('Daily missions','Daily objectives and claimable daily rewards are not connected. This journal tracks your actual mountain progression.','Daily rewards unavailable')
 elseif self.tab=='Trials' then
  for k,g in ipairs(C.guardians) do
   local owned=data.captures[g.id];local won=data.wins[tostring(k)]
   self:note(g.name..' · '..g.title,(if owned then 'CAPTURED · replay for mastery; no duplicate capture.' elseif won then 'Trial available at the kingdom altar.' else 'Defeat the normal Guardian to unlock its Trial.')..'\n3 clean dodges + 4 resolved patterns'..(if k==5 then ' + interrupt the golden heart.' elseif k==6 then ' + align three constellation stones.' else '.'),132)
  end
 else
  local f=self:note('Six kingdoms. One summit.','Travel from a checkpoint or refuge. Only discovered checkpoints are available. Travelling secures carried eggs.',146)
  self:action(f,'ReturnRefuge','Return to refuge','Travel','refuge',data.ui and (data.ui.atRefuge or data.ui.nearCheckpoint))
  for k,kingdom in ipairs(C.kingdoms) do
   local unlocked=R.canEnter(data,k);local color=Color3.fromRGB(table.unpack(kingdom.accent))
   local f=self:note(kingdom.name,(if data.wins[tostring(k)] then 'Guardian defeated' elseif unlocked then 'Explore and challenge '..C.guardians[k].name else 'Locked · defeat '..C.guardians[k-1].name)..'\n'..(data.resources[tostring(k)] or 0)..' '..kingdom.resource,174)
   W.stroke(f,color,2)
   for i,point in ipairs({'entrance','recovery','guardian'}) do
    local id=k..':'..point;local found=data.discoveries[id]==true
    self:action(f,'Travel_'..k..'_'..point,if found then point:gsub('^%l',string.upper) else 'Undiscovered','Travel',id,unlocked and found and data.ui and (data.ui.atRefuge or data.ui.nearCheckpoint),UDim2.new((i-1)/3,10,1,-58),UDim2.new(1/3,-14,0,46))
   end
  end
 end
end
function S:social(data)
 if self.tab=='Party' then
  local battle=self.store.battle
  self:note('Climb together','Friends can join the same Guardian at its altar while the encounter is open. Your teammates attack automatically and share the battle.',116)
  if battle and battle.members then
   for _,m in ipairs(battle.members) do self:note(m.name or tostring(m.userId),'In your current Guardian encounter',82) end
  else self:note('No active co-op encounter','Meet other climbers at a Guardian altar to battle together.',92) end
  self:blocked('Party finder & invitations','Persistent parties, invitations and readiness are not connected in this review. No invitations are sent from this screen.','Invitations unavailable')
 elseif self.tab=='Defense' then
  local f=self:note('Your equipped team is your defense','Register a snapshot for asynchronous challenges. Your creatures and eggs cannot be stolen. UserId: '..Players.LocalPlayer.UserId,164)
  self:action(f,'RegisterDefense','Register defense','RegisterDefense',nil,data.ui and data.ui.atRefuge)
  for i,id in ipairs(data.team) do local c=R.find(data.creatures,id);if c then self:note('Slot '..i..' · '..C.byId[c.species].name,'Level '..c.level..' · '..(c.specialization or 'No specialization'),82) end end
  self:blocked('Sanctuary defense layout','Defense placement and raid buildings need the sanctuary gameplay service. Your team snapshot challenge is available above.')
 else
  self:note('Sanctuary challenges',data.trophies..' trophies · challenge a saved defense\nA registered opponent can be offline. Practice is clearly separate from another player.',116)
  local f=self:note('Challenge a defense','Enter another player’s numeric UserId. Use 0 for the existing practice defense.',222)
  local box=W.round(W.new('TextBox',f,{Name='OpponentId',Size=UDim2.new(1,-28,0,44),Position=UDim2.fromOffset(14,106),Text=self.opponent or '',PlaceholderText='Player UserId (0 = practice)',ClearTextOnFocus=false,TextColor3=T.ink,PlaceholderColor3=T.muted,BackgroundColor3=T.navy,Font=T.body,TextSize=T.size(15),BorderSizePixel=0}),8)
  box.FocusLost:Connect(function() self.opponent=box.Text;if self.deferredRender then task.defer(function() self:render(true) end) end end)
  self:action(f,'ChallengeDefense','Challenge','ChallengeDefense',function() self.opponent=box.Text;return tonumber(box.Text) end,data.ui and data.ui.atRefuge)
  local timer=W.text(f,'',UDim2.new(1,-28,0,23),UDim2.fromOffset(14,79),nil,12,T.gold)
  table.insert(self.tickers,function() local n=P.remaining(data.competitionAt,self.store:now());timer.Text=if n>0 then 'Next challenge in '..P.formatTime(n) else 'Ready at refuge' end)
  self:blocked('Raids & friend challenges','Live raid management and friend matchmaking are not connected. Saved defense challenges use the existing server rules.','Live raids unavailable')
 end
end
function S:profile(data)
 local captures,wins=0,0;for _ in pairs(data.captures) do captures+=1 end;for _ in pairs(data.wins) do wins+=1 end
 if self.tab=='Overview' then
  self:note(Players.LocalPlayer.DisplayName,'@'..Players.LocalPlayer.Name..'\n'..#data.creatures..' companions · '..captures..' / 6 Guardians · '..data.trophies..' trophies',124)
  self:note('Expedition record',wins..' / 6 kingdom Guardians defeated\n'..(if data.discoveries.summit then 'Summit reached · Sovereign Explorer' else 'Summit journey in progress'),112)
 elseif self.tab=='Achievements' then
  for k,g in ipairs(C.guardians) do self:note(g.name..' mastery',(if data.wins[tostring(k)] then '✓ Normal victory earned' else '○ Normal victory not yet earned')..'\n'..(if data.captures[g.id] then '✓ Trial capture earned' else '○ Trial capture not yet earned'),104) end
  self:note('Sovereign Explorer',if data.discoveries.summit then '✓ Summit reached' else '○ Defeat Caeloryn and reach the summit',88)
 else
  self:note('Trophy gallery',data.trophies..' trophies earned in the existing mountain and challenge systems. Guardian captures and summit achievements appear in your profile.',108)
  self:blocked('Leaderboards & in-world rankings','A ranking service and authoritative in-world display feed are not connected. No sample players or invented ranks are shown.','Rankings unavailable')
  self:blocked('Badges & equipped titles','Badge awards and title selection need their platform/profile services. Earned mountain milestones remain visible in Achievements.','Title selection unavailable')
 end
end
function S:shop()
 if self.tab=='Cosmetics' then
  self:note('Make the mountain yours','Cosmetics and personal style belong here: appearances, decorations and visual effects. Your combat strength comes from play.',118)
  self:blocked('Cosmetic collection','No approved product catalog or entitlement service is connected to this review. Items and prices will appear when available.','Checkout unavailable')
 else
  self:note('Fair conveniences','Only noncompetitive convenience belongs here. No paid creature odds, capture advantage or power purchases.',112)
  self:blocked('Convenience catalog','No approved convenience products or receipt validation are connected. There are no purchases available.','Checkout unavailable')
 end
end
function S:settings(data)
 local prefs=(data.ui and data.ui.settings) or {}
 local function toggle(key,title,description)
  local f=self:note(title,description,148)
  self:action(f,'Setting_'..key,if prefs[key] then 'On · tap to turn off' else 'Off · tap to turn on','Settings',function() return {[key]=not prefs[key]} end,true)
 end
 if self.tab=='Audio' then
  for _,v in ipairs({{'musicVolume','Music & ambience'},{'sfxVolume','Sound effects'}}) do
   local key,title=v[1],v[2];local value=prefs[key] or 0
   local f=self:note(title,'Volume '..math.floor(value*100)..'% · visual cues always remain available.',150)
   self:action(f,'Volume_'..key,'Adjust volume','Settings',function() return {[key]=if value>=1 then 0 else math.min(1,value+.25)} end,true)
  end
 elseif self.tab=='Quick' then
  toggle('reducedMotion','Reduced motion','Keep feedback still and remove cinematic movement.')
  toggle('hints','Contextual hints','Short guidance during your expedition, never a mandatory slideshow.')
  toggle('simplifiedVFX','Simplified effects','Reduce decorative particles while retaining encounter cues.')
 else
  toggle('largeText','Larger text','Larger menu labels and descriptions. Panels remain scrollable.')
  toggle('highContrast','High contrast','Opaque panels and brighter outlines improve readability.')
  toggle('reducedMotion','Reduced motion','Reduce UI animation and camera feedback.')
  toggle('simplifiedVFX','Simplified effects','Reduce decorative effects without hiding danger.')
  toggle('hints','Contextual hints','Show short, nonblocking expedition guidance.')
 end
 self:note('Preference storage',data.saveMode or 'Preferences follow your profile save status.',88)
end
return S
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="39">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[local T={
 navy=Color3.fromRGB(11,23,48),panel=Color3.fromRGB(20,44,82),card=Color3.fromRGB(30,61,103),
 sky=Color3.fromRGB(33,184,255),blue=Color3.fromRGB(52,120,246),gold=Color3.fromRGB(255,194,71),
 green=Color3.fromRGB(66,217,121),purple=Color3.fromRGB(163,107,255),coral=Color3.fromRGB(255,102,95),
 ink=Color3.fromRGB(248,251,255),muted=Color3.fromRGB(189,211,237),line=Color3.fromRGB(65,99,146),
 display=Enum.Font.FredokaOne,body=Enum.Font.GothamMedium,bold=Enum.Font.GothamBold,
 prefs={},
 rarity={Common=Color3.fromRGB(190,211,227),Uncommon=Color3.fromRGB(89,222,153),Rare=Color3.fromRGB(70,186,255),Epic=Color3.fromRGB(181,133,255),Mythic=Color3.fromRGB(255,136,185),Legendary=Color3.fromRGB(255,204,91)},
}
function T.configure(p) T.prefs=p or {} end
function T.size(n) return n+(if T.prefs.largeText then 2 else 0) end
return T
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">Widgets</string>
              <string name="Source"><![CDATA[local T=require(script.Parent.Theme)
local W={}
function W.new(class,parent,props)
 local o=Instance.new(class)
 for k,v in pairs(props or {}) do o[k]=v end
 o.Parent=parent;return o
end
function W.round(o,r) W.new('UICorner',o,{CornerRadius=UDim.new(0,r or 12)});return o end
function W.stroke(o,color,thickness) return W.new('UIStroke',o,{Color=color or T.line,Thickness=thickness or (if T.prefs.highContrast then 2 else 1),Transparency=if T.prefs.highContrast then 0 else .15}) end
function W.frame(parent,name,size,pos,color)
 return W.new('Frame',parent,{Name=name,Size=size or UDim2.fromScale(1,1),Position=pos or UDim2.new(),BackgroundColor3=color or T.panel,BorderSizePixel=0})
end
function W.panel(parent,name,size,pos,color)
 local o=W.round(W.frame(parent,name,size,pos,color));W.stroke(o);return o
end
function W.text(parent,content,size,pos,font,n,color)
 local label=W.new('TextLabel',parent,{Name='Text',Size=size or UDim2.new(1,0,0,26),Position=pos or UDim2.new(),BackgroundTransparency=1,Text=tostring(content),TextColor3=color or T.ink,Font=font or T.body,TextSize=T.size(n or 15),TextWrapped=true,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Center,RichText=false})
 label:SetAttribute('BaseTextSize',n or 15);return label
end
function W.button(parent,name,label,size,pos,fn,variant,enabled)
 local isEnabled=enabled~=false
 local color=if variant=='gold' then T.gold elseif variant=='quiet' then T.card elseif variant=='danger' then T.coral else T.blue
 local b=W.round(W.new('TextButton',parent,{Name=name,Size=size or UDim2.new(1,0,0,44),Position=pos or UDim2.new(),BackgroundColor3=if isEnabled then color else T.panel,BorderSizePixel=0,Text=label,TextColor3=if not isEnabled then T.muted elseif variant=='gold' then T.navy else T.ink,TextSize=T.size(14),Font=T.bold,TextWrapped=true,AutoButtonColor=isEnabled,Active=isEnabled,Selectable=isEnabled}),10)
 W.stroke(b,if isEnabled then color else T.line)
 b:SetAttribute('QAControl',true);b:SetAttribute('Enabled',isEnabled)
 b:SetAttribute('BaseTextSize',14)
 b.Activated:Connect(function() if b:GetAttribute('Enabled') and fn then fn() end end)
 return b
end
function W.enable(b,on,label)
 b:SetAttribute('Enabled',on);b.Active=on;b.Selectable=on;b.AutoButtonColor=on
 b.TextTransparency=if on then 0 else .35;if label then b.Text=label end
end
function W.padding(o,n) return W.new('UIPadding',o,{PaddingTop=UDim.new(0,n),PaddingBottom=UDim.new(0,n),PaddingLeft=UDim.new(0,n),PaddingRight=UDim.new(0,n)}) end
function W.list(parent,gap,horizontal)
 return W.new('UIListLayout',parent,{Padding=UDim.new(0,gap or 10),FillDirection=if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical,SortOrder=Enum.SortOrder.LayoutOrder})
end
function W.scroll(parent,name,size,pos)
 local s=W.new('ScrollingFrame',parent,{Name=name,Size=size,Position=pos or UDim2.new(),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=4,ScrollBarImageColor3=T.sky,CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y,ScrollingDirection=Enum.ScrollingDirection.Y})
 W.padding(s,4);W.list(s,10);return s
end
function W.row(parent,title,description,height,color)
 local f=W.panel(parent,(title:gsub('[^%w]','')),UDim2.new(1,-8,0,height or 112),nil,color or T.card)
 W.text(f,title,UDim2.new(1,-28,0,28),UDim2.fromOffset(14,10),T.bold,16).Name='Title'
 local desc=W.text(f,description,UDim2.new(1,-28,0,(height or 112)-52),UDim2.fromOffset(14,42),nil,14,T.muted);desc.Name='Description';desc.TextYAlignment=Enum.TextYAlignment.Top
 return f
end
function W.progress(parent,value,size,pos,color)
 local track=W.round(W.frame(parent,'Progress',size,pos,T.navy),5)
 local fill=W.round(W.frame(track,'Fill',UDim2.fromScale(math.clamp(value or 0,0,1),1),nil,color or T.sky),5)
 return fill
end
function W.tag(parent,label,pos,color)
 local f=W.round(W.frame(parent,'Tag',UDim2.fromOffset(100,24),pos,color or T.navy),7)
 local t=W.text(f,label,UDim2.fromScale(1,1),nil,T.bold,11);t.TextXAlignment=Enum.TextXAlignment.Center
 return f
end
function W.portrait(parent,species,size,pos)
 local C=require(game.ReplicatedStorage.MountainShared.Catalog)
 local color=Color3.fromRGB(table.unpack(C.kingdoms[species.kingdom].accent))
 local f=W.round(W.frame(parent,'Portrait',size,pos,T.navy),14)
 -- Species silhouette badge stays legible even before 3D world streaming completes.
 local halo=W.round(W.frame(f,'Medallion',UDim2.fromScale(.70,.70),UDim2.fromScale(.15,.15),color),100)
 halo.BackgroundTransparency=.83
 local face=W.round(W.frame(f,'Face',UDim2.fromScale(.52,.42),UDim2.fromScale(.24,.35),color),18)
 for _,x in ipairs({.28,.66}) do
  W.round(W.frame(face,'Eye',UDim2.fromScale(.10,.16),UDim2.fromScale(x,.36),T.navy),20)
 end
 local shape=species.shape
 local tall=shape=='rabbit' or shape=='deer';local wing=shape=='moth' or shape=='bird'
 for _,x in ipairs({.24,.59}) do
  local ear=W.round(W.frame(f,'Silhouette',UDim2.fromScale(if wing then .28 else .16,if tall then .38 else .22),UDim2.fromScale(x,if tall then .1 else .23),color),8)
  ear.Rotation=if x<.4 then -20 else 20
 end
 local tier=({Common=1,Uncommon=2,Rare=3,Epic=4,Mythic=5,Legendary=6})[species.rarity] or 1
 W.text(f,string.rep('◆',tier),UDim2.new(1,0,0,18),UDim2.new(0,0,1,-20),T.bold,10,T.rarity[species.rarity]).TextXAlignment=Enum.TextXAlignment.Center
 return f
end
function W.mountain(parent)
 local f=W.frame(parent,'MountainMark',UDim2.fromScale(1,1));f.BackgroundTransparency=1;f.ClipsDescendants=true
 for i,v in ipairs({{.24,.57,.34,T.panel},{.51,.54,.45,T.card},{.70,.68,.26,T.blue}}) do
  local p=W.frame(f,'Peak'..i,UDim2.fromScale(v[3],v[3]*1.5),UDim2.fromScale(v[1],v[2]),v[4]);p.AnchorPoint=Vector2.new(.5,.5);p.Rotation=45
 end
 local star=W.text(f,'✦',UDim2.fromOffset(42,42),UDim2.fromScale(.49,.16),T.display,34,T.gold);star.AnchorPoint=Vector2.new(.5,.5)
 return f
end
return W
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="41">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="FallenPartsDestroyHeight">-200</float>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">true</bool>
    </Properties>
  </Item>
</roblox>