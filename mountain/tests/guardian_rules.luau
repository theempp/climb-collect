local ok,G=pcall(require,'../shared/GuardianRules')
assert(ok and type(G.step)=='function','shared mobile guardian rules exist')
local n=0;local function check(v,name) assert(v,name);n+=1 end
local s=G.new(1,0)
local observations={[1]={alive=true,inside=true,breaking=true,distance=20},[2]={alive=true,inside=true,breaking=true,distance=10},[3]={alive=true,inside=true,breaking=false,distance=1}}
G.alert(s,1,'egg1',0);local _,effects=G.step(s,observations,0)
check(s.target==1 and s.phase=='approaching','first_accepted_strike_alerts')
G.alert(s,2,'egg2',.1);G.step(s,observations,.1)
check(s.target==2,'multi_egg_priority')
observations[1].distance=1;G.step(s,observations,.2);check(s.target==2,'stable_target_dwell')
observations[2].breaking=false;G.step(s,observations,3)
check(s.target==1,'breaking_egg_priority_over_fighter')
observations[1].alive=false;observations[2].inside=false;G.step(s,observations,4)
check(s.target==nil and s.phase=='defending','target_leaves_dies_and_bystander_excluded')
G.alert(s,1,'egg1',5);observations[1].alive=true;observations[1].inside=true;observations[1].breaking=false
G.step(s,observations,6);check(s.target==1,'eligible_threat_pursuit')
G.step(s,observations,100);check(s.target==nil,'timeout_returns_defense')
G.alert(s,1,'egg1',101)
local _,win=G.normalWin(s,{1,2,1},102)
check(s.phase=='resting' and #win.xp==2,'normal_win_xp_contributors_once')
local untilTime=s.restUntil;local _,again=G.normalWin(s,{2,3},103)
check(#again.xp==0 and s.restUntil==untilTime,'respite_nonstacking')
G.alert(s,2,'egg2',104);G.step(s,observations,105);check(s.phase=='resting','public_respite')
G.step(s,observations,untilTime+1);check(s.phase~='resting','respite_ends')
check(s.threats[3]==nil,'no_lower_section_auto_aggro')
print('PASS '..n..' guardian state checks')
