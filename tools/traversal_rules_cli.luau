local R=require("../src/core/shared/TraversalRules")
local K=require("../src/core/shared/TraversalConfig")
local n=0
local function check(name,fn) assert(fn(),name); n+=1 end
check("epoch server timestamps accepted",function() return R.step({mode="climb",hand="L",stamina=50,nextAt=1790000000},"L",{},1790000001,K,false) end)
check("waiting never times out",function() return R.step({mode="climb",hand="L",stamina=50,nextAt=1},"L",{},1790000001,K,false) end)
check("wrong hand neither moves nor mutates stamina",function() local s={mode="climb",hand="L",stamina=50,nextAt=0}; local ok,why=R.step(s,"R",{},2,K,false); return not ok and why=="hand" and s.stamina==50 end)
check("assistance retains same step cost",function() local s={mode="climb",hand="L",stamina=50,nextAt=0}; local a,x=R.step(s,"L",{},2,K,false); local b,y=R.step(s,"R",{},2,K,true); return a and b and x==y end)
check("walkoff has no parachute receipt",function() return not R.canDeploy({mode="fall"},2,true,20,10,K) end)
check("climbing cannot use grounded jump receipt",function() return not R.canDeploy({mode="climb",jumpAt=1,jumpY=10},1.4,true,20,10,K) end)
check("intentional jump remains eligible while airborne",function() return R.canDeploy({mode="fall",jumpAt=1,jumpY=10},1.4,true,12,10,K) end)
check("expired receipt rejects",function() return not R.canDeploy({mode="fall",jumpAt=1,jumpY=10},4,true,12,10,K) end)
check("occupied rope survives expiry",function() return not R.canRemoveRope({expires=1,occupants=1,retiring=true},10) and R.canRemoveRope({expires=1,occupants=0,retiring=true},10) end)
check("flight cannot unlock future camp",function() return not R.checkpointAllowed("flight",true,"Shepherd",1,0) and not R.canLand(1,2,20,30) end)
check("closed route cannot unlock checkpoint",function() return not R.checkpointAllowed("ground",true,"Ledge",nil,4) and not R.checkpointAllowed("ground",true,"Spire",nil,4) end)
check("invalid numbers reject",function() return not R.finite(0/0) and not R.finite(math.huge) and not R.finite("3") end)
check("bank request cannot race movement heartbeat",function() return R.movementAllowed and not R.movementAllowed(80,0,0.01) and not R.movementAllowed(0,80,0.01) end)
check("authorized baseline walk and ordinary fall remain valid",function() return R.movementAllowed(0,0,0.01) and R.movementAllowed(3,0,0.15) and R.movementAllowed(0,-100,0.15) end)
print("Traversal rules: "..n.."/"..n.." passed (pure Luau)")
assert(not R.movementAllowed(30,0,1,16), "normal speed envelope rejects 30")
